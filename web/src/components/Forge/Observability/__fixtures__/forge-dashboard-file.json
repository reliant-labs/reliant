{
  "version": "forge.dashboards/v1",
  "id": "releases",
  "title": "shop: releases",
  "description": "Request rate, error rate and latency split by service.version, so a deploy shows as one version replacing another. Deploy markers come from the release ledger. Narrow with the service.name and deployment.environment.name filters.",
  "filters": [
    {
      "id": "service",
      "label": "service.name",
      "field": "service.name"
    },
    {
      "id": "env",
      "label": "deployment.environment.name",
      "field": "deployment.environment.name"
    }
  ],
  "annotations": [
    {
      "source": "releases",
      "label": "Releases"
    }
  ],
  "panels": [
    {
      "id": "request-rate-by-version",
      "title": "Requests by version",
      "kind": "line",
      "signal": "traces",
      "series": [
        {
          "label": "requests",
          "agg": "count"
        }
      ],
      "where": [
        {
          "field": "span.kind",
          "op": "eq",
          "value": "server"
        }
      ],
      "groupBy": [
        "resource.attr.service.version"
      ],
      "unit": "count",
      "width": 12,
      "height": 7
    },
    {
      "id": "error-rate-by-version",
      "title": "Error rate by version",
      "description": "Server faults (span status Error) over all requests, per version.",
      "kind": "line",
      "signal": "traces",
      "series": [
        {
          "label": "errors",
          "agg": "count",
          "where": [
            {
              "field": "span.status",
              "op": "eq",
              "value": "error"
            }
          ]
        },
        {
          "label": "requests",
          "agg": "count"
        }
      ],
      "ratio": true,
      "where": [
        {
          "field": "span.kind",
          "op": "eq",
          "value": "server"
        }
      ],
      "groupBy": [
        "resource.attr.service.version"
      ],
      "unit": "percent",
      "width": 12,
      "height": 7
    },
    {
      "id": "p95-by-version",
      "title": "p95 latency by version",
      "kind": "line",
      "signal": "traces",
      "series": [
        {
          "label": "p95",
          "agg": "quantile",
          "quantile": 0.95,
          "field": "span.duration"
        }
      ],
      "where": [
        {
          "field": "span.kind",
          "op": "eq",
          "value": "server"
        }
      ],
      "groupBy": [
        "resource.attr.service.version"
      ],
      "unit": "ms",
      "width": 12,
      "height": 7
    },
    {
      "id": "p99-by-version",
      "title": "p99 latency by version",
      "kind": "line",
      "signal": "traces",
      "series": [
        {
          "label": "p99",
          "agg": "quantile",
          "quantile": 0.99,
          "field": "span.duration"
        }
      ],
      "where": [
        {
          "field": "span.kind",
          "op": "eq",
          "value": "server"
        }
      ],
      "groupBy": [
        "resource.attr.service.version"
      ],
      "unit": "ms",
      "width": 12,
      "height": 7
    },
    {
      "id": "version-comparison",
      "title": "Version comparison",
      "description": "Requests, errors and latency per service.version over the selected range. Pick a range that spans a deploy to read old against new.",
      "kind": "table",
      "signal": "traces",
      "series": [
        {
          "label": "requests",
          "agg": "count"
        },
        {
          "label": "errors",
          "agg": "count",
          "where": [
            {
              "field": "span.status",
              "op": "eq",
              "value": "error"
            }
          ]
        },
        {
          "label": "p50",
          "agg": "quantile",
          "quantile": 0.5,
          "field": "span.duration"
        },
        {
          "label": "p95",
          "agg": "quantile",
          "quantile": 0.95,
          "field": "span.duration"
        },
        {
          "label": "p99",
          "agg": "quantile",
          "quantile": 0.99,
          "field": "span.duration"
        }
      ],
      "where": [
        {
          "field": "span.kind",
          "op": "eq",
          "value": "server"
        }
      ],
      "groupBy": [
        "resource.attr.service.version"
      ],
      "width": 24,
      "height": 8
    },
    {
      "id": "error-logs-by-version",
      "title": "Error logs by version",
      "kind": "line",
      "signal": "logs",
      "series": [
        {
          "label": "errors",
          "agg": "count"
        }
      ],
      "where": [
        {
          "field": "log.severity",
          "op": "eq",
          "value": "error"
        }
      ],
      "groupBy": [
        "resource.attr.service.version"
      ],
      "unit": "count",
      "width": 24,
      "height": 7
    }
  ]
}
