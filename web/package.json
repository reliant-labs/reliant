{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:alpha": "vite build",
    "build:alpha-safe": "(tsc -b tsconfig.alpha.json || echo 'TypeScript errors ignored for alpha build') && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:memory": "playwright test tests/memory-leak.test.ts --project=memory-tests",
    "test:memory:ci": "CI=true playwright test tests/memory-leak.test.ts --project=memory-tests --reporter=json",
    "test:watch": "vitest --watch",
    "test:all": "npm run test",
    "mcp:playwright": "npx playwright-mcp"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@connectrpc/connect": "^2.1.1",
