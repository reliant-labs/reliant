[
  cmd.workerOptions {
    DatabaseDriver: "postgres"
    DatabaseURL: "postgres://reliant:pw@db.surface.test:5432/reliant"
    DatabaseDirectURL: "postgres://reliant:pw@db-direct.surface.test:5432/reliant"
    DatabasePool: db.Pool {
      MaxOpenConns: 41
      MaxIdleConns: 17
      ConnectTimeout: 47s
      SchemaWait: 2m3s
      KeepIdleWarm: true
    }
    DataDir: "/surface/data"
    TemporalHost: "temporal.surface.test"
    TemporalPort: 7299
    TemporalNamespace: "surface"
    NATS: natsutil.Endpoint {
      URL: "nats://nats.surface.test:4223"
      User: "nats-user"
      Password: "nats-pass"
    }
    StreamingDriver: "nats"
    HealthAddr: ":18082"
    LivenessPaths: [
      "/live"
      "/health"
    ]
    ReadinessPaths: [
      "/ready"
      "/ready2"
    ]
    PreStopDelay: 11s
    ShutdownTimeout: 43s
    PprofPort: 16061
    ControlPlane: controlplane.Endpoint {
      URL: "http://cp.surface.test:8080"
      InternalServiceSecret: "cp-secret"
    }
    AllowPrivateEgress: true
    Log: logging.Settings {
      Level: "warn"
      Format: "json"
    }
    PublicURL: "https://public.surface.test"
    VaultKey: "v1:c3VyZmFjZS12YXVsdC1rZXktMzItYnl0ZXMtbG9uZyE="
    Webhooks: webhook.RegistryConfig {
      SlackSigningSecret: "slack-signing"
      GitHubWebhookSecret: "gh-webhook"
      OAuthClients: func(set=false)
      PublicURL: "https://public.surface.test"
      TestIntegrationSecret: "test-integration"
    }
    GitHubAppSlug: "surface-app"
    GitHubBot: github.OurBot {
      ID: 4242
      Login: ""
    }
    Observability: observability.Settings {
      Environment: "surface"
      OTLPEndpoint: "http://otel.surface.test:4318"
      OTLPEnabled: true
      PrometheusEnabled: false
    }
    Analytics: analytics.Settings {
      Disabled: true
    }
    LLM: drivers.Settings {
      StreamTimeouts: llm.StreamTimeouts {
        Idle: 1m31s
        ContentStall: 6m0s
        Progress: 11m0s
        MidBlock: 3m0s
      }
      ReliantBaseURL: "https://llm.surface.test"
      VertexProject: "surface-project"
      VertexLocation: "europe-west4"
      DebugOpenAIResponsesInput: true
      DebugOpenAIToolSchemas: true
    }
    Preview: tools.PreviewSettings {
      ProxyHost: "proxy.surface.test"
      WorkspaceBaseDomain: "ws.surface.test"
      WorkspaceURLScheme: "http"
      WorkspaceURLPort: 8443
    }
    WorkflowTaskSlots: 7
    WorkflowTaskPollers: 3
    Egress: egresslimit.Limits {
      Replicas: 2
      UserPerMinute: 11
      UserBurst: 12
      UserMaxConcurrent: 15
      HostMaxConcurrent: 17
      TurnMaxParallel: 18
    }
  }
  {
    github: [
      "gh-client"
      "gh-secret"
    ]
    gmail: [
      ""
      ""
    ]
    slack: [
      "slack-client"
      ""
    ]
  }
]