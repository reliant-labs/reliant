--log-format shorthand="" type=string default=""
--log-level shorthand="" type=string default=""
--pprof-port shorthand="" type=int32 default="6060"
--streaming-driver shorthand="" type=string default="nats"
--temporal-host shorthand="" type=string default="localhost"
--temporal-namespace shorthand="" type=string default="reliant"
--temporal-port shorthand="" type=int32 default="7233"
--tls-cert shorthand="" type=string default=""
