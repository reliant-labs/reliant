# Generated protobuf code
# gen/reliant/ is committed: it is the importable public API surface
# (reliant.v1 Connect types + clients) consumed by sibling repos.
# gen/controlplane/ stays ignored — internal-only, regenerated from
# proto/controlplane/v1/admin.proto via `buf generate`.
gen/controlplane/
web/src/gen/
nul
dev/

# Generated documentation and presets (rebuilt during make generate)
# Source of truth files and what they generate:
#
# Keyboard Shortcuts (from config/shortcuts.yaml):
#   -> web/src/store/shortcutsData.generated.ts
#   -> generated/docs-source/settings/keyboard-shortcuts.generated.md
#
# Workflow/schema/model/tool reference docs:
#   -> generated/docs-source/reference/*.md
#   -> docs/reference/*.mdx
#
# Preset reference docs:
#   -> generated/docs-source/workflows/presets-reference.generated.md
#   -> docs/workflows/presets-reference.generated.mdx
#
# Changelog:
#   -> docs/data/releases/*.yaml
#   -> docs/changelog.mdx
#
# Workflow Builder Skill (from generated docs + runtime reference data):
#   -> internal/skills/catalog/builtin/workflow-builder/SKILL.md

# Generated directory (intermediate build artifacts)
generated/

# Generated Go reference files (from tools/docgen)
internal/workflow/v3/reference/
internal/workflow/v2/schema/field_descriptions.go

# Generated YAML bindings (from proto descriptors)
internal/workflow/yaml/bindings_generated.go

# Generated sqlc code
internal/db/sqlite/generated/

# Generated mocks
internal/llm/drivers/mocks/

# Generated TypeScript
web/src/store/shortcutsData.generated.ts

