      "code": "twitter_card_missing",
      "severity": "info",
      "category": "seo",
      "route": "/",
      "ref": "twitter:card",
      "fix": "Add \u003cmeta name=\"twitter:card\" content=\"summary_large_image\"\u003e for a large preview on X."
