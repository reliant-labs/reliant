      "code": "canonical_missing",
      "severity": "warn",
      "category": "seo",
      "route": "/",
      "ref": "canonical",
      "fix": "Add \u003clink rel=\"canonical\" href=\"https://\u003cprod host\u003e/\u003cpath\u003e\"\u003e naming the page's preferred URL."
    },
    {
      "code": "description_missing",
      "severity": "warn",
      "category": "seo",
      "route": "/",
      "ref": "description",
      "fix": "Add \u003cmeta name=\"description\" content=\"…\"\u003e summarising the page in one or two sentences."
    },
    {
      "code": "image_alt_missing",
      "severity": "warn",
      "category": "seo",
      "route": "/",
      "ref": "/x.png",
      "fix": "Add alt text describing the image, or alt=\"\" when it is decorative."
    },
    {
      "code": "lang_missing",
      "severity": "warn",
      "category": "seo",
      "route": "/",
      "fix": "Add a lang attribute to \u003chtml\u003e (\u003chtml lang=\"en\"\u003e)."
    },
    {
      "code": "link_text_generic",
      "severity": "warn",
      "category": "seo",
      "route": "/",
      "ref": "https://lint.example/missing",
      "evidence": {
        "text": "here"
      },
      "fix": "Describe the target in the link text instead of \"click here\" or \"read more\"."
    },
    {
      "code": "og_image_relative",
      "severity": "warn",
      "category": "seo",
      "route": "/",
      "ref": "og:image",
      "evidence": {
        "og:image": "/og.png"
      },
      "fix": "Make og:image an absolute https URL: scrapers do not resolve relative ones."
    },
