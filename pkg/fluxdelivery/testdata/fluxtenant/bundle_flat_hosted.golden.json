{
  "OCIRepository": {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "OCIRepository",
    "metadata": {
      "name": "acme.env.env-prod",
      "namespace": "flux-acme",
      "labels": {
        "app.kubernetes.io/managed-by": "reliant-control-plane",
        "reliant.dev/environment": "env-prod",
        "reliant.dev/org": "acme",
        "sharding.fluxcd.io/key": "shard0"
      }
    },
    "spec": {
      "url": "oci://registry.example.com/orgs/acme/bundle.v1/prod",
      "interval": "5m0s",
      "ref": {
        "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "secretRef": {
        "name": "registry-pull"
      },
      "layerSelector": {
        "mediaType": "application/vnd.forge.bundle.manifests.v1.tar+gzip",
        "operation": "extract"
      }
    }
  },
  "Kustomizations": [
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "acme.env.env-prod-hosted",
        "namespace": "flux-acme",
        "labels": {
          "app.kubernetes.io/managed-by": "reliant-control-plane",
          "reliant.dev/cluster": "hosted",
          "reliant.dev/environment": "env-prod",
          "reliant.dev/org": "acme",
          "sharding.fluxcd.io/key": "shard0"
        }
      },
      "spec": {
        "interval": "5m0s",
        "prune": true,
        "sourceRef": {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "name": "acme.env.env-prod"
        },
        "path": "manifests/hosted",
        "targetNamespace": "env-prod",
        "serviceAccountName": "reliant-deploy-tenant",
        "wait": true,
        "timeout": "5m0s",
        "commonMetadata": {
          "labels": {
            "reliant.dev/environment": "env-prod",
            "reliant.dev/org": "acme"
          }
        },
        "patches": [
          {
            "patch": "metadata:\n  labels:\n    forge.dev/deployment-id: d-1\n",
            "target": {
              "group": "forge.dev",
              "version": "v1alpha1",
              "kind": "Workload",
              "name": "api"
            }
          }
        ]
      }
    }
  ]
}
