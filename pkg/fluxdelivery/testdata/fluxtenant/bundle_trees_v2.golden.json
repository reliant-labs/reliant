{
  "OCIRepository": {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "OCIRepository",
    "metadata": {
      "name": "acme.env.env-prod",
      "namespace": "flux-acme",
      "labels": {
        "app.kubernetes.io/managed-by": "reliant-control-plane",
        "reliant.dev/environment": "env-prod",
        "reliant.dev/org": "acme",
        "sharding.fluxcd.io/key": "shard0"
      }
    },
    "spec": {
      "url": "oci://registry.example.com/orgs/acme/bundle.v1/prod",
      "interval": "5m0s",
      "ref": {
        "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "secretRef": {
        "name": "registry-pull"
      },
      "layerSelector": {
        "mediaType": "application/vnd.forge.bundle.manifests.v1.tar+gzip",
        "operation": "extract"
      }
    }
  },
  "Kustomizations": [
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "acme.env.env-prod-daemon-daemon-substrate-pre",
        "namespace": "flux-acme",
        "labels": {
          "app.kubernetes.io/managed-by": "reliant-control-plane",
          "reliant.dev/cluster": "daemon",
          "reliant.dev/delivery-unit": "daemon-substrate",
          "reliant.dev/environment": "env-prod",
          "reliant.dev/org": "acme",
          "reliant.dev/phase": "pre",
          "sharding.fluxcd.io/key": "connected"
        }
      },
      "spec": {
        "interval": "5m0s",
        "prune": true,
        "sourceRef": {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "name": "acme.env.env-prod"
        },
        "path": "manifests/daemon/daemon-substrate/pre",
        "serviceAccountName": "",
        "kubeConfig": {
          "secretRef": {
            "name": "daemon-kubeconfig",
            "key": "value"
          }
        },
        "wait": false,
        "timeout": "1m30s",
        "retryInterval": "15s"
      }
    },
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "acme.env.env-prod-daemon-daemon-substrate-rollout",
        "namespace": "flux-acme",
        "labels": {
          "app.kubernetes.io/managed-by": "reliant-control-plane",
          "reliant.dev/cluster": "daemon",
          "reliant.dev/delivery-unit": "daemon-substrate",
          "reliant.dev/environment": "env-prod",
          "reliant.dev/org": "acme",
          "reliant.dev/phase": "rollout",
          "sharding.fluxcd.io/key": "connected"
        }
      },
      "spec": {
        "interval": "5m0s",
        "prune": true,
        "sourceRef": {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "name": "acme.env.env-prod"
        },
        "path": "manifests/daemon/daemon-substrate/rollout",
        "serviceAccountName": "",
        "kubeConfig": {
          "secretRef": {
            "name": "daemon-kubeconfig",
            "key": "value"
          }
        },
        "wait": false,
        "timeout": "1m30s",
        "retryInterval": "15s",
        "dependsOn": [
          {
            "name": "acme.env.env-prod-daemon-daemon-substrate-pre"
          }
        ],
        "healthChecks": [
          {
            "apiVersion": "apps/v1",
            "kind": "Deployment",
            "name": "operator",
            "namespace": "kata"
          }
        ]
      }
    },
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "acme.env.env-prod-hub-base-post",
        "namespace": "flux-acme",
        "labels": {
          "app.kubernetes.io/managed-by": "reliant-control-plane",
          "reliant.dev/cluster": "hub",
          "reliant.dev/delivery-unit": "base",
          "reliant.dev/environment": "env-prod",
          "reliant.dev/org": "acme",
          "reliant.dev/phase": "post",
          "sharding.fluxcd.io/key": "connected"
        }
      },
      "spec": {
        "interval": "5m0s",
        "prune": true,
        "sourceRef": {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "name": "acme.env.env-prod"
        },
        "path": "manifests/hub/base/post",
        "serviceAccountName": "",
        "kubeConfig": {
          "secretRef": {
            "name": "hub-kubeconfig",
            "key": "value"
          }
        },
        "wait": false,
        "timeout": "1m30s",
        "retryInterval": "15s",
        "dependsOn": [
          {
            "name": "acme.env.env-prod-hub-base-rollout"
          }
        ],
        "healthChecks": [
          {
            "apiVersion": "batch/v1",
            "kind": "Job",
            "name": "seed-def456",
            "namespace": "app"
          }
        ]
      }
    },
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "acme.env.env-prod-hub-base-pre",
        "namespace": "flux-acme",
        "labels": {
          "app.kubernetes.io/managed-by": "reliant-control-plane",
          "reliant.dev/cluster": "hub",
          "reliant.dev/delivery-unit": "base",
          "reliant.dev/environment": "env-prod",
          "reliant.dev/org": "acme",
          "reliant.dev/phase": "pre",
          "sharding.fluxcd.io/key": "connected"
        }
      },
      "spec": {
        "interval": "5m0s",
        "prune": true,
        "sourceRef": {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "name": "acme.env.env-prod"
        },
        "path": "manifests/hub/base/pre",
        "serviceAccountName": "",
        "kubeConfig": {
          "secretRef": {
            "name": "hub-kubeconfig",
            "key": "value"
          }
        },
        "wait": false,
        "timeout": "1m30s",
        "retryInterval": "15s",
        "dependsOn": [
          {
            "name": "acme.env.env-prod-daemon-daemon-substrate-rollout"
          }
        ],
        "healthChecks": [
          {
            "apiVersion": "batch/v1",
            "kind": "Job",
            "name": "migrate-abc123",
            "namespace": "app"
          }
        ]
      }
    },
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "acme.env.env-prod-hub-base-rollout",
        "namespace": "flux-acme",
        "labels": {
          "app.kubernetes.io/managed-by": "reliant-control-plane",
          "reliant.dev/cluster": "hub",
          "reliant.dev/delivery-unit": "base",
          "reliant.dev/environment": "env-prod",
          "reliant.dev/org": "acme",
          "reliant.dev/phase": "rollout",
          "sharding.fluxcd.io/key": "connected"
        }
      },
      "spec": {
        "interval": "5m0s",
        "prune": true,
        "sourceRef": {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "name": "acme.env.env-prod"
        },
        "path": "manifests/hub/base/rollout",
        "serviceAccountName": "",
        "kubeConfig": {
          "secretRef": {
            "name": "hub-kubeconfig",
            "key": "value"
          }
        },
        "wait": false,
        "timeout": "1m30s",
        "retryInterval": "15s",
        "dependsOn": [
          {
            "name": "acme.env.env-prod-hub-base-pre"
          }
        ],
        "healthChecks": [
          {
            "apiVersion": "apps/v1",
            "kind": "Deployment",
            "name": "web",
            "namespace": "app"
          }
        ]
      }
    }
  ]
}
