    readOnlyRootFilesystem?: bool
    runAsGroup?: int
    runAsUser?: int

    check:
        fsGroup == Undefined or fsGroup >= 1, "PodSecurity.fsGroup must be at least 1"
        runAsGroup == Undefined or runAsGroup >= 1, "PodSecurity.runAsGroup must be at least 1"
