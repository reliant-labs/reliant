        port == Undefined or port >= 1, "Probes.port must be at least 1"
        port == Undefined or port <= 65535, "Probes.port must be at most 65535"
        readinessPath == Undefined or regex.match(readinessPath, "^/.*$"), "Probes.readinessPath must match ^/.*$"
        readinessPath == Undefined or len(readinessPath) <= 2048, "Probes.readinessPath must be at most 2048 characters"
        startupPath == Undefined or regex.match(startupPath, "^/.*$"), "Probes.startupPath must match ^/.*$"
        startupPath == Undefined or len(startupPath) <= 2048, "Probes.startupPath must be at most 2048 characters"
        timeoutSeconds >= 1, "Probes.timeoutSeconds must be at least 1"

probes_json = lambda v: Probes -> {str:} {
    _d = {
        "failureThreshold": v.failureThreshold
        "initialDelaySeconds": v.initialDelaySeconds
        "livenessPath": v.livenessPath
        "periodSeconds": v.periodSeconds
        "port": v.port
        "readinessPath": v.readinessPath
        "startupPath": v.startupPath
        "tcp": v.tcp
        "timeoutSeconds": v.timeoutSeconds
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Resources:
    """Resources is a workload's compute request and limit, in NEUTRAL units: CPU in millicores, memory in BYTES."""
    cpuLimitMillicores?: int
    cpuRequestMillicores: int = 250
    memoryLimitBytes?: int
    memoryRequestBytes: int = 1073741824

    check:
        cpuLimitMillicores == Undefined or cpuLimitMillicores >= 1, "Resources.cpuLimitMillicores must be at least 1"
        cpuRequestMillicores >= 1, "Resources.cpuRequestMillicores must be at least 1"
        memoryLimitBytes == Undefined or memoryLimitBytes >= 1, "Resources.memoryLimitBytes must be at least 1"
        memoryRequestBytes >= 1, "Resources.memoryRequestBytes must be at least 1"

resources_json = lambda v: Resources -> {str:} {
    _d = {
        "cpuLimitMillicores": v.cpuLimitMillicores
        "cpuRequestMillicores": v.cpuRequestMillicores
        "memoryLimitBytes": v.memoryLimitBytes
        "memoryRequestBytes": v.memoryRequestBytes
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema RuntimeConfigValue:
    """RuntimeConfigValue is one entry of a StaticSite's runtime config: EXACTLY ONE of a literal value or a workload URL reference."""
    value?: str
    workloadURL?: WorkloadURLRef

    check:
        value == Undefined or len(value) <= 32768, "RuntimeConfigValue.value must be at most 32768 characters"
        (1 if value != Undefined and value != None else 0) + (1 if workloadURL != Undefined and workloadURL != None else 0) == 1, "RuntimeConfigValue: exactly one of the fields in [value workloadURL] must be set"

runtime_config_value_json = lambda v: RuntimeConfigValue -> {str:} {
    _d = {
        "value": v.value
        "workloadURL": workload_url_ref_json(v.workloadURL) if v.workloadURL else Undefined
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema SecretKeyRef:
    """SecretKeyRef names one key of a Secret in the workload's own namespace."""
    key: str
    name: str
    optional?: bool

    check:
        len(key) >= 1, "SecretKeyRef.key must be at least 1 characters"
        len(key) <= 253, "SecretKeyRef.key must be at most 253 characters"
        len(name) >= 1, "SecretKeyRef.name must be at least 1 characters"
        len(name) <= 253, "SecretKeyRef.name must be at most 253 characters"

secret_key_ref_json = lambda v: SecretKeyRef -> {str:} {
    _d = {
        "key": v.key
        "name": v.name
        "optional": v.optional
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema SecretVolumeSource:
    """SecretVolumeSource names a Secret, and optionally which keys to project."""
    items?: [KeyToPath]
    name: str
    optional?: bool

    check:
        items == Undefined or len(items) <= 64, "SecretVolumeSource.items allows at most 64 entries"
        len(name) >= 1, "SecretVolumeSource.name must be at least 1 characters"
        len(name) <= 253, "SecretVolumeSource.name must be at most 253 characters"

secret_volume_source_json = lambda v: SecretVolumeSource -> {str:} {
    _d = {
        "items": [key_to_path_json(_i) for _i in v.items] if v.items else Undefined
        "name": v.name
        "optional": v.optional
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema StaticSiteCDN:
    """StaticSiteCDN is the CDN in front of the site's bucket, and what a deploy does to the edge cache afterwards. Neither side creates the CDN: URLMap names an EXISTING load-balancer URL map whose backend is the bucket."""
    extraInvalidatePaths?: [str]
    invalidate: str = "entrypoints"
    urlMap: str

    check:
        invalidate in ["entrypoints", "none", "all"], "StaticSiteCDN.invalidate must be one of \"entrypoints\", \"none\", \"all\""
        len(urlMap) >= 1, "StaticSiteCDN.urlMap must be at least 1 characters"

static_site_cdn_json = lambda v: StaticSiteCDN -> {str:} {
    _d = {
        "extraInvalidatePaths": v.extraInvalidatePaths
        "invalidate": v.invalidate
        "urlMap": v.urlMap
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Toleration:
    """Toleration lets the workload's pods schedule onto nodes with a matching taint. It is a local mirror of core/v1 Toleration, for the same reasons as PolicyRule: the schema is closed and self-contained."""
    effect?: str
    key?: str
    operator?: str
    tolerationSeconds?: int
    value?: str

    check:
        effect == Undefined or effect in ["NoSchedule", "PreferNoSchedule", "NoExecute"], "Toleration.effect must be one of \"NoSchedule\", \"PreferNoSchedule\", \"NoExecute\""
        key == Undefined or len(key) <= 316, "Toleration.key must be at most 316 characters"
        operator == Undefined or operator in ["Exists", "Equal"], "Toleration.operator must be one of \"Exists\", \"Equal\""
        tolerationSeconds == Undefined or tolerationSeconds >= 0, "Toleration.tolerationSeconds must be at least 0"
        value == Undefined or len(value) <= 63, "Toleration.value must be at most 63 characters"

toleration_json = lambda v: Toleration -> {str:} {
    _d = {
        "effect": v.effect
        "key": v.key
        "operator": v.operator
        "tolerationSeconds": v.tolerationSeconds
        "value": v.value
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Volume:
    """Volume is one pod volume and its mount into the MAIN container."""
    mountPath: str
    name: str
    readOnly?: bool
    source: VolumeSource

    check:
        regex.match(mountPath, "^/.*$"), "Volume.mountPath must match ^/.*$"
        len(mountPath) >= 1, "Volume.mountPath must be at least 1 characters"
        len(mountPath) <= 4096, "Volume.mountPath must be at most 4096 characters"
        regex.match(name, "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"), "Volume.name must match ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        len(name) >= 1, "Volume.name must be at least 1 characters"
        len(name) <= 63, "Volume.name must be at most 63 characters"

volume_json = lambda v: Volume -> {str:} {
    _d = {
        "mountPath": v.mountPath
        "name": v.name
        "readOnly": v.readOnly
        "source": volume_source_json(v.source) if v.source else Undefined
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema VolumeSource:
    """VolumeSource is exactly one of the four closed volume sources."""
    configMap?: ConfigMapVolumeSource
    emptyDir?: EmptyDirVolumeSource
    pvc?: PVCVolumeSource
    secret?: SecretVolumeSource

    check:
        (1 if secret != Undefined and secret != None else 0) + (1 if configMap != Undefined and configMap != None else 0) + (1 if emptyDir != Undefined and emptyDir != None else 0) + (1 if pvc != Undefined and pvc != None else 0) == 1, "VolumeSource: exactly one of the fields in [secret configMap emptyDir pvc] must be set"

volume_source_json = lambda v: VolumeSource -> {str:} {
    _d = {
        "configMap": config_map_volume_source_json(v.configMap) if v.configMap else Undefined
        "emptyDir": empty_dir_volume_source_json(v.emptyDir) if v.emptyDir else Undefined
        "pvc": pvc_volume_source_json(v.pvc) if v.pvc else Undefined
        "secret": secret_volume_source_json(v.secret) if v.secret else Undefined
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema WorkloadURLRef:
    """WorkloadURLRef names a workload, in the same environment, whose public URL is the value. Resolution is scoped by construction: the name carries no org, env or namespace component, so a reference can only ever reach a sibling workload."""
    name: str

    check:
        regex.match(name, "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"), "WorkloadURLRef.name must match ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        len(name) >= 1, "WorkloadURLRef.name must be at least 1 characters"
        len(name) <= 63, "WorkloadURLRef.name must be at most 63 characters"

workload_url_ref_json = lambda v: WorkloadURLRef -> {str:} {
    _d = {
        "name": v.name
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

# The hosted (Restricted-profile) mask: every WorkloadSpec field path and
# kind v1alpha1.FieldProfiles / KindProfiles allow ONLY under the Full
# profile, with the reason admission gives. Paths are JSON names joined
# with "."; a list element shares its list's path ("env.secretRef").
RESTRICTED_FIELD_REASONS: {str:str} = {
    "clusterRBAC" = "hosted workloads have no Kubernetes API access until each hosted user runs in an isolated cluster (vcluster)"
    "crds" = "operators need cluster-scoped Kubernetes API access, which shared hosted nodes cannot grant until each hosted user runs in an isolated cluster (vcluster)"
    "enableServiceLinks" = "service links inject an env var per Service in the namespace; a hosted namespace is platform-owned, and its Services are not the author's to read. Address your own workloads by DNS name"
    "env.configMapRef" = "a ConfigMap reference reads a namespace object you did not write; use value, or managedSecret for a credential"
    "env.fieldRef" = "the Downward API exposes pod and node placement, which the hosted platform owns"
    "env.secretRef" = "a raw Secret name in a shared hosted namespace can address platform-owned Secrets; use managedSecret, which names a value in your environment's secret store"
    "group" = "operators need cluster-scoped Kubernetes API access, which shared hosted nodes cannot grant until each hosted user runs in an isolated cluster (vcluster)"
    "leaderElection" = "operators need cluster-scoped Kubernetes API access, which shared hosted nodes cannot grant until each hosted user runs in an isolated cluster (vcluster)"
    "namespacedRBAC" = "hosted workloads have no Kubernetes API access until each hosted user runs in an isolated cluster (vcluster)"
    "nodeSelector" = "hosted placement (the isolation pool) is decided by the platform, never by the workload's author"
    "podAnnotations" = "pod annotations drive platform integrations (mesh injection, runtime class, autoscalers) that the hosted platform owns"
    "priorityClassName" = "the hosted platform ranks hosted pods itself, on its own priority ladder; a class you chose could preempt another hosted user's pods, or the platform's own"
    "schedule" = "cron is not available on hosted until metering covers it"
    "securityContext" = "the hosted platform owns the pod identity (uid, gid, filesystem) its isolation depends on"
    "serviceAccount" = "hosted workloads run under a platform-owned ServiceAccount; naming another one would borrow its identity"
    "serviceAccountAnnotations" = "hosted workloads run under a platform-owned ServiceAccount; cloud workload identity is bound by the platform, never by the workload's author"
    "sidecars" = "the hosted platform composes the pod itself (runtime class, isolation, egress), and a second container you author would run outside the single-container policy it enforces"
    "terminationGracePeriodSeconds" = "the hosted platform sets the grace period, because it holds shared node capacity past SIGTERM; tune PRE_STOP_DELAY and SHUTDOWN_TIMEOUT, which it derives from"
    "tolerations" = "hosted placement (the isolation pool) is decided by the platform, never by the workload's author; a toleration would let a pod onto nodes reserved for something else"
    "version" = "operators need cluster-scoped Kubernetes API access, which shared hosted nodes cannot grant until each hosted user runs in an isolated cluster (vcluster)"
    "volumes" = "a Secret, ConfigMap or PVC volume reads namespace objects you did not write; use storageGiB for a persistent disk, and env for configuration"
}

RESTRICTED_KIND_REASONS: {str:str} = {
    "cron" = "cron is not available on hosted until metering covers it"
    "operator" = "an operator needs cluster-scoped Kubernetes API access, which shared hosted nodes cannot grant until each hosted user runs in an isolated cluster (vcluster)"
    "tool" = "a tool is never scheduled, so there is nothing for the hosted runtime to run"
}
