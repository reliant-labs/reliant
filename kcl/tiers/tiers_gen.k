        len(name) <= 15, "Port.name must be at most 15 characters"
        port >= 1, "Port.port must be at least 1"
        port <= 65535, "Port.port must be at most 65535"
        protocol in ["tcp", "udp"], "Port.protocol must be one of \"tcp\", \"udp\""

port_json = lambda v: Port -> {str:} {
