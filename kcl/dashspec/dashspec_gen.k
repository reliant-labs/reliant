"""
GENERATED by forge from pkg/dashspec — DO NOT EDIT.

Regenerate: FORGE_UPDATE_GENERATED=1 go test ./internal/codegen -run TestDashspecKCLIsCurrent

forge's dashboard vocabulary (forge.dashboards/v1) as KCL schemas. The Go
types in pkg/dashspec are the source of truth; field names are the JSON names
a dashboard file carries, so a declaration here serializes directly to one.

The schemas are CLOSED: a field that is not declared is refused at author
time. The checks are the per-field enums. Cross-field rules (a quantile needs
a histogram, which panel kinds take which fields, ids, bounds) are enforced by
dashspec.ParseDashboard, which every reader of a dashboard runs.

Each schema also has a <name>_json lambda that drops unset optional fields,
so the output is exactly the JSON a dashboard file carries:
dashboard_json(Dashboard {...}).
"""

# The serialized shape a dashboard is written in (dashspec.SpecVersion).
SPEC_VERSION = "forge.dashboards/v1"

# Agg is an aggregate function.
AGG_VALUES: [str] = ["count", "count_distinct", "sum", "avg", "max", "quantile", "last", "rate", "increase", "min"]

# AnnotationSource names where a dashboard's time-series markers come from.
ANNOTATION_SOURCE_VALUES: [str] = ["releases"]

# BrowseOp is a BrowseFilter operator. The set is the data browser's (dbbrowse.Op), duplicated here because the spec must not depend on the browser's database code: keep the two equal, and pin them with a test wherever both are imported.
BROWSE_OP_VALUES: [str] = ["eq", "neq", "lt", "lte", "gt", "gte", "like", "ilike", "is_null", "not_null", "in"]

# ChartColor is a named colour of the renderer's data-visualisation palette. A spec names a palette key, never a raw colour, so the renderer keeps control of contrast: the Reliant console maps each key to a chart token that is legible on its cards in every colour scheme, light and dark.
CHART_COLOR_VALUES: [str] = ["blue", "violet", "cyan", "amber", "fuchsia", "slate", "danger"]

# CompareMode is the comparison a dashboard opens with (Dashboard.DefaultCompare).
COMPARE_MODE_VALUES: [str] = ["period", "release"]

# Direction is which way a figure is better (Display.Good).
DIRECTION_VALUES: [str] = ["up", "down"]

# DisplayStyle is one way to draw a panel's data, where its kind has more than one. The query a panel runs is decided by its kind alone; a style only changes the picture, so a reader that does not know a style draws the kind's default instead and is still right about the numbers.
DISPLAY_STYLE_VALUES: [str] = ["line", "area", "bars", "bar", "pie", "donut", "stat", "gauge", "funnel", "heatmap", "barlist", "kpi"]

# FilterKind is the kind of a dashboard Filter.
FILTER_KIND_VALUES: [str] = ["toggle"]

# FunnelBy is what a funnel counts: how events are tied into one journey.
FUNNEL_BY_VALUES: [str] = ["session", "user"]

# FunnelLayout is how a funnel's steps are laid out (Display.Layout).
FUNNEL_LAYOUT_VALUES: [str] = ["steps"]

# Group is the list section a dashboard belongs to. It is presentation data only: it never affects identity, scope or a query.
GROUP_VALUES: [str] = ["overview", "services", "jobs", "product", "ai", "platform", "releases", "custom"]

# MetricType: the MetricType* constants.
METRIC_TYPE_VALUES: [str] = ["sum", "gauge", "histogram", "exp_histogram", "summary"]

# Op is a predicate operator.
OP_VALUES: [str] = ["eq", "neq", "in", "not_in", "prefix", "match", "exists", "gte"]

# PanelKind is how a panel is drawn.
PANEL_KIND_VALUES: [str] = ["number", "line", "table", "search", "bar", "heatmap", "sql", "issues", "sessions", "funnel", "postgres", "text", "browse", "attention", "release_health", "promotions", "delivery"]

# PostgresDraw: the PostgresDraw* constants.
POSTGRES_DRAW_VALUES: [str] = ["auto", "line", "number", "table", "bar"]

# Scope says which telemetry a dashboard's panels read. It is one enum: the default and the two wider reads.
SCOPE_VALUES: [str] = ["project", "org", "platform"]

# Signal is the telemetry table a panel reads.
SIGNAL_VALUES: [str] = ["traces", "metrics", "logs"]

# Unit is how a panel's values are formatted.
UNIT_VALUES: [str] = ["", "count", "ms", "bytes", "percent", "s"]

schema Dashboard:
    """Dashboard is an ordered list of panels under a shared set of filters."""
    # Scope is empty for ScopeProject.
    scope?: str
    sections?: [Section]
    id: str
    title: str
    description?: str
    # Group is the list section (see Group); Tags are free-form labels
    # (lowercase letters, digits, '.', '_' and '-', at most MaxTags).
    group?: str
    tags?: [str]
    # Replaces lists the ids of dashboards this one supersedes (a renamed
    # generated dashboard, or several consolidated into one). A reader that
    # keeps per-dashboard state (stars, copies) moves it from a replaced id
    # to this one. It never changes what the dashboard draws.
    replaces?: [str]
    filters?: [Filter]
    # FilterParams are the values a viewer narrows the dashboard's sql
    # panels by from the data (see FilterParam). At most MaxFilterParams.
    filterParams?: [FilterParam]
    annotations?: [Annotation]
    # DefaultRange is the time range the dashboard opens on when the viewer
    # picked none: a number and a unit of s, m, h or d ("24h", "7d"), at most
    # MaxDefaultRange. A dashboard whose panels bucket by day declares "7d";
    # without it a renderer opens on its own default (an hour, in the console).
    # A renderer with fixed presets rounds up to the nearest one.
    defaultRange?: str
    # DefaultCompare is the comparison the dashboard opens with when the
    # viewer picked none (see CompareMode); empty opens with none. A viewer
    # can still turn it off. A dashboard of headline figures declares
    # ComparePeriod, so each figure opens beside its change.
    defaultCompare?: str
    panels: [Panel]

    check:
        not scope or scope in SCOPE_VALUES, "Dashboard.scope must be one of: \"project\", \"org\", \"platform\""
        not group or group in GROUP_VALUES, "Dashboard.group must be one of: \"overview\", \"services\", \"jobs\", \"product\", \"ai\", \"platform\", \"releases\", \"custom\""
        not defaultCompare or defaultCompare in COMPARE_MODE_VALUES, "Dashboard.defaultCompare must be one of: \"period\", \"release\""

dashboard_json = lambda v: Dashboard -> {str:} {
    _d = {
        "scope": v.scope
        "sections": [section_json(_i) for _i in v.sections] if v.sections else Undefined
        "id": v.id
        "title": v.title
        "description": v.description
        "group": v.group
        "tags": v.tags
        "replaces": v.replaces
        "filters": [filter_json(_i) for _i in v.filters] if v.filters else Undefined
        "filterParams": [filter_param_json(_i) for _i in v.filterParams] if v.filterParams else Undefined
        "annotations": [annotation_json(_i) for _i in v.annotations] if v.annotations else Undefined
        "defaultRange": v.defaultRange
        "defaultCompare": v.defaultCompare
        "panels": [panel_json(_i) for _i in v.panels] if v.panels else Undefined
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Annotation:
    """Annotation is a marker series drawn over every KindLine panel of a dashboard. HyperDX has no such concept, so RenderHyperDX ignores it."""
    source: str
    label?: str

    check:
        source in ANNOTATION_SOURCE_VALUES, "Annotation.source must be one of: \"releases\""

annotation_json = lambda v: Annotation -> {str:} {
    _d = {
        "source": v.source
        "label": v.label
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Attention:
    """Attention is what a KindAttention panel watches: figures that declare Display.Good. The reader lists each one whose relative change against the comparison is at least Threshold, those that moved the wrong way first, with the figures themselves. It is a declared comparison, not a statistical test."""
    # Watch are ids of panels on the same dashboard, each a figure with
    # Display.Good. Empty is every such panel of the dashboard.
    watch?: [str]
    # Figures are figures only this panel reads: sql panels, each with
    # Display.Good, drawn nowhere else. At most MaxAttentionFigures.
    figures?: [Panel]
    # Threshold is the relative change that counts, a fraction in (0, 1].
    # Zero is DefaultAttentionThreshold.
    threshold?: float

attention_json = lambda v: Attention -> {str:} {
    _d = {
        "watch": v.watch
        "figures": [panel_json(_i) for _i in v.figures] if v.figures else Undefined
        "threshold": v.threshold
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema BrowseFilter:
    """BrowseFilter is one condition of a BrowseView."""
    column: str
    op: str
    values?: [str]

    check:
        op in BROWSE_OP_VALUES, "BrowseFilter.op must be one of: \"eq\", \"neq\", \"lt\", \"lte\", \"gt\", \"gte\", \"like\", \"ilike\", \"is_null\", \"not_null\", \"in\""

browse_filter_json = lambda v: BrowseFilter -> {str:} {
    _d = {
        "column": v.column
        "op": v.op
        "values": v.values
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema BrowseSort:
    """BrowseSort is one sort key of a BrowseView."""
    column: str
    desc?: bool

browse_sort_json = lambda v: BrowseSort -> {str:} {
    _d = {
        "column": v.column
        "desc": v.desc
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema BrowseView:
    """KindBrowse's request: one table of one database, as the data browser reads it. The console runs it through the data browser's own read (the same admission and audit); nothing in it is SQL, so it stays inside the columns the read-only role may read, and opening it in the data browser ("Open in Data") is the same request."""
    # Database is a database name, as PostgresQuery.Database.
    database: str
    # Table is schema-qualified: "public.users".
    table: str
    # Columns are the columns shown, in order; empty shows every column the
    # role may read.
    columns?: [str]
    # Filters are ANDed.
    filters?: [BrowseFilter]
    # Sort keys, most significant first. The data browser adds the primary
    # key after them, so a page boundary is stable.
    sort?: [BrowseSort]
    # Size is the page size: one of BrowseSizes, zero for DefaultBrowseSize.
    size?: int

browse_view_json = lambda v: BrowseView -> {str:} {
    _d = {
        "database": v.database
        "table": v.table
        "columns": v.columns
        "filters": [browse_filter_json(_i) for _i in v.filters] if v.filters else Undefined
        "sort": [browse_sort_json(_i) for _i in v.sort] if v.sort else Undefined
        "size": v.size
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Display:
    """Display says how a panel's data is drawn when its kind can draw it more than one way. Every field is optional and changes the picture only, never the query. Renderers that cannot honour a field ignore it (HyperDX ignores all of them)."""
    # Style is one of DisplayStyles(kind). Empty is the kind's default.
    style?: str
    # Stack stacks the series, so the top edge is their total and each band
    # or bar segment is one series' share: a line or sql panel drawn as area
    # or bars, or a bar panel drawn as bars. Only additive values (counts,
    # sums, rates) add up to a meaningful whole; the author decides.
    stack?: bool
    # Horizontal lays a bar panel's bars along the y axis, which suits long
    # group names.
    horizontal?: bool
    # Min and Max are a gauge's scale. Min defaults to 0; Max is required
    # unless the panel's unit is percent, whose scale is 0 to 1.
    min?: float
    max?: float
    # TopN is how many series a line panel (or slices a pie or donut) draws
    # before folding the rest into one "Other": summed where the values add
    # up, left out where they do not. The full list stays a click away. Zero
    # is the reader's own default; at most MaxTopN.
    topN?: int
    # Color is the colour of what the panel draws in one: a heatmap's scale,
    # a number panel's sparklines, and the series of a chart that draws one.
    # Empty is the palette's first.
    color?: str
    # Colors gives series their colour by name: a series' Label, a sql
    # panel's value column, or a group value (a bar group, a pie slice, a
    # line per group). A series it does not name takes the next palette
    # colour no named series has, in the renderer's usual order, so naming
    # two series never repaints the rest. At most MaxColors.
    colors?: {str:str}
    # Exact draws a figure's values in full, never abbreviated: 1,284, not
    # 1.3k. For a count a reader compares with another page that states it
    # exactly (accounts, users). A number panel or a sql panel drawn as
    # figures; a renderer that never abbreviates ignores it.
    exact?: bool
    # Good is which way the figure is better. A reader draws a change in the
    # good direction as an improvement and one in the other as a worsening
    # (the Reliant console colours them green and red), and a KindAttention
    # panel watches the figure. Empty is neutral: a change is only a change.
    # A number panel, or a sql panel drawn as figures.
    good?: str
    # Bar is the value column a StyleBarList panel draws as its bar: a sql
    # panel's column or a bar panel's series label. Empty is the first
    # numeric column.
    bar?: str
    # Share follows each bar of a StyleBarList panel with its share of the
    # rows' total.
    share?: bool
    # Units gives the value columns of a StyleBarList or StyleKPI panel each
    # their own unit, by column name, where they differ ("Visitors" a count,
    # "Conversion %" a percent); a column it does not name takes the panel's
    # Unit. At most MaxColors. A pointer, as Colors is, so Display stays
    # comparable.
    units?: {str:str}
    # Layout lays out a funnel's steps: a funnel panel's, or a sql panel's
    # drawn as StyleFunnel (see FunnelLayout). Empty is bars.
    layout?: str

    check:
        not style or style in DISPLAY_STYLE_VALUES, "Display.style must be one of: \"line\", \"area\", \"bars\", \"bar\", \"pie\", \"donut\", \"stat\", \"gauge\", \"funnel\", \"heatmap\", \"barlist\", \"kpi\""
        not color or color in CHART_COLOR_VALUES, "Display.color must be one of: \"blue\", \"violet\", \"cyan\", \"amber\", \"fuchsia\", \"slate\", \"danger\""
        not colors or all _k, _x in colors { _x in CHART_COLOR_VALUES }, "Display.colors values must each be one of: \"blue\", \"violet\", \"cyan\", \"amber\", \"fuchsia\", \"slate\", \"danger\""
        not good or good in DIRECTION_VALUES, "Display.good must be one of: \"up\", \"down\""
        not units or all _k, _x in units { _x in UNIT_VALUES }, "Display.units values must each be one of: \"\", \"count\", \"ms\", \"bytes\", \"percent\", \"s\""
        not layout or layout in FUNNEL_LAYOUT_VALUES, "Display.layout must be one of: \"steps\""

display_json = lambda v: Display -> {str:} {
    _d = {
        "style": v.style
        "stack": v.stack
        "horizontal": v.horizontal
        "min": v.min
        "max": v.max
        "topN": v.topN
        "color": v.color
        "colors": v.colors
        "exact": v.exact
        "good": v.good
        "bar": v.bar
        "share": v.share
        "units": v.units
        "layout": v.layout
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Filter:
    """Filter is a dashboard-level control. The default kind is a dropdown over a field that narrows every panel; FilterToggle is an on/off switch a sql panel reads as a Bool parameter."""
    # PanelIDs restricts this filter to declared panels. Empty preserves the
    # dashboard-wide default. RPC filters must not blank runtime/billing panels.
    panelIds?: [str]
    # Kind is "" (a field dropdown) or FilterToggle.
    kind?: str
    id: str
    label: str
    # Field is the dropdown's field. A toggle has none.
    field?: str
    # Signal is the telemetry the dropdown reads its values from. Empty is
    # Traces, which every dashboard but the metrics ones draws. A toggle has
    # none.
    signal?: str
    # Default is a toggle's state when the viewer has not touched it. Only a
    # toggle takes it.
    default?: bool

    check:
        not kind or kind in FILTER_KIND_VALUES, "Filter.kind must be one of: \"toggle\""
        not signal or signal in SIGNAL_VALUES, "Filter.signal must be one of: \"traces\", \"metrics\", \"logs\""

filter_json = lambda v: Filter -> {str:} {
    _d = {
        "panelIds": v.panelIds
        "kind": v.kind
        "id": v.id
        "label": v.label
        "field": v.field
        "signal": v.signal
        "default": v.default
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema FilterParam:
    """FilterParam is a value a viewer narrows a dashboard's sql panels by, most often by clicking a row of a breakdown (a panel's Select): the page, the channel, the country. A sql panel reads it as the ClickHouse parameter named by its id, typed String, and the reader binds it to the empty string when the viewer has set none, so a statement honours it as"""
    id: str
    # Label names the filter on its chip ("Page", "Country").
    label: str
    # Description is one sentence on what the filter keeps.
    description?: str

filter_param_json = lambda v: FilterParam -> {str:} {
    _d = {
        "id": v.id
        "label": v.label
        "description": v.description
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Funnel:
    """Funnel is the definition a KindFunnel panel draws: the ordered event names a journey passes through, within Window, counted per session or per user."""
    # Steps are product event names (the names passed to track()), in order.
    steps: [str]
    # Window is how long a journey may take from its first step to its last:
    # a number and a unit of s, m, h or d ("1h", "7d"). Empty is "1h".
    window?: str
    # By is the journey's identity. Empty is FunnelBySession.
    by?: str

    check:
        not by or by in FUNNEL_BY_VALUES, "Funnel.by must be one of: \"session\", \"user\""

funnel_json = lambda v: Funnel -> {str:} {
    _d = {
        "steps": v.steps
        "window": v.window
        "by": v.by
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Panel:
    """Panel is one tile."""
    # Section is an optional declared dashboard section, for temporary viewer
    # toggles. Empty retains the unsectioned layout.
    section?: str
    id: str
    title: str
    description?: str
    kind: str
    # Signal is required on every kind but KindSQL, whose statement names its
    # own tables.
    signal?: str
    series?: [Series]
    # Ratio makes a two-series line panel plot Series[0]/Series[1]
    # (an error rate is failed requests over all requests).
    ratio?: bool
    # Formula makes a line or number panel plot one arithmetic expression
    # over its series instead of the series themselves: "A / B * 100", where
    # A is Series[0], B is Series[1], and so on (see ParseFormula). It is the
    # general form of Ratio, which a panel uses instead of, not with, it.
    formula?: str
    # Limit keeps the top Limit rows of a table or bar panel, largest
    # Series[0] first. Zero is DefaultBarLimit for a bar and the reader's own
    # row cap for a table; at most MaxLimit. On a promotions panel it is the
    # newest Limit promotions (zero is DefaultPromotionsLimit).
    limit?: int
    # SQL is a KindSQL panel's statement: one read-only SELECT over the
    # telemetry tables, which may use the SQLParam* query parameters. Only
    # that kind takes it.
    sql?: str
    # TrendSQL is a sql panel's sparkline: a second read-only SELECT, under
    # the same guard and parameters as SQL, that returns a time series (the
    # first column a date or time, then one numeric column). A renderer draws
    # it under the figure SQL returns, when SQL returns one row of figures:
    # each day's active users across the range, under the figure for the
    # last day. It never changes the figure. Only a sql panel takes it, and not
    # one drawn as a funnel or a heatmap. Renderers that draw no sparkline
    # ignore it.
    trendSql?: str
    # SubtitleSQL is a sql panel's subtitle: a read-only SELECT, under the
    # same guard and parameters as SQL, whose first row's first column is a
    # short text a renderer draws under the panel's title, as part of its
    # label ("New users", "since 14 Nov"). It qualifies what the panel shows
    # for the window read, when that depends on the data: new users counted
    # only since the environment began reporting sign-ups. An empty string,
    # a NULL or no row draws no subtitle, so a panel whose qualification no
    # longer applies loses it by itself. It never changes the figures. Only a
    # sql panel takes it. Renderers that draw no subtitle ignore it.
    subtitleSql?: str
    # MinStep is the narrowest bucket a KindSQL panel's statement produces,
    # in the same form as DefaultRange ("1d"): set it when the statement
    # groups by a fixed bucket (toDate, toStartOfWeek) rather than by the
    # {step} parameter. A range shorter than two buckets can draw only one
    # point, so a renderer widens such a panel's range to hold two, and says
    # so. It is also the panel's bucket: a renderer that names a sql panel's
    # bucket ("7-day buckets") names MinStep when it is set, rather than
    # guessing from the result's first column (a Date column is a day, a
    # toMonday one a week, and both read back as a Date). Only a sql panel
    # takes it.
    minStep?: str
    # Where narrows every series of the panel.
    where?: [Predicate]
    groupBy?: [str]
    # Columns are the fields a KindSearch panel shows.
    columns?: [str]
    # Funnel is what a KindFunnel panel draws; only that kind takes it.
    funnel?: Funnel
    # Postgres is the query a KindPostgres panel draws; only that kind takes
    # it, and it takes no Signal, Series or SQL.
    postgres?: PostgresQuery
    # Browse is the view a KindBrowse panel draws; only that kind takes it,
    # and it takes no Signal, Series or query.
    browse?: BrowseView
    # Link makes each row of a table or bar panel, or of a postgres panel
    # drawn as one, open the data browser (see PanelLink). Only the console
    # follows it.
    link?: PanelLink
    # Select makes a click on a row of a sql panel set one of the
    # dashboard's filter params to that row's value (see RowSelect). Only
    # a sql panel takes it.
    select?: RowSelect
    # HasError narrows a KindSessions panel to sessions that hit an error;
    # only that kind takes it.
    hasError?: bool
    # Markdown is a KindText panel's content (CommonMark with GFM tables and
    # links, at most MaxMarkdownBytes); only that kind takes it.
    markdown?: str
    # Display picks how a line, bar, number or sql panel is drawn (see
    # Display); nil draws the kind's default.
    display?: Display
    unit?: str
    # Width is in grid columns out of 24; Height in rows. Zero takes the
    # default for the kind.
    width?: int
    height?: int
    # Drill is where the panel's detail lives: a link in its header to
    # another dashboard of the project (see PanelDrill). Any kind takes it;
    # only the console follows it.
    drill?: PanelDrill
    # Attention is what a KindAttention panel watches; only that kind takes
    # it.
    attention?: Attention

    check:
        kind in PANEL_KIND_VALUES, "Panel.kind must be one of: \"number\", \"line\", \"table\", \"search\", \"bar\", \"heatmap\", \"sql\", \"issues\", \"sessions\", \"funnel\", \"postgres\", \"text\", \"browse\", \"attention\", \"release_health\", \"promotions\", \"delivery\""
        not signal or signal in SIGNAL_VALUES, "Panel.signal must be one of: \"traces\", \"metrics\", \"logs\""
        not unit or unit in UNIT_VALUES, "Panel.unit must be one of: \"\", \"count\", \"ms\", \"bytes\", \"percent\", \"s\""

panel_json = lambda v: Panel -> {str:} {
    _d = {
        "section": v.section
        "id": v.id
        "title": v.title
        "description": v.description
        "kind": v.kind
        "signal": v.signal
        "series": [series_json(_i) for _i in v.series] if v.series else Undefined
        "ratio": v.ratio
        "formula": v.formula
        "limit": v.limit
        "sql": v.sql
        "trendSql": v.trendSql
        "subtitleSql": v.subtitleSql
        "minStep": v.minStep
        "where": [predicate_json(_i) for _i in v.where] if v.where else Undefined
        "groupBy": v.groupBy
        "columns": v.columns
        "funnel": funnel_json(v.funnel) if v.funnel else Undefined
        "postgres": postgres_query_json(v.postgres) if v.postgres else Undefined
        "browse": browse_view_json(v.browse) if v.browse else Undefined
        "link": panel_link_json(v.link) if v.link else Undefined
        "select": row_select_json(v.select) if v.select else Undefined
        "hasError": v.hasError
        "markdown": v.markdown
        "display": display_json(v.display) if v.display else Undefined
        "unit": v.unit
        "width": v.width
        "height": v.height
        "drill": panel_drill_json(v.drill) if v.drill else Undefined
        "attention": attention_json(v.attention) if v.attention else Undefined
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema PanelDrill:
    """PanelDrill links a panel to the dashboard that has its detail ("Users →"). The reader keeps the range, the comparison and the environments when it follows it. It differs from Link, which opens the data browser per row."""
    # Dashboard is the id of a dashboard of the same project.
    dashboard: str
    # Label is the link's text; empty is that dashboard's title.
    label?: str
    # Panel is the id of a panel on that dashboard to scroll to.
    panel?: str

panel_drill_json = lambda v: PanelDrill -> {str:} {
    _d = {
        "dashboard": v.dashboard
        "label": v.label
        "panel": v.panel
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema PanelLink:
    """PanelLink makes each row of a panel open the data browser: a table or bar panel's row, or a postgres panel's drawn as a table or bar (draw table, bar or auto). Only the Reliant console follows it; HyperDX ignores it."""
    # Database is a database name, as PostgresQuery.Database.
    database: str
    # Table is schema-qualified: "public.users".
    table: str
    # Column is the column of Table to filter on, FromField the field of the
    # panel's row holding the value.
    column?: str
    fromField?: str
    # Row opens one row of Table; FromFields name its primary key's values
    # in key order.
    row?: bool
    fromFields?: [str]

panel_link_json = lambda v: PanelLink -> {str:} {
    _d = {
        "database": v.database
        "table": v.table
        "column": v.column
        "fromField": v.fromField
        "row": v.row
        "fromFields": v.fromFields
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema PostgresQuery:
    """PostgresQuery is what a KindPostgres panel draws: one read-only statement run live against a named database, and how its result set becomes a chart. The statement runs under dbquery.Run (read only, read committed, short statement and lock timeouts), so a dashboard never blocks other queries."""
    # Database names the database to run against: the same name as `forge db
    # query` takes (a DNS-label-like identifier of at most 63 bytes).
    database: str
    # SQL is one SELECT, WITH, TABLE or VALUES statement that may use the
    # PostgresParam* parameters. Nothing a viewer picks is spliced into it.
    sql: str
    # Draw is how the result is drawn: PostgresDrawAuto (or empty), line,
    # number, table or bar. Auto draws a line when Time names a column, a
    # number for one row and one value, a table otherwise.
    draw?: str
    # Time names the result column holding each row's timestamp. A line
    # requires it.
    time?: str
    # Values names the numeric result columns to plot. Empty means every
    # column that is not Time or in Group. A number takes at most one.
    values?: [str]
    # Group names the result columns that split rows into separate series.
    group?: [str]

    check:
        not draw or draw in POSTGRES_DRAW_VALUES, "PostgresQuery.draw must be one of: \"auto\", \"line\", \"number\", \"table\", \"bar\""

postgres_query_json = lambda v: PostgresQuery -> {str:} {
    _d = {
        "database": v.database
        "sql": v.sql
        "draw": v.draw
        "time": v.time
        "values": v.values
        "group": v.group
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Predicate:
    """Predicate is one condition. Values are literals; Field is a semantic field."""
    field: str
    op: str
    value?: str
    values?: [str]

    check:
        op in OP_VALUES, "Predicate.op must be one of: \"eq\", \"neq\", \"in\", \"not_in\", \"prefix\", \"match\", \"exists\", \"gte\""

predicate_json = lambda v: Predicate -> {str:} {
    _d = {
        "field": v.field
        "op": v.op
        "value": v.value
        "values": v.values
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema RowSelect:
    """RowSelect makes a click on a row of a sql panel drawn as rows set one of the dashboard's filter params to the row's value in Column: the Pages breakdown's rows set f_route to their page. Only the Reliant console follows it; any other reader draws the rows as they are."""
    # Param is the id of one of the dashboard's FilterParams.
    param: str
    # Column is the result column whose value the click sets it to.
    column: str

row_select_json = lambda v: RowSelect -> {str:} {
    _d = {
        "param": v.param
        "column": v.column
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Section:
    """Section is a named, ordered group of panels. It changes presentation only; filtering remains explicit through Filter.PanelIDs."""
    id: str
    title: str
    # Description is a line under the heading: what the section answers.
    description?: str

section_json = lambda v: Section -> {str:} {
    _d = {
        "id": v.id
        "title": v.title
        "description": v.description
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Series:
    """Series is one aggregate shown by a panel."""
    label: str
    agg: str
    # Quantile is the level for AggQuantile, e.g. 0.95.
    quantile?: float
    # Field is the aggregated value: a semantic field for traces and logs
    # (span.duration, span.attr.lcp), the metric NAME for metrics. Empty for
    # AggCount.
    field?: str
    # MetricType is "sum", "gauge", "histogram", "exp_histogram" or "summary"
    # (metrics only): one of the MetricType* constants.
    metricType?: str
    # Where narrows this series alone (e.g. only the failed requests).
    where?: [Predicate]
    # Thresholds grade the series' values good / needs improvement / poor.
    thresholds?: Thresholds

    check:
        agg in AGG_VALUES, "Series.agg must be one of: \"count\", \"count_distinct\", \"sum\", \"avg\", \"max\", \"quantile\", \"last\", \"rate\", \"increase\", \"min\""
        not metricType or metricType in METRIC_TYPE_VALUES, "Series.metricType must be one of: \"sum\", \"gauge\", \"histogram\", \"exp_histogram\", \"summary\""

series_json = lambda v: Series -> {str:} {
    _d = {
        "label": v.label
        "agg": v.agg
        "quantile": v.quantile
        "field": v.field
        "metricType": v.metricType
        "where": [predicate_json(_i) for _i in v.where] if v.where else Undefined
        "thresholds": thresholds_json(v.thresholds) if v.thresholds else Undefined
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}

schema Thresholds:
    """Thresholds colour a series' values the way Core Web Vitals do: at or below Good is good, above Poor is poor, between is "needs improvement". Renderers that cannot colour ignore it."""
    good: float
    poor: float

thresholds_json = lambda v: Thresholds -> {str:} {
    _d = {
        "good": v.good
        "poor": v.poor
    }
    {k: _v for k, _v in _d if _v != Undefined and _v != None}
}
