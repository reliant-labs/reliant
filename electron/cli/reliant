#!/bin/bash

# Reliant CLI - Opens Reliant app with specified directory
# Usage: reliant [path]

# Get the directory to open (default to current directory)
TARGET_DIR="${1:-.}"

# Convert to absolute path
if [[ "$TARGET_DIR" == "." ]]; then
    TARGET_DIR="$(pwd)"
elif [[ ! "$TARGET_DIR" =~ ^/ ]]; then
    # Relative path, convert to absolute
    TARGET_DIR="$(cd "$(dirname "$TARGET_DIR")" && pwd)/$(basename "$TARGET_DIR")"
fi

# Check if directory exists
if [[ ! -d "$TARGET_DIR" ]]; then
    echo "Error: Directory '$TARGET_DIR' does not exist"
    exit 1
fi

# URL encode the path for the protocol handler
URL_ENCODED_PATH=$(printf '%s' "$TARGET_DIR" | python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.stdin.read(), safe=''))")

# Construct the deep link URL
DEEP_LINK="reliant://open?path=${URL_ENCODED_PATH}"

# Open the app with the deep link
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS
    open "$DEEP_LINK"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux
    xdg-open "$DEEP_LINK"
elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
    # Windows
    start "$DEEP_LINK"
else
    echo "Error: Unsupported operating system"
    exit 1
fi