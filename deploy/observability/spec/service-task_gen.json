          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.TaskService/AddTaskDependency"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-AddTaskDependency-errors",
        "title": "AddTaskDependency: error rate",
