{
  "version": "forge.dashboard-parts/v1",
  "service": "run",
  "dashboard": {
    "id": "service-run",
    "title": "reliant: run service",
    "description": "RED per rpc of reliant.v1.RunService (server spans named reliant.v1.RunService/\u003cMethod\u003e), Go runtime and logs. The Go runtime panels describe the PROCESS that serves this service: narrow with the service.name filter.",
    "filters": [
      {
        "id": "service",
        "label": "service.name",
        "field": "service.name"
      },
      {
        "id": "env",
        "label": "deployment.environment.name",
        "field": "deployment.environment.name"
      }
    ],
    "annotations": [
      {
        "source": "releases",
        "label": "Releases"
      }
    ],
    "panels": [
      {
        "id": "requests",
        "title": "Requests",
        "kind": "number",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.RunService/"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 4
      },
      {
        "id": "errors",
        "title": "Server errors",
        "kind": "number",
        "signal": "traces",
        "series": [
          {
            "label": "errors",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.RunService/"
          },
          {
            "field": "span.status",
            "op": "eq",
            "value": "error"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 4
      },
      {
        "id": "p95",
        "title": "p95 latency",
        "kind": "number",
        "signal": "traces",
        "series": [
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.RunService/"
          }
        ],
        "unit": "ms",
        "width": 8,
        "height": 4
      },
      {
        "id": "red-by-rpc",
        "title": "Rate, errors and latency by rpc",
        "kind": "table",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          },
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.RunService/"
          }
        ],
        "groupBy": [
          "span.name"
        ],
        "width": 24,
        "height": 8
      },
      {
        "id": "rpc-CancelRun-rate",
        "title": "CancelRun: requests",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.RunService/CancelRun"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-CancelRun-errors",
        "title": "CancelRun: error rate",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "errors",
            "agg": "count",
            "where": [
