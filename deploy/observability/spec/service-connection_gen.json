          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.ConnectionService/CompleteOAuth"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-CompleteOAuth-errors",
        "title": "CompleteOAuth: error rate",
        "kind": "line",
