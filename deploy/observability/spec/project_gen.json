        {
          "id": "browser-console",
          "title": "Browser console and error events",
          "description": "The HyperDX SDK ships console output and uncaught errors as spans (console.*, onerror, unhandledrejection), not as OTLP logs.",
          "kind": "search",
          "signal": "traces",
          "where": [
            {
              "field": "service.name",
