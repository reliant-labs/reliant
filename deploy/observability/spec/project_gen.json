              "field": "resource.attr.rum.sessionId"
            }
          ],
          "where": [
            {
              "field": "service.name",
              "op": "in",
              "values": [
                "reliant-web"
              ]
            },
            {
              "field": "resource.attr.rum.sessionId",
              "op": "exists"
            }
