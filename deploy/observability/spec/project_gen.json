      "panels": [
        {
          "id": "js-errors",
          "title": "JS errors",
          "kind": "number",
          "signal": "traces",
          "series": [
            {
              "label": "errors",
              "agg": "count"
            }
          ],
          "where": [
            {
              "field": "service.name",
              "op": "in",
              "values": [
                "reliant-web"
              ]
            },
            {
              "field": "resource.attr.rum.sessionId",
              "op": "exists"
            },
            {
              "field": "span.status",
              "op": "eq",
              "value": "error"
            },
            {
              "field": "span.attr.component",
              "op": "not_in",
              "values": [
                "fetch",
                "xml-http-request"
              ]
            }
          ],
          "unit": "count",
          "width": 6,
          "height": 4
        },
        {
          "id": "sessions",
          "title": "Sessions",
