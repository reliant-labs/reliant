        {
          "id": "vitals-by-route",
          "title": "Web vitals by route",
          "description": "p75 per page. LCP good at 2500 ms or less and poor above 4000 ms; INP 200 / 500 ms; CLS 0.1 / 0.25.",
          "kind": "table",
          "signal": "traces",
          "series": [
            {
              "label": "lcp p75",
              "agg": "quantile",
              "quantile": 0.75,
              "field": "span.attr.lcp",
              "where": [
                {
                  "field": "span.attr.lcp",
                  "op": "exists"
                }
              ],
              "thresholds": {
                "good": 2500,
                "poor": 4000
              }
            },
            {
              "label": "inp p75",
              "agg": "quantile",
              "quantile": 0.75,
              "field": "span.attr.inp",
              "where": [
                {
                  "field": "span.attr.inp",
                  "op": "exists"
                }
              ],
              "thresholds": {
                "good": 200,
                "poor": 500
              }
            },
            {
              "label": "cls p75",
              "agg": "quantile",
              "quantile": 0.75,
              "field": "span.attr.cls",
              "where": [
                {
                  "field": "span.attr.cls",
                  "op": "exists"
                }
              ],
              "thresholds": {
                "good": 0.1,
                "poor": 0.25
              }
            },
            {
              "label": "samples",
              "agg": "count",
