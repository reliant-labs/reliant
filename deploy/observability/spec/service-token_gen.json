      {
        "id": "db-latency",
        "title": "Database call latency",
        "description": "Client spans carrying db.system (the ORM's query hook).",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "client"
          },
          {
            "field": "span.attr.db.system",
            "op": "exists"
          }
        ],
        "unit": "ms",
        "width": 12,
        "height": 7
      },
      {
        "id": "db-by-operation",
        "title": "Database calls by operation",
        "kind": "table",
        "signal": "traces",
        "series": [
          {
            "label": "calls",
            "agg": "count"
          },
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "client"
          },
          {
            "field": "span.attr.db.system",
            "op": "exists"
          }
        ],
        "groupBy": [
          "span.attr.db.operation"
        ],
        "width": 12,
        "height": 7
      },
      {
