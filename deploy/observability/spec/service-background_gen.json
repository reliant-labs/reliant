      {
        "id": "db-latency",
        "title": "Database call latency",
        "description": "Client spans carrying db.system (the ORM's query hook).",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "client"
          },
          {
            "field": "span.attr.db.system",
            "op": "exists"
          }
        ],
        "unit": "ms",
        "width": 12,
        "height": 7
      },
      {
        "id": "db-by-operation",
        "title": "Database calls by operation",
        "kind": "table",
        "signal": "traces",
        "series": [
          {
            "label": "calls",
            "agg": "count"
          },
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "client"
          },
          {
            "field": "span.attr.db.system",
            "op": "exists"
          }
        ],
        "groupBy": [
          "span.attr.db.operation"
        ],
        "width": 12,
        "height": 7
      },
      {
        "id": "go-memory",
        "title": "Go memory used",
        "kind": "line",
        "signal": "metrics",
        "series": [
          {
            "label": "used",
            "agg": "sum",
            "field": "go.memory.used",
            "metricType": "sum"
          },
          {
            "label": "gc goal",
            "agg": "avg",
            "field": "go.memory.gc.goal",
            "metricType": "sum"
          }
        ],
        "unit": "bytes",
        "width": 12,
        "height": 7
      },
      {
        "id": "go-goroutines",
        "title": "Goroutines",
        "kind": "line",
        "signal": "metrics",
        "series": [
          {
            "label": "goroutines",
            "agg": "sum",
            "field": "go.goroutine.count",
            "metricType": "sum"
          }
        ],
        "unit": "count",
        "width": 12,
        "height": 7
      },
      {
        "id": "go-alloc",
        "title": "Heap allocation",
        "description": "Bytes allocated to the heap per time bucket: the rate the garbage collector has to keep up with.",
        "kind": "line",
        "signal": "metrics",
        "series": [
          {
            "label": "allocated",
            "agg": "sum",
            "field": "go.memory.allocated",
            "metricType": "sum"
          }
        ],
        "unit": "bytes",
        "width": 24,
        "height": 7
      },
      {
        "id": "error-logs",
        "title": "Error logs",
        "kind": "search",
        "signal": "logs",
        "where": [
          {
            "field": "log.attr.procedure",
            "op": "prefix",
            "value": "/reliant.v1.BackgroundService/"
          },
          {
            "field": "log.severity",
            "op": "eq",
            "value": "error"
          }
        ],
        "columns": [
          "timestamp",
          "service.name",
          "log.severity",
          "log.body"
        ],
        "width": 24,
        "height": 9
      },
      {
        "id": "logs",
        "title": "Logs",
        "description": "Every record whose rpc procedure belongs to this service.",
        "kind": "search",
        "signal": "logs",
        "where": [
          {
            "field": "log.attr.procedure",
            "op": "prefix",
            "value": "/reliant.v1.BackgroundService/"
          }
        ],
        "columns": [
