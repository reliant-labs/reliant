          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.BackgroundService/GetProcessOutput"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-GetProcessOutput-errors",
        "title": "GetProcessOutput: error rate",
