          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.BackgroundService/GetProcessOutput"
          }
        ],
        "unit": "percent",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-GetProcessOutput-latency",
        "title": "GetProcessOutput: latency",
        "kind": "line",
        "signal": "traces",
        "series": [
