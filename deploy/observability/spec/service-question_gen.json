{
  "version": "forge.dashboard-parts/v1",
  "service": "question",
  "dashboard": {
    "id": "service-question",
    "title": "reliant: question service",
    "description": "RED per rpc of reliant.v1.QuestionService (server spans named reliant.v1.QuestionService/\u003cMethod\u003e), Go runtime and logs. The Go runtime panels describe the PROCESS that serves this service: narrow with the service.name filter.",
    "filters": [
      {
        "id": "service",
        "label": "service.name",
        "field": "service.name"
      },
      {
        "id": "env",
        "label": "deployment.environment.name",
        "field": "deployment.environment.name"
      }
    ],
    "annotations": [
      {
        "source": "releases",
        "label": "Releases"
      }
    ],
    "panels": [
      {
        "id": "requests",
        "title": "Requests",
        "kind": "number",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.QuestionService/"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 4
      },
      {
        "id": "errors",
        "title": "Server errors",
        "kind": "number",
        "signal": "traces",
        "series": [
          {
            "label": "errors",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.QuestionService/"
          },
          {
            "field": "span.status",
            "op": "eq",
            "value": "error"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 4
      },
      {
        "id": "p95",
        "title": "p95 latency",
        "kind": "number",
        "signal": "traces",
        "series": [
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.QuestionService/"
          }
        ],
        "unit": "ms",
        "width": 8,
        "height": 4
      },
      {
        "id": "red-by-rpc",
        "title": "Rate, errors and latency by rpc",
        "kind": "table",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          },
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "prefix",
            "value": "reliant.v1.QuestionService/"
          }
        ],
        "groupBy": [
          "span.name"
        ],
        "width": 24,
        "height": 8
      },
      {
        "id": "rpc-ListAsyncQuestions-rate",
        "title": "ListAsyncQuestions: requests",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ListAsyncQuestions"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ListAsyncQuestions-errors",
        "title": "ListAsyncQuestions: error rate",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "ratio": true,
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ListAsyncQuestions"
          }
        ],
        "unit": "percent",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ListAsyncQuestions-latency",
        "title": "ListAsyncQuestions: latency",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ListAsyncQuestions"
          }
        ],
        "unit": "ms",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ListPendingQuestions-rate",
        "title": "ListPendingQuestions: requests",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ListPendingQuestions"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ListPendingQuestions-errors",
        "title": "ListPendingQuestions: error rate",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "ratio": true,
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ListPendingQuestions"
          }
        ],
        "unit": "percent",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ListPendingQuestions-latency",
        "title": "ListPendingQuestions: latency",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ListPendingQuestions"
          }
        ],
        "unit": "ms",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ResolveQuestion-rate",
        "title": "ResolveQuestion: requests",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ResolveQuestion"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ResolveQuestion-errors",
        "title": "ResolveQuestion: error rate",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "requests",
            "agg": "count"
          }
        ],
        "ratio": true,
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ResolveQuestion"
          }
        ],
        "unit": "percent",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-ResolveQuestion-latency",
        "title": "ResolveQuestion: latency",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "server"
          },
          {
            "field": "span.name",
            "op": "match",
            "value": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"
          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.QuestionService/ResolveQuestion"
          }
        ],
        "unit": "ms",
        "width": 8,
        "height": 6
      },
      {
        "id": "db-latency",
        "title": "Database call latency",
        "description": "Client spans carrying db.system (the ORM's query hook).",
        "kind": "line",
        "signal": "traces",
        "series": [
          {
            "label": "p50",
            "agg": "quantile",
            "quantile": 0.5,
            "field": "span.duration"
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          },
          {
            "label": "p99",
            "agg": "quantile",
            "quantile": 0.99,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "client"
          },
          {
            "field": "span.attr.db.system",
            "op": "exists"
          }
        ],
        "unit": "ms",
        "width": 12,
        "height": 7
      },
      {
        "id": "db-by-operation",
        "title": "Database calls by operation",
        "kind": "table",
        "signal": "traces",
        "series": [
          {
            "label": "calls",
            "agg": "count"
          },
          {
            "label": "errors",
            "agg": "count",
            "where": [
              {
                "field": "span.status",
                "op": "eq",
                "value": "error"
              }
            ]
          },
          {
            "label": "p95",
            "agg": "quantile",
            "quantile": 0.95,
            "field": "span.duration"
          }
        ],
        "where": [
          {
            "field": "span.kind",
            "op": "eq",
            "value": "client"
          },
          {
            "field": "span.attr.db.system",
            "op": "exists"
          }
        ],
        "groupBy": [
          "span.attr.db.operation"
        ],
        "width": 12,
        "height": 7
      },
      {
        "id": "go-memory",
        "title": "Go memory used",
        "kind": "line",
        "signal": "metrics",
        "series": [
          {
            "label": "used",
            "agg": "sum",
            "field": "go.memory.used",
            "metricType": "sum"
          },
          {
            "label": "gc goal",
            "agg": "avg",
            "field": "go.memory.gc.goal",
            "metricType": "sum"
          }
        ],
        "unit": "bytes",
        "width": 12,
        "height": 7
      },
      {
        "id": "go-goroutines",
        "title": "Goroutines",
        "kind": "line",
        "signal": "metrics",
        "series": [
          {
            "label": "goroutines",
            "agg": "sum",
            "field": "go.goroutine.count",
            "metricType": "sum"
          }
        ],
        "unit": "count",
        "width": 12,
        "height": 7
      },
      {
        "id": "go-alloc",
        "title": "Heap allocation",
        "description": "Bytes allocated to the heap per time bucket: the rate the garbage collector has to keep up with.",
        "kind": "line",
        "signal": "metrics",
        "series": [
          {
            "label": "allocated",
            "agg": "sum",
            "field": "go.memory.allocated",
            "metricType": "sum"
          }
        ],
        "unit": "bytes",
        "width": 24,
        "height": 7
      },
      {
        "id": "error-logs",
        "title": "Error logs",
        "kind": "search",
        "signal": "logs",
        "where": [
          {
            "field": "log.attr.procedure",
            "op": "prefix",
            "value": "/reliant.v1.QuestionService/"
          },
          {
            "field": "log.severity",
            "op": "eq",
            "value": "error"
          }
        ],
        "columns": [
          "timestamp",
          "service.name",
          "log.severity",
          "log.body"
        ],
        "width": 24,
        "height": 9
      },
      {
        "id": "logs",
        "title": "Logs",
        "description": "Every record whose rpc procedure belongs to this service.",
        "kind": "search",
        "signal": "logs",
        "where": [
          {
            "field": "log.attr.procedure",
            "op": "prefix",
            "value": "/reliant.v1.QuestionService/"
          }
        ],
        "columns": [
          "timestamp",
          "service.name",
          "log.severity",
          "log.body"
        ],
        "width": 24,
        "height": 9
      }
    ]
  },
  "savedSearches": [
    {
      "id": "errors-question",
      "title": "question: error logs",
      "signal": "logs",
      "where": [
        {
          "field": "log.attr.procedure",
          "op": "prefix",
          "value": "/reliant.v1.QuestionService/"
        },
        {
          "field": "log.severity",
          "op": "eq",
          "value": "error"
        }
      ],
      "columns": [
        "timestamp",
        "service.name",
        "log.severity",
        "log.body"
      ]
    }
  ],
  "alert": {
    "name": "question",
    "rpc_service": "reliant.v1.QuestionService"
  }
}
