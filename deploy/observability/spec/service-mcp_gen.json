          },
          {
            "field": "span.name",
            "op": "eq",
            "value": "reliant.v1.MCPService/GetServer"
          }
        ],
        "unit": "count",
        "width": 8,
        "height": 6
      },
      {
        "id": "rpc-GetServer-errors",
        "title": "GetServer: error rate",
