        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$') AND startsWith(SpanName, 'reliant.v1.TokenService/')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
