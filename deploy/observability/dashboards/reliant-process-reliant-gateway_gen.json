{
  "name": "reliant: reliant-gateway",
  "tags": [
    "forge",
    "generated"
  ],
  "tiles": [
    {
      "id": "t-requests",
      "x": 0,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "Requests",
        "source": "Metrics",
        "displayType": "number",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "alias": "requests",
            "metricName": "rpc.server.calls",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-errors",
      "x": 8,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "Server faults",
        "source": "Metrics",
        "displayType": "number",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "aggCondition": "Attributes['error_class'] = 'server'",
            "aggConditionLanguage": "sql",
            "alias": "server faults",
            "metricName": "rpc.server.errors",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-p95",
      "x": 16,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "p95 RPC duration",
        "source": "Metrics",
        "displayType": "number",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "",
            "alias": "p95",
            "metricName": "rpc.server.duration",
            "metricType": "histogram"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "s"
        }
      }
    },
    {
      "id": "t-request-rate",
      "x": 0,
      "y": 4,
      "w": 8,
      "h": 7,
      "config": {
        "name": "Request rate by process (per bucket: HyperDX has no per-second rate)",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "alias": "requests",
            "metricName": "rpc.server.calls",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-rate",
      "x": 8,
      "y": 4,
      "w": 8,
      "h": 7,
      "config": {
        "name": "Server fault rate by process (per bucket: HyperDX has no per-second rate)",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "aggCondition": "Attributes['error_class'] = 'server'",
            "aggConditionLanguage": "sql",
            "alias": "server faults",
            "metricName": "rpc.server.errors",
            "metricType": "sum"
          },
          {
            "aggFn": "increase",
            "valueExpression": "",
            "alias": "requests",
            "metricName": "rpc.server.calls",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "seriesReturnType": "ratio",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-latency",
      "x": 16,
      "y": 4,
      "w": 8,
      "h": 7,
      "config": {
        "name": "p95 duration by process",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "",
            "alias": "p95",
            "metricName": "rpc.server.duration",
            "metricType": "histogram"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "s"
        }
      }
    },
    {
      "id": "t-red-by-rpc",
      "x": 0,
      "y": 11,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Rate, errors and latency by RPC",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration/1e6",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway') AND SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "groupBy": "SpanName"
      }
    },
    {
      "id": "t-go-memory",
      "x": 0,
      "y": 19,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Go memory used",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "",
            "alias": "used",
            "metricName": "go.memory.used",
            "metricType": "sum"
          },
          {
            "aggFn": "avg",
            "valueExpression": "",
            "alias": "gc goal",
            "metricName": "go.memory.gc.goal",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "byte",
          "mantissa": 1
        }
      }
    },
    {
