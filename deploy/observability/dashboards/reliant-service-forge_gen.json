    {
      "id": "t-requests",
      "x": 0,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "Requests",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$') AND startsWith(SpanName, 'reliant.v1.ForgeService/')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
