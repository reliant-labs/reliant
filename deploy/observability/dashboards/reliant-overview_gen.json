{
  "name": "reliant: overview",
  "tags": [
    "forge",
    "generated"
  ],
  "tiles": [
    {
      "id": "t-requests",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 4,
      "config": {
        "name": "Requests",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-errors",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 4,
      "config": {
        "name": "Server errors",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "errors"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$') AND lower(StatusCode) = 'error'",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-p95",
      "x": 12,
      "y": 0,
      "w": 6,
      "h": 4,
      "config": {
        "name": "p95 latency",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "ms"
        }
      }
    },
    {
      "id": "t-p99",
      "x": 18,
      "y": 0,
      "w": 6,
      "h": 4,
      "config": {
        "name": "p99 latency",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "ms"
        }
      }
    },
    {
      "id": "t-request-rate",
      "x": 0,
      "y": 4,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Requests per service",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "groupBy": "ServiceName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-rate",
      "x": 12,
      "y": 4,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Error rate per service",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "groupBy": "ServiceName",
        "granularity": "auto",
        "seriesReturnType": "ratio",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-latency",
      "x": 0,
      "y": 11,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Latency p50 / p95 / p99",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration/1e6",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "ms"
        }
      }
    },
    {
      "id": "t-red-by-service",
      "x": 0,
      "y": 18,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Rate, errors and latency by service",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration/1e6",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$')",
        "whereLanguage": "sql",
        "groupBy": "ServiceName"
      }
    },
    {
      "id": "t-top-errors",
      "x": 0,
      "y": 26,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Top errors",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "count"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$') AND lower(StatusCode) = 'error'",
        "whereLanguage": "sql",
        "groupBy": "SpanName, StatusMessage"
      }
    },
    {
      "id": "t-error-logs",
      "x": 0,
      "y": 34,
      "w": 24,
      "h": 9,
      "config": {
        "name": "Recent error logs",
        "source": "Logs",
        "displayType": "search",
        "select": "Timestamp, ServiceName, SeverityText, Body",
        "where": "lower(SeverityText) = 'error'",
        "whereLanguage": "sql"
      }
    }
  ],
  "filters": [
    {
      "id": "filter-service",
      "type": "QUERY_EXPRESSION",
      "name": "service.name",
      "expression": "ServiceName",
      "source": "Traces",
      "whereLanguage": "sql"
    },
    {
      "id": "filter-env",
      "type": "QUERY_EXPRESSION",
      "name": "deployment.environment.name",
      "expression": "ResourceAttributes['deployment.environment.name']",
      "source": "Traces",
      "whereLanguage": "sql"
    }
  ]
}
