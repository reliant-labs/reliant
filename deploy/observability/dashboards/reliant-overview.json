{
  "name": "reliant: overview",
  "tags": [
    "forge",
    "generated"
  ],
  "tiles": [
    {
      "id": "t-requests",
      "x": 0,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "Requests",
        "source": "Metrics",
        "displayType": "number",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "alias": "requests",
            "metricName": "rpc.server.calls",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-errors",
      "x": 8,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "Server faults",
        "source": "Metrics",
        "displayType": "number",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "aggCondition": "Attributes['error_class'] = 'server'",
            "aggConditionLanguage": "sql",
            "alias": "server faults",
            "metricName": "rpc.server.errors",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-p95",
      "x": 16,
      "y": 0,
      "w": 8,
      "h": 4,
      "config": {
        "name": "p95 RPC duration",
        "source": "Metrics",
        "displayType": "number",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "",
            "alias": "p95",
            "metricName": "rpc.server.duration",
            "metricType": "histogram"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "s"
        }
      }
    },
    {
      "id": "t-request-rate",
      "x": 0,
      "y": 4,
      "w": 8,
      "h": 7,
      "config": {
        "name": "Request rate by process (per bucket: HyperDX has no per-second rate)",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "alias": "requests",
            "metricName": "rpc.server.calls",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "groupBy": "ServiceName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-rate",
      "x": 8,
      "y": 4,
      "w": 8,
      "h": 7,
      "config": {
        "name": "Server fault rate by process (per bucket: HyperDX has no per-second rate)",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "increase",
            "valueExpression": "",
            "aggCondition": "Attributes['error_class'] = 'server'",
            "aggConditionLanguage": "sql",
            "alias": "server faults",
            "metricName": "rpc.server.errors",
            "metricType": "sum"
          },
          {
            "aggFn": "increase",
            "valueExpression": "",
            "alias": "requests",
            "metricName": "rpc.server.calls",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "groupBy": "ServiceName",
        "granularity": "auto",
        "seriesReturnType": "ratio",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-latency",
      "x": 16,
      "y": 4,
      "w": 8,
      "h": 7,
      "config": {
        "name": "p95 duration by process",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "",
            "alias": "p95",
            "metricName": "rpc.server.duration",
            "metricType": "histogram"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "groupBy": "ServiceName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "s"
        }
      }
    },
    {
      "id": "t-top-errors",
      "x": 0,
      "y": 11,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Top server faults",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "sampled faults"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker') AND SpanKind IN ('Server', 'SPAN_KIND_SERVER') AND match(SpanName, '^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$') AND lower(StatusCode) = 'error'",
        "whereLanguage": "sql",
        "groupBy": "ServiceName, SpanName, StatusMessage"
      }
    },
    {
      "id": "t-cpu-vs-limit",
      "x": 0,
      "y": 18,
      "w": 12,
      "h": 7,
      "config": {
        "name": "CPU against its limit",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "of limit",
            "metricName": "k8s.container.cpu_limit_utilization",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-memory-vs-limit",
      "x": 12,
      "y": 18,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Memory against its limit",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "of limit",
            "metricName": "k8s.container.memory_limit_utilization",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-restarts",
      "x": 0,
      "y": 25,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Container restarts",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "restarts",
            "metricName": "k8s.container.restarts",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-request-rate-by-version",
      "x": 12,
      "y": 25,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Requests by version",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker') AND SpanKind IN ('Server', 'SPAN_KIND_SERVER')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['service.version']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-logs",
      "x": 0,
      "y": 32,
      "w": 24,
      "h": 9,
      "config": {
        "name": "Recent error logs",
        "source": "Logs",
        "displayType": "search",
        "select": "Timestamp, ServiceName, SeverityText, Body",
        "where": "ServiceName IN ('daemon-gateway', 'reliant-api-server', 'reliant-migrate', 'reliant-temporal-worker') AND lower(SeverityText) = 'error'",
        "whereLanguage": "sql"
      }
    }
  ],
  "filters": [
    {
      "id": "filter-service",
      "type": "QUERY_EXPRESSION",
      "name": "service.name",
      "expression": "ServiceName",
      "source": "Traces",
      "whereLanguage": "sql"
    },
    {
      "id": "filter-env",
      "type": "QUERY_EXPRESSION",
      "name": "deployment.environment.name",
      "expression": "ResourceAttributes['deployment.environment.name']",
      "source": "Traces",
      "whereLanguage": "sql"
    }
  ]
}
