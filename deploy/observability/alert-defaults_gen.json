{
  "version": "forge.alert-defaults/v1",
  "input": {
    "project": "reliant",
    "services": [
      {
        "name": "account",
        "rpc_service": "reliant.v1.AccountService"
      },
      {
        "name": "approval",
        "rpc_service": "reliant.v1.ApprovalService"
      },
      {
        "name": "attachment",
        "rpc_service": "reliant.v1.AttachmentService"
      },
      {
        "name": "background",
        "rpc_service": "reliant.v1.BackgroundService"
      },
      {
        "name": "connector",
        "rpc_service": "reliant.v1.ConnectorService"
      },
      {
        "name": "daemon",
        "rpc_service": "reliant.v1.DaemonService"
      },
      {
        "name": "daemon_registry",
        "rpc_service": "reliant.v1.DaemonRegistryService"
      },
      {
        "name": "file_system",
        "rpc_service": "reliant.v1.FileSystemService"
      },
      {
        "name": "message",
        "rpc_service": "reliant.v1.MessageService"
      },
      {
        "name": "model_endpoint",
        "rpc_service": "reliant.v1.ModelEndpointService"
      },
      {
        "name": "package_commands",
        "rpc_service": "reliant.v1.PackageCommandsService"
      },
      {
        "name": "plan",
        "rpc_service": "reliant.v1.PlanService"
      },
      {
        "name": "preset",
        "rpc_service": "reliant.v1.PresetService"
      },
      {
        "name": "question",
        "rpc_service": "reliant.v1.QuestionService"
      },
      {
        "name": "run",
        "rpc_service": "reliant.v1.RunService"
      },
      {
        "name": "settings",
        "rpc_service": "reliant.v1.SettingsService"
      },
      {
        "name": "streaming",
        "rpc_service": "reliant.v1.StreamingService"
      },
      {
        "name": "system",
        "rpc_service": "reliant.v1.SystemService"
      },
      {
        "name": "task",
        "rpc_service": "reliant.v1.TaskService"
      },
      {
        "name": "terminal",
        "rpc_service": "reliant.v1.TerminalService"
      },
      {
        "name": "token",
        "rpc_service": "reliant.v1.TokenService"
      },
      {
        "name": "tool_call",
        "rpc_service": "reliant.v1.ToolCallService"
      },
      {
        "name": "tools_daemon",
        "rpc_service": "reliant.v1.ToolsDaemonService"
      }
    ]
  },
  "defaults": [
    {
      "id": "error-rate",
      "alert": "ServiceErrorRateHigh",
      "title": "Service error rate above 5%",
      "severity": "critical",
      "for": "5m",
      "interval": "1m",
      "signal": "metrics",
      "params": [
        {
          "name": "threshold",
          "default": 0.05,
          "doc": "error ratio (0..1) that fires"
        },
        {
          "name": "window_minutes",
          "default": 5,
          "doc": "minutes the ratio is computed over"
        },
        {
          "name": "min_requests",
          "default": 20,
          "doc": "fewer requests than this in the window never fire (a ratio of 1 call is noise)"
        }
      ]
    },
    {
      "id": "p95-latency",
      "alert": "ServiceLatencyP95High",
      "title": "Service p95 latency above 1s",
      "severity": "warning",
      "for": "10m",
      "interval": "1m",
      "signal": "metrics",
      "params": [
        {
          "name": "threshold_seconds",
          "default": 1,
          "doc": "p95 latency in seconds that fires"
        },
        {
          "name": "window_minutes",
          "default": 5,
          "doc": "minutes the percentile is computed over"
        },
        {
          "name": "min_requests",
          "default": 20,
          "doc": "fewer requests than this in the window never fire"
        }
      ]
    },
    {
      "id": "service-silent",
      "alert": "ServiceSilent",
      "title": "A service with steady traffic went quiet",
      "severity": "warning",
      "for": "0s",
      "interval": "1m",
      "signal": "metrics",
      "params": [
        {
          "name": "silent_minutes",
          "default": 10,
          "doc": "minutes without a request before it fires"
        },
        {
          "name": "min_active_hours",
          "default": 18,
          "doc": "of the previous 24h, the hours the service must have served requests in to count as steady (a quiet staging service never pages)"
        }
      ]
    },
    {
      "id": "crash-loop",
      "alert": "WorkloadCrashLooping",
      "title": "A container keeps restarting",
      "severity": "critical",
      "for": "0s",
      "interval": "1m",
      "signal": "metadata",
      "requires": "metadata",
      "params": [
        {
          "name": "min_restarts",
          "default": 3,
          "doc": "restarts in the window that fire (the agent reports restarts every 5 minutes)"
        },
        {
          "name": "window_minutes",
          "default": 10,
          "doc": "minutes the restart growth is measured over"
        }
      ]
    },
    {
      "id": "oom-killed",
      "alert": "WorkloadOOMKilled",
      "title": "A container was killed for running out of memory",
      "severity": "critical",
      "for": "0s",
      "interval": "1m",
      "signal": "metadata",
      "requires": "metadata",
      "params": [
        {
          "name": "window_minutes",
          "default": 10,
          "doc": "minutes a fresh OOM kill stays visible (a container that restarted in the window and last died of OOMKilled)"
        }
      ]
    },
    {
      "id": "memory-near-limit",
      "alert": "WorkloadMemoryNearLimit",
      "title": "A container is close to its memory limit",
      "severity": "warning",
      "for": "10m",
      "interval": "1m",
      "signal": "metadata",
      "requires": "metadata",
      "params": [
        {
          "name": "threshold",
          "default": 0.9,
          "doc": "memory / limit ratio (0..1) that fires"
        },
        {
          "name": "window_minutes",
          "default": 5,
          "doc": "minutes the ratio is averaged over, so a spike does not fire"
        }
      ]
    },
    {
      "id": "image-pull-failed",
      "alert": "WorkloadImagePullFailed",
      "title": "A workload cannot pull its image",
      "severity": "warning",
      "for": "5m",
      "interval": "1m",
      "signal": "metadata",
      "requires": "metadata",
      "params": [
        {
          "name": "min_events",
          "default": 1,
          "doc": "pull-failure events in the window that fire"
        },
        {
          "name": "window_minutes",
          "default": 15,
          "doc": "minutes of events considered"
        }
      ]
    },
    {
      "id": "evicted",
      "alert": "WorkloadEvicted",
      "title": "A pod was evicted",
      "severity": "warning",
      "for": "0s",
      "interval": "1m",
      "signal": "metadata",
      "requires": "metadata",
      "params": [
        {
          "name": "min_events",
          "default": 1,
          "doc": "eviction events in the window that fire"
        },
        {
          "name": "window_minutes",
          "default": 15,
          "doc": "minutes of events considered"
        }
      ]
    },
    {
      "id": "deploy-failed",
      "alert": "DeployFailed",
      "title": "A promoted release did not converge",
      "severity": "critical",
      "for": "5m",
      "interval": "1m",
      "signal": "platform",
      "params": []
    },
    {
      "id": "observability-quota",
      "alert": "ObservabilityQuotaOver100",
      "title": "Observability usage is at or over its monthly allowance (warning from 100%, critical from 150%)",
      "severity": "warning",
      "for": "0s",
      "interval": "1m",
      "signal": "platform",
      "alert_names": [
        "ObservabilityQuotaOver150"
      ],
      "params": []
    }
  ]
}
