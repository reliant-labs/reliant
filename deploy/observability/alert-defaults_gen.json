{
  "version": "forge.alert-defaults/v1",
  "input": {
    "project": "reliant",
    "services": [
      {
        "name": "account",
        "rpc_service": "reliant.v1.AccountService"
      },
      {
        "name": "attachment",
        "rpc_service": "reliant.v1.AttachmentService"
      },
      {
        "name": "connector",
        "rpc_service": "reliant.v1.ConnectorService"
      },
      {
        "name": "daemon_registry",
        "rpc_service": "reliant.v1.DaemonRegistryService"
      },
      {
        "name": "file_system",
        "rpc_service": "reliant.v1.FileSystemService"
      },
      {
        "name": "message",
        "rpc_service": "reliant.v1.MessageService"
      },
      {
        "name": "package_commands",
        "rpc_service": "reliant.v1.PackageCommandsService"
      },
      {
        "name": "preset",
        "rpc_service": "reliant.v1.PresetService"
      },
      {
        "name": "question",
        "rpc_service": "reliant.v1.QuestionService"
      },
      {
        "name": "run",
        "rpc_service": "reliant.v1.RunService"
      },
      {
        "name": "streaming",
        "rpc_service": "reliant.v1.StreamingService"
      },
      {
        "name": "system",
        "rpc_service": "reliant.v1.SystemService"
      },
      {
        "name": "token",
        "rpc_service": "reliant.v1.TokenService"
      },
      {
        "name": "tool_call",
        "rpc_service": "reliant.v1.ToolCallService"
      },
      {
        "name": "tools_daemon",
        "rpc_service": "reliant.v1.ToolsDaemonService"
      }
    ]
  },
  "defaults": [
    {
      "id": "error-rate",
      "alert": "ServiceErrorRateHigh",
      "title": "Service error rate above 5%",
      "severity": "critical",
      "for": "5m",
      "interval": "1m",
      "signal": "metrics",
      "params": [
        {
          "name": "threshold",
          "default": 0.05,
          "doc": "error ratio (0..1) that fires"
        },
        {
          "name": "window_minutes",
          "default": 5,
          "doc": "minutes the ratio is computed over"
        },
        {
          "name": "min_requests",
          "default": 20,
          "doc": "fewer requests than this in the window never fire (a ratio of 1 call is noise)"
        }
      ]
    },
    {
      "id": "p95-latency",
      "alert": "ServiceLatencyP95High",
      "title": "Service p95 latency above 1s",
      "severity": "warning",
      "for": "10m",
      "interval": "1m",
      "signal": "metrics",
      "params": [
        {
          "name": "threshold_seconds",
          "default": 1,
          "doc": "p95 latency in seconds that fires"
        },
        {
          "name": "window_minutes",
          "default": 5,
          "doc": "minutes the percentile is computed over"
        },
        {
          "name": "min_requests",
          "default": 20,
          "doc": "fewer requests than this in the window never fire"
        }
      ]
    },
    {
      "id": "service-silent",
      "alert": "ServiceSilent",
      "title": "A service with steady traffic went quiet",
      "severity": "warning",
      "for": "0s",
      "interval": "1m",
      "signal": "metrics",
      "params": [
        {
          "name": "silent_minutes",
          "default": 10,
          "doc": "minutes without a request before it fires"
        },
        {
          "name": "min_active_hours",
          "default": 18,
          "doc": "of the previous 24h, the hours the service must have served requests in to count as steady (a quiet staging service never pages)"
        }
      ]
    }
  ]
}
