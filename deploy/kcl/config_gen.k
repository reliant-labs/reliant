# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = reliantConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
reliantConfigEnvMap = lambda c: ReliantConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section reliantConfigEnvMap secrets (end)
        # forge:hash=8814721ecfde294a68421f4230bd7c3f0c85f54ed77f18b7b62982501bc97207
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "reliantConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of ReliantConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section reliantConfigEnvMap values log
        # forge:hash=6724fc2d6c81072eaa3680269d6b9921054c97bb6810004acfe15839861acc41
        "RELIANT_LOG_LEVEL" = c.log.level
        "LOG_FORMAT" = c.log.format

        # forge:section reliantConfigEnvMap values runtime
        # forge:hash=e1a31687caf801f0ae2d966db3b3f8cc56a8c38be874e2fce125854f2014f878
        "RELIANT_ENV" = c.runtime.environment

        # forge:section reliantConfigEnvMap values storage_reaper
        # forge:hash=7a9a7d79d910742aaa0f6a81160aece5bad9b273088696f81e15bb2e4a360024
        "RELIANT_STORAGE_REAPER" = c.storage_reaper.mode
        "RELIANT_STORAGE_REAPER_INTERVAL" = c.storage_reaper.interval
        "RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL" = c.storage_reaper.pressure_interval
        "FORGE_STORAGE_POLICY" = c.storage_reaper.policy_path
        "RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL" = c.storage_reaper.gocache_interval

        # forge:section reliantConfigEnvMap values (end)
        # forge:hash=e1769827ac16f2cb38e2dd9a87b234861e5af33f295889268d5884a88256e96c
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

# forge:section schema DaemonConfigInstance
# forge:hash=b87570d8f3f0779b6354cbf3c846f0f611ce6e30d796a192ca84f18e41395427
# DaemonConfigInstance is the instance block (DaemonInstanceConfig) — author its values in config.k as `instance.<field> = ...`.
schema DaemonConfigInstance:
    # Data directory (default: this instance's directory under ~/.reliant/instances)
    data_dir: str = ""
    # Account (user id) this daemon runs as; selects among several accounts on one server
    account: str = ""
    # Workspace this daemon serves (defaults to the git worktree root of the current directory)
    workspace: str = ""

# forge:section schema DaemonConfig
# forge:hash=2d4c72e2af151367796c517361550ea95f96b6ce57d548baf225f7f97d215485
schema DaemonConfig:
    # Daemon gateway URL to dial (default: the credential's gateway, else localhost on --port)
    gateway_url: str = ""
    # Port of the local daemon gateway, dialled when no gateway URL is known
    gateway_port: int = 9190
    # TLS mode for the gateway connection: tls, insecure_tls_skip_verify, h2c or disabled
    tls_mode: str = ""
    # TLS certificate file path
    tls_cert_file: str = ""
    # TLS key file path
    tls_key_file: str = ""
    # Listen for incoming gateway connections instead of dialing out
    server_mode: bool = False
    # Port to listen on in server mode
    listen_port: int = 9190
    # Never open a browser or run interactive login; idle and wait for credentials to appear on disk instead
    non_interactive: bool = False
    # Daemon type the platform declares: managed (an operator-created workspace pod) or self_hosted
    daemon_type: str = ""
    # Working directory the daemon serves (default: the process's working directory)
    working_dir: str = ""
    # Container runtime the daemon runs under (reported to the server)
    runtime_type: str = ""
    # Preview forwarder port; setting it starts the forwarder (default 9191 in server mode)
    frontend_port: int = 0
    # Project directory announced to the server at connect (default: the working directory)
    project_path: str = ""
    # Priority of agent-started commands: low or normal
    child_priority: str = "low"
    # Directory new worktrees are created in (default: ~/.reliant/worktrees)
    worktree_dir: str = ""
    # DevTools URL of an already-running browser for the chrome-devtools MCP
    chrome_browser_url: str = ""
    # Disk use (percent, or off) past which the daemon reclaims space (default 90)
    disk_reclaim_at: str = ""
    # Disk use (percent, or off) past which the daemon refuses heavy commands (default 95)
    disk_refuse_at: str = ""
    # Comma-separated commands queued behind the machine's heavy slots
    heavy_commands: str = "go build,go test,go vet,go install,golangci-lint run,vitest,npx vitest,npm test,npm run test*,npm run build*,npm ci,forge generate,forge lint,reliant forge generate,reliant forge lint,make test*,task test*,docker build"
    # Let fetch reach this machine's localhost and private network (default off; link-local and cloud-metadata addresses are always refused)
    fetch_allow_private_network: bool = False
    # Egress tool calls per minute this daemon may make (0: default 600; managed daemons: 60, fixed)
    egress_user_per_minute: int = 0
    # Egress burst this daemon may make at once (0: default 100; managed daemons: 20, fixed)
    egress_user_burst: int = 0
    # Egress calls this daemon may have in flight (0: default 32; managed daemons: 6, fixed)
    egress_user_max_concurrent: int = 0
    # Egress calls this daemon may have in flight to one destination host (0: default 32; managed daemons: 16, fixed)
    egress_host_max_concurrent: int = 0
    # instance config block (DaemonInstanceConfig). Set its fields as `instance.<field> = ...`.
    instance: DaemonConfigInstance = DaemonConfigInstance {}

    check:
        child_priority != "", "child_priority = \"\" cannot reach the process: an empty RELIANT_CHILD_PRIORITY counts as unset, so it would load the default \"low\" — set a value, or change its default in the proto"
        heavy_commands != "", "heavy_commands = \"\" cannot reach the process: an empty RELIANT_HEAVY_COMMANDS counts as unset, so it would load the default \"go build,go test,go vet,go install,golangci-lint run,vitest,npx vitest,npm test,npm run test*,npm run build*,npm ci,forge generate,forge lint,reliant forge generate,reliant forge lint,make test*,task test*,docker build\" — set a value, or change its default in the proto"

