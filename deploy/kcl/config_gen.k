        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "JWT_PUBLIC_KEY" = c.jwt_public_key
        "JWT_PUBLIC_KEY_FILE" = c.jwt_public_key_file
        "RELIANT_JWKS_URL" = c.jwks_url
        "SUPABASE_JWT_ISSUER" = c.supabase_jwt_issuer
        "SUPABASE_JWT_AUDIENCE" = c.supabase_jwt_audience
        "JWT_ISSUER" = c.jwt_issuer
        "JWT_AUDIENCE" = c.jwt_audience
        "JWT_JWKS_URL" = c.jwt_jwks_url
        "JWT_SIGNING_METHOD" = c.jwt_signing_method
        "JWT_ROLES_CLAIM" = c.jwt_roles_claim
        "JWT_JWKS_SNAPSHOT_FILE" = c.jwt_jwks_snapshot_file
        "JWT_JWKS_SNAPSHOT_MAX_AGE" = c.jwt_jwks_snapshot_max_age
        "OIDC_CLIENT_ID" = c.oidc_client_id
        "OIDC_REDIRECT_URI" = c.oidc_redirect_uri
        "OIDC_SCOPES" = c.oidc_scopes
        "IDP_LOGIN_URI" = c.idp_login_uri
        "IDP_BASE" = c.idp_base
        "IDP_HOST" = c.idp_host
        "IDP_BROKER_TOKEN_FILE" = c.idp_broker_token_file
        "TRUSTED_PROXY_HOPS" = str(c.trusted_proxy_hops)
        "AUTH_SELF_SIGNUP" = "true" if c.auth_self_signup else "false"
        "HANDOFF_REDIRECTS" = c.handoff_redirects
        "ALLOWED_EMAIL_DOMAINS" = c.allowed_email_domains
        "RELIANT_DISABLE_FORGE_API" = "true" if c.disable_forge_api else "false"
        "GRPC_PORT" = str(c.grpc_port)
        "HEALTH_PORT" = str(c.health_port)
        "PPROF_PORT" = str(c.pprof_port)
        "BIND_ADDRESS" = c.bind_address
        "CORS_ALLOWED_ORIGINS" = c.cors_allowed_origins
        "AUTH_MODE" = c.auth_mode
        "AUTH_REQUIRE_EMAIL_VERIFIED_CLAIM" = "true" if c.require_email_verified_claim else "false"
        "RELIANT_AUTHORIZATION_SERVER" = c.authorization_server
        "MCP_OAUTH_ISSUERS" = c.mcp_oauth_issuers
        "MCP_OAUTH_SCOPES" = c.mcp_oauth_scopes
        "MAX_UPLOAD_SIZE" = str(c.max_upload_size)
        "RELIANT_WORKTREE_AUTO_ARCHIVE" = c.worktree_auto_archive
        "RELIANT_WORKTREE_LANDED_IDLE" = c.worktree_landed_idle
        "RELIANT_WORKTREE_RECLAIM_QUIET" = c.worktree_reclaim_quiet
        "RELIANT_WORKTREE_RECLAIM_GRACE" = c.worktree_reclaim_grace
        "RELIANT_WORKTREE_LIVE_SHED_IDLE" = c.worktree_live_shed_idle
        "RELIANT_AUTH_URL" = c.auth_provider_url
        "RELIANT_AUTH_KEY" = c.auth_provider_key
        "RELIANT_PAYLOAD_BLOB_GC_HORIZON" = c.payload_blob_gc_horizon
        "PRE_STOP_DELAY" = c.pre_stop_delay
        "SHUTDOWN_TIMEOUT" = c.shutdown_timeout
        "LIVENESS_PATHS" = c.liveness_paths
        "READINESS_PATHS" = c.readiness_paths

        # forge:section apiServerConfigEnvMap values orgs
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_ORGS_CONNECTIONS_ENABLED" = "true" if c.orgs.connections_enabled else "false"
        "RELIANT_ORGS_GITHUB_INSTALLATION_TRIGGERS_ENABLED" = "true" if c.orgs.github_installation_triggers_enabled else "false"
        "RELIANT_ORGS_PROVIDER_ACCOUNTS_ENABLED" = "true" if c.orgs.provider_accounts_enabled else "false"
        "RELIANT_ORGS_PROJECT_MOVES_ENABLED" = "true" if c.orgs.project_moves_enabled else "false"
        "RELIANT_ORGS_PROVIDER_WORKSPACE_SEATS_ENABLED" = "true" if c.orgs.provider_workspace_seats_enabled else "false"

        # forge:section apiServerConfigEnvMap values chat_collaboration
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_CHAT_COLLABORATION_ENABLED" = "true" if c.chat_collaboration.enabled else "false"

        # forge:section apiServerConfigEnvMap values (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
