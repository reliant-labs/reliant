schema DatabaseConfig:
    # Postgres connection URL
    database_url: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "database_url" }
    # Session-capable Postgres URL for session-scoped work, when DATABASE_URL is a transaction pooler
    database_direct_url: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "database_direct_url" }
    # Database driver (postgres)
    database_driver: str = "postgres"
    # Most open database connections
    db_max_open_conns: int = 25
    # Most idle database connections kept open
    db_max_idle_conns: int = 10
    # How long the startup ping retries a database that is not up yet
    db_connect_timeout: str = ""
    # Seconds to wait for the schema to be migrated
    db_schema_wait_seconds: int = 300

    check:
        database_driver != "", "database_driver = \"\" cannot reach the process: an empty DATABASE_DRIVER counts as unset, so it would load the default \"postgres\" — set a value, or pass --db-driver= in the workload's args to make it empty"

# Every ENV_VAR DatabaseConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
DATABASE_CONFIG_SENSITIVE_ENV: [str] = ["DATABASE_URL", "DATABASE_DIRECT_URL"]

# Every ENV_VAR DatabaseConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
DATABASE_CONFIG_OPTIONAL_SECRET_ENV: [str] = ["DATABASE_DIRECT_URL"]

# databaseConfigEnvMap projects a typed DatabaseConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = databaseConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
databaseConfigEnvMap = lambda c: DatabaseConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        "DATABASE_URL" = forge.SecretRef {name = c.database_url.name, key = c.database_url.key, store_key = "DATABASE_URL"}
        "DATABASE_DIRECT_URL" = forge.SecretRef {name = c.database_direct_url.name, key = c.database_direct_url.key, store_key = "DATABASE_DIRECT_URL", optional = True}
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "databaseConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of DatabaseConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        "DATABASE_DRIVER" = c.database_driver
        "RELIANT_DB_MAX_OPEN_CONNS" = str(c.db_max_open_conns)
        "RELIANT_DB_MAX_IDLE_CONNS" = str(c.db_max_idle_conns)
        "DB_CONNECT_TIMEOUT" = c.db_connect_timeout
        "RELIANT_DB_SCHEMA_WAIT_SECONDS" = str(c.db_schema_wait_seconds)
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

schema GatewayConfig:
    # Daemon bidi-streaming gRPC listen port
    daemon_port: int = 9190
    # Health/readiness HTTP endpoint port
    health_port: int = 8080
    # Network address to bind to
    bind_address: str = "0.0.0.0"
    # pprof debug server address host:port (unset: no pprof server)
    pprof_addr: str = ""
    # How long to keep serving after readiness flips at shutdown (negative: no pause)
    pre_stop_delay: str = "5s"
    # Budget for graceful shutdown after the pre-stop pause
    shutdown_timeout: str = "30s"
    # Liveness probe paths on the health port (comma-separated)
    liveness_paths: str = "/health,/healthz"
    # Readiness probe paths on the health port (comma-separated)
    readiness_paths: str = "/ready,/readyz"

    check:
        bind_address != "", "bind_address = \"\" cannot reach the process: an empty BIND_ADDRESS counts as unset, so it would load the default \"0.0.0.0\" — set a value, or pass --bind-address= in the workload's args to make it empty"
        pre_stop_delay != "", "pre_stop_delay = \"\" cannot reach the process: an empty PRE_STOP_DELAY counts as unset, so it would load the default \"5s\" — set a value"
        shutdown_timeout != "", "shutdown_timeout = \"\" cannot reach the process: an empty SHUTDOWN_TIMEOUT counts as unset, so it would load the default \"30s\" — set a value"
        liveness_paths != "", "liveness_paths = \"\" cannot reach the process: an empty LIVENESS_PATHS counts as unset, so it would load the default \"/health,/healthz\" — set a value, or change its default in the proto"
        readiness_paths != "", "readiness_paths = \"\" cannot reach the process: an empty READINESS_PATHS counts as unset, so it would load the default \"/ready,/readyz\" — set a value, or change its default in the proto"

# Every ENV_VAR GatewayConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
