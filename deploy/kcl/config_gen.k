# ServerProcessConfigControlPlane is the control_plane block (ControlPlaneConfig) — author its values in config.k as `control_plane.<field> = ...`.
schema ServerProcessConfigControlPlane:
    # Control-plane base URL; unset means self-hosted
    url: str = ""
    # Secret for internal-service calls to the control plane (required when url is set)
    internal_service_secret: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "internal_service_secret" }

# ServerProcessConfigNats is the nats block (NatsConfig) — author its values in config.k as `nats.<field> = ...`.
schema ServerProcessConfigNats:
    # NATS server URL
    url: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "nats_url" }
    # NATS user name (used with NATS_PASSWORD)
    user: str = ""
    # NATS password (used with NATS_USER)
    password: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "nats_password" }

# ServerProcessConfigTemporal is the temporal block (TemporalConfig) — author its values in config.k as `temporal.<field> = ...`.
schema ServerProcessConfigTemporal:
    # Temporal server host
    host: str = "localhost"
    # Temporal server port
    port: int = 7233
    # Temporal namespace
    namespace: str = "reliant"

    check:
        host != "", "host = \"\" cannot reach the process: an empty TEMPORAL_HOST counts as unset, so it would load the default \"localhost\" — set a value, or pass --temporal-host= in the workload's args to make it empty"
        namespace != "", "namespace = \"\" cannot reach the process: an empty TEMPORAL_NAMESPACE counts as unset, so it would load the default \"reliant\" — set a value, or pass --temporal-namespace= in the workload's args to make it empty"

# ServerProcessConfigTLS is the tls block (ServerTLSConfig) — author its values in config.k as `tls.<field> = ...`.
schema ServerProcessConfigTLS:
    # TLS certificate file path
    cert_file: str = ""
    # TLS key file path
    key_file: str = ""
    # Disable TLS (use plaintext HTTP)
    disable: bool = False

# ServerProcessConfigIntegrations is the integrations block (IntegrationsConfig) — author its values in config.k as `integrations.<field> = ...`.
schema ServerProcessConfigIntegrations:
    # Externally reachable base URL of this deployment
    public_url: str = ""
    # Credential vault key (v1:<base64>); required when hosted
    vault_key: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "reliant_vault_key" }
    # Slack signing secret (unset: Slack events are not received)
    slack_signing_secret: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "reliant_slack_signing_secret" }
    # GitHub App webhook secret (unset: GitHub events are not received)
    github_webhook_secret: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "reliant_github_webhook_secret" }
    # GitHub App slug
    github_app_slug: str = ""
    # GitHub App bot's numeric user id (default: the production App's)
    github_bot_user_id: int = 0
    # GitHub App bot's login, used when no user id is set
    github_bot_login: str = ""
    # Test integration secret (e2e stacks only)
    test_integration_secret: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "reliant_test_integration_secret" }
    # Integration OAuth client ids, RELIANT_OAUTH_<ID>_CLIENT_ID
    # Env family RELIANT_OAUTH_<KEY>_CLIENT_ID: one entry per KEY.
    oauth_client_ids: {str: str} = {}
    # Integration OAuth client secrets, RELIANT_OAUTH_<ID>_CLIENT_SECRET
    # Env family RELIANT_OAUTH_<KEY>_CLIENT_SECRET: one entry per KEY.
    oauth_client_secrets: {str: ConfigSecretRef} = {}

    check:
        all _k in oauth_client_ids { regex.match(_k, r"^[A-Za-z0-9_]+$") }, "oauth_client_ids: ${[_k for _k in oauth_client_ids if not regex.match(_k, r'^[A-Za-z0-9_]+$')]} cannot be a KEY of RELIANT_OAUTH_<KEY>_CLIENT_ID — a KEY is letters, digits and underscores"
        all _k, _v in oauth_client_ids { _v != "" }, "oauth_client_ids: ${[_k for _k, _v in oauth_client_ids if _v == '']} set to \"\" cannot reach the process: an empty variable counts as unset — remove the entry instead"
        all _k in oauth_client_secrets { regex.match(_k, r"^[A-Za-z0-9_]+$") }, "oauth_client_secrets: ${[_k for _k in oauth_client_secrets if not regex.match(_k, r'^[A-Za-z0-9_]+$')]} cannot be a KEY of RELIANT_OAUTH_<KEY>_CLIENT_SECRET — a KEY is letters, digits and underscores"

# ServerProcessConfigObservability is the observability block (ObservabilityConfig) — author its values in config.k as `observability.<field> = ...`.
schema ServerProcessConfigObservability:
    # OTLP collector base URL (export is on whenever it is set)
    otlp_endpoint: str = ""
    # Require an OTLP collector endpoint (OTEL_EXPORTER_OTLP_ENDPOINT)
    otel_enabled: bool = False
    # Serve Reliant's Prometheus metrics
    prometheus_enabled: bool = True
    # Deployment environment telemetry is filed under
    environment: str = ""

# ServerProcessConfigAnalytics is the analytics block (AnalyticsConfig) — author its values in config.k as `analytics.<field> = ...`.
schema ServerProcessConfigAnalytics:
    # Record no product analytics events
    disabled: bool = False

# ServerProcessConfigLLM is the llm block (LLMConfig) — author its values in config.k as `llm.<field> = ...`.
schema ServerProcessConfigLLM:
    # Reliant LLM gateway base URL
    reliant_api_base_url: str = ""
    # Vertex AI project (required to call Vertex AI models)
    vertexai_project: str = ""
    # Vertex AI region
    vertexai_location: str = "us-central1"
    # Cut a stream that sends no bytes for this long
    stream_idle_timeout: str = "90s"
    # Cut a stream that sends only keepalives before any content for this long
    stream_content_stall_timeout: str = "5m"
    # Cut a stream that produces no driver event for this long
    stream_progress_timeout: str = "10m"
    # Pin how long a content block may stay open on keepalives (default: derived from the output budget)
    stream_mid_block_stall_timeout: str = ""
    # Log each OpenAI Responses input item
    debug_openai_responses_input: bool = False
    # Log each OpenAI function tool schema as sent
    debug_openai_tool_schemas: bool = False

    check:
        vertexai_location != "", "vertexai_location = \"\" cannot reach the process: an empty VERTEXAI_LOCATION counts as unset, so it would load the default \"us-central1\" — set a value, or change its default in the proto"
        stream_idle_timeout != "", "stream_idle_timeout = \"\" cannot reach the process: an empty RELIANT_LLM_STREAM_IDLE_TIMEOUT counts as unset, so it would load the default \"90s\" — set a value"
        stream_content_stall_timeout != "", "stream_content_stall_timeout = \"\" cannot reach the process: an empty RELIANT_LLM_STREAM_CONTENT_STALL_TIMEOUT counts as unset, so it would load the default \"5m\" — set a value"
        stream_progress_timeout != "", "stream_progress_timeout = \"\" cannot reach the process: an empty RELIANT_LLM_STREAM_PROGRESS_TIMEOUT counts as unset, so it would load the default \"10m\" — set a value"

# ServerProcessConfigPreview is the preview block (PreviewConfig) — author its values in config.k as `preview.<field> = ...`.
schema ServerProcessConfigPreview:
    # Workspace proxy host for path-based preview URLs
    proxy_host: str = ""
    # Base domain of subdomain-routed preview URLs
    workspace_base_domain: str = ""
    # Scheme of subdomain-routed preview URLs
    workspace_url_scheme: str = "https"
    # Port of subdomain-routed preview URLs, when not the scheme's default
    workspace_url_port: int = 0

    check:
        workspace_url_scheme != "", "workspace_url_scheme = \"\" cannot reach the process: an empty WORKSPACE_URL_SCHEME counts as unset, so it would load the default \"https\" — set a value, or change its default in the proto"

# ServerProcessConfigNetwork is the network block (NetworkConfig) — author its values in config.k as `network.<field> = ...`.
schema ServerProcessConfigNetwork:
    # Let user-steered server-side requests (fetch, websearch, model endpoints) reach private, loopback and link-local addresses; self-hosted deployments only
    allow_private_egress: bool = False

schema ServerProcessConfig:
    # Data directory for logs and certs
    data_dir: str = "./data"
    # Streaming driver (nats)
    streaming_driver: str = "nats"
    # control_plane config block (ControlPlaneConfig). Set its fields as `control_plane.<field> = ...`.
    control_plane: ServerProcessConfigControlPlane = ServerProcessConfigControlPlane {}
    # nats config block (NatsConfig). Set its fields as `nats.<field> = ...`.
    nats: ServerProcessConfigNats = ServerProcessConfigNats {}
    # temporal config block (TemporalConfig). Set its fields as `temporal.<field> = ...`.
    temporal: ServerProcessConfigTemporal = ServerProcessConfigTemporal {}
    # tls config block (ServerTLSConfig). Set its fields as `tls.<field> = ...`.
    tls: ServerProcessConfigTLS = ServerProcessConfigTLS {}
    # integrations config block (IntegrationsConfig). Set its fields as `integrations.<field> = ...`.
    integrations: ServerProcessConfigIntegrations = ServerProcessConfigIntegrations {}
    # observability config block (ObservabilityConfig). Set its fields as `observability.<field> = ...`.
    observability: ServerProcessConfigObservability = ServerProcessConfigObservability {}
    # analytics config block (AnalyticsConfig). Set its fields as `analytics.<field> = ...`.
    analytics: ServerProcessConfigAnalytics = ServerProcessConfigAnalytics {}
    # llm config block (LLMConfig). Set its fields as `llm.<field> = ...`.
    llm: ServerProcessConfigLLM = ServerProcessConfigLLM {}
    # preview config block (PreviewConfig). Set its fields as `preview.<field> = ...`.
    preview: ServerProcessConfigPreview = ServerProcessConfigPreview {}
    # network config block (NetworkConfig). Set its fields as `network.<field> = ...`.
    network: ServerProcessConfigNetwork = ServerProcessConfigNetwork {}

    check:
        data_dir != "", "data_dir = \"\" cannot reach the process: an empty DATA_DIR counts as unset, so it would load the default \"./data\" — set a value, or pass --data-dir= in the workload's args to make it empty"
        streaming_driver != "", "streaming_driver = \"\" cannot reach the process: an empty STREAMING_DRIVER counts as unset, so it would load the default \"nats\" — set a value, or pass --streaming-driver= in the workload's args to make it empty"

# Every ENV_VAR ServerProcessConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
SERVER_PROCESS_CONFIG_SENSITIVE_ENV: [str] = ["INTERNAL_SERVICE_SECRET", "NATS_URL", "NATS_PASSWORD", "RELIANT_VAULT_KEY", "RELIANT_SLACK_SIGNING_SECRET", "RELIANT_GITHUB_WEBHOOK_SECRET", "RELIANT_TEST_INTEGRATION_SECRET", "RELIANT_OAUTH_<KEY>_CLIENT_SECRET"]

# Every ENV_VAR ServerProcessConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
SERVER_PROCESS_CONFIG_OPTIONAL_SECRET_ENV: [str] = ["INTERNAL_SERVICE_SECRET", "NATS_PASSWORD", "RELIANT_VAULT_KEY", "RELIANT_SLACK_SIGNING_SECRET", "RELIANT_GITHUB_WEBHOOK_SECRET", "RELIANT_TEST_INTEGRATION_SECRET", "RELIANT_OAUTH_<KEY>_CLIENT_SECRET"]

# serverProcessConfigEnvMap projects a typed ServerProcessConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = serverProcessConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
serverProcessConfigEnvMap = lambda c: ServerProcessConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        "INTERNAL_SERVICE_SECRET" = forge.SecretRef {name = c.control_plane.internal_service_secret.name, key = c.control_plane.internal_service_secret.key, store_key = "INTERNAL_SERVICE_SECRET", optional = True}
        "NATS_URL" = forge.SecretRef {name = c.nats.url.name, key = c.nats.url.key, store_key = "NATS_URL"}
        "NATS_PASSWORD" = forge.SecretRef {name = c.nats.password.name, key = c.nats.password.key, store_key = "NATS_PASSWORD", optional = True}
        "RELIANT_VAULT_KEY" = forge.SecretRef {name = c.integrations.vault_key.name, key = c.integrations.vault_key.key, store_key = "RELIANT_VAULT_KEY", optional = True}
        "RELIANT_SLACK_SIGNING_SECRET" = forge.SecretRef {name = c.integrations.slack_signing_secret.name, key = c.integrations.slack_signing_secret.key, store_key = "RELIANT_SLACK_SIGNING_SECRET", optional = True}
        "RELIANT_GITHUB_WEBHOOK_SECRET" = forge.SecretRef {name = c.integrations.github_webhook_secret.name, key = c.integrations.github_webhook_secret.key, store_key = "RELIANT_GITHUB_WEBHOOK_SECRET", optional = True}
        "RELIANT_TEST_INTEGRATION_SECRET" = forge.SecretRef {name = c.integrations.test_integration_secret.name, key = c.integrations.test_integration_secret.key, store_key = "RELIANT_TEST_INTEGRATION_SECRET", optional = True}
    }
    _families: {str: {str: forge.SecretRef}} = {
        "RELIANT_OAUTH_<KEY>_CLIENT_SECRET" = {"RELIANT_OAUTH_" + _k + "_CLIENT_SECRET": forge.SecretRef {name = _v.name, key = _v.key, store_key = "RELIANT_OAUTH_" + _k + "_CLIENT_SECRET", optional = True} for _k, _v in c.integrations.oauth_client_secrets}
    }
    assert all _n in config_secrets { _n in _sensitive or _n in _families }, \
        "serverProcessConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive and _n not in _families]}, which is not a `sensitive` field or env family of ServerProcessConfig. Sensitive fields: ${sorted([_k for _k in _sensitive] + [_k for _k in _families])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        "RELIANT_CONTROL_PLANE_URL" = c.control_plane.url
        "NATS_USER" = c.nats.user
        "TEMPORAL_HOST" = c.temporal.host
        "TEMPORAL_PORT" = str(c.temporal.port)
        "TEMPORAL_NAMESPACE" = c.temporal.namespace
        "TLS_CERT_FILE" = c.tls.cert_file
        "TLS_KEY_FILE" = c.tls.key_file
        "DISABLE_TLS" = "true" if c.tls.disable else "false"
        "DATA_DIR" = c.data_dir
        "STREAMING_DRIVER" = c.streaming_driver
        "PUBLIC_URL" = c.integrations.public_url
        "RELIANT_GITHUB_APP_SLUG" = c.integrations.github_app_slug
        "RELIANT_GITHUB_BOT_USER_ID" = str(c.integrations.github_bot_user_id)
        "RELIANT_GITHUB_BOT_LOGIN" = c.integrations.github_bot_login
        "OTEL_EXPORTER_OTLP_ENDPOINT" = c.observability.otlp_endpoint
        "OTEL_ENABLED" = "true" if c.observability.otel_enabled else "false"
        "PROMETHEUS_ENABLED" = "true" if c.observability.prometheus_enabled else "false"
        "ENVIRONMENT" = c.observability.environment
        "RELIANT_ANALYTICS_DISABLED" = "true" if c.analytics.disabled else "false"
        "RELIANT_API_BASE_URL" = c.llm.reliant_api_base_url
        "VERTEXAI_PROJECT" = c.llm.vertexai_project
        "VERTEXAI_LOCATION" = c.llm.vertexai_location
        "RELIANT_LLM_STREAM_IDLE_TIMEOUT" = c.llm.stream_idle_timeout
        "RELIANT_LLM_STREAM_CONTENT_STALL_TIMEOUT" = c.llm.stream_content_stall_timeout
        "RELIANT_LLM_STREAM_PROGRESS_TIMEOUT" = c.llm.stream_progress_timeout
        "RELIANT_LLM_STREAM_MID_BLOCK_STALL_TIMEOUT" = c.llm.stream_mid_block_stall_timeout
        "RELIANT_DEBUG_OPENAI_RESPONSES_INPUT" = "true" if c.llm.debug_openai_responses_input else "false"
        "RELIANT_DEBUG_OPENAI_TOOL_SCHEMAS" = "true" if c.llm.debug_openai_tool_schemas else "false"
        "PROXY_HOST" = c.preview.proxy_host
        "WORKSPACE_BASE_DOMAIN" = c.preview.workspace_base_domain
        "WORKSPACE_URL_SCHEME" = c.preview.workspace_url_scheme
        "WORKSPACE_URL_PORT" = str(c.preview.workspace_url_port)
        "RELIANT_ALLOW_PRIVATE_EGRESS" = "true" if c.network.allow_private_egress else "false"
    } | {"RELIANT_OAUTH_" + _k + "_CLIENT_ID": _v for _k, _v in c.integrations.oauth_client_ids} | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets} | {_k: _v for _n in config_secrets if _n in _families for _k, _v in _families[_n]}
}

schema VaultMaintenanceConfig:
    # Credential vault keyring (id:<base64>[,id:<base64>...], first entry primary)
    vault_key: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "reliant_vault_key" }

# Every ENV_VAR VaultMaintenanceConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
VAULT_MAINTENANCE_CONFIG_SENSITIVE_ENV: [str] = ["RELIANT_VAULT_KEY"]

# Every ENV_VAR VaultMaintenanceConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
VAULT_MAINTENANCE_CONFIG_OPTIONAL_SECRET_ENV: [str] = []

# vaultMaintenanceConfigEnvMap projects a typed VaultMaintenanceConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = vaultMaintenanceConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
vaultMaintenanceConfigEnvMap = lambda c: VaultMaintenanceConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        "RELIANT_VAULT_KEY" = forge.SecretRef {name = c.vault_key.name, key = c.vault_key.key, store_key = "RELIANT_VAULT_KEY"}
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "vaultMaintenanceConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of VaultMaintenanceConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {} | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

schema WorkerConfig:
    # Private HTTPS workspace-controller endpoint for fixed hosted actions
    hosted_actions_url: str = ""
    # PEM trust bundle for the private hosted-action controller; reloaded for each connection
    hosted_actions_ca_file: str = ""
    # Health check endpoint port
    health_port: int = 8081
    # pprof debug server port (binds 127.0.0.1 only)
    pprof_port: int = 6060
    # How long to keep serving after readiness flips at shutdown (negative: no pause)
    pre_stop_delay: str = "5s"
    # Budget for graceful shutdown after the pre-stop pause
    shutdown_timeout: str = "30s"
    # Liveness probe paths on the health port (comma-separated)
    liveness_paths: str = "/health,/healthz"
    # Readiness probe paths on the health port (comma-separated)
    readiness_paths: str = "/ready,/readyz"
    # Workflow tasks (replays included) run at once; 0 derives max(2, GOMAXPROCS-1)
    max_concurrent_workflow_tasks: int = 0
    # Workflow-task pollers
    workflow_task_pollers: int = 5
    # Worker replicas sharing the egress rate budgets (0: 1)
    egress_replicas: int = 1
    # Egress tool calls per minute per user, fleet-wide
    egress_user_per_minute: int = 60
    # Egress burst per user, fleet-wide
    egress_user_burst: int = 20
    # Egress calls in flight per user, per replica
    egress_user_max_concurrent: int = 6
    # Egress calls in flight to one destination host, per replica
    egress_host_max_concurrent: int = 16
    # Egress calls of one conversation turn run at once, per replica (the rest wait)
    egress_turn_max_parallel: int = 4

    check:
        pre_stop_delay != "", "pre_stop_delay = \"\" cannot reach the process: an empty PRE_STOP_DELAY counts as unset, so it would load the default \"5s\" — set a value"
        shutdown_timeout != "", "shutdown_timeout = \"\" cannot reach the process: an empty SHUTDOWN_TIMEOUT counts as unset, so it would load the default \"30s\" — set a value"
        liveness_paths != "", "liveness_paths = \"\" cannot reach the process: an empty LIVENESS_PATHS counts as unset, so it would load the default \"/health,/healthz\" — set a value, or change its default in the proto"
        readiness_paths != "", "readiness_paths = \"\" cannot reach the process: an empty READINESS_PATHS counts as unset, so it would load the default \"/ready,/readyz\" — set a value, or change its default in the proto"

# Every ENV_VAR WorkerConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
WORKER_CONFIG_SENSITIVE_ENV: [str] = []

# Every ENV_VAR WorkerConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
WORKER_CONFIG_OPTIONAL_SECRET_ENV: [str] = []

# workerConfigEnvMap projects a typed WorkerConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = workerConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
workerConfigEnvMap = lambda c: WorkerConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "workerConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of WorkerConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        if c.hosted_actions_url != "":
            "RELIANT_WORKER_HOSTED_ACTIONS_URL" = c.hosted_actions_url
        if c.hosted_actions_ca_file != "":
            "RELIANT_WORKER_HOSTED_ACTIONS_CA_FILE" = c.hosted_actions_ca_file
        "HEALTH_PORT" = str(c.health_port)
        "PPROF_PORT" = str(c.pprof_port)
        "PRE_STOP_DELAY" = c.pre_stop_delay
        "SHUTDOWN_TIMEOUT" = c.shutdown_timeout
        "LIVENESS_PATHS" = c.liveness_paths
        "READINESS_PATHS" = c.readiness_paths
        "RELIANT_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS" = str(c.max_concurrent_workflow_tasks)
        "RELIANT_WORKER_WORKFLOW_TASK_POLLERS" = str(c.workflow_task_pollers)
        "RELIANT_WORKER_EGRESS_REPLICAS" = str(c.egress_replicas)
        "RELIANT_WORKER_EGRESS_USER_PER_MINUTE" = str(c.egress_user_per_minute)
        "RELIANT_WORKER_EGRESS_USER_BURST" = str(c.egress_user_burst)
        "RELIANT_WORKER_EGRESS_USER_MAX_CONCURRENT" = str(c.egress_user_max_concurrent)
        "RELIANT_WORKER_EGRESS_HOST_MAX_CONCURRENT" = str(c.egress_host_max_concurrent)
        "RELIANT_WORKER_EGRESS_TURN_MAX_PARALLEL" = str(c.egress_turn_max_parallel)
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

# The `reliant` binary binds a config per subcommand, so a workload's env is the
# binary's root config PLUS the config of the subcommand its process runs.
# ReliantProcess carries the instances (config.k declares one); reliantProcessEnvMap
# picks the subcommand's from the workload's own command line.
schema ReliantProcess:
    # Every `reliant` process: the binary-wide root config.
    reliant_config?: ReliantConfig
    # Every process at or below `reliant auth`, `reliant daemon`, `reliant machine`, `reliant project`, `reliant trigger`, `reliant workflow`.
    cli_config?: CLIConfig
    # Every process at or below `reliant server`, `reliant db migrate`, `reliant db vault`.
    database_config?: DatabaseConfig
    # Every process at or below `reliant server`.
    server_process_config?: ServerProcessConfig
    # Every process at or below `reliant db vault`.
    vault_maintenance_config?: VaultMaintenanceConfig
    # `reliant server api`
    api_server_config?: ApiServerConfig
    # `reliant daemon start`
    daemon_config?: DaemonConfig
    # `reliant daemon status`
    daemon_status_config?: DaemonStatusConfig
    # `reliant daemon stop`
    daemon_stop_config?: DaemonStopConfig
    # `reliant daemon logs`
    daemon_logs_config?: DaemonLogsConfig
    # `reliant daemon register`
    daemon_register_config?: DaemonRegisterConfig
    # `reliant server gateway`
    gateway_config?: GatewayConfig
    # `reliant server worker`
    worker_config?: WorkerConfig
    # `reliant preview-url`
    preview_url_config?: PreviewURLConfig

# reliantProcessEnvMap projects ONE `reliant` process's config into a workload's env
# map: the root config, plus the config of the subcommand argv runs.
#
# argv is the process's command line, a workload's `command + args`. The
# subcommand path is what follows the token naming the binary (`reliant`, or one
# ending in `/reliant`: `./cmd/reliant`, `/app/reliant`), or all of argv when no token
# names it (an image whose ENTRYPOINT is the binary, run with `args`). The
# path ends at the first flag, so put flags after the subcommand. The
# LONGEST declared command that prefixes the path wins; a process running
# none of them gets the root config alone. Every subtree config one of whose
# paths prefixes the path is added too.
#
# config_secrets names the sensitive fields the workload reads, across both
# configs; each is routed to the config that declares it.
#
#     env = config_gen.reliantProcessEnvMap(appcfg.reliant_process, (w.command or []) + (w.args or []), w.config_secrets) | w.env
reliantProcessEnvMap = lambda p: ReliantProcess, argv: [str], config_secrets: [str] -> {str: str | forge.SecretRef} {
    _at = [_i for _i, _a in argv if _a == "reliant" or _a.endswith("/reliant")]
    _rest = argv[_at[0] + 1:] if _at else argv
    _flags = [_i for _i, _a in _rest if _a.startswith("-")]
    _path = _rest[:_flags[0]] if _flags else _rest
    _cmd = "api_server_config" if _path[:2] == ["server", "api"] else "daemon_config" if _path[:2] == ["daemon", "start"] else "daemon_status_config" if _path[:2] == ["daemon", "status"] else "daemon_stop_config" if _path[:2] == ["daemon", "stop"] else "daemon_logs_config" if _path[:2] == ["daemon", "logs"] else "daemon_register_config" if _path[:2] == ["daemon", "register"] else "gateway_config" if _path[:2] == ["server", "gateway"] else "worker_config" if _path[:2] == ["server", "worker"] else "preview_url_config" if _path[:1] == ["preview-url"] else ""
    _root_sensitive: [str] = RELIANT_CONFIG_SENSITIVE_ENV
    _in_cli_config = any _p in [["auth"], ["daemon"], ["machine"], ["project"], ["trigger"], ["workflow"]] { _path[:len(_p)] == _p }
    _in_database_config = any _p in [["server"], ["db", "migrate"], ["db", "vault"]] { _path[:len(_p)] == _p }
    _in_server_process_config = any _p in [["server"]] { _path[:len(_p)] == _p }
    _in_vault_maintenance_config = any _p in [["db", "vault"]] { _path[:len(_p)] == _p }
    _sub_sensitive: [str] = [] + (C_L_I_CONFIG_SENSITIVE_ENV if _in_cli_config else []) + (DATABASE_CONFIG_SENSITIVE_ENV if _in_database_config else []) + (SERVER_PROCESS_CONFIG_SENSITIVE_ENV if _in_server_process_config else []) + (VAULT_MAINTENANCE_CONFIG_SENSITIVE_ENV if _in_vault_maintenance_config else [])
    _cmd_sensitive: [str] = API_SERVER_CONFIG_SENSITIVE_ENV if _cmd == "api_server_config" else DAEMON_CONFIG_SENSITIVE_ENV if _cmd == "daemon_config" else DAEMON_STATUS_CONFIG_SENSITIVE_ENV if _cmd == "daemon_status_config" else DAEMON_STOP_CONFIG_SENSITIVE_ENV if _cmd == "daemon_stop_config" else DAEMON_LOGS_CONFIG_SENSITIVE_ENV if _cmd == "daemon_logs_config" else DAEMON_REGISTER_CONFIG_SENSITIVE_ENV if _cmd == "daemon_register_config" else GATEWAY_CONFIG_SENSITIVE_ENV if _cmd == "gateway_config" else WORKER_CONFIG_SENSITIVE_ENV if _cmd == "worker_config" else PREVIEW_U_R_L_CONFIG_SENSITIVE_ENV if _cmd == "preview_url_config" else []
    assert all _n in config_secrets { _n in _root_sensitive or _n in _sub_sensitive or _n in _cmd_sensitive }, \
        "reliantProcessEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _root_sensitive and _n not in _sub_sensitive and _n not in _cmd_sensitive]}, which is not a `sensitive` field of the config(s) a `reliant` process running ${_path} loads. Sensitive fields: ${sorted(_root_sensitive + _sub_sensitive + _cmd_sensitive)}."
    assert p.reliant_config not in [None, Undefined], "reliantProcessEnvMap: every `reliant` process loads ReliantConfig — set `reliant_config` on the ReliantProcess."
    assert not _in_cli_config or p.cli_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant ${' '.join(_path)}`, at or below `reliant auth`, `reliant daemon`, `reliant machine`, `reliant project`, `reliant trigger`, `reliant workflow`, which loads CLIConfig — set `cli_config` on the ReliantProcess."
    assert not _in_database_config or p.database_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant ${' '.join(_path)}`, at or below `reliant server`, `reliant db migrate`, `reliant db vault`, which loads DatabaseConfig — set `database_config` on the ReliantProcess."
    assert not _in_server_process_config or p.server_process_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant ${' '.join(_path)}`, at or below `reliant server`, which loads ServerProcessConfig — set `server_process_config` on the ReliantProcess."
    assert not _in_vault_maintenance_config or p.vault_maintenance_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant ${' '.join(_path)}`, at or below `reliant db vault`, which loads VaultMaintenanceConfig — set `vault_maintenance_config` on the ReliantProcess."
    assert _cmd != "api_server_config" or p.api_server_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant server api`, which loads ApiServerConfig — set `api_server_config` on the ReliantProcess."
    assert _cmd != "daemon_config" or p.daemon_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant daemon start`, which loads DaemonConfig — set `daemon_config` on the ReliantProcess."
    assert _cmd != "daemon_status_config" or p.daemon_status_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant daemon status`, which loads DaemonStatusConfig — set `daemon_status_config` on the ReliantProcess."
    assert _cmd != "daemon_stop_config" or p.daemon_stop_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant daemon stop`, which loads DaemonStopConfig — set `daemon_stop_config` on the ReliantProcess."
    assert _cmd != "daemon_logs_config" or p.daemon_logs_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant daemon logs`, which loads DaemonLogsConfig — set `daemon_logs_config` on the ReliantProcess."
    assert _cmd != "daemon_register_config" or p.daemon_register_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant daemon register`, which loads DaemonRegisterConfig — set `daemon_register_config` on the ReliantProcess."
    assert _cmd != "gateway_config" or p.gateway_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant server gateway`, which loads GatewayConfig — set `gateway_config` on the ReliantProcess."
    assert _cmd != "worker_config" or p.worker_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant server worker`, which loads WorkerConfig — set `worker_config` on the ReliantProcess."
    assert _cmd != "preview_url_config" or p.preview_url_config not in [None, Undefined], "reliantProcessEnvMap: this workload runs `reliant preview-url`, which loads PreviewURLConfig — set `preview_url_config` on the ReliantProcess."
    _root_env = reliantConfigEnvMap(p.reliant_config, [_n for _n in config_secrets if _n in _root_sensitive])
    _sub_env = {} | (cLIConfigEnvMap(p.cli_config, [_n for _n in config_secrets if _n in C_L_I_CONFIG_SENSITIVE_ENV]) if _in_cli_config else {}) | (databaseConfigEnvMap(p.database_config, [_n for _n in config_secrets if _n in DATABASE_CONFIG_SENSITIVE_ENV]) if _in_database_config else {}) | (serverProcessConfigEnvMap(p.server_process_config, [_n for _n in config_secrets if _n in SERVER_PROCESS_CONFIG_SENSITIVE_ENV]) if _in_server_process_config else {}) | (vaultMaintenanceConfigEnvMap(p.vault_maintenance_config, [_n for _n in config_secrets if _n in VAULT_MAINTENANCE_CONFIG_SENSITIVE_ENV]) if _in_vault_maintenance_config else {})
    _cmd_env = apiServerConfigEnvMap(p.api_server_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "api_server_config" else daemonConfigEnvMap(p.daemon_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "daemon_config" else daemonStatusConfigEnvMap(p.daemon_status_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "daemon_status_config" else daemonStopConfigEnvMap(p.daemon_stop_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "daemon_stop_config" else daemonLogsConfigEnvMap(p.daemon_logs_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "daemon_logs_config" else daemonRegisterConfigEnvMap(p.daemon_register_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "daemon_register_config" else gatewayConfigEnvMap(p.gateway_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "gateway_config" else workerConfigEnvMap(p.worker_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "worker_config" else previewURLConfigEnvMap(p.preview_url_config, [_n for _n in config_secrets if _n in _cmd_sensitive]) if _cmd == "preview_url_config" else {}
    _root_env | _sub_env | _cmd_env
}

# ---------------------------------------------------------------------------
# ROOTS — one per root of the composition graph (the //forge:root structs in
# internal/app, or the default `server`): the args that run it and the config
# it REACHES, read off its closure by forge generate. Bind a workload to one:
#
#     api = fw.Workload {
#         name = "api"
#         build = forge.GoBuild {cmd = "./cmd/<bin>", output_name = "<bin>"}
#     } | config_gen.root_of("server")
#
# and project its env with `config_gen.workloadEnvMap(cfg, w)`: exactly the
# values its root reaches and, of the credentials, those it reaches and
# requires, plus any `config_secrets` opts into (each must be reached).
# ---------------------------------------------------------------------------
schema Root:
    """One root of the composition graph, as a process."""
    args: [str]
    env: [str] = []
    secrets: [str] = []
    required_secrets: [str] = []
    families: [RootFamily] = []

schema RootFamily:
    """An env family a root reaches: every variable <prefix><KEY><suffix>.
    A sensitive one is opted into by its pattern, prefix + "<KEY>" + suffix."""
    prefix: str
    suffix: str = ""
    sensitive: bool = False
    required: bool = False

ROOTS: {str: Root} = {
    "api" = Root {
        args = ["server", "api"]
        env = ["RELIANT_LOG_LEVEL", "LOG_FORMAT", "RELIANT_ENV", "RELIANT_STORAGE_REAPER", "RELIANT_STORAGE_REAPER_INTERVAL", "RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL", "FORGE_STORAGE_POLICY", "RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL", "JWT_PUBLIC_KEY", "JWT_PUBLIC_KEY_FILE", "RELIANT_JWKS_URL", "ALLOWED_EMAIL_DOMAINS", "RELIANT_DISABLE_FORGE_API", "GRPC_PORT", "HEALTH_PORT", "PPROF_PORT", "BIND_ADDRESS", "CORS_ALLOWED_ORIGINS", "AUTH_MODE", "AUTH_REQUIRE_EMAIL_VERIFIED_CLAIM", "RELIANT_AUTHORIZATION_SERVER", "MCP_OAUTH_ISSUERS", "MAX_UPLOAD_SIZE", "RELIANT_WORKTREE_AUTO_ARCHIVE", "RELIANT_AUTH_URL", "RELIANT_AUTH_KEY", "RELIANT_PAYLOAD_BLOB_GC_HORIZON", "PRE_STOP_DELAY", "SHUTDOWN_TIMEOUT", "LIVENESS_PATHS", "READINESS_PATHS", "DATABASE_DRIVER", "RELIANT_DB_MAX_OPEN_CONNS", "RELIANT_DB_MAX_IDLE_CONNS", "DB_CONNECT_TIMEOUT", "RELIANT_DB_SCHEMA_WAIT_SECONDS", "RELIANT_CONTROL_PLANE_URL", "NATS_USER", "TEMPORAL_HOST", "TEMPORAL_PORT", "TEMPORAL_NAMESPACE", "TLS_CERT_FILE", "TLS_KEY_FILE", "DISABLE_TLS", "DATA_DIR", "STREAMING_DRIVER", "PUBLIC_URL", "RELIANT_GITHUB_APP_SLUG", "RELIANT_GITHUB_BOT_USER_ID", "RELIANT_GITHUB_BOT_LOGIN", "OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_ENABLED", "PROMETHEUS_ENABLED", "ENVIRONMENT", "RELIANT_ANALYTICS_DISABLED", "RELIANT_API_BASE_URL", "VERTEXAI_PROJECT", "VERTEXAI_LOCATION", "RELIANT_LLM_STREAM_IDLE_TIMEOUT", "RELIANT_LLM_STREAM_CONTENT_STALL_TIMEOUT", "RELIANT_LLM_STREAM_PROGRESS_TIMEOUT", "RELIANT_LLM_STREAM_MID_BLOCK_STALL_TIMEOUT", "RELIANT_DEBUG_OPENAI_RESPONSES_INPUT", "RELIANT_DEBUG_OPENAI_TOOL_SCHEMAS", "PROXY_HOST", "WORKSPACE_BASE_DOMAIN", "WORKSPACE_URL_SCHEME", "WORKSPACE_URL_PORT", "RELIANT_ALLOW_PRIVATE_EGRESS"]
        secrets = ["AUTH_API_KEY", "DATABASE_URL", "DATABASE_DIRECT_URL", "INTERNAL_SERVICE_SECRET", "NATS_URL", "NATS_PASSWORD", "RELIANT_VAULT_KEY", "RELIANT_SLACK_SIGNING_SECRET", "RELIANT_GITHUB_WEBHOOK_SECRET", "RELIANT_TEST_INTEGRATION_SECRET"]
        required_secrets = ["DATABASE_URL", "NATS_URL"]
        families = [RootFamily {prefix = "RELIANT_OAUTH_", suffix = "_CLIENT_ID"}, RootFamily {prefix = "RELIANT_OAUTH_", suffix = "_CLIENT_SECRET", sensitive = True}]
    }
    "gateway" = Root {
        args = ["server", "gateway"]
        env = ["RELIANT_LOG_LEVEL", "LOG_FORMAT", "RELIANT_ENV", "RELIANT_STORAGE_REAPER", "RELIANT_STORAGE_REAPER_INTERVAL", "RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL", "FORGE_STORAGE_POLICY", "RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL", "DATABASE_DRIVER", "RELIANT_DB_MAX_OPEN_CONNS", "RELIANT_DB_MAX_IDLE_CONNS", "DB_CONNECT_TIMEOUT", "RELIANT_DB_SCHEMA_WAIT_SECONDS", "TOOLS_DAEMON_PORT", "HEALTH_PORT", "BIND_ADDRESS", "PPROF_ADDR", "PRE_STOP_DELAY", "SHUTDOWN_TIMEOUT", "LIVENESS_PATHS", "READINESS_PATHS", "RELIANT_CONTROL_PLANE_URL", "NATS_USER", "TLS_CERT_FILE", "TLS_KEY_FILE", "DISABLE_TLS", "DATA_DIR", "OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_ENABLED", "PROMETHEUS_ENABLED", "ENVIRONMENT"]
        secrets = ["DATABASE_URL", "DATABASE_DIRECT_URL", "INTERNAL_SERVICE_SECRET", "NATS_URL", "NATS_PASSWORD"]
        required_secrets = ["DATABASE_URL", "NATS_URL"]
    }
    "worker" = Root {
        args = ["server", "worker"]
        env = ["RELIANT_LOG_LEVEL", "LOG_FORMAT", "RELIANT_ENV", "RELIANT_STORAGE_REAPER", "RELIANT_STORAGE_REAPER_INTERVAL", "RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL", "FORGE_STORAGE_POLICY", "RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL", "DATABASE_DRIVER", "RELIANT_DB_MAX_OPEN_CONNS", "RELIANT_DB_MAX_IDLE_CONNS", "DB_CONNECT_TIMEOUT", "RELIANT_DB_SCHEMA_WAIT_SECONDS", "RELIANT_CONTROL_PLANE_URL", "NATS_USER", "TEMPORAL_HOST", "TEMPORAL_PORT", "TEMPORAL_NAMESPACE", "DATA_DIR", "STREAMING_DRIVER", "PUBLIC_URL", "RELIANT_GITHUB_APP_SLUG", "RELIANT_GITHUB_BOT_USER_ID", "RELIANT_GITHUB_BOT_LOGIN", "OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_ENABLED", "PROMETHEUS_ENABLED", "ENVIRONMENT", "RELIANT_ANALYTICS_DISABLED", "RELIANT_API_BASE_URL", "VERTEXAI_PROJECT", "VERTEXAI_LOCATION", "RELIANT_LLM_STREAM_IDLE_TIMEOUT", "RELIANT_LLM_STREAM_CONTENT_STALL_TIMEOUT", "RELIANT_LLM_STREAM_PROGRESS_TIMEOUT", "RELIANT_LLM_STREAM_MID_BLOCK_STALL_TIMEOUT", "RELIANT_DEBUG_OPENAI_RESPONSES_INPUT", "RELIANT_DEBUG_OPENAI_TOOL_SCHEMAS", "PROXY_HOST", "WORKSPACE_BASE_DOMAIN", "WORKSPACE_URL_SCHEME", "WORKSPACE_URL_PORT", "RELIANT_ALLOW_PRIVATE_EGRESS", "RELIANT_WORKER_HOSTED_ACTIONS_URL", "RELIANT_WORKER_HOSTED_ACTIONS_CA_FILE", "HEALTH_PORT", "PPROF_PORT", "PRE_STOP_DELAY", "SHUTDOWN_TIMEOUT", "LIVENESS_PATHS", "READINESS_PATHS", "RELIANT_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS", "RELIANT_WORKER_WORKFLOW_TASK_POLLERS", "RELIANT_WORKER_EGRESS_REPLICAS", "RELIANT_WORKER_EGRESS_USER_PER_MINUTE", "RELIANT_WORKER_EGRESS_USER_BURST", "RELIANT_WORKER_EGRESS_USER_MAX_CONCURRENT", "RELIANT_WORKER_EGRESS_HOST_MAX_CONCURRENT", "RELIANT_WORKER_EGRESS_TURN_MAX_PARALLEL"]
        secrets = ["DATABASE_URL", "DATABASE_DIRECT_URL", "INTERNAL_SERVICE_SECRET", "NATS_URL", "NATS_PASSWORD", "RELIANT_VAULT_KEY", "RELIANT_SLACK_SIGNING_SECRET", "RELIANT_GITHUB_WEBHOOK_SECRET", "RELIANT_TEST_INTEGRATION_SECRET"]
        required_secrets = ["DATABASE_URL", "NATS_URL"]
        families = [RootFamily {prefix = "RELIANT_OAUTH_", suffix = "_CLIENT_ID"}, RootFamily {prefix = "RELIANT_OAUTH_", suffix = "_CLIENT_SECRET", sensitive = True}]
    }
}

# root_of is what a workload merges in to run a root: its name and the args
# that run it. An unknown root fails the render.
root_of = lambda name: str -> {str:} {
    assert name in ROOTS, "root_of: no root named \"${name}\" — the roots are ${sorted([_k for _k in ROOTS])} (//forge:root structs in internal/app; forge generate refreshes this list)"
    {root = name, args = ROOTS[name].args}
}

# rootEnvMap is the config env of a workload bound to a root (w.root).
rootEnvMap = lambda c: ReliantProcess, w: any -> {str: str | forge.SecretRef} {
    assert w.root in ROOTS, "workload '${w.name}': root \"${w.root}\" is not a root of this binary — the roots are ${sorted([_k for _k in ROOTS])}"
    _r = ROOTS[w.root]
    assert not w.args or w.args == _r.args, "workload '${w.name}': args ${w.args} do not run root \"${w.root}\", which runs as ${_r.args} — bind it with config_gen.root_of(\"${w.root}\")"
    _opted = w.config_secrets or []
    _fam_secrets = [_f.prefix + "<KEY>" + _f.suffix for _f in _r.families if _f.sensitive]
    _required = _r.required_secrets + [_f.prefix + "<KEY>" + _f.suffix for _f in _r.families if _f.sensitive and _f.required]
    assert all _n in _opted { _n in _r.secrets or _n in _fam_secrets }, \
        "workload '${w.name}': config_secrets names ${[_n for _n in _opted if _n not in _r.secrets and _n not in _fam_secrets]}, which root \"${w.root}\" does not reach (it reaches ${_r.secrets + _fam_secrets}): a credential reaches only the workloads whose root reads it"
    _all = reliantProcessEnvMap(c, _r.args, _required + [_n for _n in _opted if _n not in _required])
    {_k: _v for _k, _v in _all if _k in _r.env or _k in _r.secrets or any _f in _r.families { _k.startswith(_f.prefix) and _k.endswith(_f.suffix) and len(_k) > len(_f.prefix) + len(_f.suffix) }}
}

# workloadEnvMap is a workload's config env: rootEnvMap for a workload bound
# to a root, reliantProcessEnvMap (its config_secrets) for any other.
workloadEnvMap = lambda c: ReliantProcess, w: any -> {str: str | forge.SecretRef} {
    rootEnvMap(c, w) if w.root else reliantProcessEnvMap(c, (w.command or []) + (w.args or []), w.config_secrets or [])
}
