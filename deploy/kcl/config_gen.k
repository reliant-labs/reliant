schema DaemonConfig:
    # Daemon gateway URL to dial (default: the credential's gateway, else localhost on --port)
    gateway_url: str = ""
    # Port of the local daemon gateway, dialled when no gateway URL is known
    gateway_port: int = 9190
    # TLS mode for the gateway connection: tls, insecure_tls_skip_verify, h2c or disabled
    tls_mode: str = ""
    # TLS certificate file path
    tls_cert_file: str = ""
    # TLS key file path
    tls_key_file: str = ""
    # Listen for incoming gateway connections instead of dialing out
    server_mode: bool = False
    # Port to listen on in server mode
    listen_port: int = 9190
    # Never open a browser or run interactive login; idle and wait for credentials to appear on disk instead
    non_interactive: bool = False
    # Daemon type the platform declares: managed (an operator-created workspace pod) or self_hosted
    daemon_type: str = ""
    # Working directory the daemon serves (default: the process's working directory)
    working_dir: str = ""
    # Container runtime the daemon runs under (reported to the server)
    runtime_type: str = ""
    # Preview forwarder port; setting it starts the forwarder (default 9191 in server mode)
    frontend_port: int = 0
    # Project directory announced to the server at connect (default: the working directory)
    project_path: str = ""
    # Priority of agent-started commands: low or normal
    child_priority: str = "low"
    # Directory new worktrees are created in (default: ~/.reliant/worktrees)
    worktree_dir: str = ""
    # DevTools URL of an already-running browser for the chrome-devtools MCP
    chrome_browser_url: str = ""
    # Disk use (percent, or off) past which the daemon reclaims space (default 90)
    disk_reclaim_at: str = ""
    # Disk use (percent, or off) past which the daemon refuses heavy commands (default 95)
    disk_refuse_at: str = ""
    # Comma-separated commands queued behind the machine's heavy slots
    heavy_commands: str = "go build,go test,go vet,go install,golangci-lint run,vitest,npx vitest,npm test,npm run test*,npm run build*,npm ci,forge generate,forge lint,reliant forge generate,reliant forge lint,make test*,task test*,docker build"
    # Let fetch reach this machine's localhost and private network (default off; link-local and cloud-metadata addresses are always refused)
    fetch_allow_private_network: bool = False
    # Egress tool calls per minute this daemon may make (0: default 600; managed daemons: 60, fixed)
    egress_user_per_minute: int = 0
    # Egress burst this daemon may make at once (0: default 100; managed daemons: 20, fixed)
    egress_user_burst: int = 0
    # Egress calls this daemon may have in flight (0: default 32; managed daemons: 6, fixed)
    egress_user_max_concurrent: int = 0
    # Egress calls this daemon may have in flight to one destination host (0: default 32; managed daemons: 16, fixed)
    egress_host_max_concurrent: int = 0
    # instance config block (DaemonInstanceConfig). Set its fields as `instance.<field> = ...`.
    instance: DaemonConfigInstance = DaemonConfigInstance {}

