# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
DAEMON_CONFIG_SENSITIVE_ENV: [str] = [
    # forge:section DAEMON_CONFIG_SENSITIVE_ENV (end)
    # forge:hash=c2ebc7fabfa68071481f7f912d38f247a48f55bd0056c0d4ca9c75bf53d1833b
]

# Every ENV_VAR DaemonConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
DAEMON_CONFIG_OPTIONAL_SECRET_ENV: [str] = [
    # forge:section DAEMON_CONFIG_OPTIONAL_SECRET_ENV (end)
    # forge:hash=174b92e946d935e66c6b3933dd3ee3910e24555224ca4e41f499e9c575cd9e8d
]

# daemonConfigEnvMap projects a typed DaemonConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = daemonConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
daemonConfigEnvMap = lambda c: DaemonConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section daemonConfigEnvMap secrets (end)
        # forge:hash=d1f319b9b377bee727d727ca9bc339f224644ab21669dc60036115a4858d9230
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "daemonConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of DaemonConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section daemonConfigEnvMap values instance
        # forge:hash=bfeacedfab76bbb24c4dc780e8c470e7819cae9dbe51237decc237aad91b2996
        "DAEMON_DATA_DIR" = c.instance.data_dir
        "RELIANT_INSTANCE_ACCOUNT" = c.instance.account
        "RELIANT_INSTANCE_WORKSPACE" = c.instance.workspace

        # forge:section daemonConfigEnvMap values (root)
        # forge:hash=9f72a4817d226d50d177d8a572b816beecfd407876cf3418f90238ccfe02c267
        "DAEMON_GRPC_URL" = c.gateway_url
        "TOOLS_DAEMON_PORT" = str(c.gateway_port)
        "DAEMON_TLS_MODE" = c.tls_mode
        "TLS_CERT_FILE" = c.tls_cert_file
        "TLS_KEY_FILE" = c.tls_key_file
        "DAEMON_SERVER_MODE" = "true" if c.server_mode else "false"
        "DAEMON_LISTEN_PORT" = str(c.listen_port)
        "RELIANT_DAEMON_NON_INTERACTIVE" = "true" if c.non_interactive else "false"
        "RELIANT_DAEMON_TYPE" = c.daemon_type
        "DAEMON_WORKING_DIR" = c.working_dir
        "DAEMON_RUNTIME_TYPE" = c.runtime_type
        "DAEMON_FRONTEND_PORT" = str(c.frontend_port)
        "PROJECT_PATH" = c.project_path
        "RELIANT_CHILD_PRIORITY" = c.child_priority
        "RELIANT_WORKTREE_DIR" = c.worktree_dir
        "RELIANT_CHROME_BROWSER_URL" = c.chrome_browser_url
        "RELIANT_DISK_RECLAIM_AT" = c.disk_reclaim_at
        "RELIANT_DISK_REFUSE_AT" = c.disk_refuse_at
        "RELIANT_HEAVY_COMMANDS" = c.heavy_commands
        "RELIANT_FETCH_ALLOW_PRIVATE_NETWORK" = "true" if c.fetch_allow_private_network else "false"
        "RELIANT_DAEMON_EGRESS_USER_PER_MINUTE" = str(c.egress_user_per_minute)
        "RELIANT_DAEMON_EGRESS_USER_BURST" = str(c.egress_user_burst)
        "RELIANT_DAEMON_EGRESS_USER_MAX_CONCURRENT" = str(c.egress_user_max_concurrent)
        "RELIANT_DAEMON_EGRESS_HOST_MAX_CONCURRENT" = str(c.egress_host_max_concurrent)

        # forge:section daemonConfigEnvMap values (end)
        # forge:hash=06d93ea6019c14e6397469374bab99b5c2725f7353c6e9a894aa0b0ce1f5d421
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

