    skip_tls_verify: bool = False

    check:
        server_url != "", "server_url = \"\" cannot reach the process: an empty RELIANT_SERVER_URL counts as unset, so it would load the default \"https://api.reliantapi.com\" — set a value, or pass --server= in the workload's args to make it empty"
