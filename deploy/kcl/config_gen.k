#
#     env = authConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
authConfigEnvMap = lambda c: AuthConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section authConfigEnvMap secrets (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "authConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of AuthConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section authConfigEnvMap values (root)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_DAEMON_TYPE" = c.daemon_type

        # forge:section authConfigEnvMap values (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

# forge:section schema CLIConfigConnection
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# CLIConfigConnection is the connection block (CLIConnectionConfig) — author its values in config.k as `connection.<field> = ...`.
schema CLIConfigConnection:
    # Reliant API server URL
    server_url: str = "https://api.reliantapi.com"
    # Daemon gateway URL (a non-default server derives its own gateway unless this is set)
    gateway_url: str = "https://gateway.reliantapi.com"
    # API token used instead of the stored login
    token: ConfigSecretRef = ConfigSecretRef { name = "reliant-secrets", key = "reliant_token" }
    # Skip TLS certificate verification (development only)
    skip_tls_verify: bool = False

    check:
        server_url != "", "server_url = \"\" cannot reach the process: an empty RELIANT_SERVER_URL counts as unset, so it would load the default \"https://api.reliantapi.com\" — set a value, or pass --server= in the workload's args to make it empty"
        gateway_url != "", "gateway_url = \"\" cannot reach the process: an empty RELIANT_GATEWAY_URL counts as unset, so it would load the default \"https://gateway.reliantapi.com\" — set a value, or pass --gateway= in the workload's args to make it empty"

# forge:section schema CLIConfigWeb
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# CLIConfigWeb is the web block (CLIWebConfig) — author its values in config.k as `web.<field> = ...`.
schema CLIConfigWeb:
    # Comma-separated web origins the localhost OAuth helper accepts
    origins: str = ""
    # Dev web server port whose loopback origins the localhost OAuth helper accepts
    frontend_port: str = ""

# forge:section schema CLIConfigMachine
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# CLIConfigMachine is the machine block (CLIMachineConfig) — author its values in config.k as `machine.<field> = ...`.
schema CLIConfigMachine:
    # Pinned machine instance id (default: the one persisted in ~/.reliant)
    instance_id: str = ""
    # User configuration directory (default: ~/.reliant)
    user_config_dir: str = ""
    # Internal app data directory (default: platform-specific)
    app_data_dir: str = ""

# forge:section schema CLIConfig
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
schema CLIConfig:
    # connection config block (CLIConnectionConfig). Set its fields as `connection.<field> = ...`.
    connection: CLIConfigConnection = CLIConfigConnection {}
    # web config block (CLIWebConfig). Set its fields as `web.<field> = ...`.
    web: CLIConfigWeb = CLIConfigWeb {}
    # machine config block (CLIMachineConfig). Set its fields as `machine.<field> = ...`.
    machine: CLIConfigMachine = CLIConfigMachine {}

# forge:section env-map cLIConfigEnvMap
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# Every ENV_VAR CLIConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
C_L_I_CONFIG_SENSITIVE_ENV: [str] = [
    # forge:section C_L_I_CONFIG_SENSITIVE_ENV connection
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
    "RELIANT_TOKEN"

    # forge:section C_L_I_CONFIG_SENSITIVE_ENV (end)
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
]

# Every ENV_VAR CLIConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
C_L_I_CONFIG_OPTIONAL_SECRET_ENV: [str] = [
    # forge:section C_L_I_CONFIG_OPTIONAL_SECRET_ENV connection
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
    "RELIANT_TOKEN"

    # forge:section C_L_I_CONFIG_OPTIONAL_SECRET_ENV (end)
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
]

# cLIConfigEnvMap projects a typed CLIConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = cLIConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
cLIConfigEnvMap = lambda c: CLIConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section cLIConfigEnvMap secrets connection
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_TOKEN" = forge.SecretRef {name = c.connection.token.name, key = c.connection.token.key, store_key = "RELIANT_TOKEN", optional = True}

        # forge:section cLIConfigEnvMap secrets (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "cLIConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of CLIConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section cLIConfigEnvMap values connection
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_SERVER_URL" = c.connection.server_url
        "RELIANT_GATEWAY_URL" = c.connection.gateway_url
        "RELIANT_SKIP_TLS_VERIFY" = "true" if c.connection.skip_tls_verify else "false"

        # forge:section cLIConfigEnvMap values web
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_WEB_ORIGIN" = c.web.origins
        "FRONTEND_PORT" = c.web.frontend_port

        # forge:section cLIConfigEnvMap values machine
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_INSTANCE_ID" = c.machine.instance_id
        "RELIANT_USER_CONFIG_DIR" = c.machine.user_config_dir
        "RELIANT_APP_DATA_DIR" = c.machine.app_data_dir

        # forge:section cLIConfigEnvMap values (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

# forge:section schema ReliantConfigLog
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigLog is the log block (LogConfig) — author its values in config.k as `log.<field> = ...`.
schema ReliantConfigLog:
    # Log level: debug, info, warn or error (default info)
    level: str = ""
    # Log line format: text or json (default text; json for a hosted daemon)
    format: str = ""

# forge:section schema ReliantConfigRuntime
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigRuntime is the runtime block (RuntimeConfig) — author its values in config.k as `runtime.<field> = ...`.
schema ReliantConfigRuntime:
    # Environment tier: dev, test or prod (unset or unrecognised is prod)
    environment: str = ""

# forge:section schema ReliantConfigStorageReaper
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigStorageReaper is the storage_reaper block (StorageReaperConfig) — author its values in config.k as `storage_reaper.<field> = ...`.
schema ReliantConfigStorageReaper:
    # Run forge's storage reaper on a schedule: auto (managed daemons only), on, or off
    mode: str = "auto"
    # Interval of the scheduled storage reaper pass (Go duration, minimum 5m)
    interval: str = "1h"
    # Minimum gap between storage reaper passes while a volume is under pressure (Go duration, minimum 1m)
    pressure_interval: str = "10m"
    # Forge machine storage policy file (default: <user config dir>/forge/storage.json)
    policy_path: str = ""
    # Interval of the Go-cache trim between full storage reaper passes (Go duration, minimum 2m; off disables)
    gocache_interval: str = "10m"

    check:
        mode != "", "mode = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER counts as unset, so it would load the default \"auto\" — set a value, or change its default in the proto"
        interval != "", "interval = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER_INTERVAL counts as unset, so it would load the default \"1h\" — set a value, or change its default in the proto"
        pressure_interval != "", "pressure_interval = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL counts as unset, so it would load the default \"10m\" — set a value, or change its default in the proto"
        gocache_interval != "", "gocache_interval = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL counts as unset, so it would load the default \"10m\" — set a value, or change its default in the proto"

# forge:section schema ReliantConfigTranscript
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigTranscript is the transcript block (TranscriptConfig) — author its values in config.k as `transcript.<field> = ...`.
schema ReliantConfigTranscript:
    # Transcript reads may leave finished tool calls' bodies out when a client asks (on) or always send them whole (off)
    tool_body_stubs: str = "on"

    check:
        tool_body_stubs != "", "tool_body_stubs = \"\" cannot reach the process: an empty RELIANT_TRANSCRIPT_TOOL_BODY_STUBS counts as unset, so it would load the default \"on\" — set a value, or change its default in the proto"

# forge:section schema ReliantConfigWorktreeReclaim
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigWorktreeReclaim is the worktree_reclaim block (WorktreeReclaimConfig) — author its values in config.k as `worktree_reclaim.<field> = ...`.
schema ReliantConfigWorktreeReclaim:
    # Machine-wide worktree reclaim: off, dry-run (report only) or on (capture, then reclaim)
    mode: str = "dry-run"
    # Directories the worktree reclaim walks for repositories, comma-separated path[:depth] (default: worktree root, temp, cache and home dirs)
    roots: str = ""
    # Idle time before a clean, pushed worktree is reclaimed (Go duration, minimum 1h)
    clean_idle: str = "24h"
    # Idle time before a worktree with unsaved work is proposed for approval (Go duration, minimum 24h)
    approval_idle: str = "120h"

    check:
        mode != "", "mode = \"\" cannot reach the process: an empty RELIANT_WORKTREE_RECLAIM counts as unset, so it would load the default \"dry-run\" — set a value, or change its default in the proto"
        clean_idle != "", "clean_idle = \"\" cannot reach the process: an empty RELIANT_WORKTREE_RECLAIM_CLEAN_IDLE counts as unset, so it would load the default \"24h\" — set a value, or change its default in the proto"
        approval_idle != "", "approval_idle = \"\" cannot reach the process: an empty RELIANT_WORKTREE_RECLAIM_APPROVAL_IDLE counts as unset, so it would load the default \"120h\" — set a value, or change its default in the proto"

# forge:section schema ReliantConfigMachineOrg
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigMachineOrg is the machine_org block (MachineOrgConfig) — author its values in config.k as `machine_org.<field> = ...`.
schema ReliantConfigMachineOrg:
    # The connect reconcile detaches other orgs' checkout records from a machine of a known org (on), or leaves them (off)
    cross_org_cleanup: str = "on"

    check:
        cross_org_cleanup != "", "cross_org_cleanup = \"\" cannot reach the process: an empty RELIANT_MACHINE_ORG_CLEANUP counts as unset, so it would load the default \"on\" — set a value, or change its default in the proto"

# forge:section schema ReliantConfigIdleReclaim
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# ReliantConfigIdleReclaim is the idle_reclaim block (IdleReclaimConfig) — author its values in config.k as `idle_reclaim.<field> = ...`.
schema ReliantConfigIdleReclaim:
    # Idle reclaim of scratch directories and idle worktrees' node_modules: auto (where the storage reaper runs), on, dry-run or off
    mode: str = "auto"
    # Idle time before a scratch directory's regenerable output and clean, pushed worktrees are removed (Go duration, minimum 24h)
    scratch_strip_idle: str = "48h"
    # Idle time before a whole scratch directory without a .keep file is removed (Go duration, minimum 72h)
    scratch_remove_idle: str = "168h"
    # Idle time before a kept worktree's node_modules are removed (Go duration, minimum 24h)
    worktree_node_modules_idle: str = "72h"

    check:
        mode != "", "mode = \"\" cannot reach the process: an empty RELIANT_IDLE_RECLAIM counts as unset, so it would load the default \"auto\" — set a value, or change its default in the proto"
        scratch_strip_idle != "", "scratch_strip_idle = \"\" cannot reach the process: an empty RELIANT_IDLE_RECLAIM_SCRATCH_STRIP_IDLE counts as unset, so it would load the default \"48h\" — set a value, or change its default in the proto"
        scratch_remove_idle != "", "scratch_remove_idle = \"\" cannot reach the process: an empty RELIANT_IDLE_RECLAIM_SCRATCH_REMOVE_IDLE counts as unset, so it would load the default \"168h\" — set a value, or change its default in the proto"
        worktree_node_modules_idle != "", "worktree_node_modules_idle = \"\" cannot reach the process: an empty RELIANT_IDLE_RECLAIM_WORKTREE_NODE_MODULES_IDLE counts as unset, so it would load the default \"72h\" — set a value, or change its default in the proto"

# forge:section schema ReliantConfig
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
schema ReliantConfig:
    # log config block (LogConfig). Set its fields as `log.<field> = ...`.
    log: ReliantConfigLog = ReliantConfigLog {}
    # runtime config block (RuntimeConfig). Set its fields as `runtime.<field> = ...`.
    runtime: ReliantConfigRuntime = ReliantConfigRuntime {}
    # storage_reaper config block (StorageReaperConfig). Set its fields as `storage_reaper.<field> = ...`.
    storage_reaper: ReliantConfigStorageReaper = ReliantConfigStorageReaper {}
    # transcript config block (TranscriptConfig). Set its fields as `transcript.<field> = ...`.
    transcript: ReliantConfigTranscript = ReliantConfigTranscript {}
    # worktree_reclaim config block (WorktreeReclaimConfig). Set its fields as `worktree_reclaim.<field> = ...`.
    worktree_reclaim: ReliantConfigWorktreeReclaim = ReliantConfigWorktreeReclaim {}
    # machine_org config block (MachineOrgConfig). Set its fields as `machine_org.<field> = ...`.
    machine_org: ReliantConfigMachineOrg = ReliantConfigMachineOrg {}
    # idle_reclaim config block (IdleReclaimConfig). Set its fields as `idle_reclaim.<field> = ...`.
    idle_reclaim: ReliantConfigIdleReclaim = ReliantConfigIdleReclaim {}

# forge:section env-map reliantConfigEnvMap
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# Every ENV_VAR ReliantConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
RELIANT_CONFIG_SENSITIVE_ENV: [str] = [
    # forge:section RELIANT_CONFIG_SENSITIVE_ENV (end)
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
]

# Every ENV_VAR ReliantConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
RELIANT_CONFIG_OPTIONAL_SECRET_ENV: [str] = [
    # forge:section RELIANT_CONFIG_OPTIONAL_SECRET_ENV (end)
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
]

# reliantConfigEnvMap projects a typed ReliantConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = reliantConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
reliantConfigEnvMap = lambda c: ReliantConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section reliantConfigEnvMap secrets (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "reliantConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of ReliantConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section reliantConfigEnvMap values log
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_LOG_LEVEL" = c.log.level
        "LOG_FORMAT" = c.log.format

        # forge:section reliantConfigEnvMap values runtime
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_ENV" = c.runtime.environment

        # forge:section reliantConfigEnvMap values storage_reaper
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_STORAGE_REAPER" = c.storage_reaper.mode
        "RELIANT_STORAGE_REAPER_INTERVAL" = c.storage_reaper.interval
        "RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL" = c.storage_reaper.pressure_interval
        "FORGE_STORAGE_POLICY" = c.storage_reaper.policy_path
        "RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL" = c.storage_reaper.gocache_interval

        # forge:section reliantConfigEnvMap values transcript
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_TRANSCRIPT_TOOL_BODY_STUBS" = c.transcript.tool_body_stubs

        # forge:section reliantConfigEnvMap values worktree_reclaim
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_WORKTREE_RECLAIM" = c.worktree_reclaim.mode
        "RELIANT_WORKTREE_RECLAIM_ROOTS" = c.worktree_reclaim.roots
        "RELIANT_WORKTREE_RECLAIM_CLEAN_IDLE" = c.worktree_reclaim.clean_idle
        "RELIANT_WORKTREE_RECLAIM_APPROVAL_IDLE" = c.worktree_reclaim.approval_idle

        # forge:section reliantConfigEnvMap values machine_org
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_MACHINE_ORG_CLEANUP" = c.machine_org.cross_org_cleanup

        # forge:section reliantConfigEnvMap values idle_reclaim
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "RELIANT_IDLE_RECLAIM" = c.idle_reclaim.mode
        "RELIANT_IDLE_RECLAIM_SCRATCH_STRIP_IDLE" = c.idle_reclaim.scratch_strip_idle
        "RELIANT_IDLE_RECLAIM_SCRATCH_REMOVE_IDLE" = c.idle_reclaim.scratch_remove_idle
        "RELIANT_IDLE_RECLAIM_WORKTREE_NODE_MODULES_IDLE" = c.idle_reclaim.worktree_node_modules_idle

        # forge:section reliantConfigEnvMap values (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

# forge:section schema DaemonConfigInstance
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# DaemonConfigInstance is the instance block (DaemonInstanceConfig) — author its values in config.k as `instance.<field> = ...`.
schema DaemonConfigInstance:
    # Data directory (default: this instance's directory under ~/.reliant/instances)
    data_dir: str = ""
    # Account (user id) this daemon runs as; selects among several accounts on one server
    account: str = ""
    # Workspace this daemon serves (defaults to the git worktree root of the current directory)
    workspace: str = ""

# forge:section schema DaemonConfig
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
schema DaemonConfig:
    # Daemon gateway URL to dial (default: the credential's gateway, else localhost on --port)
    gateway_url: str = ""
    # Port of the local daemon gateway, dialled when no gateway URL is known
    gateway_port: int = 9190
    # TLS mode for the gateway connection: tls, insecure_tls_skip_verify, h2c or disabled
    tls_mode: str = ""
    # TLS certificate file path
    tls_cert_file: str = ""
    # TLS key file path
    tls_key_file: str = ""
    # Listen for incoming gateway connections instead of dialing out
    server_mode: bool = False
    # Port to listen on in server mode
    listen_port: int = 9190
    # Never open a browser or run interactive login; idle and wait for credentials to appear on disk instead
    non_interactive: bool = False
    # Daemon type the platform declares: managed (an operator-created workspace pod) or self_hosted
    daemon_type: str = ""
    # Working directory the daemon serves (default: the process's working directory)
    working_dir: str = ""
    # Container runtime the daemon runs under (reported to the server)
    runtime_type: str = ""
    # Preview forwarder port; setting it starts the forwarder (default 9191 in server mode)
    frontend_port: int = 0
    # Project directory announced to the server at connect (default: the working directory)
    project_path: str = ""
    # Priority of agent-started commands: low or normal
    child_priority: str = "low"
    # Directory new worktrees are created in (default: ~/.reliant/worktrees)
    worktree_dir: str = ""
    # DevTools URL of an already-running browser for the chrome-devtools MCP
    chrome_browser_url: str = ""
    # Disk use (percent, or off) past which the daemon reclaims space (default 80)
    disk_reclaim_at: str = ""
    # Disk use (percent, or off) past which the daemon refuses heavy commands (default 95)
    disk_refuse_at: str = ""
    # Comma-separated commands queued behind the machine's heavy slots
    heavy_commands: str = "go build,go test,go vet,go install,golangci-lint run,vitest,npx vitest,npm test,npm run test*,npm run build*,npm ci,forge generate,forge lint,reliant forge generate,reliant forge lint,make test*,task test*,docker build"
    # CPUs each heavy-slot command may use, as GOMAXPROCS and UV_THREADPOOL_SIZE (0: max(2, 2*CPUs/slots))
    heavy_share: int = 0
    # Threads each command may have at once (0: 1024 + 64 per CPU, at most half of what all commands share)
    command_threads: int = 0
    # How long a finished chat's background process may sit idle before the daemon stops it (0 = off)
    background_idle_reap: str = "4h"
    # Let fetch reach this machine's localhost and private network (default off; link-local and cloud-metadata addresses are always refused)
    fetch_allow_private_network: bool = False
    # Egress tool calls per minute this daemon may make (0: default 600; managed daemons: 60, fixed)
    egress_user_per_minute: int = 0
    # Egress burst this daemon may make at once (0: default 100; managed daemons: 20, fixed)
    egress_user_burst: int = 0
    # Egress calls this daemon may have in flight (0: default 32; managed daemons: 6, fixed)
    egress_user_max_concurrent: int = 0
    # Egress calls this daemon may have in flight to one destination host (0: default 32; managed daemons: 16, fixed)
    egress_host_max_concurrent: int = 0
    # Comma-separated key=value durable labels this machine declares (merged into its labels on every connect)
    labels: str = ""
    # Install new signed releases of reliant at quiet moments, restarting in place (a self-owned install only; off by default)
    auto_update: bool = False
    # Image merge-queue gates run in on this machine (empty: refuse gates)
    gate_image: str = ""
    # Grype database directory mounted read-only into merge-queue gates (empty: scans are unproven)
    gate_vuln_db_dir: str = ""
    # instance config block (DaemonInstanceConfig). Set its fields as `instance.<field> = ...`.
    instance: DaemonConfigInstance = DaemonConfigInstance {}

    check:
        child_priority != "", "child_priority = \"\" cannot reach the process: an empty RELIANT_CHILD_PRIORITY counts as unset, so it would load the default \"low\" — set a value, or change its default in the proto"
        heavy_commands != "", "heavy_commands = \"\" cannot reach the process: an empty RELIANT_HEAVY_COMMANDS counts as unset, so it would load the default \"go build,go test,go vet,go install,golangci-lint run,vitest,npx vitest,npm test,npm run test*,npm run build*,npm ci,forge generate,forge lint,reliant forge generate,reliant forge lint,make test*,task test*,docker build\" — set a value, or change its default in the proto"
        background_idle_reap != "", "background_idle_reap = \"\" cannot reach the process: an empty RELIANT_BACKGROUND_IDLE_REAP counts as unset, so it would load the default \"4h\" — set a value"

# forge:section env-map daemonConfigEnvMap
# forge:hash=429f26b6c820aaf410f35e81bf36c40aa4601067d7cb06fc7df9b6b3b01a508f
# Every ENV_VAR DaemonConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
DAEMON_CONFIG_SENSITIVE_ENV: [str] = [
    # forge:section DAEMON_CONFIG_SENSITIVE_ENV (end)
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
]

# Every ENV_VAR DaemonConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
DAEMON_CONFIG_OPTIONAL_SECRET_ENV: [str] = [
    # forge:section DAEMON_CONFIG_OPTIONAL_SECRET_ENV (end)
    # forge:hash=2bb459c9ad4bb56db23f94e0bdd9fcb927f98118c0812b9bf924d7f37d5b6e4c
]

# daemonConfigEnvMap projects a typed DaemonConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = daemonConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
daemonConfigEnvMap = lambda c: DaemonConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section daemonConfigEnvMap secrets (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "daemonConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of DaemonConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section daemonConfigEnvMap values instance
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "DAEMON_DATA_DIR" = c.instance.data_dir
        "RELIANT_INSTANCE_ACCOUNT" = c.instance.account
        "RELIANT_INSTANCE_WORKSPACE" = c.instance.workspace

        # forge:section daemonConfigEnvMap values (root)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
        "DAEMON_GRPC_URL" = c.gateway_url
        "TOOLS_DAEMON_PORT" = str(c.gateway_port)
        "DAEMON_TLS_MODE" = c.tls_mode
        "TLS_CERT_FILE" = c.tls_cert_file
        "TLS_KEY_FILE" = c.tls_key_file
        "DAEMON_SERVER_MODE" = "true" if c.server_mode else "false"
        "DAEMON_LISTEN_PORT" = str(c.listen_port)
        "RELIANT_DAEMON_NON_INTERACTIVE" = "true" if c.non_interactive else "false"
        "RELIANT_DAEMON_TYPE" = c.daemon_type
        "DAEMON_WORKING_DIR" = c.working_dir
        "DAEMON_RUNTIME_TYPE" = c.runtime_type
        "DAEMON_FRONTEND_PORT" = str(c.frontend_port)
        "PROJECT_PATH" = c.project_path
        "RELIANT_CHILD_PRIORITY" = c.child_priority
        "RELIANT_WORKTREE_DIR" = c.worktree_dir
        "RELIANT_CHROME_BROWSER_URL" = c.chrome_browser_url
        "RELIANT_DISK_RECLAIM_AT" = c.disk_reclaim_at
        "RELIANT_DISK_REFUSE_AT" = c.disk_refuse_at
        "RELIANT_HEAVY_COMMANDS" = c.heavy_commands
        "RELIANT_HEAVY_SHARE" = str(c.heavy_share)
        "RELIANT_COMMAND_THREADS" = str(c.command_threads)
        "RELIANT_BACKGROUND_IDLE_REAP" = c.background_idle_reap
        "RELIANT_FETCH_ALLOW_PRIVATE_NETWORK" = "true" if c.fetch_allow_private_network else "false"
        "RELIANT_DAEMON_EGRESS_USER_PER_MINUTE" = str(c.egress_user_per_minute)
        "RELIANT_DAEMON_EGRESS_USER_BURST" = str(c.egress_user_burst)
        "RELIANT_DAEMON_EGRESS_USER_MAX_CONCURRENT" = str(c.egress_user_max_concurrent)
        "RELIANT_DAEMON_EGRESS_HOST_MAX_CONCURRENT" = str(c.egress_host_max_concurrent)
        "RELIANT_DAEMON_LABELS" = c.labels
        "RELIANT_DAEMON_AUTO_UPDATE" = "true" if c.auto_update else "false"
        "RELIANT_DAEMON_GATE_IMAGE" = c.gate_image
        "RELIANT_DAEMON_GATE_VULN_DB_DIR" = c.gate_vuln_db_dir

        # forge:section daemonConfigEnvMap values (end)
        # forge:hash=c922a7b192ca08b0f0c78b28936dd24fd784479238603c50532f5d76d94e64ac
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

