# forge:section schema ReliantConfigLog
# forge:hash=cd9198c1810c5ad83cb61c1b6289b7182745558521099bdec5096da7937cecde
# ReliantConfigLog is the log block (LogConfig) — author its values in config.k as `log.<field> = ...`.
schema ReliantConfigLog:
    # Log level: debug, info, warn or error (default info)
    level: str = ""
    # Log line format: text or json (default text; json for a hosted daemon)
    format: str = ""

# forge:section schema ReliantConfigRuntime
# forge:hash=69f4875cc56c8af5a357f9cc6106b652be353b4968835ae1aadee4afd5f7072a
# ReliantConfigRuntime is the runtime block (RuntimeConfig) — author its values in config.k as `runtime.<field> = ...`.
schema ReliantConfigRuntime:
    # Environment tier: dev, test or prod (unset or unrecognised is prod)
    environment: str = ""

# forge:section schema ReliantConfigStorageReaper
# forge:hash=b4e18cf3b0bf88753c86a2ea559d9f391528ec5f5be4193e6a46338e8f230a65
# ReliantConfigStorageReaper is the storage_reaper block (StorageReaperConfig) — author its values in config.k as `storage_reaper.<field> = ...`.
schema ReliantConfigStorageReaper:
    # Run forge's storage reaper on a schedule: auto (managed daemons only), on, or off
    mode: str = "auto"
    # Interval of the scheduled storage reaper pass (Go duration, minimum 5m)
    interval: str = "1h"
    # Minimum gap between storage reaper passes while a volume is under pressure (Go duration, minimum 1m)
    pressure_interval: str = "10m"
    # Forge machine storage policy file (default: <user config dir>/forge/storage.json)
    policy_path: str = ""
    # Interval of the Go-cache trim between full storage reaper passes (Go duration, minimum 2m; off disables)
    gocache_interval: str = "10m"

    check:
        mode != "", "mode = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER counts as unset, so it would load the default \"auto\" — set a value, or change its default in the proto"
        interval != "", "interval = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER_INTERVAL counts as unset, so it would load the default \"1h\" — set a value, or change its default in the proto"
        pressure_interval != "", "pressure_interval = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER_PRESSURE_INTERVAL counts as unset, so it would load the default \"10m\" — set a value, or change its default in the proto"
        gocache_interval != "", "gocache_interval = \"\" cannot reach the process: an empty RELIANT_STORAGE_REAPER_GOCACHE_INTERVAL counts as unset, so it would load the default \"10m\" — set a value, or change its default in the proto"

# forge:section schema ReliantConfig
# forge:hash=5c96513f68e099653458c57b858dec75348e8a463ec0fbb2d10bfdbc80e83d2b
schema ReliantConfig:
    # log config block (LogConfig). Set its fields as `log.<field> = ...`.
    log: ReliantConfigLog = ReliantConfigLog {}
    # runtime config block (RuntimeConfig). Set its fields as `runtime.<field> = ...`.
    runtime: ReliantConfigRuntime = ReliantConfigRuntime {}
    # storage_reaper config block (StorageReaperConfig). Set its fields as `storage_reaper.<field> = ...`.
    storage_reaper: ReliantConfigStorageReaper = ReliantConfigStorageReaper {}

