    # ClickStack replay sampling policy: `new-user-funnel` records a new user's first sessions in full. Unset: the default rate.
    otel_replay_sample_policy: str = ""
    # ClickStack replay sample rate, 0-1, overriding the policy.
    otel_replay_sample_rate: str = ""
    # Where the desktop and CLI downloads the UI links to are published.
    download_base_url: str = "https://downloads.reliantlabs.io"
    # "true": show the Experiments row in the forge console's nav (Forge Changes: remote config, gradual rollouts and A/B tests, components/Forge/Experiments). Unset: hidden, though /forge/p/<app>/experiments still opens. Set it once the control plane serves ChangesService.
