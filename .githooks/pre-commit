#!/bin/bash
# Pre-commit hook to format staged Go files
# Copyright (c) 2025 Reliant Labs

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit hooks...${NC}"

# Block commits that introduce locally-forbidden strings (patterns in the
# gitignored .forbidden-strings file; no-op if that file is absent).
"$(git rev-parse --show-toplevel)/.githooks/check-forbidden-strings.sh"

# Block commits that add compiled binaries or oversized blobs. CI enforces the
# same rule, because --no-verify skips everything here.
"$(git rev-parse --show-toplevel)/.githooks/check-binary-files.sh"

# Check if Makefile exists
if [ ! -f Makefile ]; then
    echo -e "${RED}Error: Makefile not found${NC}"
    exit 1
fi

# Get list of staged Go files before formatting
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

# Run make fmt to format code
echo -e "${YELLOW}Formatting code with 'make fmt'...${NC}"
if ! make fmt; then
    echo -e "${RED}Error: Code formatting failed${NC}"
    exit 1
fi

# Check if formatting created any changes
FORMATTED_FILES=$(git diff --name-only)
if [ -n "$FORMATTED_FILES" ]; then
    echo -e "${YELLOW}Code was reformatted. Re-staging formatted files...${NC}"
    
    # Re-stage only the files that were originally staged and got formatted
    for file in $FORMATTED_FILES; do
        # Check if this file was in our original staged list
        if echo "$STAGED_GO_FILES" | grep -q "^$file$"; then
            echo -e "  Re-staging: $file"
            git add "$file"
        else
            # File was modified but wasn't originally staged
            echo -e "${YELLOW}  Warning: $file was formatted but wasn't staged. Not auto-staging.${NC}"
        fi
    done
    
    # Check if there are still unstaged changes (files that were formatted but not originally staged)
    UNSTAGED_CHANGES=$(git diff --name-only)
    if [ -n "$UNSTAGED_CHANGES" ]; then
        echo -e "${YELLOW}Note: Some files were formatted but not originally staged:${NC}"
        echo "$UNSTAGED_CHANGES"
        echo -e "${YELLOW}These files were not automatically added to the commit.${NC}"
    fi
fi

echo -e "${GREEN}Pre-commit hooks completed successfully${NC}"
exit 0