# =============================================================================
# Supabase Configuration (Production)
# =============================================================================
# Get these values from your Supabase Dashboard:
# https://app.supabase.com → Your Project → Settings → API
#
# For local development with Supabase local:
#   1. Run: supabase start
#   2. Copy the values from the output
#   3. Use http://127.0.0.1:54331 as the URL
#
# For production:
#   1. Go to Supabase Dashboard → Settings → API
#   2. Copy Project URL (e.g., https://dash.reliantlabs.io if using custom domain)
#   3. Copy anon/public key and service_role key
#   4. Go to Settings → API → JWT Settings for JWT Secret

# Frontend Supabase Configuration (React/Vite)
# Note: These must be prefixed with VITE_ to be accessible in the browser
# Use the new publishable key format (sb_publishable_xxx) from Supabase Dashboard > API Keys
VITE_SUPABASE_URL=https://dash.reliantlabs.io
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# =============================================================================
# GitHub OAuth - TEMPORARILY DISABLED
# =============================================================================
# GitHub OAuth will be added after backend split using Cloudflare Worker
# This keeps the client secret secure on the server side
# See auth-worker/ directory and GITHUB_AUTH_SETUP.md when ready to enable
#
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth credentials (optional - currently disabled)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth credentials (optional - currently disabled)
# Create at https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_ID=your_apple_client_id
# APPLE_CLIENT_SECRET=your_apple_client_secret

# Electron Configuration
NODE_ENV=development
FRONTEND_PORT=5173

# Sentry Configuration
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

# Statsig (optional - analytics and feature flags)
# Client SDK key from https://console.statsig.com
STATSIG_CLIENT_KEY=

# =============================================================================
# Development Mode
# =============================================================================
# User ID to use in dev mode (bypasses auth). Get from your local database:
# sqlite3 ./data/reliant.db "SELECT DISTINCT user_id FROM chats LIMIT 1"
DEV_USER_ID=your-user-id-here
VITE_DEV_USER_ID=your-user-id-here

# API Configuration
VITE_API_URL=http://localhost:8080

# Frontend Sentry Configuration
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_SENTRY_ENABLED=true
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0

# =============================================================================
# Backend Database Runtime
# =============================================================================
# SQLite remains the default when DATABASE_DRIVER is unset.
# Set DATABASE_DRIVER=postgres to run the backend against Postgres.
# In local dev, scripts/dev.sh and scripts/dev.ps1 auto-create a per-worktree database
# on the shared local Postgres server and export DATABASE_URL automatically.
# DATABASE_DRIVER=sqlite
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/reliant_<repo>_<worktree>?sslmode=disable

# =============================================================================
# Supabase Edge Functions (set via `supabase secrets set` or Dashboard)
# =============================================================================
# These are NOT .env variables - they're set as Supabase secrets.
# For local dev: supabase secrets set RESEND_API_KEY=re_xxx
# For production: Supabase Dashboard → Edge Functions → Secrets
#
# RESEND_API_KEY=re_your_resend_api_key
# FEEDBACK_NOTIFICATION_EMAILS=team@example.com,alerts@example.com