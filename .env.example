# =============================================================================
# Auth Configuration
# =============================================================================
# Your auth provider URL (e.g., Supabase project URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth provider configuration (required for production)
RELIANT_AUTH_URL=
RELIANT_AUTH_KEY=
RELIANT_JWT_PUBLIC_KEY=
# Or use a JWKS endpoint (Supabase exposes one at <project-url>/auth/v1/.well-known/jwks.json):
# RELIANT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Auth mode: supabase (default), or apikey
# AUTH_MODE=apikey
# AUTH_API_KEY=rlnt_sk_your-secret-key-here

# Optional web onboarding shortcut. When true, unauthenticated Supabase users are
# signed in anonymously and can upgrade to a real email before billing-sensitive actions.
# VITE_AUTO_ANON_SIGN_IN=true

# =============================================================================
# GitHub OAuth - TEMPORARILY DISABLED
# =============================================================================
# GitHub OAuth will be added after backend split using Cloudflare Worker
# This keeps the client secret secure on the server side
# See auth-worker/ directory and GITHUB_AUTH_SETUP.md when ready to enable
#
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth credentials (optional - currently disabled)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth credentials (optional - currently disabled)
# Create at https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_ID=your_apple_client_id
# APPLE_CLIENT_SECRET=your_apple_client_secret

# Electron Configuration
NODE_ENV=development
FRONTEND_PORT=5173

# Sentry Configuration (optional — noop when DSN is empty)
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

# Statsig (optional - analytics and feature flags)
# Client SDK key from https://console.statsig.com
STATSIG_CLIENT_KEY=
VITE_STATSIG_CLIENT_KEY=

# API Configuration
VITE_API_URL=http://localhost:8080

# Frontend Sentry Configuration (optional — noop when DSN is empty)
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=true
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_CANVAS=false

# =============================================================================
# Backend Database Runtime
# =============================================================================
# SQLite remains the default when DATABASE_DRIVER is unset.
# Set DATABASE_DRIVER=postgres to run the backend against Postgres.
# In local dev, scripts/dev.sh and scripts/dev.ps1 auto-create a per-worktree database
# on the shared local Postgres server and export DATABASE_URL automatically.
# DATABASE_DRIVER=sqlite
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/reliant_<repo>_<worktree>?sslmode=disable

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins. Defaults to wildcard (*) in
# development (RELIANT_ENV=dev) and restrictive origins in production.
# CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# Control Plane API URL (admin-server)
VITE_CONTROL_PLANE_API_URL=http://localhost:8090

# GitHub OAuth (connect GitHub accounts for repo access)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=