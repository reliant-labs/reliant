# =============================================================================
# Reliant — example environment
# =============================================================================
# Copy to `.env` and adjust for your setup:  cp .env.example .env
#
# Vite loads .env files from the REPO ROOT (envDir, see web/vite.config.ts),
# so this file lives at the root, not in web/. Every VITE_-prefixed var is
# baked into the browser bundle at build time; non-VITE vars configure the Go
# backend / Electron host at runtime.
#
# Defaults here target a SELF-HOSTED / localhost stack. This OSS repo ships NO
# Reliant-hosted config — when no VITE_* values are provided the app builds as
# a neutral localhost app, never the Reliant-hosted deployment.
# =============================================================================

# =============================================================================
# API / gateway URLs (frontend, baked into the bundle)
# =============================================================================
# Reliant API server (reliant.v1.* RPCs).
VITE_API_URL=http://localhost:8080
# Optional explicit gRPC URL; falls back to VITE_API_URL when unset.
VITE_GRPC_URL=
# Local gRPC port used to build a localhost URL when no API/GRPC URL is set.
VITE_GRPC_PORT=9090
# Daemon gateway (native gRPC bidi). Separate host in cloud; falls back to
# VITE_API_URL when unset.
VITE_GATEWAY_URL=
# Control-plane admin-server (controlplane.v1.* RPCs, daemon registry/tokens).
VITE_CONTROL_PLANE_API_URL=http://localhost:8090
# Optional admin UI URL.
VITE_ADMIN_URL=
# Set "true" to use http/ws instead of https/wss (for plain-http localhost).
VITE_DISABLE_TLS=true

# =============================================================================
# Auth (frontend + backend)
# =============================================================================
# Auth provider URL + publishable client key (e.g. Supabase project URL).
# Defaults to a local Supabase (supabase start) when left empty.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Auth mode for the web app: leave unset for local dev-mode, or "cloud".
VITE_AUTH_MODE=
# Optional web onboarding shortcut: sign in unauthenticated users anonymously.
# VITE_AUTO_ANON_SIGN_IN=true

# Backend auth provider config (required when running a real auth provider).
RELIANT_AUTH_URL=
RELIANT_AUTH_KEY=
RELIANT_JWT_PUBLIC_KEY=
# Or a JWKS endpoint (Supabase exposes one at <url>/auth/v1/.well-known/jwks.json):
# RELIANT_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Auth mode: supabase (default) or apikey.
# AUTH_MODE=apikey
# AUTH_API_KEY=rlnt_sk_your-secret-key-here

# GitHub OAuth (connect GitHub accounts for repo access).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth state HMAC signing secret — REQUIRED in production. Long random string,
# distinct from GITHUB_CLIENT_SECRET. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# =============================================================================
# Observability (all optional — disabled when unset)
# =============================================================================
# Sentry error tracking. Empty DSN = no-op. Provide your OWN DSN to self-host
# error reporting; this OSS repo ships none.
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_CANVAS=false
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry trace exporter endpoint. Tracing is disabled when unset.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=

# Statsig (optional — analytics and feature flags).
STATSIG_CLIENT_KEY=
VITE_STATSIG_CLIENT_KEY=

# =============================================================================
# Downloads
# =============================================================================
# Base URL for desktop-app / CLI download links. Point this at your own host
# when self-hosting; otherwise the app uses its built-in default.
VITE_DOWNLOAD_BASE_URL=

# =============================================================================
# Electron host
# =============================================================================
NODE_ENV=development
FRONTEND_PORT=5173

# =============================================================================
# Backend database
# =============================================================================
# SQLite is the default when DATABASE_DRIVER is unset.
# Set DATABASE_DRIVER=postgres to run against Postgres.
# DATABASE_DRIVER=sqlite
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/reliant?sslmode=disable

# =============================================================================
# CORS
# =============================================================================
# Comma-separated allowed origins. Defaults to wildcard (*) in dev
# (RELIANT_ENV=dev) and restrictive origins in production.
# CORS_ALLOWED_ORIGINS=https://your-domain.example.com
