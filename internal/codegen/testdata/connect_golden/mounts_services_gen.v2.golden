// MountFunc is the TYPED mount signature every per-service Mount<Svc> satisfies
// as a METHOD EXPRESSION ((*Components).Mount<Svc>). The cli layer's Serve
// takes one of these directly — selection is compile-time typed, never a
// string→inventory lookup on the run path. m carries the shared chain
// (serverkit.ChainV2.NewMux). Returns the proto service names mounted (for
// the REST transcoder / completeness check).
type MountFunc func(c *Components, m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string

// MountOptions is per-service mount configuration: one field per service,
// holding the options that service's mount gets on top of the shared chain.
// The zero value gives every service the shared chain alone. Its methods are
// the mounts, each a MountFunc as a method value.
type MountOptions struct {
	Orders []mountkit.Option
	Billing []mountkit.Option
}

// MountOrders registers the orders service's Connect + HTTP routes
// on m, reading the constructed instance off c. Its Connect handlers are
// served behind m's interceptors (the shared chain) followed by those in
// o.Orders; its HTTP routes get o.Orders's HTTP stack, else
// the default. Returns its proto service name, so the method value
// o.MountOrders satisfies MountFunc.
func (o MountOptions) MountOrders(c *Components, m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string {
	r := mountkit.ResolveV2(fmw.HTTPStack(logger, middleware.ClaimsFromContext), o.Orders...)
	m.Register(c.Orders.RegisterV2, o.Orders...)
	c.Orders.RegisterHTTP(m.Mux(), r.HTTPStack)
	return []string{ ordersv1connect.OrdersServiceName }
}

// MountOrders mounts the orders service with no per-service
// options. The method expression (*Components).MountOrders satisfies
// MountFunc, so Serve can take it DIRECTLY — no string lookup.
func (c *Components) MountOrders(m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string {
	return MountOptions{}.MountOrders(c, m, cfg, logger)
}

// MountBilling registers the billing service's Connect + HTTP routes
// on m, reading the constructed instance off c. Its Connect handlers are
// served behind m's interceptors (the shared chain) followed by those in
// o.Billing; its HTTP routes get o.Billing's HTTP stack, else
// the default. Returns its proto service name, so the method value
// o.MountBilling satisfies MountFunc.
func (o MountOptions) MountBilling(c *Components, m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string {
	r := mountkit.ResolveV2(fmw.HTTPStack(logger, middleware.ClaimsFromContext), o.Billing...)
	m.Register(c.Billing.MountV2, o.Billing...)
	c.Billing.RegisterHTTP(m.Mux(), r.HTTPStack)
	c.Billing.RegisterWebhookRoutes(m.Mux(), r.HTTPStack)
	return []string{ billingv1connect.BillingServiceName }
}

// MountBilling mounts the billing service with no per-service
// options. The method expression (*Components).MountBilling satisfies
// MountFunc, so Serve can take it DIRECTLY — no string lookup.
func (c *Components) MountBilling(m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string {
	return MountOptions{}.MountBilling(c, m, cfg, logger)
}

// MountAll mounts every service on m, each with its options in o, via the
// typed per-service mounts — explicit, compile-time calls, NOT a loop over
// the data-only Inventory. Returns the proto service names of all mounted
// services.
func (o MountOptions) MountAll(c *Components, m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string {
	var mounted []string
	mounted = append(mounted, o.MountOrders(c, m, cfg, logger)...)
	mounted = append(mounted, o.MountBilling(c, m, cfg, logger)...)
	return mounted
}

// MountAll mounts every service with no per-service options. This is the
// run path for the `server` command. The method expression
// (*Components).MountAll satisfies MountFunc.
func (c *Components) MountAll(m *mountkit.MuxV2, cfg *config.Config, logger *slog.Logger) []string {
	return MountOptions{}.MountAll(c, m, cfg, logger)
}

