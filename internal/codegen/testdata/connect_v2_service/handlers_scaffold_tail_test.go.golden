// yours: scaffolded once, never touched again — forge will not overwrite this file.
// Rename it freely once it holds real tests (e.g. to rpc_tail_test.go, beside the handler), or delete it:
// .forge/scaffolded/ records that forge wrote it, so forge never writes it again, even if Tail is re-stubbed.
// ONE RPC PER FILE, no package-level identifiers, so two RPCs' owners never collide; CRUD RPCs are
// tested in handlers_crud_test.go.
// TestTail_Generated drives the stream through items.NewTestItemsServer's real Connect
// client. Its case is SELF-DESTRUCTING: it matches only forge's stub sentinel (not a bare CodeUnimplemented),
// so it fails once you implement Tail — replace it then. Depth: `forge skill load testing/patterns`.
package items_test

import (
	"context"
	"errors"
	"io"
	"testing"
	"time"

	connect "connectrpc.com/connect/v2"

	"github.com/reliant-labs/forge/pkg/tdd"

	pb "example.com/v2app/gen/services/items/v1"

	items "example.com/v2app/internal/handlers/items"
)

func TestTail_Generated(t *testing.T) {
	t.Parallel()

	// items.NewTestItemsServer serves the items *Service wired
	// with stubbed dependencies; pass items.WithItemsDeps(...) to
	// override one, or items.WithoutPrincipal() for an anonymous caller.
	_, client := items.NewTestItemsServer(t)

	t.Run("unimplemented_scaffold", func(t *testing.T) {
		// Delete this case once you implement Tail; it only asserts nobody has.
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		// The call's CallInfo carries the reason that identifies forge's stub
		// across the wire (a v2 error carries no metadata of its own).
		ctx, info := connect.NewClientContext(ctx)
		stream, err := client.Tail(ctx, &pb.TailRequest{})
		if err == nil {
			for {
				// A real case asserts on each received message here.
				if _, err = stream.Receive(); err != nil {
					break
				}
			}
			if errors.Is(err, io.EOF) {
				err = nil
			}
			_ = stream.Close()
		}
		tdd.AssertScaffoldStubV2(t, err, info)
	})
}
