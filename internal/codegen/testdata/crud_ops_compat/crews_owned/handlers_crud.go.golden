// CreateCrew delegates CRUD create to pkg/crud.
// Auth: SCOPED to company_id (forge:owner) via middleware.GetUser(ctx) — finish the FORGE_SCAFFOLD owner mapping below.
func (s *Service) CreateCrew(
	ctx context.Context,
	req *connect.Request[pb.CreateCrewRequest],
) (*connect.Response[pb.CreateCrewResponse], error) {
	claims, err := middleware.GetUser(ctx)
	if err != nil {
		return nil, err // connect.CodeUnauthenticated
	}
	// FORGE_SCAFFOLD: `claims.UserID` is forge's placeholder for the value of
	// Crew.company_id that belongs to this caller. Only your app
	// knows that mapping — replace the expression, then remove this comment.
	owner := claims.UserID
	op := s.crudCreateCrewOp()
	build := op.Entity
	op.Entity = func(ctx context.Context, r *pb.CreateCrewRequest) (*db.Crew, error) {
		e, err := build(ctx, r)
		if err != nil {
			return nil, err
		}
		// Stamped from the caller, never from the request: a create that
		// took company_id off the wire would let anyone file a row
		// under anyone else's name.
		e.CompanyID = owner
		return e, nil
	}
	resp, err := crud.HandleCreate(op)(ctx, req)
	metrics.RecordCreated(ctx, "Crew", err)
	return resp, err
}

// GetCrew delegates CRUD get to pkg/crud.
// Auth: SCOPED to company_id (forge:owner) via middleware.GetUser(ctx) — finish the FORGE_SCAFFOLD owner mapping below.
func (s *Service) GetCrew(
	ctx context.Context,
	req *connect.Request[pb.GetCrewRequest],
) (*connect.Response[pb.GetCrewResponse], error) {
	claims, err := middleware.GetUser(ctx)
	if err != nil {
		return nil, err // connect.CodeUnauthenticated
	}
	// FORGE_SCAFFOLD: `claims.UserID` is forge's placeholder for the value of
	// Crew.company_id that belongs to this caller. Only your app
	// knows that mapping — replace the expression, then remove this comment.
	owner := claims.UserID
	op := s.crudGetCrewOp()
	// Passed as a query option rather than compared after the fetch: a row
	// that is not this caller's is never read, and reports NotFound exactly
	// as an unknown id does. A distinguishable "exists but is not yours"
	// tells an attacker which ids are real.
	fetch := op.Fetch
	op.Fetch = func(ctx context.Context, id string, opts ...orm.QueryOption) (*db.Crew, error) {
		return fetch(ctx, id, append(opts, orm.WhereEq("company_id", owner))...)
	}
	return crud.HandleGet(op)(ctx, req)
}

// ListCrews delegates CRUD list to pkg/crud.
// Auth: SCOPED to company_id (forge:owner) via middleware.GetUser(ctx) — finish the FORGE_SCAFFOLD owner mapping below.
func (s *Service) ListCrews(
	ctx context.Context,
	req *connect.Request[pb.ListCrewsRequest],
) (*connect.Response[pb.ListCrewsResponse], error) {
	claims, err := middleware.GetUser(ctx)
	if err != nil {
		return nil, err // connect.CodeUnauthenticated
	}
	// FORGE_SCAFFOLD: `claims.UserID` is forge's placeholder for the value of
	// Crew.company_id that belongs to this caller. Only your app
	// knows that mapping — replace the expression, then remove this comment.
	owner := claims.UserID
	op := s.crudListCrewsOp()
	// The predicate goes in the QUERY, never on the returned page: Count runs
	// over these same opts, so a post-filtered page would report a total
	// including rows this caller may not see.
	filters := op.Filters // nil when the RPC declares no filter fields
	op.Filters = func(ctx context.Context, r *pb.ListCrewsRequest) ([]orm.QueryOption, error) {
		var opts []orm.QueryOption
		if filters != nil {
			var err error
			if opts, err = filters(ctx, r); err != nil {
				return nil, err
			}
		}
		return append(opts, orm.WhereEq("company_id", owner)), nil
	}
	return crud.HandleList(op)(ctx, req)
}

// UpdateCrew delegates CRUD update to pkg/crud.
// Auth: SCOPED to company_id (forge:owner) via middleware.GetUser(ctx) — finish the FORGE_SCAFFOLD owner mapping below.
// No update_mask field, so every Update is a whole-row write (op.ReadOnly columns are still kept); add one for AIP-134 partial updates.
func (s *Service) UpdateCrew(
	ctx context.Context,
	req *connect.Request[pb.UpdateCrewRequest],
) (*connect.Response[pb.UpdateCrewResponse], error) {
	claims, err := middleware.GetUser(ctx)
	if err != nil {
		return nil, err // connect.CodeUnauthenticated
	}
	// FORGE_SCAFFOLD: `claims.UserID` is forge's placeholder for the value of
	// Crew.company_id that belongs to this caller. Only your app
	// knows that mapping — replace the expression, then remove this comment.
	owner := claims.UserID
	op := s.crudUpdateCrewOp()
	// Two halves, and both are needed. The predicate is checked against the
	// STORED row, so a caller cannot take ownership by rewriting
	// company_id in the request they send; the stamp then keeps the
	// written row on the same owner, since a maskless update writes every
	// column of the submitted entity.
	build := op.Entity
	op.Entity = func(ctx context.Context, r *pb.UpdateCrewRequest) (*db.Crew, error) {
		e, err := build(ctx, r)
		if err != nil {
			return nil, err
		}
		e.CompanyID = owner
		return e, nil
	}
	persist := op.Persist
	op.Persist = func(ctx context.Context, e *db.Crew, opts ...orm.QueryOption) error {
		return persist(ctx, e, append(opts, orm.WhereEq("company_id", owner))...)
	}
	return crud.HandleUpdate(op)(ctx, req)
}

