func (s *Service) DeleteCrew(
	ctx context.Context,
	req *connect.Request[pb.DeleteCrewRequest],
) (*connect.Response[pb.DeleteCrewResponse], error) {
	claims, err := middleware.GetUser(ctx)
	if err != nil {
		return nil, err // connect.CodeUnauthenticated
	}
	// FORGE_SCAFFOLD: `claims.UserID` is forge's placeholder for the value of
	// Crew.company_id that belongs to this caller. Only your app
	// knows that mapping — replace the expression, then remove this comment.
	owner := claims.UserID
	op := s.crudDeleteCrewOp()
	// Scoped like Get: a row that is not this caller's is not deleted, and
	// the absent-row check reports NotFound.
	del := op.Persist
	op.Persist = func(ctx context.Context, id string, opts ...orm.QueryOption) error {
		return del(ctx, id, append(opts, orm.WhereEq("company_id", owner))...)
	}
	return crud.HandleDelete(op)(ctx, req)
}
