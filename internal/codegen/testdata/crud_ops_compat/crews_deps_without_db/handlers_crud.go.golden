}

// UpdateCrew delegates CRUD update to pkg/crud.
// Auth: AUTHENTICATED, UNSCOPED — nothing reads the caller; scope with middleware.GetUser(ctx) (see file header).
// No update_mask field, so every Update is a whole-row write (op.ReadOnly columns are still kept); add one for AIP-134 partial updates.
func (s *Service) UpdateCrew(
	ctx context.Context,
	req *connect.Request[pb.UpdateCrewRequest],
) (*connect.Response[pb.UpdateCrewResponse], error) {
	return crud.HandleUpdate(s.crudUpdateCrewOp())(ctx, req)
}

// DeleteCrew delegates CRUD delete to pkg/crud.
// Auth: AUTHENTICATED, UNSCOPED — nothing reads the caller; scope with middleware.GetUser(ctx) (see file header).
func (s *Service) DeleteCrew(
