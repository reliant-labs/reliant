                  {
                    "patch": "apiVersion: apiextensions.k8s.io/v1\nkind: CustomResourceDefinition\nmetadata:\n  name: all\n  annotations:\n    fluxcd.controlplane.io/prune: disabled\n",
                    "target": {
                      "kind": "CustomResourceDefinition"
                    }
                  },
                  {
                    "patch": "apiVersion: v1\nkind: Namespace\nmetadata:\n  name: flux-system\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: latest\n    pod-security.kubernetes.io/warn: restricted\n    pod-security.kubernetes.io/audit: restricted\n",
                    "target": {
                      "kind": "Namespace",
                      "name": "^flux-system$"
                    }
                  },
                  {
                    "patch": "- op: replace\n  path: /spec/template/spec/containers/0/args\n  value:\n  - '--watch-all-namespaces=true'\n  - '--log-level=info'\n  - '--log-encoding=json'\n  - '--enable-leader-election'\n  - '--no-remote-bases=true'\n  - '--no-cross-namespace-refs=true'\n  - '--default-service-account=forge-delivery-none'\n  - '--concurrent=16'\n  - '--concurrent-ssa=8'\n  - '--requeue-dependency=10s'\n  - '--feature-gates=CancelHealthCheckOnNewRevision=true,DisableConfigWatchers=true'\n",
                    "target": {
                      "kind": "Deployment",
                      "name": "^kustomize-controller$"
                    }
                  },
                  {
                    "patch": "- op: replace\n  path: /spec/template/spec/containers/0/args\n  value:\n  - '--watch-all-namespaces=true'\n  - '--log-level=info'\n  - '--log-encoding=json'\n  - '--enable-leader-election'\n  - '--storage-path=/data'\n  - '--storage-adv-addr=source-controller.$(RUNTIME_NAMESPACE).svc.cluster.local.'\n  - '--concurrent=8'\n",
                    "target": {
                      "kind": "Deployment",
                      "name": "^source-controller$"
                    }
                  },
                  {
                    "patch": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: kustomize-controller\nspec:\n  template:\n    spec:\n      enableServiceLinks: false\n      containers:\n      - name: manager\n        resources:\n          requests:\n            cpu: '500m'\n            memory: '512Mi'\n          limits:\n            cpu: '2'\n            memory: '2Gi'\n      priorityClassName: forge-delivery\n",
                    "target": {
                      "kind": "Deployment",
                      "name": "^kustomize-controller$"
