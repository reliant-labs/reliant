                  {
                    "patch": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: source-controller\nspec:\n  template:\n    spec:\n      enableServiceLinks: false\n      containers:\n      - name: manager\n        resources:\n          requests:\n            cpu: '250m'\n            memory: '256Mi'\n          limits:\n            cpu: '1'\n            memory: '1Gi'\n      priorityClassName: forge-delivery\n",
                    "target": {
                      "kind": "Deployment",
                      "name": "^source-controller$"
                    }
                  },
                  {
                    "patch": "$patch: delete\napiVersion: rbac.authorization.k8s.io/v1\nkind: ClusterRoleBinding\nmetadata:\n  name: all\n",
                    "target": {
                      "kind": "ClusterRoleBinding",
