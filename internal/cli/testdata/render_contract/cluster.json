    "manifests": [
      {
        "apiVersion": "v1",
        "kind": "Namespace",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev",
            "pod-security.kubernetes.io/audit": "restricted",
            "pod-security.kubernetes.io/enforce": "restricted",
            "pod-security.kubernetes.io/warn": "restricted"
          },
          "name": "acme-dev"
        }
      },
      {
        "apiVersion": "forge.dev/v1alpha1",
        "kind": "Workload",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "app.kubernetes.io/name": "api",
            "app.kubernetes.io/part-of": "acme",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev"
          },
          "name": "api",
          "namespace": "acme-dev"
        },
        "spec": {
          "args": [
            "api"
          ],
          "env": [
            {
              "name": "LOG_LEVEL",
              "value": "info"
            },
            {
              "name": "API_KEY",
              "secretRef": {
                "key": "api_key",
                "name": "acme-secrets",
                "optional": true
              }
            },
            {
              "fieldRef": {
                "fieldPath": "metadata.name"
              },
              "name": "POD_NAME"
            },
            {
              "name": "OTEL_SERVICE_NAME",
              "value": "api"
            },
            {
              "name": "OTEL_RESOURCE_ATTRIBUTES",
              "value": "deployment.environment.name=dev,service.namespace=acme"
            },
            {
              "name": "GOMEMLIMIT",
              "value": "921MiB"
            }
          ],
          "image": "localhost:5050/acme:latest",
          "kind": "service",
          "ports": [
            {
              "expose": true,
              "name": "http",
              "port": 8080,
              "protocol": "tcp"
            }
          ],
          "probes": {
            "failureThreshold": 3,
            "initialDelaySeconds": 0,
            "livenessPath": "/healthz",
            "periodSeconds": 5,
            "port": 8080,
            "readinessPath": "/readyz",
            "startupPath": "/readyz",
            "timeoutSeconds": 3
          },
          "replicas": 2,
          "resources": {
            "cpuRequestMillicores": 250,
            "memoryRequestBytes": 1073741824
          }
        }
      },
      {
        "apiVersion": "forge.dev/v1alpha1",
        "kind": "Workload",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "app.kubernetes.io/name": "migrate",
            "app.kubernetes.io/part-of": "acme",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev"
          },
          "name": "migrate",
          "namespace": "acme-dev"
        },
        "spec": {
          "args": [
            "db",
            "migrate",
            "up"
          ],
          "before": [
            "*"
          ],
          "env": [
            {
              "name": "OTEL_SERVICE_NAME",
              "value": "migrate"
            },
            {
              "name": "OTEL_RESOURCE_ATTRIBUTES",
              "value": "deployment.environment.name=dev,service.namespace=acme"
            },
            {
              "name": "GOMEMLIMIT",
              "value": "921MiB"
            }
          ],
          "image": "localhost:5050/acme:latest",
          "kind": "job",
          "replicas": 1,
          "resources": {
            "cpuRequestMillicores": 250,
            "memoryRequestBytes": 1073741824
          }
        }
      },
      {
        "apiVersion": "forge.dev/v1alpha1",
        "kind": "Workload",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "app.kubernetes.io/name": "nightly",
            "app.kubernetes.io/part-of": "acme",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev"
          },
          "name": "nightly",
          "namespace": "acme-dev"
        },
        "spec": {
          "args": [
            "sweep"
          ],
          "env": [
            {
              "name": "OTEL_SERVICE_NAME",
              "value": "nightly"
            },
            {
              "name": "OTEL_RESOURCE_ATTRIBUTES",
              "value": "deployment.environment.name=dev,service.namespace=acme"
            },
            {
              "name": "GOMEMLIMIT",
              "value": "921MiB"
            }
          ],
          "image": "localhost:5050/acme:latest",
          "kind": "cron",
          "namespacedRBAC": [
            {
              "apiGroups": [
                ""
              ],
              "resources": [
                "configmaps"
              ],
              "verbs": [
                "list",
                "delete"
              ]
            }
          ],
          "replicas": 1,
          "resources": {
            "cpuRequestMillicores": 250,
            "memoryRequestBytes": 1073741824
          },
          "schedule": "@daily"
        }
      },
      {
        "apiVersion": "forge.dev/v1alpha1",
        "kind": "Workload",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "app.kubernetes.io/name": "nats",
            "app.kubernetes.io/part-of": "acme",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev"
          },
          "name": "nats",
          "namespace": "acme-dev"
        },
        "spec": {
          "env": [
            {
              "name": "OTEL_SERVICE_NAME",
              "value": "nats"
            },
            {
              "name": "OTEL_RESOURCE_ATTRIBUTES",
              "value": "deployment.environment.name=dev,service.namespace=acme"
            }
          ],
          "image": "docker.io/library/nats:2.10",
          "kind": "service",
          "ports": [
            {
              "name": "client",
              "port": 4222,
              "protocol": "tcp"
            }
          ],
          "replicas": 1,
          "resources": {
            "cpuRequestMillicores": 250,
            "memoryRequestBytes": 1073741824
          }
        }
      },
      {
        "apiVersion": "forge.dev/v1alpha1",
        "kind": "Workload",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "app.kubernetes.io/name": "workspace",
            "app.kubernetes.io/part-of": "acme",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev"
          },
          "name": "workspace",
          "namespace": "acme-dev"
        },
        "spec": {
          "args": [
            "workspace-controller"
          ],
          "clusterRBAC": [
            {
              "apiGroups": [
                "acme.dev"
              ],
              "resources": [
                "workspaces"
              ],
              "verbs": [
                "get",
                "list",
                "watch"
              ]
            }
          ],
          "crds": [
            "Workspace"
          ],
          "env": [
            {
              "name": "OTEL_SERVICE_NAME",
              "value": "workspace"
            },
            {
              "name": "OTEL_RESOURCE_ATTRIBUTES",
              "value": "deployment.environment.name=dev,service.namespace=acme"
            },
            {
              "name": "GOMEMLIMIT",
              "value": "921MiB"
            }
          ],
          "image": "localhost:5050/acme:latest",
          "kind": "operator",
          "leaderElection": true,
          "replicas": 1,
          "resources": {
            "cpuRequestMillicores": 250,
            "memoryRequestBytes": 1073741824
          }
        }
      },
      {
        "apiVersion": "forge.dev/v1alpha1",
        "kind": "ManagedDatabase",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "forge",
            "app.kubernetes.io/name": "db",
            "app.kubernetes.io/part-of": "acme",
            "forge.dev/cluster": "k3d-acme",
            "forge.dev/env": "dev"
          },
          "name": "db",
          "namespace": "acme-dev"
        },
        "spec": {
          "deletionPolicy": "retain",
          "engine": "postgres",
          "instances": 1,
          "storageGiB": 10
        }
      }
    ],
    "network_policy": {
      "egress_ports": [
        443,
        5432
      ],
      "ingress_namespace": "",
      "telemetry_namespace": ""
    },
    "overrides": {},
    "project": "acme",
    "release_manifest_consumers": [],
    "rendered_secrets": [],
    "required_dns": [],
    "required_secrets": [],
    "runtime_classes": [],
    "secret_provider": {
      "path": "secrets/dev.yaml",
      "type": "file"
    },
    "telemetry": [
      {
        "address": "",
        "attachment": "manageddatabase",
        "checks": [
          {
            "interval": "30s",
            "kind": "tcp",
            "name": "",
            "path": "/",
            "port": 0,
            "port_name": "postgres",
            "scheme": "http"
          }
        ],
        "cluster": "k3d-acme",
        "container": "postgres",
        "dashboard": {
          "enabled": true,
          "title": ""
        },
        "dashboards": [
          {
            "description": "The CloudNativePG instances of the managed database db: availability, connections, size, throughput, replication, WAL archiving and backups. Its logs, scrape health and resources are on its system dashboard.",
            "filters": [
              {
                "field": "deployment.environment.name",
                "id": "env",
                "label": "deployment.environment.name"
              }
            ],
            "group": "platform",
            "id": "db-postgres",
            "panels": [
              {
                "description": "1 while the instance accepts queries, 0 when it does not. One line per instance.",
                "groupBy": [
                  "resource.attr.service.instance.id"
                ],
                "height": 7,
                "id": "up",
                "kind": "line",
                "section": "health",
                "series": [
                  {
                    "agg": "min",
                    "field": "cnpg_collector_up",
                    "label": "up",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Postgres up",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Backends by state (active, idle, idle in transaction). Idle in transaction holds locks and blocks vacuum.",
                "groupBy": [
                  "metric.attr.state"
                ],
                "height": 7,
                "id": "connections",
                "kind": "line",
                "section": "health",
                "series": [
                  {
                    "agg": "sum",
                    "field": "cnpg_backends_total",
                    "label": "backends",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Connections by state",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Queries blocked behind another backend's lock.",
                "height": 7,
                "id": "waiting",
                "kind": "line",
                "section": "health",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_backends_waiting_total",
                    "label": "waiting",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Backends waiting on locks",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "The oldest transaction still open. Long ones hold back vacuum and bloat the tables.",
                "height": 7,
                "id": "longest-tx",
                "kind": "line",
                "section": "health",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_backends_max_tx_duration_seconds",
                    "label": "seconds",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Longest open transaction",
                "unit": "s",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Disk used by each database.",
                "groupBy": [
                  "metric.attr.datname"
                ],
                "height": 7,
                "id": "size",
                "kind": "line",
                "section": "load",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_pg_database_size_bytes",
                    "label": "size",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Database size",
                "unit": "bytes",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Commits and rollbacks per second, all databases.",
                "height": 7,
                "id": "transactions",
                "kind": "line",
                "section": "load",
                "series": [
                  {
                    "agg": "rate",
                    "field": "cnpg_pg_stat_database_xact_commit",
                    "label": "commits",
                    "metricType": "sum"
                  },
                  {
                    "agg": "rate",
                    "field": "cnpg_pg_stat_database_xact_rollback",
                    "label": "rollbacks",
                    "metricType": "sum"
                  }
                ],
                "signal": "metrics",
                "title": "Transactions / s",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Deadlocks Postgres detected and broke by cancelling a transaction.",
                "groupBy": [
                  "metric.attr.datname"
                ],
                "height": 7,
                "id": "deadlocks",
                "kind": "line",
                "section": "load",
                "series": [
                  {
                    "agg": "rate",
                    "field": "cnpg_pg_stat_database_deadlocks",
                    "label": "deadlocks",
                    "metricType": "sum"
                  }
                ],
                "signal": "metrics",
                "title": "Deadlocks / s",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Transactions since each database's oldest unfrozen XID. Postgres stops accepting writes near 2 billion; autovacuum should keep it far below.",
                "groupBy": [
                  "metric.attr.datname"
                ],
                "height": 7,
                "id": "xid-age",
                "kind": "line",
                "section": "load",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_pg_database_xid_age",
                    "label": "xid age",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Transaction ID age",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "How far each replica's replay is behind the primary. 0 on the primary.",
                "groupBy": [
                  "resource.attr.service.instance.id"
                ],
                "height": 7,
                "id": "replication-lag",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_pg_replication_lag",
                    "label": "lag",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Replication lag",
                "unit": "s",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Replicas streaming from the primary.",
                "height": 7,
                "id": "replicas",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_pg_replication_streaming_replicas",
                    "label": "replicas",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Streaming replicas",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "The size of pg_wal. It grows when archiving or a replica falls behind.",
                "groupBy": [
                  "resource.attr.service.instance.id"
                ],
                "height": 7,
                "id": "wal-size",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_collector_pg_wal",
                    "label": "wal",
                    "metricType": "gauge",
                    "where": [
                      {
                        "field": "metric.attr.value",
                        "op": "eq",
                        "value": "size"
                      }
                    ]
                  }
                ],
                "signal": "metrics",
                "title": "WAL on disk",
                "unit": "bytes",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Segments marked ready but not yet archived. A growing count means archiving is failing or slow.",
                "groupBy": [
                  "resource.attr.service.instance.id"
                ],
                "height": 7,
                "id": "wal-ready",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_collector_pg_wal_archive_status",
                    "label": "ready",
                    "metricType": "gauge",
                    "where": [
                      {
                        "field": "metric.attr.value",
                        "op": "eq",
                        "value": "ready"
                      }
                    ]
                  }
                ],
                "signal": "metrics",
                "title": "WAL waiting to be archived",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Failed attempts to archive a WAL segment to the backup store.",
                "height": 7,
                "id": "archive-failures",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "rate",
                    "field": "cnpg_pg_stat_archiver_failed_count",
                    "label": "failed",
                    "metricType": "sum"
                  }
                ],
                "signal": "metrics",
                "title": "WAL archive failures / s",
                "unit": "count",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Seconds since a WAL segment was last archived. -1 before the first.",
                "height": 7,
                "id": "archive-age",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "max",
                    "field": "cnpg_pg_stat_archiver_seconds_since_last_archival",
                    "label": "seconds",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Time since last archived WAL",
                "unit": "s",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 12
              },
              {
                "description": "Unix time of the newest base backup in the store, as the Barman Cloud plugin reports it (the instance's own series on older operators). It steps up at every scheduled backup; a flat line is a backup that stopped.",
                "height": 7,
                "id": "last-backup",
                "kind": "line",
                "section": "durability",
                "series": [
                  {
                    "agg": "max",
                    "field": "barman_cloud_cloudnative_pg_io_last_available_backup_timestamp",
                    "label": "plugin",
                    "metricType": "gauge"
                  },
                  {
                    "agg": "max",
                    "field": "cnpg_collector_last_available_backup_timestamp",
                    "label": "instance",
                    "metricType": "gauge"
                  }
                ],
                "signal": "metrics",
                "title": "Last backup",
                "unit": "s",
                "where": [
                  {
                    "field": "service.name",
                    "op": "eq",
                    "value": "db-postgres"
                  }
                ],
                "width": 24
              }
            ],
            "sections": [
              {
                "id": "health",
                "title": "Health"
              },
              {
                "id": "load",
                "title": "Load"
              },
              {
                "id": "durability",
                "title": "Replication, WAL and backups"
              }
            ],
            "tags": [
              "postgres",
              "database"
            ],
            "title": "Postgres: db"
          }
        ],
        "default_alerts": true,
        "isolated": false,
        "logs": {
          "body": "record.message",
          "drop": [],
          "format": "json",
          "regex": "",
          "rules": [
            {
              "body_match": "",
              "field": "level",
              "from_severity": "",
              "severity": "error",
              "value_match": "^error$"
            },
            {
              "body_match": "",
              "field": "level",
              "from_severity": "",
              "severity": "warn",
              "value_match": "^warning$"
            },
            {
              "body_match": "",
              "field": "level",
              "from_severity": "",
              "severity": "debug",
              "value_match": "^(debug|trace)$"
            }
          ],
          "severity": {
            "field": "record.error_severity",
            "mapping": {
              "debug": [
                "DEBUG1",
                "DEBUG2",
                "DEBUG3",
                "DEBUG4",
                "DEBUG5"
              ],
              "error": [
                "ERROR"
              ],
              "fatal": [
                "FATAL",
                "PANIC"
              ],
              "info": [
                "LOG",
                "INFO",
                "NOTICE"
              ],
              "warn": [
                "WARNING"
              ]
            }
          },
          "span_id": "",
          "timestamp": {
            "field": "ts",
            "layout": "rfc3339"
          },
          "trace_id": ""
        },
        "metrics": [
          {
