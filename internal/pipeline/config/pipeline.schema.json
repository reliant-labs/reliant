{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reliant .reliant/pipeline.yaml, version 1",
  "description": "The Reliant pipeline configuration, read only from the repository's base branch. Reliant's parser is the authority: this schema mirrors it for editors, and cannot check uniqueness across entries, duration and count bounds, cron lines, regular expressions or CEL syntax. Nor can it see YAML keys: Reliant refuses a key written twice in any mapping and a key that is not a string (true:, 1:, null:), which JSON cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gate"],
  "dependentRequired": { "regen": ["generated"] },
  "properties": {
    "version": { "const": 1, "description": "The format version. Only 1 exists." },
    "check": {
      "description": "Optional fast tier run on each PR head on push: a command, or {run, checks}.",
      "oneOf": [{ "$ref": "#/$defs/command" }, { "$ref": "#/$defs/Check" }]
    },
    "gate": {
      "description": "The gate every batch candidate must pass before it lands: the test stage's command (the full suite), or {run, stages, runner, pool, timeout, checks, env, infra_patterns, infra_patterns_file, allow_unisolated}.",
      "oneOf": [{ "$ref": "#/$defs/command" }, { "$ref": "#/$defs/Gate" }]
    },
    "generated": {
      "description": "Globs of generated files, relative to the repository root.",
      "type": "array",
      "items": { "$ref": "#/$defs/glob" }
    },
    "regen": { "$ref": "#/$defs/command", "description": "Regenerates the generated files. Requires generated." },
    "owner_approval": { "type": "array", "items": { "$ref": "#/$defs/OwnerApproval" } },
    "pins": { "type": "array", "items": { "$ref": "#/$defs/Pin" } },
    "consumers": { "type": "array", "items": { "$ref": "#/$defs/Consumer" } },
    "queue": { "$ref": "#/$defs/Queue" },
    "review": { "$ref": "#/$defs/Review" },
    "fix": { "$ref": "#/$defs/Fix" },
    "flake": { "$ref": "#/$defs/Flake" },
    "release": { "$ref": "#/$defs/Release" },
    "recurring": { "type": "array", "items": { "$ref": "#/$defs/RecurringJob" } },
    "sweep": { "$ref": "#/$defs/Sweep" },
    "playbooks": {
      "description": "Prompt file per incident source, overriding the responder's built-in prompt.",
      "type": "object",
      "propertyNames": {
        "enum": ["main", "release", "prod_alert", "obs_issue", "nightly", "flake", "infra", "recurring"]
      },
      "additionalProperties": { "$ref": "#/$defs/relPath" }
    }
  },
  "$defs": {
    "command": { "type": "string", "pattern": "\\S", "description": "A shell command run from the repository root." },
    "duration": {
      "type": "string",
      "pattern": "^(0|([0-9]+(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
      "description": "A duration with a unit, such as 60m or 1h30m."
    },
    "schedule": {
      "type": "string",
      "description": "A 5-field cron line in UTC (\"0 6 * * *\") or \"every <duration>\".",
      "pattern": "^\\s*(every\\s+\\S+|\\S+(\\s+\\S+){4})\\s*$",
      "not": { "pattern": "if main moved" }
    },
    "releaseSchedule": {
      "type": "string",
      "description": "A 5-field cron line in UTC or \"every <duration>\", optionally followed by \" if main moved\". Default \"every 2h if main moved\".",
      "pattern": "^\\s*(every\\s+\\S+|\\S+(\\s+\\S+){4})(\\s+if\\s+main\\s+moved)?\\s*$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$",
      "description": "A GitHub repository as owner/name."
    },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
    "relPath": {
      "type": "string",
      "description": "A repository-relative path with / separators.",
      "pattern": "^([^/\\\\]+/)*[^/\\\\]+$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
    },
    "glob": {
      "type": "string",
      "pattern": "\\S",
      "description": "A doublestar glob relative to the repository root.",
      "not": { "anyOf": [{ "pattern": "^/" }, { "pattern": "(^|/)\\.\\.(/|$)" }] }
    },
    "checkNames": {
      "type": "array",
      "description": "GitHub check run names.",
      "items": { "type": "string", "pattern": "\\S" },
      "uniqueItems": true
    },
    "Check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": { "$ref": "#/$defs/command" },
        "checks": { "$ref": "#/$defs/checkNames" }
      },
      "anyOf": [{ "required": ["run"] }, { "required": ["checks"] }]
    },
    "Gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/command",
          "description": "The test stage's command, the full suite: exit 0 pass, 1 fail, 2 unproven. The same as stages.test.run; write one of them."
        },
        "stages": { "$ref": "#/$defs/Stages" },
        "runner": {
          "enum": ["machine", "checks"],
          "description": "machine (default when run is set): an isolated gate machine; checks: only wait for GitHub check runs."
        },
        "pool": { "$ref": "#/$defs/name", "description": "Gate machine pool. Default gate." },
        "timeout": { "$ref": "#/$defs/duration", "description": "Default 60m, 1m to 6h." },
        "checks": { "$ref": "#/$defs/checkNames" },
        "env": {
          "type": "object",
          "description": "Non-secret environment variables for the gate. Never put a secret here.",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": { "pattern": "^RELIANT_" } },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "infra_patterns": {
          "type": "array",
          "description": "Regular expressions over failing step logs that mark a failure as infra.",
          "items": { "type": "string", "minLength": 1 }
        },
        "infra_patterns_file": { "$ref": "#/$defs/relPath" },
        "allow_unisolated": {
          "type": "boolean",
          "description": "Let a batch land on a gate that ran outside an isolation boundary (plain runc), until isolated gate machines exist. Default false: such a gate never lands."
        }
      },
      "anyOf": [{ "required": ["run"] }, { "$ref": "#/$defs/testStageWritten" }, { "required": ["checks"] }],
      "not": { "required": ["run", "stages"], "properties": { "stages": { "required": ["test"] } } },
      "allOf": [
        {
          "if": { "required": ["runner"], "properties": { "runner": { "const": "checks" } } },
          "then": {
            "required": ["checks"],
            "not": {
              "anyOf": [{ "required": ["run"] }, { "required": ["pool"] }, { "required": ["env"] }, { "required": ["stages"] }]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["runner"], "properties": { "runner": { "const": "machine" } } },
              { "required": ["stages"], "not": { "required": ["runner"] } }
            ]
          },
          "then": { "anyOf": [{ "required": ["run"] }, { "$ref": "#/$defs/testStageWritten" }] }
        }
      ]
    },
    "testStageWritten": {
      "description": "gate.stages.test is written: a command, or off.",
      "required": ["stages"],
      "properties": { "stages": { "required": ["test"] } }
    },
    "Stages": {
      "type": "object",
      "additionalProperties": false,
      "description": "The gate's built-in stages, always run in the order lint, test, build, sbom_scan. A stage not written keeps its detected default (forge: reliant forge lint, task ci:full or task test, reliant forge env build of the release chain's first env without pushing, forge's SBOM and scan under the env's vuln_gate; Go: go vet ./..., go test ./..., go build ./..., an SBOM and scan under forge's default vuln_gate; Node: npm run lint, npm test, npm run build, the same scan). Turning a stage off is a recorded setting change, and the stage shows as off on every report, never as passed. Machine runner only.",
      "properties": {
        "lint": { "$ref": "#/$defs/stage" },
        "test": { "$ref": "#/$defs/stage" },
        "build": { "$ref": "#/$defs/stage" },
        "sbom_scan": { "$ref": "#/$defs/stage" }
      },
      "not": {
        "required": ["lint", "test", "build", "sbom_scan"],
        "properties": {
          "lint": { "const": "off" },
          "test": { "const": "off" },
          "build": { "const": "off" },
          "sbom_scan": { "const": "off" }
        }
      }
    },
    "stage": {
      "description": "{run: <command>} replaces the stage's command (exit 0 pass, 1 fail, 2 unproven); off turns the stage off. No other string: a command goes in run.",
      "oneOf": [{ "const": "off" }, { "$ref": "#/$defs/Stage" }]
    },
    "Stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": { "run": { "$ref": "#/$defs/command" } }
    },
    "OwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["approve_breaking_proto", "approve_breaks_rollback", "approve_prod_fix"] },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/glob" } },
        "when_cmd": { "$ref": "#/$defs/command" },
        "when": { "type": "string", "pattern": "\\S", "maxLength": 200, "description": "A CEL expression." }
      }
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": {
        "repo": { "$ref": "#/$defs/repo" },
        "file": { "$ref": "#/$defs/relPath" },
        "bump": {
          "$ref": "#/$defs/command",
          "description": "Moves the pin. {owner/name} placeholders are replaced by the sha being pinned."
        },
        "lockstep_with": { "type": "array", "items": { "$ref": "#/$defs/repo" }, "uniqueItems": true }
      }
    },
    "Consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "command"],
      "properties": {
        "repo": { "$ref": "#/$defs/repo" },
        "mode": { "enum": ["advisory", "required"], "description": "Default advisory." },
        "command": { "$ref": "#/$defs/command", "description": "{candidate} is the producer candidate's sha." }
      }
    },
    "Queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_max": { "type": "integer", "minimum": 1, "maximum": 16, "description": "Default 4." },
        "speculate": { "type": "integer", "minimum": 0, "maximum": 4, "description": "Default 0." },
        "rerun_on_red": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Default 1." },
        "preempt": { "type": "boolean", "description": "Default false." }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "max_rounds": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Default 3." } }
    },
    "Fix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts_per_signature": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Default 3." }
      }
    },
    "Flake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["quarantine", "delete"], "description": "Default quarantine." },
        "quarantine_days": { "type": "integer", "minimum": 1, "maximum": 7, "description": "Default 7." }
      }
    },
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present (even as {}): releases are on.",
      "properties": {
        "schedule": { "$ref": "#/$defs/releaseSchedule" },
        "on_land": { "type": "boolean", "description": "Also release after every landed batch. Default false." },
        "pool": { "$ref": "#/$defs/name" },
        "envs": {
          "type": "array",
          "minItems": 1,
          "description": "The promotion chain in order. Omitted: the project's forge HealthGate order.",
          "items": { "$ref": "#/$defs/ReleaseEnv" }
        },
        "on_fail": { "enum": ["rollback", "hold", "fix_forward"], "description": "Default rollback." }
      }
    },
    "ReleaseEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "soak": { "$ref": "#/$defs/duration", "description": "At least the env's release_health after window." },
        "approval": {
          "enum": ["project_setting", "none", "required"],
          "description": "Default project_setting: the project's release approval setting (prod only unless changed)."
        },
        "early_pass": { "$ref": "#/$defs/duration" },
        "inconclusive": {
          "enum": ["probes"],
          "description": "What an inconclusive obs check (too little traffic) means. probes (the default, and the only value): the env's probes judge it."
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "description": "Probes that judge an inconclusive check. Default: every built-in (health, synthetic).",
          "items": { "oneOf": [{ "$ref": "#/$defs/probeBuiltin" }, { "$ref": "#/$defs/Probe" }] }
        },
        "strategy": { "$ref": "#/$defs/Strategy" }
      }
    },
    "probeBuiltin": { "enum": ["health", "synthetic"] },
    "Probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "{name: <built-in>} is that built-in probe, the same as the bare name. {name, run} is a repo command probe (exit 0 when the env is healthy), whose name is not a built-in's.",
      "properties": {
        "name": { "type": "string" },
        "run": { "$ref": "#/$defs/command" }
      },
      "if": { "required": ["run"] },
      "then": { "properties": { "name": { "$ref": "#/$defs/name", "not": { "$ref": "#/$defs/probeBuiltin" } } } },
      "else": { "properties": { "name": { "$ref": "#/$defs/probeBuiltin" } } }
    },
    "Strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "all_at_once",
          "description": "all_at_once is the only strategy available. canary is reserved until a runtime implements traffic splitting."
        },
        "steps": { "type": "array", "maxItems": 0, "description": "Canary traffic weights; reserved." }
      }
    },
    "RecurringJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schedule"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "prompt": { "$ref": "#/$defs/relPath", "description": "A prompt file: an agent job." },
        "run": { "$ref": "#/$defs/command", "description": "A command: a job with no model." },
        "output": { "enum": ["pr", "incident", "report", "none"], "description": "Default report." },
        "max_prs": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Output pr only. Default 1." },
        "tools": { "type": "array", "items": { "type": "string", "pattern": "\\S" }, "uniqueItems": true },
        "timeout": { "$ref": "#/$defs/duration", "description": "Default 60m, 1m to 12h." }
      },
      "oneOf": [{ "required": ["prompt"] }, { "required": ["run"] }],
      "dependentSchemas": {
        "max_prs": { "required": ["output"], "properties": { "output": { "const": "pr" } } },
        "tools": { "required": ["prompt"] }
      }
    },
    "Sweep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": { "$ref": "#/$defs/schedule", "description": "Default \"0 6 * * *\"." },
        "checks": {
          "type": "array",
          "description": "Replaces the default (every built-in check).",
          "items": { "oneOf": [{ "$ref": "#/$defs/sweepBuiltin" }, { "$ref": "#/$defs/SweepCheck" }] }
        }
      }
    },
    "sweepBuiltin": {
      "enum": [
        "stale_needs_person",
        "stale_pr",
        "flake_quarantine_expiring",
        "orphan_queue_branches",
        "pin_drift",
        "unproven_rate",
        "escapes"
      ]
    },
    "SweepCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "{name: <built-in>} is that built-in check, the same as the bare name. {name, run} is a repo command check whose JSON output lists findings, and whose name is not a built-in's.",
      "properties": {
        "name": { "type": "string" },
        "run": { "$ref": "#/$defs/command" }
      },
      "if": { "required": ["run"] },
      "then": { "properties": { "name": { "$ref": "#/$defs/name", "not": { "$ref": "#/$defs/sweepBuiltin" } } } },
      "else": { "properties": { "name": { "$ref": "#/$defs/sweepBuiltin" } } }
    }
  }
}
