"""
The `prod` environment of shop, hosted on Reliant.

YOURS. forge scaffolds this file once and never rewrites it.

This file BINDS; it does not declare. `deploy/kcl/workloads.k` states what
each workload is (build, subcommand, ports, credentials). This file says
where each one runs here, and states the values only this env knows.

As scaffolded, everything runs on the forge control plane (Reliant cloud),
which owns the namespace, the registry, the database and the secrets (and,
for static sites, the bucket, the CDN and the hostname):

  workloads  `forge.OnHosted`: each a Workload the platform admits under its
             Restricted profile (kinds service, worker, job) and renders with
             the same Go renderer a cluster you operate uses. The API is ONE
             of them, `_api`: every service and worker, in one process
  database   `_db`, a dedicated managed Postgres; workloads read its URL
             through `forge.DatabaseRef`, so nobody handles the password
  secrets    the control plane's write-only store:
             `forge secret set --env prod <KEY>` (value on stdin)
  frontend   the static export, on the platform's static hosting

Hosted workloads, the managed database and static sites all need billing on
your Reliant organization (Reliant → Settings → Billing).

HOSTING ELSEWHERE is a binding edit, not a rewrite: the binders for a
cluster you operate (`_on_cluster`) and your own bucket (`_on_bucket`) are
declared below, unused, each saying what to fill in.

Render and deploy through forge: `forge env render prod`,
`forge env deploy prod`.
"""

import forge
import forge.workloads as fw

# What this project RUNS — declared once, shared by every env.
import ..workloads as wl

# How any env binds a workload or frontend — shared by every deployed env.
# This file keeps only what is this env's own (deploy/kcl/base/env.k).
import ..base.env as envbase

# The users — declared once, shared by every env; only where they run differs.
import ..identity as idn

# Per-environment config values (the typed AppConfig instance in config.k).
import config_gen
import .config as appcfg

# The database. RETAIN (the default deletionPolicy): removing this
# declaration never drops the data. Your own Postgres instead? Delete `_db`
# and `databases`, pass "" for the database in `_hosted`, then
# `forge secret set --env prod DATABASE_URL`.
_db = forge.ManagedDatabase {
    name = "shop"
    runtime = forge.OnHosted {}
}

# ---------------------------------------------------------------------------
# THE BINDINGS: where each workload runs in this env.
# ---------------------------------------------------------------------------
# There is no env-wide runtime: each line in `_workloads` names its binder,
# and rebinding a workload is editing that one line. The binders are the
# shared ones in deploy/kcl/base/env.k, given this env's values.

# HOSTED, on the forge control plane, reading `_db` (envbase.hosted).
_hosted = lambda w: fw.Workload -> fw.Workload {
    envbase.hosted(w, appcfg.app_config, _db.name)
}

# A CLUSTER YOU OPERATE (envbase.on_cluster explains): declare it here, e.g.
#
#     _cluster = forge.ClusterTarget {
#         cluster = "gke_acme_us-central1_prod"   # its kubectl context
#         connected_cluster = "shop-prod"     # `forge cluster connect`
#         namespace = "shop-" + option("env")
#         platform = "amd64"                       # the nodes' arch
#     }
#
# then rebind a line `_hosted(...)` → `_on_cluster(...)`. This env's capacity
# floor on it is `_cluster_resources` and `_cluster_replicas`.
_cluster = None
_cluster_resources = fw.Resources {
    cpuRequestMillicores = forge.cpu(0.5)
    memoryRequestBytes = forge.mib(512)
    cpuLimitMillicores = forge.cpu(2.0)
    memoryLimitBytes = forge.mib(1024)
}
_cluster_replicas = 3
_on_cluster = lambda w: fw.Workload -> fw.Workload {
    envbase.on_cluster(w, appcfg.app_config, _cluster, "prod", _cluster_resources, _cluster_replicas)
}

# Built, never run.
_build_only = lambda w: fw.Workload -> fw.Workload {
    envbase.build_only(w)
}

# THE API, as ONE workload: the binary's `server` command, every service at
# the one origin a browser calls (deploy/kcl/base/env.k says why).
_api = fw.Workload {
    name = "api"
    kind = "service"
    image = "ghcr.io/acme/shop"
    build = forge.GoBuild {cmd = "./cmd/shop", output_name = "shop"}
    args = ["server"]
    ports = [fw.Port {name = "http", port = 8080, expose = True}]
    config_secrets = ["DATABASE_URL"]
}

# Every workload this env runs, one binding each. `forge scaffold` appends
# a line here when it adds a workload; drop a line to not run it here.
# (The dev-IdP convergence job is not here: this env's issuer is a real
# one, with its applications registered out of band.)
_workloads = [
    _hosted(wl.migrate)
    _hosted(_api)
]

# FRONTENDS bind the same way (envbase.hosted_frontend, envbase.on_bucket). The
# browser calls `_api`, once this env runs it — every service, at one origin.
_api_config = envbase.api_config(_api, _workloads)
_hosted_frontend = lambda f: forge.Frontend -> forge.Frontend {
    envbase.hosted_frontend(f, _api_config)
}
# Your own bucket instead: declare it (`_bucket = forge.OnBucket {bucket =
# "shop-prod-site"}`), then rebind the frontend's line.
_bucket = None
_on_bucket = lambda f: forge.Frontend -> forge.Frontend {
    envbase.on_bucket(f, _bucket, "prod")
}

# Masked session recording for this environment. It sets the frontend's
# `telemetry.replay` (forge.BrowserTelemetry), which renders its OTEL_REPLAY
# and opts the env in to replay ingestion; False stops both. DNT/GPC and the
# app's consent gate still win.
_session_replay = True
_web_frontend = forge.Frontend {
    name = "web"
    path = "frontends/web"
    telemetry = forge.BrowserTelemetry {replay = _session_replay}
    public_dir = "out"
}

_bundle = forge.Bundle {
    project = "shop"
    observability = forge.Observability {}
    # Where hosted workloads, the database and the site are published:
    # Reliant cloud (set `endpoint` for another control plane).
    control_plane = forge.ControlPlane {}
    workloads = _workloads
    databases = [_db]
    # THE USERS (deploy/kcl/identity.k), hosted: the control plane gives this
    # env its own identity instance and delivers its issuer, audience, client
    # id and broker token to the API (forge.IdentityRef): nothing is copied by
    # hand. Bringing your own issuer instead? Delete this line and set
    # jwt_issuer / oidc_client_id in config.k.
    identity = idn.IDENTITY
    # Where each frontend runs here, one binding each — rebind by editing its
    # line, or as an env is created: `forge env new <name> --bind
    # web=bucket`.
    frontends = [
        _hosted_frontend(_web_frontend)
    ]
    # SECRET VALUES live in the control plane's store; forge never sees one.
    # A `sensitive` config field a hosted workload reads is a managedSecret
    # of the same key: `forge secret set --env prod <KEY>`.
    secret_provider = forge.HostedSecrets {}
    # Once workloads run on `_cluster`, it carries this env's support objects
    # too. Add, with `import .ingress as ing` above (deploy/kcl/prod/ingress.k):
    #
    #     cluster_target = _cluster
    #     network_policy = forge.NetworkPolicy {ingress_namespace = "envoy-gateway-system"}
    #     gateways = ing.GATEWAYS
    #     http_routes = ing.HTTP_ROUTES
    #     grpc_routes = ing.GRPC_ROUTES
}

output = forge.render(_bundle)
