# syntax=docker/dockerfile:1

# --- Build ---
FROM node:22-alpine AS builder

# The frontend builds at the SAME project-relative path it has in the
# repository (frontends/web), not at /app. Every relative path the committed
# config carries then means in the image what it means on a developer machine
# and in CI's `pnpm run build`. Built from /app, tsconfig's
# "../../node_modules/…" peer pins pointed at /node_modules, which webpack
# re-rooted onto /app/node_modules — a pin that resolves where it resolves
# nowhere else, and the environment-specific failure mode that hid a bundle
# split behind "it only breaks in Docker".
WORKDIR /src/frontends/web

# pnpm at exactly the release package.json's `packageManager` pins: corepack,
# which ships with Node through v24, downloads that version on first use.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable pnpm

# --frozen-lockfile: the image installs exactly what pnpm-lock.yaml says, and
# fails rather than silently re-resolving a range. pnpm-workspace.yaml holds
# the overrides and the install scripts pnpm may run, so it is an input to the
# install too. The store is a build cache mount, so a rebuild downloads only
# what changed. The build context is this directory, so ./.dockerignore (not
# the project root's) keeps a host node_modules — native binaries built for
# the developer's OS — out of the image.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm fetch --frozen-lockfile
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --offline --frozen-lockfile

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN pnpm run build

# --- Run ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# The runner only ever executes `node`. npm, npx and corepack ship in the base
# image with their own dependency trees, which is where every HIGH CVE a scan
# of node:22-alpine reports lives; nothing here uses them, so they go.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

# The upstream `node` image ships a built-in non-root `node` user
# (uid=1000). Running the server as root adds no value and makes a
# container escape materially more dangerous; we drop privileges before
# CMD and own the copied assets so the process can still read them.
#
# next.config.ts sets `output: "standalone"`, which emits a minimal Node
# server at <distDir>/standalone/server.js plus pruned node_modules; the
# static assets and public/ must be copied alongside it. Production builds
# use distDir ".next-prod" (next.config.ts fences them off from the dev
# server's .next).
#
# server.js sits directly under standalone/ because the build context is the
# FRONTEND directory alone: nothing above /src/frontends/web is an npm
# workspace root, so next.config.ts's outputFileTracingRoot walk finds none
# and roots at the frontend. On a HOST build that root is the project's
# workspace root instead (see next.config.ts), so server.js lands under
# standalone/frontends/<name>/ — nothing consumes the host-built tree. Do not
# "fix" that difference by re-pinning the tracing root to the frontend.
COPY --from=builder --chown=node:node /src/frontends/web/.next-prod/standalone ./
COPY --from=builder --chown=node:node /src/frontends/web/.next-prod/static ./.next-prod/static
COPY --from=builder --chown=node:node /src/frontends/web/public ./public

USER node

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["node", "server.js"]
