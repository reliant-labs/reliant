"""
What every deployed env of shop shares: how a workload or a frontend
is bound to where it runs. YOURS: forge scaffolds this file once and never
rewrites it.

THE SHARED BASE. Each env's `deploy/kcl/<env>/main.k` imports this as
`import ..base.env as envbase` and keeps only what is its own: its database, the
cluster or bucket it declares (if any), its capacity, and one binding line per
workload and frontend. A change here reaches every env at once, and
`forge env new <name> --from <env>` copies just that thin file — a new env
starts as its deltas. What a workload IS (build, command, ports, credentials)
is `deploy/kcl/workloads.k`; this file is how any env places one.

Every binder takes the env's own values as arguments, so an env can still wrap
or replace one in its main.k (`_hosted = lambda w ... { envbase.hosted(...) | {...} }`).
"""

import forge
import forge.workloads as fw

# The typed config projection (generated from the config proto).
import config_gen

# An env's layer over a workload: its typed config projected into the
# workload's env (a credential only into the workloads that list it in
# `config_secrets`). OTEL_SERVICE_NAME is not set here: forge.render gives every
# workload its own name unless its env sets one.
configured = lambda w: fw.Workload, app_config: any -> fw.Workload {
    w | {env = config_gen.appConfigEnvMap(app_config, w.config_secrets) | w.env}
}

# HOSTED: a Workload on the forge control plane. Its image is the declared
# one minus the registry host: the platform pulls only from its own
# registry, and forge composes that address (<registry>/<org>/shop/<name>)
# from your credential. DATABASE_URL is the env's managed database (`db_name`;
# "" for none).
hosted = lambda w: fw.Workload, app_config: any, db_name: str -> fw.Workload {
    _c = configured(w, app_config)
    _c | {
        image = w.image[w.image.rfind("/") + 1:] if w.image else w.image
        env = _c.env \
            | ({DATABASE_URL = forge.DatabaseRef {name = db_name}} if db_name and "DATABASE_URL" in w.config_secrets else {})
        runtime = forge.OnHosted {}
    }
}

# A CLUSTER YOU OPERATE, for what hosting refuses — an operator (no
# Kubernetes API on shared nodes), a `kind = "cron"` CronJob (not metered
# yet) — or what you would rather run yourself. The env declares the cluster
# (`_cluster`), then rebinds the workload's line: `_hosted(_api)` →
# `_on_cluster(_api)`.
#
#     _cluster = forge.ClusterTarget {
#         cluster = "gke_acme_us-central1_<env>"   # its kubectl context
#         connected_cluster = "shop-<env>"     # see below
#         namespace = "shop-" + option("env")  # one per env, previews included
#         platform = "amd64"                       # the nodes' arch
#     }
#
# A hosted env's deploys go through the control plane, so it must reach the
# cluster too: register it once with `forge cluster connect shop-<env>
# --context <kubectl context> --env <env>`. Until `_cluster` is declared, a
# workload bound here fails the render, naming itself. A cluster workload
# pulls the image workloads.k declares (`forge env build <env> --push`), gets
# the env's capacity floor, and reads DATABASE_URL from the
# `shop-secrets` Secret you provision in its namespace.
on_cluster = lambda w: fw.Workload, app_config: any, cluster: any, env_name: str, resources: fw.Resources, replicas: int -> fw.Workload {
    assert cluster, "workload '${w.name}' is bound to _on_cluster, but deploy/kcl/${env_name}/main.k declares no `_cluster`: declare the cluster you operate there" \
        + (" — the hosted platform refuses ${w.kind}s, so it cannot be rebound `_hosted`; drop the line to not run it here" if w.kind in ["cron", "operator"] else ", or rebind the line `_hosted`")
    configured(w, app_config) | {
        resources = resources
        # A replica FLOOR for the long-running kinds; above one, forge adds a
        # PodDisruptionBudget and spreads the pods across nodes.
        if w.kind in ["service", "worker", "operator"]:
            replicas = w.replicas if w.replicas > replicas else replicas
        runtime = forge.OnCluster {target = cluster}
    }
}
# Elsewhere again: `wl.<name> | {runtime = forge.OnCompose {}}` runs a
# workload as a docker-compose service on the machine that deploys.

# Built, never run.
build_only = lambda w: fw.Workload -> fw.Workload {
    w | {runtime = forge.BuildOnly {}}
}

# THE API, as ONE workload: the binary's `server` command, which mounts
# every service on one Connect mux and supervises every worker beside it.
#
# A browser reaches the API at one origin. Its Connect transport has one
# base URL (a call is `/<package>.<Service>/<Method>`, so one origin serves
# every service), and sign-in answers with an HttpOnly session cookie the
# browser sends back to that origin only. The platform gives each workload
# its own hostname and routes no paths between them, so a workload per
# service would leave the frontend reaching one of them, signed in to none
# of the others.
#
# workloads.k still declares each service and worker; here `server` runs
# them (dev runs the same `_api`, under air). So `forge scaffold
# service|worker` adds no binding line for one. Splitting one out — a service
# no browser calls, a worker that needs its own capacity — is its own line,
# `_hosted(wl.<name>)`, and taking it out of `server`'s mount or worker list:
# cmd/shop/cmd/server.go. (`server` runs no operator hosted —
# with no Kubernetes API it logs that operators are disabled and serves on.)

# ---------------------------------------------------------------------------
# FRONTENDS bind a runtime the same way. A frontend is a static export
# (`output: static` in forge.yaml), published from its `public_dir`.
# ---------------------------------------------------------------------------

# The API the browser calls: the API workload, once the env runs it — every
# service, at one origin.
api_config = lambda api: fw.Workload, workloads: [fw.Workload] -> {str:} {
    {API_URL = forge.WorkloadURL {workload = api.name}} if any w in workloads {w.name == api.name} else {}
}

# HOSTED: the platform's static hosting. Like a workload, its image
# names no registry host. The release carries no config.js: the control
# plane writes one after every sync, so one release promotes between envs
# unchanged. An API_URL that references a workload becomes "/_api": the
# platform serves that workload on every host of the site (custom domains
# too) at /_api/*, the path the dev loop proxies, so the session cookie is
# first-party to the site. The API's own URL keeps working for CLIs, mobile
# apps and servers. To have the browser call that URL instead, write it as a
# literal: `API_URL = "https://<api host>"` is never rewritten.
hosted_frontend = lambda f: forge.Frontend, api: {str:} -> forge.Frontend {
    f | {
        image = f.name
        runtime = forge.OnHosted {}
        runtime_config = f.runtime_config | api
    }
}

# YOUR OWN BUCKET (and a CDN you operate): each deploy uploads an immutable
# `releases/<digest>/` and syncs `live/` from it. Bucket names are global,
# so forge does not guess one: the env declares it (`_bucket`), then rebinds
# the frontend's line to `_on_bucket(...)`.
#
#     _bucket = forge.OnBucket {bucket = "shop-<env>-site"}   # cdn = forge.StaticSiteCDN {...}
on_bucket = lambda f: forge.Frontend, bucket: any, env_name: str -> forge.Frontend {
    assert bucket, "frontend '${f.name}' is bound to _on_bucket, but deploy/kcl/${env_name}/main.k declares no `_bucket`: declare it there, or rebind the line `_hosted_frontend`"
    f | {runtime = bucket}
}
