# syntax=docker/dockerfile:1

# --- Build ---
FROM node:22-alpine AS builder

# The frontend builds at the SAME project-relative path it has in the
# repository (frontends/web), not at /app. Every relative path the committed
# config carries then means in the image what it means on a developer machine
# and in CI's `npm run build`. Built from /app, tsconfig's
# "../../node_modules/…" peer pins pointed at /node_modules, which webpack
# re-rooted onto /app/node_modules — a pin that resolves where it resolves
# nowhere else, and the environment-specific failure mode that hid a bundle
# split behind "it only breaks in Docker".
WORKDIR /src/frontends/web

# `npm ci`, not `npm install`: the image installs exactly what the lockfile
# says, and fails rather than silently re-resolving a range. The build
# context is this directory, so ./.dockerignore (not the project root's)
# keeps a host node_modules — native binaries built for the developer's OS —
# out of the image.
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build

# --- Serve the static export ---
# `output: static` builds `output: "export"`: the whole site is plain files in
# out/, and nothing runs at request time. nginx serves them. The unprivileged
# image runs as uid 101 and listens on 8080; it carries no Node and no npm,
# whose bundled dependencies are where node:22-alpine's HIGH CVEs live.
FROM nginxinc/nginx-unprivileged:1.30-alpine AS runner

# Exported pages are <route>.html (trailingSlash is off), so a request for
# /settings has to find settings.html; unknown paths get the exported 404.
# The export's URLs all carry base_path "/admin", so it is mounted
# there — the same place the StaticSite deploy puts it.
RUN printf '%s\n' \
  'server {' \
  '    listen 8080;' \
  '    server_name _;' \
  '    root /usr/share/nginx/html;' \
  '    location / {' \
  '        try_files $uri $uri.html $uri/ =404;' \
  '    }' \
  '    error_page 404 /admin/404.html;' \
  '}' > /etc/nginx/conf.d/default.conf

# public/config.js is not in the image (see ./.dockerignore): each environment
# renders its own runtime config beside the bundle. Mount one at
# /usr/share/nginx/html/admin/config.js to point the site at a real API.
COPY --from=builder /src/frontends/web/out /usr/share/nginx/html/admin

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/admin/ >/dev/null || exit 1
