// "Didn't get a code?" is ONE sentence for every address. The server cannot
// know whether mail arrived (a relay may refuse an address that once reported
// spam), and copy that said why would tell anyone which addresses exist.
const NO_CODE = "Didn't get a code? Check spam, try another sign-in method, or contact support.";

describe("no code arrived", () => {
  afterEach(() => {
    vi.useRealTimers();
  });

  async function requestLink(message: string) {
    stubRoutes({ "/auth/magic/request": { status: 202, body: { message } } });
    render(
      <SignInMethods options={allOptions} email="a@b.test" returnTo="/" onSignedIn={() => {}} />,
    );
    fireEvent.click(screen.getByRole("button", { name: "Email me a link" }));
    await screen.findByText(new RegExp(message));
  }

  it("appears after a minute of waiting, not before", async () => {
    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
    render(<NoCodeHint />);
    expect(screen.queryByText(NO_CODE)).toBeNull();
    await act(async () => {
      await vi.advanceTimersByTimeAsync(59_000);
    });
    expect(screen.queryByText(NO_CODE)).toBeNull();
    await act(async () => {
      await vi.advanceTimersByTimeAsync(2_000);
    });
    expect(screen.getByText(NO_CODE)).toBeTruthy();
  });

  it("appears at once after asking again", async () => {
    await requestLink("Link requested.");
    fireEvent.click(screen.getByRole("button", { name: "Send a new link" }));
    expect(await screen.findByText(NO_CODE)).toBeTruthy();
  });

  it("follows a resent confirmation link too", async () => {
    stubRoutes({ "/auth/verify/resend": { status: 202, body: { message: "Sent if pending." } } });
    render(<UnverifiedNotice email="a@b.test" />);
    fireEvent.click(screen.getByRole("button", { name: "Send a new link" }));
    expect(await screen.findByText(NO_CODE)).toBeTruthy();
  });

  it("says the same thing whatever the server answered", async () => {
    const shown: string[] = [];
    for (const message of ["Link requested.", "Something else entirely."]) {
      await requestLink(message);
      fireEvent.click(screen.getByRole("button", { name: "Send a new link" }));
      shown.push((await screen.findByText(/Didn't get a code/)).textContent ?? "");
      cleanup();
    }
    expect(shown).toEqual([NO_CODE, NO_CODE]);
  });
});

