  });

  it("lets the person see the password they typed", async () => {
    stubRoutes({ ...options(["password"]), "/auth/password-policy": { status: 204 } });
    render(
      <AcceptInviteForm
        userID="u1"
        code="inv"
        orgID={null}
        signInHref="/auth/sign-in"
        onSignedIn={() => {}}
      />,
    );
    const field = screen.getByLabelText("Password");
    const toggle = screen.getByRole("button", { name: "Show password" });
    expect(field.getAttribute("type")).toBe("password");
    fireEvent.click(toggle);
    expect(field.getAttribute("type")).toBe("text");
    expect(toggle.getAttribute("aria-pressed")).toBe("true");
    fireEvent.click(toggle);
    expect(field.getAttribute("type")).toBe("password");
  });

  it("offers the policy's methods and mails a link for magic_link", async () => {
    const fetchMock = stubRoutes({
      ...options(["password", "magic_link"]),
      "/auth/password-policy": { status: 204 },
      "/auth/invite/accept": {
        status: 202,
        body: { message: "A sign-in link is on its way to your email." },
      },
    });
    render(
      <AcceptInviteForm
        userID="u1"
        code="inv"
        orgID={null}
        signInHref="/auth/sign-in"
        onSignedIn={() => {}}
      />,
    );
    fireEvent.click(await screen.findByLabelText("Email me a sign-in link each time"));
    expect(screen.queryByLabelText("Password")).toBeNull();
    fireEvent.click(screen.getByRole("button", { name: "Accept invitation" }));
    await screen.findByText(/on its way to your email/);
    expect(bodyOf(fetchMock, "/auth/invite/accept").method).toBe("magic_link");
  });

  it("shows a rejected invitation", async () => {
    stubRoutes({
      ...options(["password"]),
      "/auth/password-policy": { status: 204 },
      "/auth/invite/accept": {
        status: 401,
        body: { error: "That code or link is not valid.", code: "invalid_code" },
      },
    });
    render(
      <AcceptInviteForm
        userID="u1"
        code="used"
        orgID={null}
        signInHref="/auth/sign-in"
        onSignedIn={() => {}}
      />,
    );
    fireEvent.change(screen.getByLabelText("Password"), { target: { value: "a-long-password" } });
    fireEvent.click(screen.getByRole("button", { name: "Accept invitation" }));
    await screen.findByText("That code or link is not valid.");
  });

  it("accepts with a social account when no other method is offered", async () => {
    const fetchMock = stubRoutes({
      ...options([]),
      "/auth/password-policy": { status: 204 },
      "/auth/invite/accept": {
        status: 200,
        body: { redirect: "https://provider.example/start?state=i1" },
      },
    });
    render(
      <AcceptInviteForm
        userID="u1"
        code="inv"
        orgID={null}
        signInHref="/auth/sign-in"
        onSignedIn={() => {}}
      />,
    );
    fireEvent.click(await screen.findByRole("button", { name: "Continue with Google" }));
    // acceptInvite then leaves for the provider (window.location.assign).
    await waitFor(() => expect(calls(fetchMock, "/auth/invite/accept")).toHaveLength(1));
    expect(bodyOf(fetchMock, "/auth/invite/accept")).toEqual({
      userID: "u1",
      code: "inv",
      method: "social",
      provider: "google",
    });
    // Nothing defaults to a password the server would refuse.
    expect(screen.queryByLabelText("Password")).toBeNull();
    expect(screen.queryByRole("button", { name: "Accept invitation" })).toBeNull();
  });

  it("refuses an incomplete link", () => {
    stubRoutes(options(["password"]));
    render(
      <AcceptInviteForm
        userID="u1"
        code={null}
        orgID={null}
        signInHref="/auth/sign-in"
        onSignedIn={() => {}}
      />,
    );
    expect(screen.getByRole("alert").textContent).toMatch(/incomplete/);
  });
});

describe("SocialCallback", () => {
  it("completes once and lands where the sign-in started", async () => {
    const fetchMock = stubRoutes({
      "/auth/social/callback": {
        status: 200,
        body: { identity: { authenticated: true }, returnTo: "/projects" },
      },
    });
    const onSignedIn = vi.fn();
    render(
      <SocialCallback id="i1" token="t1" signInHref="/auth/sign-in" onSignedIn={onSignedIn} />,
    );
    await waitFor(() => expect(onSignedIn).toHaveBeenCalledWith("/projects"));
    expect(calls(fetchMock, "/auth/social/callback")).toHaveLength(1);
    expect(bodyOf(fetchMock, "/auth/social/callback")).toEqual({ id: "i1", token: "t1" });
  });

  it("says to confirm the address when the provider's was unverified", async () => {
    stubRoutes({
      "/auth/social/callback": {
        status: 202,
        body: { verify: "sent", message: "Check your email." },
      },
    });
    const onSignedIn = vi.fn();
    render(
      <SocialCallback id="i1" token="t1" signInHref="/auth/sign-in" onSignedIn={onSignedIn} />,
    );
    await screen.findByText("Check your email.");
    expect(onSignedIn).not.toHaveBeenCalled();
  });

  it("shows why a link was refused", async () => {
    stubRoutes({
      "/auth/social/callback": {
        status: 409,
        body: {
          error: "Sign in another way, then connect Google from your account.",
          code: "social_link_required",
        },
      },
    });
    render(<SocialCallback id="i1" token="t1" signInHref="/auth/sign-in" onSignedIn={() => {}} />);
    await screen.findByText("Sign in another way, then connect Google from your account.");
  });

  it("lands home when the returned path would leave the site", async () => {
    stubRoutes({
      "/auth/social/callback": {
        status: 200,
        body: { identity: { authenticated: true }, returnTo: "/a/..//evil.com" },
      },
    });
    const onSignedIn = vi.fn();
    render(
      <SocialCallback id="i1" token="t1" signInHref="/auth/sign-in" onSignedIn={onSignedIn} />,
    );
    await waitFor(() => expect(onSignedIn).toHaveBeenCalledWith("/"));
  });

  it("does not call the server without the id and token", async () => {
    const fetchMock = stubRoutes({});
    render(<SocialCallback id={null} token="t" signInHref="/auth/sign-in" onSignedIn={() => {}} />);
    await screen.findByText(/did not complete/);
    expect(fetchMock).not.toHaveBeenCalled();
  });
});
