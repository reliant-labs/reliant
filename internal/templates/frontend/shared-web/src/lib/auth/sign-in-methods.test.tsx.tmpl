type Route = { status: number; body?: unknown };

/** Stubs fetch by path: each path answers its listed responses in turn (the last one repeats). */
function stubRoutes(routes: Record<string, Route | Route[]>) {
  const seen: Record<string, number> = {};
  const fetchMock = vi.fn<typeof fetch>(async (input) => {
    const path = new URL(String(input), "http://app.test").pathname.replace(/^\/_api/, "");
    const entry = routes[path];
    if (!entry) return new Response(JSON.stringify({ error: "not found" }), { status: 404 });
    const list = Array.isArray(entry) ? entry : [entry];
    const n = seen[path] ?? 0;
    seen[path] = n + 1;
    const r: Route = list[Math.min(n, list.length - 1)] ?? { status: 500 };
    return new Response(r.body === undefined ? null : JSON.stringify(r.body), {
      status: r.status,
      headers: { "Content-Type": "application/json" },
    });
  });
  vi.stubGlobal("fetch", fetchMock);
  return fetchMock;
}

function calls(fetchMock: ReturnType<typeof stubRoutes>, path: string) {
  return fetchMock.mock.calls.filter(([input]) => String(input).endsWith(path));
}

function bodyOf(fetchMock: ReturnType<typeof stubRoutes>, path: string): Record<string, unknown> {
  const call = calls(fetchMock, path)[0];
  if (!call) throw new Error(`${path} was never called`);
  return JSON.parse(String(call[1]?.body ?? "{}")) as Record<string, unknown>;
}

const allOptions: AuthOptions = {
  selfSignup: true,
  signup: "open",
  methods: ["password", "passkey", "magic_link"],
  social: [{ type: "google", label: "Google" }],
  mail: true,
};

/** A WebAuthn-capable browser whose authenticator answers with `credential` (null: cancelled). */
function stubWebAuthn(credential: PublicKeyCredential | null) {
  vi.stubGlobal("PublicKeyCredential", function PublicKeyCredential() {});
  const get = vi.fn(async () => credential);
  const create = vi.fn(async () => credential);
  vi.stubGlobal("navigator", { ...navigator, credentials: { get, create } });
  return { get, create };
}

function fakeCredential(): PublicKeyCredential {
  const bytes = (s: string) => new TextEncoder().encode(s).buffer;
  return {
    id: "a2V5",
    rawId: bytes("key"),
    type: "public-key",
    response: {
      clientDataJSON: bytes('{"type":"webauthn.get"}'),
      authenticatorData: bytes("auth"),
      signature: bytes("sig"),
      userHandle: bytes("user"),
    },
  } as unknown as PublicKeyCredential;
}

afterEach(() => {
  cleanup();
  vi.unstubAllGlobals();
});

describe("the auth client", () => {
  it("reads every option, and fails closed to password-only, invite-only", async () => {
    stubRoutes({
      "/auth/options": { status: 200, body: { ...allOptions, methods: ["passkey", "sms"] } },
    });
    expect(await fetchAuthOptions()).toEqual({ ...allOptions, methods: ["passkey"] });

    // An older server answers only {selfSignup}.
    stubRoutes({ "/auth/options": { status: 200, body: { selfSignup: true } } });
    expect(await fetchAuthOptions()).toEqual({ ...LEGACY_AUTH_OPTIONS, selfSignup: true });

    stubRoutes({});
    expect(await fetchAuthOptions()).toEqual(LEGACY_AUTH_OPTIONS);
  });

  it("round-trips base64url and converts the server's passkey options", () => {
    const raw = new Uint8Array([0, 250, 251, 252, 253, 254, 255]).buffer;
    expect(toBase64url(raw)).toBe("APr7_P3-_w");
    expect(new Uint8Array(fromBase64url("APr7_P3-_w"))).toEqual(new Uint8Array(raw));
    const opts = toRequestOptions({
      publicKey: {
        challenge: "Y2g",
        rpId: "app.test",
        allowCredentials: [{ type: "public-key", id: "a2V5" }],
      },
    });
    expect(opts.publicKey?.rpId).toBe("app.test");
    expect(opts.publicKey?.challenge).toBeInstanceOf(ArrayBuffer);
    expect(opts.publicKey?.allowCredentials?.[0]?.id).toBeInstanceOf(ArrayBuffer);
    expect(credentialToJSON(fakeCredential())).toMatchObject({
      id: "a2V5",
      rawId: "a2V5",
      type: "public-key",
      response: { signature: "c2ln", userHandle: "dXNlcg" },
    });
  });

  it("signs in with a passkey: begin, the authenticator, finish", async () => {
    const fetchMock = stubRoutes({
      "/auth/passkey/begin": {
        status: 200,
        body: { options: { publicKey: { challenge: "Y2g" } } },
      },
      "/auth/passkey/finish": { status: 200, body: { authenticated: true, subject: "u1" } },
    });
    stubWebAuthn(fakeCredential());
    expect(await passkeySignIn("a@b.test")).toEqual({ authenticated: true, subject: "u1" });
    expect(bodyOf(fetchMock, "/auth/passkey/begin")).toEqual({ email: "a@b.test" });
    expect(bodyOf(fetchMock, "/auth/passkey/finish").credential).toMatchObject({
      type: "public-key",
    });
  });

  it("does not post a cancelled passkey prompt", async () => {
    const fetchMock = stubRoutes({
      "/auth/passkey/begin": {
        status: 200,
        body: { options: { publicKey: { challenge: "Y2g" } } },
      },
    });
    stubWebAuthn(null);
    const err = await passkeySignIn("a@b.test").catch((e: unknown) => e);
    expect(err).toBeInstanceOf(AuthError);
    expect((err as AuthError).code).toBe("passkey_cancelled");
    expect(calls(fetchMock, "/auth/passkey/finish")).toHaveLength(0);
  });

  it("tells a 'check your email' sign-up from a signed-in one", async () => {
    stubRoutes({
      "/auth/register": { status: 202, body: { verify: "sent", message: "Check your email." } },
    });
    expect(isVerifySent(await signUp({ email: "a@b.test" }))).toBe(true);
    stubRoutes({ "/auth/register": { status: 200, body: { authenticated: true } } });
    expect(isVerifySent(await signUp({ email: "a@b.test", password: "x" }))).toBe(false);
  });

  it("carries the server's reason code on a refusal", async () => {
    stubRoutes({
      "/auth/passkey/begin": {
        status: 200,
        body: { options: { publicKey: { challenge: "Y2g" } } },
      },
      "/auth/passkey/finish": {
        status: 403,
        body: { error: "Confirm your email.", code: "email_unverified" },
      },
    });
    stubWebAuthn(fakeCredential());
    const err = await passkeySignIn("a@b.test").catch((e: unknown) => e);
    expect((err as AuthError).code).toBe("email_unverified");
  });
});

describe("SignInMethods", () => {
  const noop = () => {};

  it("renders nothing for the legacy password-only policy", () => {
    const { container } = render(
      <SignInMethods options={LEGACY_AUTH_OPTIONS} email="" returnTo="/" onSignedIn={noop} />,
    );
    expect(container.innerHTML).toBe("");
  });

  it("offers each method only when the policy does", () => {
    stubWebAuthn(fakeCredential());
    render(<SignInMethods options={allOptions} email="" returnTo="/" onSignedIn={noop} />);
    expect(screen.getByRole("button", { name: "Continue with passkey" })).toBeTruthy();
    expect(screen.getByRole("button", { name: "Email me a link" })).toBeTruthy();
    expect(screen.getByRole("button", { name: "Continue with Google" })).toBeTruthy();
    cleanup();
    // No mail delivery: no emailed link, however the methods read.
    const noMail: AuthOptions = { ...allOptions, mail: false };
    render(<SignInMethods options={noMail} email="" returnTo="/" onSignedIn={noop} />);
    expect(screen.queryByRole("button", { name: "Email me a link" })).toBeNull();
  });

  it("asks for the address before mailing a link, then waits for the code in this tab", async () => {
    const fetchMock = stubRoutes({
      "/auth/magic/request": {
        status: 202,
        body: { message: "If that address can sign in, a sign-in link is on its way." },
      },
      "/auth/magic/consume": [
        { status: 401, body: { error: "That code or link is not valid.", code: "invalid_code" } },
        { status: 200, body: { authenticated: true } },
      ],
    });
    const onSignedIn = vi.fn();
    const { rerender } = render(
      <SignInMethods options={allOptions} email="" returnTo="/" onSignedIn={onSignedIn} />,
    );
    fireEvent.click(screen.getByRole("button", { name: "Email me a link" }));
    expect(screen.getByRole("alert").textContent).toMatch(/email address first/);
    expect(calls(fetchMock, "/auth/magic/request")).toHaveLength(0);

    rerender(
      <SignInMethods options={allOptions} email="a@b.test" returnTo="/" onSignedIn={onSignedIn} />,
    );
    fireEvent.click(screen.getByRole("button", { name: "Email me a link" }));
    await screen.findByText(/a sign-in link is on its way/);
    fireEvent.change(screen.getByLabelText("Code from the email"), { target: { value: "123456" } });
    fireEvent.click(screen.getByRole("button", { name: "Sign in with the code" }));
    await screen.findByText("That code or link is not valid.");
    expect(onSignedIn).not.toHaveBeenCalled();
    fireEvent.click(screen.getByRole("button", { name: "Sign in with the code" }));
    await waitFor(() => expect(onSignedIn).toHaveBeenCalledOnce());
  });

  it("offers a new confirmation link when the address is unverified", async () => {
    stubWebAuthn(fakeCredential());
    stubRoutes({
      "/auth/passkey/begin": {
        status: 200,
        body: { options: { publicKey: { challenge: "Y2g" } } },
      },
      "/auth/passkey/finish": {
        status: 403,
        body: { error: "Confirm your email.", code: "email_unverified" },
      },
      "/auth/verify/resend": { status: 202, body: { message: "A new link is on its way." } },
    });
    render(<SignInMethods options={allOptions} email="a@b.test" returnTo="/" onSignedIn={noop} />);
    fireEvent.click(screen.getByRole("button", { name: "Continue with passkey" }));
    fireEvent.click(await screen.findByRole("button", { name: "Send a new link" }));
    await screen.findByText("A new link is on its way.");
  });
});

