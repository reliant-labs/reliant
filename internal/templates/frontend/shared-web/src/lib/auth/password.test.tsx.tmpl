// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// Pins the password-requirements behaviour the sign-up and reset forms depend
// on: the client-side rule checks, the up-front checklist, and the way a
// server rejection reaches the screen.
//
// The bug this guards: sign-up answered "That password does not meet the
// requirements." and never said what they were. Every assertion below is a
// way that sentence could creep back.

import { cleanup, render, screen, waitFor } from "@testing-library/react";
import { afterEach, describe, expect, it, vi } from "vitest";

import { PasswordRequirements } from "@/components/password-requirements";

import {
  AuthError,
  activeRules,
  fetchPasswordPolicy,
  forgotPassword,
  resetPassword,
  signUp,
  unmetRules,
  type PasswordPolicy,
} from "./native-login";
{{- if .HasTypedConfig}}

vi.mock("@/lib/config_gen", () => ({ loadConfig: () => ({ API_URL: "", MOCK_API: "" }) }));
{{- end}}

const strict: PasswordPolicy = {
  min_length: 8,
  has_uppercase: true,
  has_lowercase: true,
  has_number: true,
  has_symbol: true,
};

function stubFetch(status: number, body: unknown) {
  // Typed as fetch so mock.calls carries (input, init) without declaring
  // parameters the stub never reads.
  const fetchMock = vi.fn<typeof fetch>(
    async () =>
      new Response(JSON.stringify(body), {
        status,
        headers: { "Content-Type": "application/json" },
      }),
  );
  vi.stubGlobal("fetch", fetchMock);
  return fetchMock;
}

/** The first request a stubbed fetch received; fails loudly if it received none. */
function firstCall(fetchMock: ReturnType<typeof stubFetch>): { url: string; init: RequestInit } {
  const call = fetchMock.mock.calls[0];
  if (!call) throw new Error("fetch was never called");
  return { url: String(call[0]), init: call[1] ?? {} };
}

afterEach(() => {
  cleanup();
  vi.unstubAllGlobals();
});

describe("unmetRules", () => {
  it("lists every rule a password breaks, in display order", () => {
    expect(unmetRules(strict, "short")).toEqual(["min_length", "uppercase", "number", "symbol"]);
    expect(unmetRules(strict, "Sh0rt!")).toEqual(["min_length"]);
    expect(unmetRules(strict, "Password1!")).toEqual([]);
  });

  it("treats anything that is not A-Z, a-z or 0-9 as a symbol, a space included", () => {
    expect(unmetRules(strict, "Has Space1234")).toEqual([]);
  });

  it("counts characters, not UTF-16 units", () => {
    expect(unmetRules({ ...strict, min_length: 3, has_uppercase: false, has_lowercase: false, has_number: false, has_symbol: false }, "😀😀")).toEqual(["min_length"]);
  });

  it("asks for nothing the policy does not", () => {
    const relaxed: PasswordPolicy = { min_length: 6, has_uppercase: false, has_lowercase: false, has_number: false, has_symbol: false };
    expect(activeRules(relaxed)).toEqual(["min_length"]);
    expect(unmetRules(relaxed, "abcdef")).toEqual([]);
  });
});

describe("PasswordRequirements", () => {
  it("shows every requirement before anything is typed, without scolding", () => {
    const { container } = render(<PasswordRequirements policy={strict} password="" />);
    expect(screen.getByText(/At least 8 characters/)).toBeTruthy();
    expect(screen.getByText(/An uppercase letter/)).toBeTruthy();
    expect(screen.getByText(/A symbol/)).toBeTruthy();
    const states = [...container.querySelectorAll("li")].map((li) => li.getAttribute("data-state"));
    expect(states).toEqual(["pending", "pending", "pending", "pending", "pending"]);
  });

  it("ticks rules off as they are satisfied and marks the rest", () => {
    const { container } = render(<PasswordRequirements policy={strict} password="Sh0rt!" />);
    const state = (rule: string) => container.querySelector(`[data-rule="${rule}"]`)?.getAttribute("data-state");
    expect(state("min_length")).toBe("unmet");
    expect(state("uppercase")).toBe("met");
    expect(state("number")).toBe("met");
    expect(state("symbol")).toBe("met");
  });

  it("marks a rule the SERVER named even when the client thought it was met", () => {
    const { container } = render(
      <PasswordRequirements policy={strict} password="Password1!" serverUnmet={["symbol"]} />,
    );
    expect(container.querySelector('[data-rule="symbol"]')?.getAttribute("data-state")).toBe("unmet");
    expect(container.querySelector('[data-rule="min_length"]')?.getAttribute("data-state")).toBe("met");
  });

  it("never relies on colour alone", () => {
    render(<PasswordRequirements policy={strict} password="Sh0rt!" />);
    expect(screen.getAllByText(/\(met\)/).length).toBeGreaterThan(0);
    expect(screen.getAllByText(/\(not met\)/).length).toBeGreaterThan(0);
  });

  it("renders nothing when the policy could not be loaded", () => {
    const { container } = render(<PasswordRequirements policy={null} password="x" />);
    expect(container.innerHTML).toBe("");
  });
});

describe("the auth client", () => {
  it("reads the policy from the app's own API, and returns null rather than throwing when it cannot", async () => {
    const fetchMock = stubFetch(200, strict);
    expect(await fetchPasswordPolicy()).toEqual(strict);
    expect(firstCall(fetchMock).url).toMatch(/\/auth\/password-policy$/);

    stubFetch(502, { error: "down" });
    expect(await fetchPasswordPolicy()).toBeNull();

    vi.stubGlobal("fetch", vi.fn(async () => { throw new TypeError("Failed to fetch"); }));
    expect(await fetchPasswordPolicy()).toBeNull();
  });

  it("surfaces the specific unmet rules from a sign-up rejection, not a generic sentence", async () => {
    stubFetch(400, {
      error: "That password needs at least 8 characters and a symbol.",
      code: "password_policy",
      unmet: ["min_length", "symbol"],
    });
    const err = await signUp({ email: "a@b.test", password: "short" }).catch((e: unknown) => e);
    expect(err).toBeInstanceOf(AuthError);
    expect((err as AuthError).message).toContain("at least 8 characters");
    expect((err as AuthError).unmet).toEqual(["min_length", "symbol"]);
    expect((err as AuthError).status).toBe(400);
  });

  it("carries no unmet rules for a rejection that is not about the password", async () => {
    stubFetch(401, { error: "Those credentials were not accepted." });
    const err = await signUp({ email: "a@b.test", password: "x" }).catch((e: unknown) => e);
    expect((err as AuthError).unmet).toEqual([]);
  });

  it("posts forgot and reset to the app's own API with credentials", async () => {
    const forgot = stubFetch(202, { message: "If that address has an account, a reset link is on its way." });
    await forgotPassword("a@b.test");
    expect(firstCall(forgot).url).toMatch(/\/auth\/forgot$/);
    expect(firstCall(forgot).init.credentials).toBe("include");
    expect(JSON.parse(String(firstCall(forgot).init.body))).toEqual({ email: "a@b.test" });

    const reset = stubFetch(200, { authenticated: true, email: "a@b.test" });
    const identity = await resetPassword({ userID: "u1", code: "ABC123", password: "NewPassw0rd!" });
    expect(identity.authenticated).toBe(true);
    expect(firstCall(reset).url).toMatch(/\/auth\/reset$/);
    expect(JSON.parse(String(firstCall(reset).init.body))).toEqual({
      userID: "u1",
      code: "ABC123",
      password: "NewPassw0rd!",
    });
  });

  it("treats a thrown fetch as unreachable, not as a rejected password", async () => {
    vi.stubGlobal("fetch", vi.fn(async () => { throw new TypeError("Failed to fetch"); }));
    await waitFor(async () => {
      const err = await forgotPassword("a@b.test").catch((e: unknown) => e);
      expect((err as AuthError).status).toBe(0);
    });
  });
});
