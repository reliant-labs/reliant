//
// The light/dark preference: how it is stored, and how it is read back.
//
// ── Three states, not two ─────────────────────────────────────────────
//
// "system" is the default and is NOT the same as picking light. A user who
// has never touched the toggle should follow their OS, including when the OS
// flips at sunset while the tab is open. Collapsing to a boolean loses that:
// the app would freeze on whatever the OS happened to be at first paint.
//
// ── Where the truth lives ─────────────────────────────────────────────
//
// The resolved theme is written to `data-theme` on <html>, and the CSS in
// globals.css / index.css does the rest — it declares a dark block for
// `[data-theme="dark"]` and for `prefers-color-scheme: dark` when
// data-theme is not "light". So:
//
//   - "system" → the attribute is REMOVED, and the media query applies.
//   - "light" / "dark" → the attribute is set, and beats the media query.
//
// No component subscribes to a theme value to pick classes; every surface
// already uses the semantic tokens (`bg-surface`, `text-ink`) which flip on
// their own. This hook exists for the TOGGLE UI, not for styling.

import { useCallback, useSyncExternalStore } from "react";

/** What the user chose. "system" defers to the OS. */
export type ThemePreference = "light" | "dark" | "system";

/** What is actually on screen once "system" has been resolved. */
export type ResolvedTheme = "light" | "dark";

/**
 * localStorage key. Shared with the pre-paint script in the HTML shell —
 * change it in one place and the other flashes on reload, so the palette
 * contract test asserts the two agree.
 */
export const THEME_STORAGE_KEY = "forge-theme";

const isTheme = (v: unknown): v is ThemePreference =>
  v === "light" || v === "dark" || v === "system";

/** Reads the stored preference. Defaults to "system". */
export function readStoredTheme(): ThemePreference {
  // Storage can throw outright (Safari private mode, embedded webviews with
  // cookies blocked), not merely return null — so this is a try, not a
  // null-check. A theme toggle must never be the thing that white-screens
  // an app.
  try {
    const raw = window.localStorage.getItem(THEME_STORAGE_KEY);
    return isTheme(raw) ? raw : "system";
  } catch {
    return "system";
  }
}

function prefersDark(): boolean {
  return window.matchMedia("(prefers-color-scheme: dark)").matches;
}

/** Resolves a preference against the OS setting. */
export function resolveTheme(pref: ThemePreference): ResolvedTheme {
  if (pref === "system") return prefersDark() ? "dark" : "light";
  return pref;
}

/**
 * Writes the preference to <html>. Exported because the pre-paint script
 * performs the same write — keeping the DOM effect in one named function
 * means the inline script and the React path cannot drift in behaviour.
 */
export function applyTheme(pref: ThemePreference): void {
  const root = document.documentElement;
  if (pref === "system") {
    root.removeAttribute("data-theme");
  } else {
    root.setAttribute("data-theme", pref);
  }
}

// ── The preference is an EXTERNAL store, not React state ──────────────
//
// It lives in localStorage, which React does not own: the pre-paint script
// reads it before React exists, another tab can change it, and the toggle
// writes it. `useSyncExternalStore` is the hook for exactly that shape, and
// it is what keeps SSR honest — it takes a SERVER snapshot separately from
// the client one, so the server and the hydrating client agree by
// construction rather than by a correction after mount.
//
// `storage` only fires in OTHER tabs, so a same-tab write has to announce
// itself; that is what this listener set is for.
const themeListeners = new Set<() => void>();

function subscribeToStoredTheme(onStoreChange: () => void): () => void {
  themeListeners.add(onStoreChange);
  window.addEventListener("storage", onStoreChange);
  return () => {
    themeListeners.delete(onStoreChange);
    window.removeEventListener("storage", onStoreChange);
  };
}

function subscribeToSystemTheme(onStoreChange: () => void): () => void {
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  mq.addEventListener("change", onStoreChange);
  return () => mq.removeEventListener("change", onStoreChange);
}

/**
 * useTheme — the toggle's state.
 *
 * Returns the stored `theme` (which may be "system") and the `resolved`
 * value actually painted, because a toggle UI needs both: which option is
 * selected, and which icon to show.
 *
 * SERVER SNAPSHOTS ARE THE HYDRATION CONTRACT. The third argument to each
 * `useSyncExternalStore` below is what renders on the server AND on the
 * client's first, hydrating render: "system" and light. Neither one touches
 * localStorage or matchMedia, so the two renders cannot disagree — reading
 * either during render is precisely what would reintroduce the hydration
 * mismatch. React swaps in the real client snapshot immediately after
 * mount, and the visible palette is NOT waiting on that: the pre-paint
 * script in the HTML shell has already set data-theme, so the correction is
 * invisible.
 *
 * This replaced a `useState("system")` seeded from an effect. Same three
 * states, same hydration property, same invisible correction — but the
 * preference is now READ from where it actually lives instead of being
 * copied into React state that a second tab could silently make stale.
 */
export function useTheme(): {
  theme: ThemePreference;
  resolved: ResolvedTheme;
  setTheme: (next: ThemePreference) => void;
} {
  const theme = useSyncExternalStore(
    subscribeToStoredTheme,
    readStoredTheme,
    () => "system" as ThemePreference,
  );

  // Follow the OS while the preference is "system" — including a change that
  // happens with the tab open. Subscribed unconditionally and ignored below
  // when the user has picked a side: the media query is cheap, and gating the
  // subscription on `theme` is what a hook cannot do anyway.
  const systemDark = useSyncExternalStore(
    subscribeToSystemTheme,
    prefersDark,
    () => false,
  );

  const resolved: ResolvedTheme =
    theme === "system" ? (systemDark ? "dark" : "light") : theme;

  const setTheme = useCallback((next: ThemePreference) => {
    applyTheme(next);
    try {
      window.localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // Non-fatal: the theme still applies for this page, it just will not
      // survive a reload. Better than breaking the click.
    }
    // Same-tab writes do not fire `storage`, so tell the subscribers here or
    // the toggle would not re-render until something else did.
    for (const listener of themeListeners) listener();
  }, []);

  return { theme, resolved, setTheme };
}
