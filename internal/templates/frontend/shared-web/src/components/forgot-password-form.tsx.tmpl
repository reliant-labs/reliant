{{end}}// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// ForgotPasswordForm — "I forgot my password", for the /auth/forgot screen.
//
// ── What this form can and cannot promise ─────────────────────────────
//
// It asks the server to have the identity provider EMAIL a reset link. The
// provider sends mail only when the app's identity has SMTP configured
// (`smtp` on forge.ManagedIdentity in deploy/kcl). A customer environment that
// declares none accepts the request and delivers nothing — and the provider
// does not tell the app.
//
// So the form does not claim an email is on its way. After a request it says
// "if that address has an account AND this app can send email, a link is
// coming", and the notice under the field says up front that mail needs SMTP.
// The server's answer is the same whether or not the address has an account,
// so this screen cannot be used to find out who is registered.
//
// ── Yours to change ───────────────────────────────────────────────────
//
// An app that delivers the code another way (its own mailer, a support
// console — see handleForgot in internal/app/login_broker.go) should reword
// the notice, and may delete it. An app with working SMTP should delete the
// notice and the second sentence of the confirmation.

import { useState } from "react";

import { AuthAlert, AuthCard, AuthInput, AuthLink } from "@/components/auth-ui";
import { NoCodeHint } from "@/components/sign-in-methods";
import Button from "@/components/ui/button";
import Label from "@/components/ui/label";
import { AuthError, forgotPassword } from "@/lib/auth/native-login";

export function ForgotPasswordForm({ signInHref }: { signInHref: string }) {
  const [email, setEmail] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [sent, setSent] = useState(false);
  const [submitting, setSubmitting] = useState(false);

  async function onSubmit(event: React.FormEvent) {
    event.preventDefault();
    setSubmitting(true);
    setError(null);
    try {
      await forgotPassword(email);
      setSent(true);
    } catch (err) {
      setError(
        err instanceof AuthError ? err.message : "Could not send the request. Please try again.",
      );
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <AuthCard
      title={sent ? "Check your email" : "Reset your password"}
      description={
        sent
          ? undefined
          : "Enter the email address of your account and we'll request a link to choose a new password."
      }
      footer={<AuthLink href={signInHref}>Back to sign in</AuthLink>}
    >
      {sent ? (
        // The same words whether or not the address has an account: this
        // screen must not tell anyone who is registered.
        <AuthAlert tone="success" className="mt-6">
          <p>If that address has an account, a password reset link has been requested.</p>
          <p className="text-ink-muted">
            The link is sent by email, and only if this app&apos;s identity has email delivery
            (SMTP) configured. If nothing arrives, ask whoever runs this app for a reset link.
          </p>
          <NoCodeHint />
        </AuthAlert>
      ) : (
        <form onSubmit={onSubmit} aria-busy={submitting} className="mt-6">
          <Label htmlFor="email">Email</Label>
          <AuthInput
            id="email"
            name="email"
            type="email"
            autoComplete="username"
            placeholder="you@example.com"
            required
            autoFocus
            aria-describedby="forgot-delivery"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
          />

          {/*
            Truthful about delivery: a customer instance has no mail unless
            the environment declares `smtp` (forge.ManagedIdentity.smtp).
            Reword or delete this once your app delivers the code.
          */}
          <p id="forgot-delivery" className="mt-2 text-sm text-ink-muted">
            Heads up: the link is emailed only if this app has email delivery (SMTP) configured.
            Without it, no email is sent.
          </p>

          {error ? <AuthAlert tone="error">{error}</AuthAlert> : null}

          <Button type="submit" size="xl" fullWidth loading={submitting} className="mt-6 h-11">
            {submitting ? "Requesting…" : "Request reset link"}
          </Button>
        </form>
      )}
    </AuthCard>
  );
}
