{{if eq .Platform "nextjs"}}"use client";

{{end}}// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// The pieces every /auth screen is built from: the page frame, the card, the
// inline alerts, the password field with its show/hide control, the "or"
// divider and the text links. Sign-in, sign-up, forgot, reset, invite, magic
// link, verify and the social return all compose these, so restyling the
// sign-in experience is an edit here rather than eight.
//
// ── What is deliberately NOT here ─────────────────────────────────────
//
// A logo or an illustration. The mark above the card is the product's
// initial on an accent tile and its name, drawn from the theme tokens, so it
// is honest placeholder branding: replace <AuthBrand> with your logo. There is
// no marketing panel beside the card either; add one in AuthPage if your
// product wants it.
//
// ── Colour, type and geometry ─────────────────────────────────────────
//
// Only the semantic tokens from globals.css / index.css (`bg-surface`,
// `text-ink`, `text-danger-ink`, …), so dark mode, the theme toggle and a
// rebrand all reach these screens with no edit here. The page sits on
// `surface-sunken` and the card on `surface`, which reads as a raised card in
// both palettes.
//
// ── Accessibility ─────────────────────────────────────────────────────
//
//   - Every alert carries an icon AND words; colour is never the only signal.
//   - An error is role="alert" (announced at once); a notice is role="status".
//   - The show/hide control is a real button with a name and aria-pressed,
//     44px square, so it is a comfortable touch target.
//   - Every focusable thing has a visible keyboard focus outline.

import { Eye, EyeOff, Info, MailCheck, TriangleAlert } from "lucide-react";
import { forwardRef, useState } from "react";

import Input, { type InputProps } from "@/components/ui/input";

/** The product name the screens greet people with. */
const PRODUCT = "{{.ProjectName}}";

/** The keyboard focus ring every bespoke control on these screens uses. */
const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";

/**
 * The full-viewport frame: the sunken page, the brand mark, then the card.
 *
 * On a phone the column starts near the top rather than centring, so the
 * on-screen keyboard does not shove the form around; from `sm` up it centres.
 */
export function AuthPage({ children }: { children: React.ReactNode }) {
  return (
    <main className="flex min-h-dvh flex-col items-center bg-surface-sunken px-4 pt-10 pb-12 text-ink sm:justify-center sm:py-16">
      <div className="w-full max-w-md">
        <AuthBrand />
        {children}
      </div>
    </main>
  );
}

/** Placeholder branding: the product's initial and name. Swap in your logo. */
export function AuthBrand() {
  return (
    <div className="mb-8 flex items-center justify-center gap-2.5">
      <span
        aria-hidden="true"
        className="flex size-9 items-center justify-center rounded-lg bg-accent text-base font-semibold text-on-accent shadow-sm"
      >
        {PRODUCT.charAt(0).toUpperCase()}
      </span>
      <span className="text-lg font-semibold tracking-tight text-ink">{PRODUCT}</span>
    </div>
  );
}

/**
 * The card: a heading, an optional line under it, and the body.
 *
 * `footer` renders BELOW the card — the quiet "New here? Create an account"
 * line — so the card holds only the task at hand.
 */
export function AuthCard({
  title,
  description,
  children,
  footer,
}: {
  title: React.ReactNode;
  description?: React.ReactNode;
  children?: React.ReactNode;
  footer?: React.ReactNode;
}) {
  return (
    <>
      <section className="rounded-xl border border-border bg-surface p-6 shadow-md sm:p-8">
        <header>
          <h1 className="text-2xl font-semibold tracking-tight text-balance text-ink">{title}</h1>
          {description ? (
            <p className="mt-2 text-sm text-pretty text-ink-muted">{description}</p>
          ) : null}
        </header>
        {children}
      </section>
      {footer ? <div className="mt-6 text-center text-sm text-ink-muted">{footer}</div> : null}
    </>
  );
}

type AlertTone = "error" | "info" | "success";

const alertTone: Record<AlertTone, string> = {
  error: "border-danger-border bg-danger-surface text-danger-ink",
  info: "border-border bg-surface-muted text-ink",
  success: "border-success-border bg-success-surface text-success-ink",
};

const alertIcon: Record<AlertTone, typeof Info> = {
  error: TriangleAlert,
  info: Info,
  success: MailCheck,
};

/**
 * An inline message inside the card. `error` is announced at once
 * (role="alert"); `info` and `success` politely (role="status").
 */
export function AuthAlert({
  tone,
  children,
  className,
  id,
}: {
  tone: AlertTone;
  children: React.ReactNode;
  className?: string;
  id?: string;
}) {
  const Icon = alertIcon[tone];
  return (
    <div
      id={id}
      role={tone === "error" ? "alert" : "status"}
      className={[
        "flex gap-3 rounded-lg border p-3 text-sm",
        alertTone[tone],
        className ?? "mt-4",
      ].join(" ")}
    >
      <Icon aria-hidden="true" className="mt-0.5 size-4 shrink-0" />
      <div className="min-w-0 flex-1 space-y-1 break-words">{children}</div>
    </div>
  );
}

/**
 * A password input with a show/hide control.
 *
 * Seeing what you typed is the cheapest fix for a mistyped password, and the
 * single biggest reason people reach for "Forgot password?". The input keeps
 * its `autoComplete`, so password managers still fill and save it.
 */
export const PasswordInput = forwardRef<HTMLInputElement, Omit<InputProps, "type">>(
  function PasswordInput({ className, ...props }, ref) {
    const [visible, setVisible] = useState(false);
    return (
      <div className="relative">
        <Input
          ref={ref}
          {...props}
          type={visible ? "text" : "password"}
          className={["h-11 pe-11 max-sm:text-base", className ?? ""].join(" ")}
        />
        <button
          type="button"
          aria-label="Show password"
          aria-pressed={visible}
          aria-controls={props.id}
          onClick={() => setVisible((v) => !v)}
          className={`absolute inset-y-0 end-0 flex w-11 items-center justify-center rounded-e-md text-ink-subtle transition-colors hover:text-ink ${focusRing} focus-visible:-outline-offset-2`}
        >
          {visible ? (
            <EyeOff aria-hidden="true" className="size-4" />
          ) : (
            <Eye aria-hidden="true" className="size-4" />
          )}
        </button>
      </div>
    );
  },
);

/** The plain text field at the same height as the password field and buttons. */
export const AuthInput = forwardRef<HTMLInputElement, InputProps>(function AuthInput(
  { className, ...props },
  ref,
) {
  return (
    <Input ref={ref} {...props} className={["h-11 max-sm:text-base", className ?? ""].join(" ")} />
  );
});

/** "or", between the password form and the other ways in. */
export function AuthDivider({ label = "or" }: { label?: string }) {
  return (
    <div className="my-6 flex items-center gap-3">
      <span aria-hidden="true" className="h-px flex-1 bg-border" />
      <span className="text-xs font-medium tracking-wide text-ink-subtle uppercase">{label}</span>
      <span aria-hidden="true" className="h-px flex-1 bg-border" />
    </div>
  );
}

const linkClass = `rounded-sm font-medium text-accent underline decoration-accent-border underline-offset-4 transition-colors hover:text-accent-hover hover:decoration-current ${focusRing}`;

/** A text link in the accent colour, underlined so colour is not its only cue. */
export function AuthLink({
  href,
  children,
  className,
}: {
  href: string;
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <a href={href} className={[linkClass, className ?? ""].join(" ")}>
      {children}
    </a>
  );
}

/** A button that looks like an AuthLink: for in-page switches (sign in / sign up). */
export function AuthTextButton({
  onClick,
  children,
}: {
  onClick: () => void;
  children: React.ReactNode;
}) {
  return (
    <button type="button" onClick={onClick} className={linkClass}>
      {children}
    </button>
  );
}
