//
// PasswordRequirements — what a password must contain, shown BEFORE the person
// types one, ticking off as they do.
//
// The sign-up screen used to say nothing until the server refused a password,
// and then said "That password does not meet the requirements." without
// naming one. This is the other half of that fix: the requirements come from
// the identity provider's own policy (GET /auth/password-policy), so what this
// shows is what the provider enforces — per instance, not a guess.
//
// ── Guidance, not enforcement ─────────────────────────────────────────
//
// The checks here are a courtesy. The server decides: a password that passes
// every tick can still be refused (a policy the provider changed a moment ago,
// a rule this list does not know), and the refusal comes back as `serverUnmet`
// so the rule that failed is marked even though the client thought it passed.
//
// ── If the policy cannot be loaded ────────────────────────────────────
//
// The component renders nothing and the form works without it. A missing
// checklist is a worse form, not a broken one. The policy comes from
// usePasswordPolicy() in @/lib/auth/use-password-policy — a hook kept out of
// this file so it exports only a component, which React Fast Refresh needs to
// hot-swap it.

import {
  activeRules,
  describeRule,
  unmetRules,
  type PasswordPolicy,
  type PasswordRule,
} from "@/lib/auth/native-login";

/**
 * The checklist.
 *
 * `password` is what has been typed so far. A rule is shown as:
 *   - pending (neutral) while nothing is typed — the requirements are visible
 *     up front without scolding someone who has not started;
 *   - met (ticked) when the typed password satisfies it;
 *   - unmet (marked) once typing has started and it is not yet satisfied, or
 *     when the server named it in `serverUnmet`.
 */
export function PasswordRequirements({
  policy,
  password,
  serverUnmet = [],
  id,
}: {
  policy: PasswordPolicy | null;
  password: string;
  serverUnmet?: PasswordRule[];
  id?: string;
}) {
  if (!policy) return null;
  const rules = activeRules(policy);
  if (rules.length === 0) return null;

  const typing = password.length > 0;
  const failing = new Set(unmetRules(policy, password));

  return (
    <div id={id} className="mt-2 text-xs text-ink-muted">
      <p id={id ? `${id}-title` : undefined}>Your password needs:</p>
      <ul aria-labelledby={id ? `${id}-title` : undefined} className="mt-1 space-y-0.5">
        {rules.map((rule) => {
          const flagged = serverUnmet.includes(rule);
          const met = typing && !failing.has(rule) && !flagged;
          const unmet = flagged || (typing && failing.has(rule));
          return (
            <li
              key={rule}
              data-rule={rule}
              data-state={met ? "met" : unmet ? "unmet" : "pending"}
              className={
                met
                  ? "text-success-ink"
                  : unmet
                    ? "text-danger-ink"
                    : "text-ink-muted"
              }
            >
              {/* The glyph is decoration; the word carries the state for a
                  screen reader, so colour is never the only signal. */}
              <span aria-hidden="true">{met ? "✓" : unmet ? "✗" : "•"}</span>{" "}
              {describeRule(policy, rule)}
              <span className="sr-only">
                {met ? " (met)" : unmet ? " (not met)" : ""}
              </span>
            </li>
          );
        })}
      </ul>
    </div>
  );
}
