//
// PasswordRequirements — what a password must contain, shown BEFORE the person
// types one, each rule turning green with a tick the moment it is satisfied.
//
// The sign-up screen used to say nothing until the server refused a password,
// and then said "That password does not meet the requirements." without
// naming one. This is the other half of that fix: the requirements come from
// the identity provider's own policy (GET /auth/password-policy), so what this
// shows is what the provider enforces — per instance, not a guess.
//
// ── Guidance, not enforcement ─────────────────────────────────────────
//
// The checks here are a courtesy. The server decides: a password that passes
// every tick can still be refused (a policy the provider changed a moment ago,
// a rule this list does not know), and the refusal comes back as `serverUnmet`
// so the rule that failed is marked even though the client thought it passed.
//
// ── Encouraging, then specific ────────────────────────────────────────
//
// While someone is typing, a rule they have not met yet stays neutral: a
// half-typed password is not a mistake, and a list that turns red on the first
// keystroke scolds people for typing. Only once they try to submit
// (`attempted`), or the server names a rule, does an unmet rule turn red with
// a cross.
//
// ── If the policy cannot be loaded ────────────────────────────────────
//
// The component renders nothing and the form works without it: the server's
// own message names what it refused when the password is submitted. A missing
// checklist is a worse form, not a broken one. The policy comes from
// usePasswordPolicy() in @/lib/auth/use-password-policy — a hook kept out of
// this file so it exports only a component, which React Fast Refresh needs to
// hot-swap it.
//
// Nothing here depends on who is signing up: the policy is the same for every
// visitor, so the checklist cannot reveal whether an address has an account.

import { Check, X } from "lucide-react";

import {
  activeRules,
  describeRule,
  unmetRules,
  type PasswordPolicy,
  type PasswordRule,
} from "@/lib/auth/native-login";

/**
 * The checklist.
 *
 * `password` is what has been typed so far. A rule's `data-state` is:
 *   - pending while nothing is typed — the requirements are visible up front;
 *   - met (green, ticked) when the typed password satisfies it;
 *   - unmet once typing has started and it is not yet satisfied, or when the
 *     server named it in `serverUnmet`. It is DRAWN neutral while typing and
 *     red with a cross once `attempted` is set or the server named it.
 */
export function PasswordRequirements({
  policy,
  password,
  serverUnmet = [],
  attempted = false,
  id,
}: {
  policy: PasswordPolicy | null;
  password: string;
  serverUnmet?: PasswordRule[];
  /** The person tried to submit: draw every unmet rule as an error. */
  attempted?: boolean;
  id?: string;
}) {
  if (!policy) return null;
  const rules = activeRules(policy);
  if (rules.length === 0) return null;

  const typing = password.length > 0;
  const failing = new Set(unmetRules(policy, password));
  const metCount = typing
    ? rules.filter((r) => !failing.has(r) && !serverUnmet.includes(r)).length
    : 0;
  const allMet = metCount === rules.length;
  const titleId = id ? `${id}-title` : undefined;

  return (
    <div id={id} className="mt-3 rounded-lg border border-border bg-surface-muted px-3.5 py-3">
      <div className="flex items-baseline justify-between gap-3">
        <p id={titleId} className="text-sm font-medium text-ink">
          Your password needs
        </p>
        {/* The count is a glance for sighted users; the list itself carries
            each rule's state for a screen reader. */}
        <p aria-hidden="true" className="text-xs text-ink-muted tabular-nums">
          {metCount} of {rules.length}
        </p>
      </div>
      <ul aria-labelledby={titleId} className="mt-2 grid gap-x-4 gap-y-1.5 sm:grid-cols-2">
        {rules.map((rule) => {
          const flagged = serverUnmet.includes(rule);
          const met = typing && !failing.has(rule) && !flagged;
          const unmet = flagged || (typing && failing.has(rule));
          const failed = flagged || (attempted && !met);
          return (
            <li
              key={rule}
              data-rule={rule}
              data-state={met ? "met" : unmet ? "unmet" : "pending"}
              className={[
                "flex items-center gap-2 text-sm transition-colors duration-150",
                met ? "text-success-ink" : failed ? "text-danger-ink" : "text-ink-muted",
              ].join(" ")}
            >
              {/* The glyph is decoration; the words carry the state for a
                  screen reader, so colour is never the only signal. */}
              <span
                aria-hidden="true"
                className={[
                  "flex size-4 shrink-0 items-center justify-center rounded-full border transition-colors duration-150",
                  met
                    ? "border-success bg-success text-surface"
                    : failed
                      ? "border-danger-border bg-danger-surface text-danger-ink"
                      : "border-border-strong bg-surface",
                ].join(" ")}
              >
                {met ? (
                  <Check className="size-3" strokeWidth={3} />
                ) : failed ? (
                  <X className="size-3" strokeWidth={3} />
                ) : null}
              </span>
              <span>{describeRule(policy, rule)}</span>
              <span className="sr-only">{met ? " (met)" : unmet ? " (not met)" : ""}</span>
            </li>
          );
        })}
      </ul>
      {/* One polite announcement when the last rule is met, rather than one
          per keystroke. */}
      <p aria-live="polite" className="sr-only">
        {allMet ? "Your password meets every requirement." : ""}
      </p>
    </div>
  );
}
