//
// ResetPasswordForm — choose a new password with the code from a reset link,
// for the /auth/reset screen.
//
// ── Where the link comes from ─────────────────────────────────────────
//
//   <your app>/auth/reset?userID=…&code=…&orgID=…
//
// That shape is what the control plane hands the identity provider as the
// reset-link template, so a link the provider emails lands here. `userID` and
// `code` are what the server needs; `orgID` is carried by the link and not
// used. A page that opens with no userID or no code cannot do anything, and
// says so instead of showing a form that can only fail.
//
// ── The code is a credential ──────────────────────────────────────────
//
// It is sent once, to the server, with the new password — never logged and
// never echoed back. The page keeps it in the URL it arrived in; once the
// reset succeeds the code is spent, so a reload of the same link does nothing.
//
// ── Requirements ──────────────────────────────────────────────────────
//
// Shown up front and ticked off as the person types (PasswordRequirements).
// A rejection from the server marks the exact rules it found unmet. The server
// decides; the ticks are guidance.

import { useState } from "react";

import { PasswordRequirements } from "@/components/password-requirements";
import Button from "@/components/ui/button";
import { AuthError, resetPassword, type PasswordRule } from "@/lib/auth/native-login";
import { useAuth } from "@/lib/auth/use-auth";
import { usePasswordPolicy } from "@/lib/auth/use-password-policy";

export function ResetPasswordForm({
  userID,
  code,
  signInHref,
  forgotHref,
  onDone,
}: {
  userID: string | null;
  code: string | null;
  signInHref: string;
  forgotHref: string;
  /** Called once the password is set. `signedIn` is false if the follow-up sign-in failed. */
  onDone: (signedIn: boolean) => void;
}) {
  const { refresh } = useAuth();
  const policy = usePasswordPolicy();

  const [password, setPassword] = useState("");
  const [confirm, setConfirm] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [serverUnmet, setServerUnmet] = useState<PasswordRule[]>([]);
  const [submitting, setSubmitting] = useState(false);

  if (!userID || !code) {
    return (
      <div className="rounded-xl border border-border bg-surface p-8 shadow-sm">
        <h1 className="text-xl font-semibold tracking-tight text-ink">
          This reset link is incomplete
        </h1>
        <p className="mt-2 text-sm text-ink-muted">
          Open the link exactly as it was sent to you, or request a new one.
        </p>
        <p className="mt-4 text-sm">
          <a className="font-medium text-accent underline" href={forgotHref}>
            Request a new reset link
          </a>
        </p>
      </div>
    );
  }

  const mismatch = confirm.length > 0 && confirm !== password;

  async function onSubmit(event: React.FormEvent) {
    event.preventDefault();
    if (password !== confirm) {
      setError("The two passwords do not match.");
      return;
    }
    setSubmitting(true);
    setError(null);
    setServerUnmet([]);
    try {
      const identity = await resetPassword({
        userID: userID as string,
        code: code as string,
        password,
      });
      if (identity.authenticated) await refresh();
      onDone(identity.authenticated);
    } catch (err) {
      if (err instanceof AuthError) {
        setError(err.message);
        setServerUnmet(err.unmet);
      } else {
        setError("Could not reset the password. Please try again.");
      }
      setSubmitting(false);
    }
  }

  return (
    <form
      onSubmit={onSubmit}
      className="rounded-xl border border-border bg-surface p-8 shadow-sm"
    >
      <h1 className="text-xl font-semibold tracking-tight text-ink">Choose a new password</h1>

      <label className="mt-6 block text-sm font-medium text-ink" htmlFor="password">
        New password
      </label>
      <input
        id="password"
        name="password"
        type="password"
        autoComplete="new-password"
        required
        autoFocus
        aria-describedby="password-requirements"
        value={password}
        onChange={(e) => setPassword(e.target.value)}
        className="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink outline-none focus:border-accent"
      />
      <PasswordRequirements
        id="password-requirements"
        policy={policy}
        password={password}
        serverUnmet={serverUnmet}
      />

      <label className="mt-4 block text-sm font-medium text-ink" htmlFor="confirm">
        Confirm new password
      </label>
      <input
        id="confirm"
        name="confirm"
        type="password"
        autoComplete="new-password"
        required
        aria-invalid={mismatch}
        value={confirm}
        onChange={(e) => setConfirm(e.target.value)}
        className="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink outline-none focus:border-accent"
      />
      {mismatch ? (
        <p className="mt-1 text-xs text-danger-ink">The two passwords do not match.</p>
      ) : null}

      {error ? (
        <p
          role="alert"
          className="mt-4 break-words rounded-md border border-danger-border bg-danger-surface p-3 text-sm text-danger-ink"
        >
          {error}
        </p>
      ) : null}

      <Button type="submit" disabled={submitting} className="mt-6 w-full">
        {submitting ? "Setting password…" : "Set password"}
      </Button>

      <p className="mt-4 text-center text-sm text-ink-muted">
        <a className="font-medium text-accent underline" href={signInHref}>
          Back to sign in
        </a>
      </p>
    </form>
  );
}
