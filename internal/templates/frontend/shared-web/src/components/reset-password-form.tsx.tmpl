//
// ResetPasswordForm — choose a new password with the code from a reset link,
// for the /auth/reset screen.
//
// ── Where the link comes from ─────────────────────────────────────────
//
//   <your app>/auth/reset?userID=…&code=…&orgID=…
//
// That shape is what the control plane hands the identity provider as the
// reset-link template, so a link the provider emails lands here. `userID` and
// `code` are what the server needs; `orgID` is carried by the link and not
// used. A page that opens with no userID or no code cannot do anything, and
// says so instead of showing a form that can only fail.
//
// ── The code is a credential ──────────────────────────────────────────
//
// It is sent once, to the server, with the new password — never logged and
// never echoed back. The page keeps it in the URL it arrived in; once the
// reset succeeds the code is spent, so a reload of the same link does nothing.
//
// ── Requirements ──────────────────────────────────────────────────────
//
// Shown up front and ticked off as the person types (PasswordRequirements).
// A rejection from the server marks the exact rules it found unmet. The server
// decides; the ticks are guidance.

import { Check, X } from "lucide-react";
import { useRef, useState } from "react";

import { AuthAlert, AuthCard, AuthLink, PasswordInput } from "@/components/auth-ui";
import { PasswordRequirements } from "@/components/password-requirements";
import Button from "@/components/ui/button";
import Label from "@/components/ui/label";
import { AuthError, resetPassword, unmetRules, type PasswordRule } from "@/lib/auth/native-login";
import { useAuth } from "@/lib/auth/use-auth";
import { usePasswordPolicy } from "@/lib/auth/use-password-policy";

export function ResetPasswordForm({
  userID,
  code,
  signInHref,
  forgotHref,
  onDone,
}: {
  userID: string | null;
  code: string | null;
  signInHref: string;
  forgotHref: string;
  /** Called once the password is set. `signedIn` is false if the follow-up sign-in failed. */
  onDone: (signedIn: boolean) => void;
}) {
  const { refresh } = useAuth();
  const policy = usePasswordPolicy();

  const [password, setPassword] = useState("");
  const [confirm, setConfirm] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [serverUnmet, setServerUnmet] = useState<PasswordRule[]>([]);
  const [submitting, setSubmitting] = useState(false);
  const [attempted, setAttempted] = useState(false);
  const passwordRef = useRef<HTMLInputElement>(null);

  if (!userID || !code) {
    return (
      <AuthCard
        title="This reset link is incomplete"
        description="Open the link exactly as it was sent to you, or request a new one."
        footer={<AuthLink href={signInHref}>Back to sign in</AuthLink>}
      >
        <p className="mt-6 text-sm">
          <AuthLink href={forgotHref}>Request a new reset link</AuthLink>
        </p>
      </AuthCard>
    );
  }

  const mismatch = confirm.length > 0 && confirm !== password;
  const matches = confirm.length > 0 && confirm === password;
  // Whether the new password misses a rule the policy states. Drawn red only
  // once the person has tried to submit (`attempted`).
  const passwordUnmet = policy !== null && unmetRules(policy, password).length > 0;

  async function onSubmit(event: React.FormEvent) {
    event.preventDefault();
    // A password that misses a stated rule would only come back refused: say
    // so at the checklist, without the round trip. The server still checks.
    if (passwordUnmet) {
      setAttempted(true);
      setError("Your new password doesn't meet every requirement yet.");
      passwordRef.current?.focus();
      return;
    }
    if (password !== confirm) {
      setError("The two passwords do not match.");
      return;
    }
    setSubmitting(true);
    setError(null);
    setServerUnmet([]);
    try {
      const identity = await resetPassword({
        userID: userID as string,
        code: code as string,
        password,
      });
      if (identity.authenticated) await refresh();
      onDone(identity.authenticated);
    } catch (err) {
      if (err instanceof AuthError) {
        setError(err.message);
        setServerUnmet(err.unmet);
        if (err.unmet.length > 0) setAttempted(true);
      } else {
        setError("Could not reset the password. Please try again.");
      }
      setSubmitting(false);
    }
  }

  return (
    <AuthCard
      title="Choose a new password"
      footer={<AuthLink href={signInHref}>Back to sign in</AuthLink>}
    >
      <form onSubmit={onSubmit} aria-busy={submitting} className="mt-6">
        <div className="space-y-5">
          <div>
            <Label htmlFor="password">New password</Label>
            <PasswordInput
              ref={passwordRef}
              id="password"
              name="password"
              autoComplete="new-password"
              required
              autoFocus
              aria-describedby={policy ? "password-requirements" : undefined}
              invalid={serverUnmet.length > 0 || (attempted && passwordUnmet)}
              value={password}
              onChange={(e) => {
                setPassword(e.target.value);
                // A changed password is a new one: the server's verdict on
                // the last one no longer applies to it.
                if (serverUnmet.length > 0 || attempted) {
                  setServerUnmet([]);
                  setError(null);
                }
              }}
            />
            <PasswordRequirements
              id="password-requirements"
              policy={policy}
              password={password}
              serverUnmet={serverUnmet}
              attempted={attempted}
            />
          </div>

          <div>
            <Label htmlFor="confirm">Confirm new password</Label>
            <PasswordInput
              id="confirm"
              name="confirm"
              autoComplete="new-password"
              required
              invalid={mismatch}
              aria-describedby="confirm-hint"
              value={confirm}
              onChange={(e) => setConfirm(e.target.value)}
            />
            {/* Always in the tree so aria-describedby never points at nothing;
                empty until there is something to say. */}
            <p
              id="confirm-hint"
              className={[
                "mt-2 flex min-h-5 items-center gap-1.5 text-sm",
                mismatch ? "text-danger-ink" : "text-success-ink",
              ].join(" ")}
            >
              {mismatch ? (
                <>
                  <X aria-hidden="true" className="size-4 shrink-0" />
                  The two passwords do not match.
                </>
              ) : matches ? (
                <>
                  <Check aria-hidden="true" className="size-4 shrink-0" />
                  The passwords match.
                </>
              ) : null}
            </p>
          </div>
        </div>

        {error ? <AuthAlert tone="error">{error}</AuthAlert> : null}

        <Button type="submit" size="xl" fullWidth loading={submitting} className="mt-6 h-11">
          {submitting ? "Setting password…" : "Set password"}
        </Button>
      </form>
    </AuthCard>
  );
}
