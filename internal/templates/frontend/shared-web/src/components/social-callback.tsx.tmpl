{{if eq .Platform "nextjs"}}"use client";

{{end}}// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// SocialCallback — the /auth/social/callback page a Google or GitHub sign-in
// returns to. The identity provider appended `id` and `token`; this page
// hands them to this app's server, which checks they belong to a sign-in
// THIS browser started, and answers with a session (or says why not).
//
// Unlike the emailed-link pages it acts on load: nothing mails this URL, so
// no scanner opens it, and the person already clicked "Continue with …".

import { LoaderCircle } from "lucide-react";
import { useEffect, useRef, useState } from "react";

import { AuthAlert, AuthCard, AuthLink } from "@/components/auth-ui";
import { AuthError, isVerifySent, socialComplete } from "@/lib/auth/native-login";
import { safeReturnTo } from "@/lib/auth/return-to";

export interface SocialCallbackProps {
  id: string | null;
  token: string | null;
  signInHref: string;
  /** Called with the same-origin path to land on once signed in. */
  onSignedIn: (returnTo: string) => void | Promise<void>;
}

export function SocialCallback({ id, token, signInHref, onSignedIn }: SocialCallbackProps) {
  const incomplete = !id || !token;
  const [message, setMessage] = useState<string | null>(
    incomplete ? "That sign-in did not complete. Please try again." : null,
  );
  const [failed, setFailed] = useState(incomplete);
  const started = useRef(false);

  useEffect(() => {
    // Once: React's development double-invoke must not post the token twice.
    if (started.current || !id || !token) return;
    started.current = true;
    void socialComplete(id, token)
      .then(async (result) => {
        if (isVerifySent(result)) {
          setMessage(result.message);
          return;
        }
        // The server checked it too; the browser checks again, as it would
        // any path it is handed (src/lib/auth/return-to.ts).
        await onSignedIn(safeReturnTo(result.returnTo));
      })
      .catch((err: unknown) => {
        setFailed(true);
        setMessage(
          err instanceof AuthError
            ? err.message
            : "That sign-in did not complete. Please try again.",
        );
      });
  }, [id, token, onSignedIn]);

  return (
    <AuthCard
      title="Signing in to {{.ProjectName}}"
      footer={message ? <AuthLink href={signInHref}>Back to sign in</AuthLink> : null}
    >
      {message ? (
        <AuthAlert tone={failed ? "error" : "success"} className="mt-6">
          {message}
        </AuthAlert>
      ) : (
        <p role="status" className="mt-6 flex items-center gap-3 text-sm text-ink-muted">
          <LoaderCircle aria-hidden="true" className="size-4 shrink-0 motion-safe:animate-spin" />
          One moment…
        </p>
      )}
    </AuthCard>
  );
}
