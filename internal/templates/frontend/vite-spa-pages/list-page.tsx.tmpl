// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// This route is OWNED and DISPOSABLE. forge scaffolds a full CRUD route for
// EVERY entity, but a purpose-built frontend uses only a fraction — if this
// entity isn't part of THIS frontend's product surface, delete the route
// instead of leaving it wired into navigation.
// {{.EntityNamePlural}} list page — generated by `forge scaffold page`.
//
// This Vite SPA consumes the SAME forge runtime as the Next.js frontend —
// the runtime is framework-agnostic (pure React/TS), so there is no parallel
// table implementation to drift:
//   - <Resource> (@reliantlabs/forge-web-runtime) owns the loading / error /
//     empty / data tristate ladder, the debounced server-side filter box,
//     and cursor pagination. This page never re-hand-rolls that ladder and
//     never client-side-filters a single fetched page.
//   - Filtering + pagination happen SERVER-SIDE via the List RPC's own
//     request filter fields (the SAME fields the backend query filters on);
//     the response's next_page_token drives the cursor.
//   - Prior rows stay visible (dimmed) across page/filter changes via
//     `placeholderData: keepPreviousData` — no skeleton flash.
//   - Typed columns: enum columns render through <StatusBadge>, which takes
//     the raw field plus the enum object and does the protobuf-es NUMBER →
//     member-name reverse map itself; money (*_cents) columns format as
//     currency.
//
// This file is yours — hand-edit freely. To regenerate it from the current
// proto, delete the file and run `forge project rescaffold <path>`.
{{- /* Import ORDER is derived, not authored. This import set is conditional
       on the entity's shape and two of its paths are only known at render
       time (the service hooks module, the enums' protobuf-es module), so no
       fixed line order here can be canonical for every entity. The page
       writer sorts what was actually emitted — see
       templates.CanonicalTSImportOrder. List a new import wherever it reads
       best; do not hand-maintain the order. */}}
{{- if or .HasCursorPagination .SearchFilterField .ExactFilterFields}}

import { useState } from "react";
{{- end}}
import { Resource, type ResourceColumn } from "@reliantlabs/forge-web-runtime";
import { keepPreviousData } from "@tanstack/react-query";
{{- if or .HasCreate .EmitsDetailPage}}
import { {{if .HasCreate}}Link{{end}}{{if and .HasCreate .EmitsDetailPage}}, {{end}}{{if .EmitsDetailPage}}useNavigate{{end}} } from "@tanstack/react-router";
{{- end}}
{{- if .HasCreate}}
import { Plus } from "lucide-react";
{{- end}}

{{if .HasBadgeColumns}}import { StatusBadge } from "@/components/status-badge";
{{end}}import { useQueryResource{{if .HasScalarExactFilter}}, useDebouncedValue{{end}} } from "@/hooks/use-query-resource";
import { {{if .HasMoneyColumns}}formatMoneyCents, {{end}}formatValue } from "@/lib/format-utils";
import { use{{.ListRPC}} } from "{{.HooksImportPath}}";
{{- range .ListEnumImports}}
import { {{range $i, $t := .Types}}{{if $i}}, {{end}}{{$t}}{{end}} } from "{{.Path}}";
{{- end}}

import type { {{.EntityName}} } from "{{.EntityTypeImportPath}}";
{{- if .HasPageSize}}

// Rows per page requested from the server. Paginate the result with the
// <Resource> footer's Prev/Next (they walk the next_page_token cursor).
const PAGE_SIZE = 25;
{{- end}}

// ---- Typed columns ----
// One entry per renderable proto field, type-checked against {{.EntityName}}.
{{- if .EmitsDetailPage}}
// The id and the created/updated timestamps are deliberately NOT here — the row
// already links to the detail page, which is where they belong. Add one back if
// this list needs it; this file is yours.
{{- else}}
// The service has no Get RPC, so there is no detail page: rows are not links,
// and the id and timestamps a detail page would show stay here instead. Add a
// Get RPC (and delete + rescaffold this file) to give records a page of their own.
{{- end}}
const columns: ResourceColumn<{{.EntityName}}>[] = [
{{- range .ListColumns}}
  {
    header: "{{.Label}}",
{{- if .IsBadge}}
{{- if .EnumType}}
    cell: (item) => <StatusBadge value={item.{{.Name}}} enumType={ {{.EnumType}} } />,
{{- else}}
    cell: (item) => <StatusBadge value={item.{{.Name}}} />,
{{- end}}
{{- else if .IsMoney}}
    cell: (item) => formatMoneyCents(item.{{.Name}}{{if .CurrencyField}}, item.{{.CurrencyField}}{{end}}),
{{- else}}
    cell: (item) => formatValue(item.{{.Name}}),
{{- end}}
  },
{{- end}}
];

export default function {{.EntityNamePlural}}Page() {
{{- if .EmitsDetailPage}}
  const navigate = useNavigate();
{{- end}}
{{- if .HasCursorPagination}}

  // Cursor stack: each entry is the page_token that opened that page (the
  // last entry is the current page; empty = first page). Any filter change
  // resets the stack to page one.
  const [cursor, setCursor] = useState<string[]>([]);
{{- end}}
{{- if .SearchFilterField}}
  const [search, setSearch] = useState("");
{{- end}}
{{- range .ExactFilterFields}}
{{- if eq .Kind "enum"}}
  const [{{.Name}}, set{{.NamePascal}}] = useState<{{.EnumType}} | undefined>(undefined);
{{- else if eq .Kind "bool"}}
  const [{{.Name}}, set{{.NamePascal}}] = useState<boolean | undefined>(undefined);
{{- else}}
  // Debounced so typing doesn't fire one RPC per keystroke.
  const [{{.Name}}Input, set{{.NamePascal}}Input] = useState("");
  const {{.Name}} = useDebouncedValue({{.Name}}Input, 300);
{{- end}}
{{- end}}

  // Server-side query: filters + cursor go to the backend; nothing is
  // filtered or capped in the browser.
  const query = use{{.ListRPC}}({
{{- if .HasPageSize}}
    pageSize: PAGE_SIZE,
{{- end}}
{{- if .HasCursorPagination}}
    pageToken: cursor.at(-1),
{{- end}}
{{- if .SearchFilterField}}
    {{.SearchFilterField}}: search || undefined,
{{- end}}
{{- range .ExactFilterFields}}
{{- if eq .Kind "number"}}
{{- if .IsBigInt}}
    {{- /* A 64-bit filter goes through the DIGITS, never through Number():
           an exact-match filter on 9007199254740993 rounded through a double
           queries 9007199254740992 and quietly returns the wrong row (or
           none). Non-digits mean "no filter" rather than a thrown BigInt. */}}
    {{.Name}}: /^-?\d+$/.test({{.Name}}) ? BigInt({{.Name}}) : undefined,
{{- else}}
    {{.Name}}: {{.Name}} === "" ? undefined : Number({{.Name}}),
{{- end}}
{{- else if eq .Kind "text"}}
    {{.Name}}: {{.Name}} || undefined,
{{- else}}
    {{.Name}}: {{.Name}},
{{- end}}
{{- end}}
  }, { placeholderData: keepPreviousData });
  const resource = useQueryResource(query);
{{- if .HasCursorPagination}}

  const nextToken = resource.status === "success" ? resource.data.{{.NextTokenField}} : "";
{{- end}}
{{- if .HasTotalCount}}
  const total = resource.status === "success" ? resource.data.{{.TotalCountField}} : undefined;
{{- end}}

  return (
    <Resource<{{.EntityName}}>
      title="{{.EntityNamePlural | humanize}}"
      status={resource.status}
      data={resource.status === "success" ? resource.data.{{.ItemsField}} : undefined}
      error={resource.status === "error" ? resource.error : undefined}
      onRetry={resource.status === "error" ? resource.refetch : undefined}
      isFetching={query.isFetching}
      columns={columns}
      rowKey={(item) => String(item.{{.PkFieldCamel}})}
{{- if .EmitsDetailPage}}
      onRowClick={(item) => void navigate({ to: `/{{.EntitySlug}}/$id`, params: { id: String(item.{{.PkFieldCamel}}) } })}
{{- end}}
      emptyTitle="No {{.EntityNamePlural | humanLower}} found"
      emptyMessage="No records match the current view."
{{- if .SearchFilterField}}
      filter={search}
      onFilterChange={(value) => {
        setSearch(value);
{{- if .HasCursorPagination}}
        setCursor([]);
{{- end}}
      }}
      filterPlaceholder="Search {{.EntityNamePlural | humanLower}}…"
{{- end}}
{{- if .HasCursorPagination}}
      onNextPage={() => setCursor((c) => [...c, nextToken])}
      onPrevPage={() => setCursor((c) => c.slice(0, -1))}
      hasNextPage={Boolean(nextToken)}
      hasPrevPage={cursor.length > 0}
{{- end}}
{{- if or .HasCreate .HasTotalCount .ExactFilterFields}}
      actions={
        <>
{{- if .HasTotalCount}}
          {total !== undefined ? (
            <span className="text-sm text-ink-muted">{total} total</span>
          ) : null}
{{- end}}
{{- range .ExactFilterFields}}
{{- if eq .Kind "enum"}}
          <select
            aria-label="Filter by {{.Label | lower}}"
            value={ {{.Name}} === undefined ? "" : String({{.Name}}) }
            onChange={(e) => {
              const v = e.target.value;
              set{{.NamePascal}}(v === "" ? undefined : (Number(v) as {{.EnumType}}));
{{- if $.HasCursorPagination}}
              setCursor([]);
{{- end}}
            }}
            className="rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          >
            <option value="">All {{.Label | lower}}</option>
{{- range .EnumValues}}
            <option value={String({{.Ref}})}>{{.Label}}</option>
{{- end}}
          </select>
{{- else if eq .Kind "bool"}}
          <select
            aria-label="Filter by {{.Label | lower}}"
            value={ {{.Name}} === undefined ? "" : {{.Name}} ? "true" : "false" }
            onChange={(e) => {
              const v = e.target.value;
              set{{.NamePascal}}(v === "" ? undefined : v === "true");
{{- if $.HasCursorPagination}}
              setCursor([]);
{{- end}}
            }}
            className="rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          >
            <option value="">All</option>
            <option value="true">{{.Label}}</option>
            <option value="false">Not {{.Label}}</option>
          </select>
{{- else}}
          <input
            {{- /* A 64-bit field is filtered as TEXT: <input type="number"> is a
                   double and cannot hold every int64. */}}
            type="{{if and (eq .Kind "number") (not .IsBigInt)}}number{{else if eq .Kind "number"}}text{{else}}search{{end}}"
            aria-label="Filter by {{.Label | lower}}"
            value={ {{.Name}}Input }
            onChange={(e) => {
              set{{.NamePascal}}Input(e.target.value);
{{- if $.HasCursorPagination}}
              setCursor([]);
{{- end}}
            }}
            placeholder="{{.Label}}"
            className="rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          />
{{- end}}
{{- end}}
{{- if .HasCreate}}
          <Link
            to="/{{.EntitySlug}}/new"
            className="inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-on-accent shadow-sm hover:bg-accent-hover"
          >
            <Plus aria-hidden className="h-4 w-4" strokeWidth={2} />
            Create {{.EntityName | humanize}}
          </Link>
{{- end}}
        </>
      }
{{- end}}
    />
  );
}
