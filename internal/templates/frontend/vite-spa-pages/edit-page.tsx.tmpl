// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// This route is OWNED and DISPOSABLE. forge scaffolds a full CRUD route for
// EVERY entity, but a purpose-built frontend uses only a fraction — if this
// entity isn't part of THIS frontend's product surface, delete the route
// instead of leaving it wired into navigation.
// Edit page emitted by `forge scaffold page`. See `forge skill load frontend/pages` for canonical patterns.
{{- /* Import ORDER is derived, not authored: the page writer sorts the
       imports this render actually emitted into the groups the scaffold's
       eslint import/order rule expects (templates.CanonicalTSImportOrder).
       List a new import wherever it reads best. */}}
{{- if .HasUpdateBytesFields}}
import { base64Decode, base64Encode } from "@bufbuild/protobuf/wire";
{{- end}}
{{- if .HasDateUpdateFields}}
import { timestampFromDate } from "@bufbuild/protobuf/wkt";
{{- end}}
import { zodResolver } from "@hookform/resolvers/zod";
import { userMessage } from "@reliantlabs/forge-web-runtime";
import { Link, useNavigate, useParams } from "@tanstack/react-router";
import { {{if .HasUpdateFK}}Controller, {{end}}useForm } from "react-hook-form";
import { z } from "zod";

{{if .HasUpdateFK}}import { EntityName } from "@/components/entity-name";
import { EntityPicker } from "@/components/entity-picker";
{{end -}}
import AlertBanner from "@/components/ui/alert_banner";
import Button from "@/components/ui/button";
{{- with .UpdateFormControls}}
{{- if .Input}}
import Input from "@/components/ui/input";
{{- end}}
{{- if .Label}}
import Label from "@/components/ui/label";
{{- end}}
{{- end}}
import PageHeader from "@/components/ui/page_header";
{{- with .UpdateFormControls}}
{{- if .Select}}
import Select from "@/components/ui/select";
{{- end}}
{{- end}}
import SkeletonLoader from "@/components/ui/skeleton_loader";
{{- if .UpdateFormControls.Textarea}}
import Textarea from "@/components/ui/textarea";
{{- end}}
{{- range .UpdateEnumImports}}
import { {{joinStrings .Types ", "}} } from "{{.Path}}";
{{- end}}
{{- range .EditHookImports}}
import { {{joinStrings .Symbols ", "}} } from "{{.Module}}";
{{- end}}
{{- if .HasDateUpdateFields}}
import { toDatetimeLocal } from "@/lib/format-utils";
{{- end}}

const schema = z.object({
  {{- range .UpdateFields}}
  {{- /* One expression per field, derived beside the TypeScript projection
         it has to agree with (codegen.attachZodExpr): the zod value's type
         is what the prefill above produces and the submit handler below
         converts FROM, so the three cannot be authored independently. A
         64-bit integer validates as digit TEXT, not as a number — an
         <input type="number"> is a double, and opening this form on a row
         holding 9007199254740993 and pressing Save would write back
         9007199254740992. `bytes` validates as base64, the encoding the
         field already has on the wire.

         An empty input for a proto3 `optional` field validates as unset,
         and the mask below still names the field — so clearing a stored
         value writes NULL instead of leaving it, or writing the zero. */}}
  {{.Name}}: {{.ZodExpr}},
  {{- end}}
{{- if not .UpdateFields}}}){{else}}
}){{end}};

type FormValues = z.infer<typeof schema>;

export default function Edit{{.EntityName}}Page() {
  const params = useParams({ strict: false }) as { id: string };
  const id = params.id;
  const navigate = useNavigate();

  const { data, isLoading, error: fetchError } = use{{.GetRPC}}({ id });
  // Typed access: the response wraps the entity in `{{.GetEntityAccessor}}` —
  // no `?? data` hedging, no Record<string, unknown> cast.
  const item = data?.{{.GetEntityAccessor}};

  const mutation = use{{.UpdateRPC}}({
    onSuccess: () => void navigate({ to: `/{{.EntitySlug}}/${id}` }),
    // The error renders inline below — opt out of the app-wide error
    // toast so the failure isn't announced twice.
    meta: { silenceErrorToast: true },
  });

  const { {{if .HasUpdateFK}}control, {{end}}{{if .HasUpdateRegistered}}register, {{end}}handleSubmit, formState: { errors, isDirty } } = useForm<FormValues>({
    resolver: zodResolver(schema),
    values: item
      ? {
          {{- range .UpdateFields}}
          {{.Name}}: {{.PrefillExpr}},
          {{- end}}
        }
      : undefined,
  });

  function onSubmit(values: FormValues) {
    // Typed end-to-end: every form value that is not already the wire type
    // is converted BEFORE mutate() — date strings to proto Timestamps,
    // 64-bit ints to bigints, base64 text to bytes, comma-separated text
    // to arrays — so the request matches the schema instead of being cast
    // into shape.
{{- if .UpdateEntityFieldCamel}}
    // AIP-134: the entity rides under `{{.UpdateEntityFieldCamel}}` and the
    // mask names exactly the fields this form edits — the server writes
    // those columns and nothing else. Without the mask, columns the form
    // doesn't carry would be replaced by the request's zero values.
    mutation.mutate({
      {{.UpdateEntityFieldCamel}}: {
        {{.PkFieldCamel}}: id,
        ...values,
        {{- range .UpdateFields}}
        {{- if .SubmitExpr}}
        {{- if .SubmitNote}}
        // {{.SubmitNote}}
        {{- end}}
        {{.Name}}: {{.SubmitExpr}},
        {{- end}}
        {{- end}}
      },
      {{- if .UpdateMaskFieldCamel}}
      {{.UpdateMaskFieldCamel}}: { paths: [{{range $i, $f := .UpdateFields}}{{if $i}}, {{end}}"{{$f.ProtoName}}"{{end}}] },
      {{- end}}
    });
{{- else}}
    mutation.mutate({
      id,
      ...values,
      {{- range .UpdateFields}}
      {{- if .SubmitExpr}}
      {{- if .SubmitNote}}
      // {{.SubmitNote}}
      {{- end}}
      {{.Name}}: {{.SubmitExpr}},
      {{- end}}
      {{- end}}
    });
{{- end}}
  }

  // Loading is its own state — bail explicitly. Do not derive booleans from
  // `!isLoading && X` and act on them; that gate is false during the load
  // window AND when the load returns a falsy value, which races and wipes
  // real state. See `frontend/state` ("Loading is not the negative of success").
  if (isLoading) return <div className="mx-auto max-w-xl px-4 py-8"><SkeletonLoader variant="form-field" count={4} /></div>;

  if (fetchError) {
    return (
      <div className="mx-auto max-w-xl px-4 py-8">
        <AlertBanner variant="error" message={userMessage(fetchError)} />
        <Link to="/{{.EntitySlug}}" className="mt-4 inline-flex text-sm text-accent underline hover:text-accent-hover">
          Back to {{.EntityNamePlural | humanLower}}
        </Link>
      </div>
    );
  }

  return (
    <div className="mx-auto max-w-xl px-4 py-8">
      <PageHeader
        title="Edit {{.EntityName | humanize}}"
        breadcrumbs={[
          { label: "{{.EntityNamePlural | humanize}}", href: "/{{.EntitySlug}}" },
          { label: {{if .DisplayField}}item?.{{.DisplayField}} || {{end}}String(item?.{{.PkFieldCamel}} ?? id), href: `/{{.EntitySlug}}/${id}` },
          { label: "Edit" },
        ]}
      />

      {mutation.error && (
        <div className="mb-6">
          <AlertBanner variant="error" message={userMessage(mutation.error)} dismissible onDismiss={() => mutation.reset()} />
        </div>
      )}

      <form onSubmit={handleSubmit(onSubmit)} className="space-y-6 rounded-lg border border-border bg-surface p-6 shadow-sm">
        {{- range .UpdateFormFields}}
        {{- template "formField" .}}
        {{- end}}
        {{- if .HasGuardedFields}}

        {{- /* Columns a custom RPC owns, declared with
               `// forge:guards <table>.<column>` on that rpc's request.
               They are shown, disabled, and NOT in the update_mask above —
               writing them through Update would bypass whatever the rpc
               enforces (an overpayment refusal, a double-booking check) and
               surface as a raw CHECK violation 500.

               Shown rather than omitted on purpose: a field that is simply
               absent tells the reader nothing, while a disabled row naming
               the rpc points at the API that can make the change. Wire the
               button to that rpc's generated hook, or delete the row. */}}
        <div className="space-y-3 border-t border-border pt-6">
          <p className="text-sm font-medium text-ink">Managed elsewhere</p>
          {{- range .GuardedFields}}
          <div className="flex items-center justify-between gap-3 rounded-lg border border-border bg-surface-muted px-3 py-2">
            <div>
              <p className="text-sm font-medium text-ink">{{.Label}}</p>
              <p className="text-xs text-ink-muted">
                Changed through <code>{{.GuardedBy}}</code>, which enforces the rules for this value.
              </p>
            </div>
            <span className="text-sm tabular-nums text-ink-muted">{String(item?.{{.Name}} ?? "")}</span>
          </div>
          {{- end}}
        </div>
        {{- end}}

        <div className="flex items-center justify-end gap-3 border-t border-border pt-6">
          <Button href={`/{{.EntitySlug}}/${id}`} variant="outline" size="lg">
            Cancel
          </Button>
          <Button type="submit" size="lg" loading={mutation.isPending} disabled={mutation.isPending || !isDirty}>
            {mutation.isPending ? "Saving…" : "Save Changes"}
          </Button>
        </div>
      </form>
    </div>
  );
}
