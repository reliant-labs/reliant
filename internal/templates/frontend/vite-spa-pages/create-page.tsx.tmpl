//
// This route is OWNED and DISPOSABLE. forge scaffolds a full CRUD route for
// EVERY entity, but a purpose-built frontend uses only a fraction — if this
// entity isn't part of THIS frontend's product surface, delete the route
// instead of leaving it wired into navigation.
// Create page emitted by `forge scaffold page`. See `forge skill load frontend/pages` for canonical patterns.
{{- /* Import ORDER is derived, not authored: the page writer sorts the
       imports this render actually emitted into the groups the scaffold's
       eslint import/order rule expects (templates.CanonicalTSImportOrder).
       List a new import wherever it reads best. */}}
{{- if .HasCreateBytesFields}}
import { base64Decode } from "@bufbuild/protobuf/wire";
{{- end}}
{{- if .HasDateCreateFields}}
import { timestampFromDate } from "@bufbuild/protobuf/wkt";
{{- end}}
import { zodResolver } from "@hookform/resolvers/zod";
import { userMessage } from "@reliantlabs/forge-web-runtime";
import { useNavigate } from "@tanstack/react-router";
import { {{if .HasCreateFK}}Controller, {{end}}useForm } from "react-hook-form";
import { z } from "zod";

{{if .HasCreateFK}}import { EntityPicker } from "@/components/entity-picker";
{{end -}}
import AlertBanner from "@/components/ui/alert_banner";
import Button from "@/components/ui/button";
{{- with .CreateFormControls}}
{{- if .Input}}
import Input from "@/components/ui/input";
{{- end}}
{{- if .Label}}
import Label from "@/components/ui/label";
{{- end}}
{{- end}}
import PageHeader from "@/components/ui/page_header";
{{- with .CreateFormControls}}
{{- if .Select}}
import Select from "@/components/ui/select";
{{- end}}
{{- end}}
{{- if .CreateFormControls.Textarea}}
import Textarea from "@/components/ui/textarea";
{{- end}}
{{- range .CreateEnumImports}}
import { {{joinStrings .Types ", "}} } from "{{.Path}}";
{{- end}}
{{- range .CreateHookImports}}
import { {{joinStrings .Symbols ", "}} } from "{{.Module}}";
{{- end}}

const schema = z.object({
  {{- range .CreateFields}}
  {{- /* One expression per field, derived beside the TypeScript projection
         it has to agree with (codegen.attachZodExpr): the zod value's type
         is what the submit handler below converts FROM, so the two cannot
         be authored independently. A 64-bit integer validates as digit
         TEXT, not as a number — an <input type="number"> is a double and
         cannot hold every int64. `bytes` validates as base64, the
         encoding the field already has on the wire.

         A field is required only where a rule says so (protovalidate
         `required`, `min_len >= 1`, or a non-optional reference); an empty
         input for a proto3 `optional` field validates as unset, so the
         request omits it instead of sending the zero. */}}
  {{.Name}}: {{.ZodExpr}},
  {{- end}}
{{- if not .CreateFields}}}){{else}}
}){{end}};

type FormValues = z.infer<typeof schema>;

export default function Create{{.EntityName}}Page() {
  const navigate = useNavigate();

  const mutation = use{{.CreateRPC}}({
{{- if and .EmitsDetailPage .CreateEntityFieldCamel}}
    // Land on the record just created — its detail page is where the next
    // step (editing it, adding a related row) starts.
    onSuccess: ({ {{.CreateEntityFieldCamel}}: created }) => void navigate({ to: created ? `/{{.EntitySlug}}/${created.{{.PkFieldCamel}}}` : "/{{.EntitySlug}}" }),
{{- else}}
    onSuccess: () => void navigate({ to: "/{{.EntitySlug}}" }),
{{- end}}
    // The error renders inline below — opt out of the app-wide error
    // toast so the failure isn't announced twice.
    meta: { silenceErrorToast: true },
  });

  const { {{if .HasCreateFK}}control, {{end}}{{if .HasCreateRegistered}}register, {{end}}handleSubmit, formState: { errors } } = useForm<FormValues>({
    resolver: zodResolver(schema),
  });

  function onSubmit(values: FormValues) {
    // Typed end-to-end: every form value that is not already the wire type
    // is converted BEFORE mutate() — date strings to proto Timestamps,
    // 64-bit ints to bigints, base64 text to bytes, comma-separated text
    // to arrays — so the request matches the schema instead of being cast
    // into shape.
    mutation.mutate({
      ...values,
      {{- range .CreateFields}}
      {{- if .SubmitExpr}}
      {{- if .SubmitNote}}
      // {{.SubmitNote}}
      {{- end}}
      {{.Name}}: {{.SubmitExpr}},
      {{- end}}
      {{- end}}
    });
  }

  return (
    <div className="mx-auto max-w-xl px-4 py-8">
      <PageHeader
        title="Create {{.EntityName | humanize}}"
        breadcrumbs={[
          { label: "{{.EntityNamePlural | humanize}}", href: "/{{.EntitySlug}}" },
          { label: "Create" },
        ]}
      />

      {mutation.error && (
        <div className="mb-6">
          <AlertBanner variant="error" message={userMessage(mutation.error)} dismissible onDismiss={() => mutation.reset()} />
        </div>
      )}

      <form onSubmit={handleSubmit(onSubmit)} className="space-y-6 rounded-lg border border-border bg-surface p-6 shadow-sm">
        {{- range .CreateFormFields}}
        {{- template "formField" .}}
        {{- end}}

        <div className="flex items-center justify-end gap-3 border-t border-border pt-6">
          <Button href="/{{.EntitySlug}}" variant="outline" size="lg">
            Cancel
          </Button>
          <Button type="submit" size="lg" loading={mutation.isPending} disabled={mutation.isPending}>
            {mutation.isPending ? "Creating…" : "Create {{.EntityName | humanize}}"}
          </Button>
        </div>
      </form>
    </div>
  );
}
