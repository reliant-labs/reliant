import { GeistMono } from "geist/font/mono";
import { GeistSans } from "geist/font/sans";

import { AppShell } from "@/components/app_shell";
import { MockModeBanner } from "@/components/mock_mode_banner";
import { joinBasePath } from "@/lib/basepath_gen";

import { Providers } from "./providers";

import type { Metadata } from "next";

import "./globals.css";

// Geist and Geist Mono are this project's DECLARED faces, not a taste choice:
// the neutral default a scaffold owes an app that has no brief yet. The
// `geist` package ships the font files and loads them through next/font/local,
// so they are self-hosted — no third-party request at build or run time, and
// no layout shift. To rebrand, swap these loaders and the `--font-sans` /
// `--font-mono` tokens in globals.css — never per-component `font-*` classes.
//
// The loaders' CSS variables (--font-geist-sans, --font-geist-mono) go on the
// html element, not the body: globals.css declares `--font-sans` on :root,
// which IS the html element, and a custom property only resolves where it is
// in scope. Set on the body, the variables are undefined where the token is
// computed, the token is invalid, and every font-* utility silently falls
// back to the OS stack.
const fontVariables = `${GeistSans.variable} ${GeistMono.variable}`;

export const metadata: Metadata = {
  title: "{{.FrontendName}} | {{.ProjectName}}",
  description: "Frontend for the {{.ProjectName}} project",
};

// The pre-paint theme script, hoisted to a const so the JSX below stays a
// plain attribute reference.
//
// It is a const rather than an inline object literal for a scaffolding
// reason, not a style one: forge renders this file through Go's
// text/template, which treats a doubled brace as an action delimiter. An
// inline `dangerouslySetInnerHTML` literal opens with exactly that, so it
// fails to render at scaffold time. Keeping the object up here leaves the
// JSX attribute a bare identifier.
const THEME_BOOT_SCRIPT = {
  __html: `(function(){try{var t=localStorage.getItem("forge-theme");if(t==="dark"||t==="light"){document.documentElement.setAttribute("data-theme",t)}}catch(e){}})();`,
};

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  return (
    <html lang="en" className={fontVariables}>
      <head>
        {/*
          Runtime configuration, rendered by KCL for THIS environment and
          served as a static asset. It must be a plain blocking <script>
          in the head: it assigns window.__FORGE_CONFIG__, and
          src/lib/config_gen.ts reads that global synchronously at module
          scope (the OIDC provider needs its issuer during initialization,
          before any component renders).

          This is what lets one built bundle be promoted between
          environments — NEXT_PUBLIC_* values are inlined at BUILD time and
          freeze an artifact to the environment it was built against, so
          they cannot be. Ship the same bundle beside a different
          config.js instead; nothing is rebuilt.

          next/script is deliberately NOT used: its strategies all defer
          execution past the point the bundle first reads the global.
        */}
        {/* eslint-disable-next-line @next/next/no-sync-scripts */}
        <script src={joinBasePath("/config.js")} />
        {/*
          Theme, applied BEFORE first paint.

          Without this the page paints the light palette, React hydrates,
          an effect reads localStorage and only then swaps to dark — a
          white flash on every single load for every dark-mode user. The
          fix has to run synchronously in <head>, before the browser
          paints, which rules out a component and rules out next/script
          (every strategy defers past first paint).

          It only sets the attribute for an EXPLICIT choice. Left absent,
          the `prefers-color-scheme` block in globals.css applies, so a
          user on "system" is already correct with no JS at all.

          The storage key is duplicated from THEME_STORAGE_KEY in
          src/lib/theme/use-theme.ts — this script cannot import (it is a
          raw string in the document head), so a contract test asserts the
          two spellings stay identical.
        */}
        <script dangerouslySetInnerHTML={THEME_BOOT_SCRIPT} />
      </head>
      {/*
        bg-surface/text-ink on the BODY are load-bearing, not decoration. The
        palette in globals.css flips with the OS preference, so a page that
        paints no background of its own lands the dark palette's near-white ink
        on the browser's default white sheet — 1.12:1, invisible. That is a
        measured defect, not a hypothetical.

        The app shell below happens to paint the same tokens on a wrapper div,
        which masks this today. That is accidental cover: it is `yours` code,
        the first person to restyle the shell can drop it, and it never covers
        the overscroll gutter. Painting the body is what makes the guarantee
        survive an edit.
      */}
      <body className="bg-surface font-sans text-ink antialiased">
        <Providers>
          <AppShell banner={<MockModeBanner />}>{children}</AppShell>
        </Providers>
      </body>
    </html>
  );
}
