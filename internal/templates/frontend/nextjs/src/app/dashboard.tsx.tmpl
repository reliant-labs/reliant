"use client";

// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// STARTER CODE, NOT A DESIGN. A tile grid is the most generic dashboard there
// is; it exists to prove the data layer works end to end, not because a count
// per entity is what your users need. Replace it with the two or three numbers
// that actually matter for your product, and delete the rest.
//
// Tiles read LIVE counts through the generated list hooks, so what they show
// is real — copy the `useList*({ pageSize: 1 }).data?.totalCount` shape for
// any metric you add. Presentation comes from the semantic theme tokens in
// globals.css (bg-surface, text-ink, border-accent), so restyle there first
// and every page follows.
//
// Adding an entity later does NOT edit this file. Add its tile yourself, the
// same edit you would make for a metric no entity provides.

import { {{if .Pages}}ChevronRight, {{end}}Inbox, Plus } from "lucide-react";
import Link from "next/link";

import { ALL_ROUTES } from "@/components/nav";
{{- range .NavHookImports}}
import { {{range $i, $s := .Symbols}}{{if $i}}, {{end}}{{$s}}{{end}} } from "{{.Module}}";
{{- end}}
{{- range .Pages}}

function {{.ComponentIdent}}Tile() {
{{- if .HasTotalCount}}
  // Live count from the SERVER's total, not the length of the page this
  // fetched. `data.{{.ItemsField}}.length` is capped by page_size, so a tile
  // built that way reads "25" forever once the table outgrows one page —
  // and this file is the exemplar every hand-written tile is copied from.
  //
  // {{if .HasPageSize}}pageSize: 1 because the rows are not rendered here; only the
  // count is.{{else}}This List RPC has no page_size, so the request stays empty.{{end}}
  const { data } = {{.ListHook}}({{if .HasPageSize}}{ pageSize: 1 }{{else}}{}{{end}});
  const count = data?.{{.TotalCountField}};
{{- else}}
  // This List response declares no total_count, so the honest count is the
  // number of rows the server returned. Add `int32 total_count` (or
  // `int64`) to the List response and re-run `forge generate` to make the
  // tile report the real total instead of one page of it.
  const { data } = {{.ListHook}}({});
  const count = data?.{{.ItemsField}}?.length;
{{- end}}
  return (
    <Link
      href="/{{.Slug}}"
      className="group relative flex flex-col justify-between overflow-hidden rounded-lg border border-border bg-surface p-5 transition-colors hover:border-border-strong hover:bg-surface-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
    >
      <div className="flex items-start justify-between gap-2">
        <p className="text-sm font-medium text-ink-muted">{{.Label}}</p>
        {/*
          The chevron is a hover affordance, not a decoration: it is
          invisible at rest and slides in on hover/focus. A tile grid where
          every card shouts an icon at rest is noisier than one where the
          affordance appears when you reach for it.
        */}
        <ChevronRight
          aria-hidden
          className="h-4 w-4 shrink-0 -translate-x-1 text-ink-subtle opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100"
          strokeWidth={2}
        />
      </div>
      {/*
        tabular-nums so a changing count does not shift the digits' width.
        String() because a total_count declared int64 arrives as a bigint.
      */}
      <p className="mt-3 text-3xl font-semibold tracking-tight text-ink tabular-nums">
        {count === undefined ? (
          <span className="inline-block h-8 w-14 animate-pulse motion-reduce:animate-none rounded-md bg-surface-muted align-middle" />
        ) : (
          String(count)
        )}
      </p>
      <p className="mt-1 text-xs text-ink-subtle">Total {{.LabelLower}}</p>
    </Link>
  );
}
{{- end}}

/**
 * EntityTiles renders the per-entity stat-card grid. One card per CRUD
 * entity, linking into its list page, with a live count from the entity's
 * list hook. Empty state ("No resources yet") surfaces when the project
 * has no CRUD services yet.
 */
export function EntityTiles() {
  if (ALL_ROUTES.length === 0) {
    return (
      <div className="rounded-lg border border-dashed border-border-strong bg-surface p-12 text-center">
        <span className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-surface-muted">
          <Inbox aria-hidden className="h-6 w-6 text-ink-subtle" strokeWidth={1.5} />
        </span>
        <p className="mt-4 text-sm font-medium text-ink">No resources yet</p>
        <p className="mx-auto mt-1 max-w-sm text-sm text-ink-muted">
          Add services with CRUD RPCs and run <code className="rounded-md bg-surface-muted px-1.5 py-0.5 font-mono text-xs text-ink">forge generate</code> to populate this dashboard.
        </p>
      </div>
    );
  }

  // auto-fit rather than fixed breakpoints: tiles keep a sane minimum width
  // and the grid decides the column count, so one entity does not stretch a
  // card across the viewport and seven do not cram.
  return (
    <div className="mb-8 grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))]">
      {{- range .Pages}}
      <{{.ComponentIdent}}Tile />
      {{- end}}
    </div>
  );
}

/**
 * QuickActions renders a "Create <Entity>" button for every CRUD entity
 * whose service has a Create RPC — and ONLY those, so each button targets
 * a create page the generator actually emitted. Returns null when no
 * entity is creatable.
 */
export function QuickActions() {
  const createRoutes = ALL_ROUTES.filter((route) => route.hasCreate);
  if (createRoutes.length === 0) {
    return null;
  }
  return (
    <div>
      <h2 className="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-subtle">
        Quick actions
      </h2>
      <div className="flex flex-wrap gap-2">
        {createRoutes.map((route) => (
          <Link
            key={route.slug}
            href={`${route.path}/new`}
            className="inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-3 py-2 text-sm font-medium text-ink transition-colors hover:border-border-strong hover:bg-surface-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
          >
            <Plus aria-hidden className="h-4 w-4 text-ink-subtle" strokeWidth={2} />
            New {route.labelSingular}
          </Link>
        ))}
      </div>
    </div>
  );
}
