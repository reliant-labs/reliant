// Code generated by forge. DO NOT EDIT.
// forge-owned: regenerated every run — do not edit (forge project disown to take ownership)
//
// Browser telemetry CONFIGURATION. The SDK wiring it configures — the HyperDX
// browser SDK, which captures errors, console output, fetch/XHR spans,
// document load and web vitals — lives in
// @reliantlabs/forge-web-runtime/telemetry.
//
// What stays here is the part that CANNOT move: the reads of this frontend's
// configuration. A value that differs per environment comes from the runtime
// config document (config.js, `window.__FORGE_CONFIG__`), not from a
// `process.env.NEXT_PUBLIC_*` build variable (that is a deprecated fallback,
// below): Next.js inlines those literals at BUILD time, so the value would
// follow that build into every environment it is promoted to. Otherwise only
// build facts are read from the build — the version (NEXT_PUBLIC_APP_VERSION,
// forge's build id) and NODE_ENV — and every build read stays written out
// verbatim here because Next.js can inline it nowhere else: a library reading
// `process.env` at runtime finds nothing in a browser.
//
// ── Where telemetry goes: same-origin `<basePath>/_otel` ─────────────────
//
// The browser never talks to a collector, and holds no secret. It POSTs
// OTLP/HTTP to `<basePath>/_otel/v1/{traces,logs}` on its OWN origin, and
// something in front of the page forwards that to a collector's OTLP/HTTP
// port:
//
//   - `next dev` / `forge env up`: next.config.ts rewrites `/_otel/*` to
//     $OTEL_EXPORTER_OTLP_ENDPOINT (default http://127.0.0.1:4318).
//   - a frontend on platform hosting (`forge.OnHosted`) is answered by the
//     platform on its own origin, so forge writes `OTEL_ENDPOINT = "/_otel"`
//     into its runtime config by default; nothing to declare.
//   - any other deployed static export (`output: static`, the scaffold
//     default) has no Next.js server, so no rewrite exists there. The
//     deployment's INGRESS must route `<basePath>/_otel/*` to the collector,
//     and the endpoint is declared (below). Until it is, a production build
//     sends nothing (the default is empty there) rather than POSTing to a 404.
//
// Declare the endpoint for a deployed environment in the frontend's KCL
// `config` block (`otel_endpoint = "/_otel"`) or its `runtime_config`
// (`OTEL_ENDPOINT = "/_otel"`); either reaches this module at RUNTIME through
// config.js. An empty value, or "off", disables it.
//
// `forge.Frontend.telemetry` reaches this module the same way:
// `console_capture = False` arrives as CONSOLE_CAPTURE and
// `replay_sample_rate` as REPLAY_SAMPLE_RATE, both read from config.js so one
// build promotes across environments.
//
// Product analytics are COOKIELESS by default: below the `full` tier the
// runtime stores nothing on the device (no cookie, no localStorage, no
// sessionStorage; the session id is kept in memory) and carries no
// persistent id; the platform counts visitors at its ingest edge. Every route
// the user lands on is a `page_viewed {route}` product event (the pathname
// only: no query, no fragment, the basePath stripped, ids replaced by `:id`;
// the first view of a page load also names its referrer host, utm_* and
// which ad network's click id the URL carried, never the id), and a frontend
// with native sign-in stamps the signed-in user's opaque id (the `subject`
// of the API's /auth/session) on every event, so browser and backend events
// join on one user. `page_views = False` arrives as PAGE_VIEWS = "false" and
// `identify_user = False` as IDENTIFY_USER = "false"; either turns its half
// off for that environment. ANALYTICS_MODE (off < aggregate < identified <
// full; absent means "identified") sets the ceiling: "aggregate" is strictly
// anonymous (no user id even when signed in); "full" adds a persistent
// visitor id, the session cookie, multi-day attribution and replay, but only
// once the app calls grantAnalyticsConsent() (from
// @reliantlabs/forge-web-runtime) after its consent manager says yes. GPC /
// DNT cap a browser at aggregate with no user id.
//
// The SDK insists on an apiKey. It is sent a public placeholder (see
// PLACEHOLDER_API_KEY in the runtime); a collector that enforces ingestion
// auth must have the proxy in front of it strip that header or replace it
// with the real key — never the bundle.
//
// Session replay is OFF. `OTEL_REPLAY = "true"` in the runtime config
// enables it, and then masks every input and all text; there is no setting
// that records unmasked. The frontend's KCL sets it per environment with
// `telemetry = forge.BrowserTelemetry {replay = True}`, which also opts the
// environment's observability policy in, so the platform keeps the events.
// Replay records a person, so the runtime runs it only in the `full`
// analytics tier: ANALYTICS_MODE = "full" and grantAnalyticsConsent() before
// this module starts telemetry.
//
// The NEXT_PUBLIC_OTEL_ENDPOINT / NEXT_PUBLIC_ENVIRONMENT /
// NEXT_PUBLIC_OTEL_REPLAY build variables are DEPRECATED. A frontend's KCL
// that declares one (in `config` or `env_vars`) already gets the same value
// in its runtime config, which wins. One that is only exported in the shell
// at `next build` is still read when config.js does not set the key, and the
// page warns once (in the console) naming the variable and the KCL field to
// move it to. That fallback is removed in the next major version of forge.
//
// Distributed tracing itself — the traceparent attached to every RPC, which
// is what makes browser spans join the backend's trace — is always on, needs
// no collector, and does NOT depend on this module.
import { initBrowserTelemetry } from "@reliantlabs/forge-web-runtime/telemetry";

{{ if .IdentifySession -}}
import { apiBase } from "./api-base";
{{ end -}}
import { DEV_API_URL } from "./apiurl_gen";
import { BASE_PATH } from "./basepath_gen";
{{- if and .IdentifySession .HasTypedConfig .HasMockAPI}}
import { loadConfig } from "./config_gen";
{{- end}}

// The runtime config document (config.js) assigns this before any bundle code
// runs. Read directly, not through config_gen, so this module has no
// dependency on whether the project adopted typed config.
function runtimeConfig(): Record<string, unknown> {
  if (typeof window === "undefined") {
    return {};
  }
  return (
    (window as unknown as { __FORGE_CONFIG__?: Record<string, unknown> })
      .__FORGE_CONFIG__ ?? {}
  );
}

function text(value: unknown): string {
  return typeof value === "string" ? value : "";
}

// REPLAY_SAMPLE_RATE arrives as a string in the runtime config document. Unset
// (or anything that is not a number) is "every session" for the runtime, which
// clamps the rest.
function rate(value: unknown): number | undefined {
  const n = Number(text(value));
  return text(value) !== "" && Number.isFinite(n) ? n : undefined;
}

// ANALYTICS_MODE arrives as a string in the runtime config document; the
// render omits it for the default, "identified". Unset or unknown is
// undefined: the runtime's default.
function analyticsMode(value: unknown): "off" | "aggregate" | "identified" | "full" | undefined {
  const mode = text(value);
  return mode === "off" || mode === "aggregate" || mode === "identified" || mode === "full"
    ? mode
    : undefined;
}

// DEPRECATED (removed in the next major): the build-variable fallback for a
// per-environment value. The runtime config wins; a build variable is read
// only when config.js does not set the key, and each one read is recorded in
// `used` so initTelemetry can say so. `declare` is where the value belongs.
function runtimeOrBuild(
  used: string[],
  runtime: unknown,
  buildName: string,
  build: string | undefined,
  declare: string,
): string {
  const value = text(runtime);
  if (value !== "" || !build) {
    return value;
  }
  used.push(`${buildName} (declare it as ${declare})`);
  return build;
}
{{- if .IdentifySession}}

// The mock mode src/lib/auth/session-provider.ts decides with, read from the
// same source: "true" or "hybrid" means the signed-in user is a fixture.
function mockMode(): string {
{{- if and .HasTypedConfig .HasMockAPI}}
  try {
    return String(loadConfig().MOCK_API || "");
  } catch {
    // Invalid config is reported where the app reads it, not here.
    return "";
  }
{{- else if .HasTypedConfig}}
  return "";
{{- else}}
  return (process.env.NEXT_PUBLIC_MOCK_API) || "";
{{- end}}
}

// Where native sign-in answers "who is signed in": the same /auth/session URL
// src/lib/auth/native-login.ts's fetchIdentity asks, resolved the same way.
// Undefined when this page should not ask: the environment's runtime config
// says IDENTIFY_USER = "false", or the bundle runs on mock data, whose user is
// a fixture no server knows.
function identify(cfg: Record<string, unknown>): { sessionUrl: string } | undefined {
  if (text(cfg.IDENTIFY_USER) === "false") {
    return undefined;
  }
  const mock = mockMode();
  if (mock === "true" || mock === "hybrid") {
    return undefined;
  }
  const configured = text(cfg.API_URL) || process.env.NEXT_PUBLIC_API_URL || "";
  return { sessionUrl: `${apiBase(configured)}/auth/session` };
}
{{- end}}

{{browserReplayPrivacyGuard}}
let warnedBuildFallback = false;

// One warning per page load, however often initTelemetry runs (StrictMode's
// double-mount, Fast Refresh).
function warnBuildFallback(used: string[]): void {
  if (warnedBuildFallback || used.length === 0) {
    return;
  }
  warnedBuildFallback = true;
  console.warn(
    `[forge] browser telemetry read ${used.join(", ")} from a build variable, ` +
      "because this environment's runtime config (config.js) does not set it. " +
      "A build variable is frozen into the bundle and follows it into every " +
      "environment it is promoted to: move it to this frontend's runtime config " +
      "in its KCL. The build-variable fallback is deprecated and will be removed " +
      "in the next major version of forge.",
  );
}

/**
 * SERVICE_NAME is the service.name this frontend's telemetry reports:
 * "<project>-<frontend>". The generated dashboards and alert defaults under
 * deploy/observability/ filter on exactly this value, so code that starts the
 * SDK itself (instead of through initTelemetry) passes SERVICE_NAME — any
 * other name is invisible to them.
 */
export const SERVICE_NAME = '{{.TelemetryServiceName}}';

/**
 * initTelemetry starts browser telemetry. Call it once from the app shell
 * (providers.tsx already does).
 *
 * A no-op without a DOM (SSR / prerender) and while telemetry is off, and
 * idempotent under React StrictMode's double-mount and Fast Refresh — so it
 * is safe to call unconditionally. It never throws.
 */
export function initTelemetry(): void {
  const cfg = runtimeConfig();
  const dev = process.env.NODE_ENV === "development";
  // Each build variable is written out verbatim: Next.js inlines only those.
  const used: string[] = [];
  const environment = runtimeOrBuild(
    used,
    cfg.ENVIRONMENT,
    "NEXT_PUBLIC_ENVIRONMENT",
    process.env.NEXT_PUBLIC_ENVIRONMENT,
    "config.environment",
  );
  const endpoint = runtimeOrBuild(
    used,
    cfg.OTEL_ENDPOINT,
    "NEXT_PUBLIC_OTEL_ENDPOINT",
    process.env.NEXT_PUBLIC_OTEL_ENDPOINT,
    "config.otel_endpoint",
  );
  const replay = runtimeOrBuild(
    used,
    cfg.OTEL_REPLAY,
    "NEXT_PUBLIC_OTEL_REPLAY",
    process.env.NEXT_PUBLIC_OTEL_REPLAY,
    "telemetry.replay = True",
  );
  warnBuildFallback(used);

  // Built apart from the call, not as a literal argument: a literal is checked
  // for excess properties, and a lockfile still holding a runtime older than
  // analytics/pageViews/identify would then fail `tsc` on this regenerated
  // file. As a value, an older runtime typechecks and ignores them; a current
  // one checks every key.
  const options = {
    serviceName: SERVICE_NAME,
    serviceVersion: process.env.NEXT_PUBLIC_APP_VERSION || undefined,
    environment: environment || undefined,
    serviceNamespace: '{{.ProjectName}}',
    frontend: '{{.FrontendName}}',
    consoleCapture: text(cfg.CONSOLE_CAPTURE) !== "false",
    replaySampleRate: rate(cfg.REPLAY_SAMPLE_RATE),
    endpoint: endpoint || (dev ? `${BASE_PATH}/_otel` : ""),
    // The origin RPCs go to, resolved as src/lib/connect.ts resolves it — so
    // the traceparent rides on exactly the requests the transport sends.
    apiOrigins: [
      text(cfg.API_URL) || process.env.NEXT_PUBLIC_API_URL || DEV_API_URL,
    ],
    replay: replay === "true" && replayPrivacyAllows(),
    // The analytics tier's ceiling ("identified", cookieless, unless the
    // runtime config says otherwise).
    analytics: analyticsMode(cfg.ANALYTICS_MODE),
    // One `page_viewed {route}` per route the user lands on, unless the
    // runtime config says PAGE_VIEWS = "false".
    pageViews:
      text(cfg.PAGE_VIEWS) === "false" ? false : { basePath: BASE_PATH },
{{- if .IdentifySession}}
    // The signed-in user's opaque id on every event, unless the runtime
    // config says IDENTIFY_USER = "false".
    identify: identify(cfg),
{{- end}}
  };
  void initBrowserTelemetry(options);
}

export { context, getTracer, propagation, trace } from '@reliantlabs/forge-web-runtime/telemetry';
