import fs from "node:fs";
import os from "node:os";
import path from "node:path";

import bundleAnalyzer from "@next/bundle-analyzer";

import type { NextConfig } from "next";

const withBundleAnalyzer = bundleAnalyzer({
  enabled: process.env.ANALYZE === "true",
});

// Path prefix this frontend is mounted under (e.g. "/admin" behind a
// reverse proxy that blends several apps on one host). Empty = served
// from the host root.
//
// Sources, in order:
//   1. NEXT_PUBLIC_BASE_PATH — the ONLY env var forge reads for the
//      base path. The NEXT_PUBLIC_ prefix is load-bearing: Next.js
//      inlines such vars into the client bundle, so the generated
//      browser-side helper (src/lib/basepath_gen.ts) reads the SAME
//      name. One name everywhere; a second variant would silently be
//      ignored.
//   2. forge.yaml `frontends[].base_path`, baked in by forge: "{{.BasePath}}".
const basePath = process.env.NEXT_PUBLIC_BASE_PATH ?? "{{.BasePath}}";

// ── Browser telemetry proxy (DEV ONLY) ──────────────────────────────────
//
// The browser sends telemetry to `<basePath>/_otel/v1/{traces,logs}` on ITS
// OWN origin and holds no collector address and no secret (see
// src/lib/otel_gen.ts). `next dev` forwards that to the local collector's
// OTLP/HTTP port; the rewrite below is the whole proxy.
//
//   upstream: OTEL_EXPORTER_OTLP_ENDPOINT, a collector BASE URL
//             (default http://127.0.0.1:4318 — the OTLP/HTTP port, not gRPC's 4317)
//   path:     /_otel/:path*  ->  <upstream>/:path*
//
// `forge env up` sets the variable for the dev server, so this follows the
// collector that stack started. It is read when the dev server starts.
//
// There is NO production equivalent in this file, by design: a static export
// (`output: "export"`) has no Next.js server, so `rewrites` do not exist in
// the built site, and a standalone build bakes a rewrite's destination in at
// BUILD time, which cannot name a collector that differs per environment.
// Routing `<basePath>/_otel/*` to the collector in a deployed environment is
// the ingress's job (the hosted gateway, or your cluster's ingress). Until
// that route exists, leave the frontend's otel_endpoint unset and the
// production bundle sends nothing.
const otelUpstream = (
  process.env.OTEL_EXPORTER_OTLP_ENDPOINT || "http://127.0.0.1:4318"
).replace(/\/+$/, "");

// ── API proxy (DEV ONLY) ────────────────────────────────────────────────
//
// Under `next dev` the browser calls the API on ITS OWN origin, at
// `<basePath>/_api/*`, and the rewrite below forwards that to the API server.
// A page opened through a Reliant workspace preview URL, a tunnel or another
// machine's IP cannot reach "localhost:<api port>" — that is the viewer's
// machine — so the API is reached through the one host the browser already
// has. src/lib/api-base.ts has the whole story.
//
//   upstream: NEXT_PUBLIC_API_URL, the API's base URL. `forge env up` sets it
//             to the API it started, and a value from your shell or the
//             frontend's KCL env_vars wins over forge's. Read here, on the
//             server, when the dev server starts.
//   path:     /_api/:path*  ->  <upstream>/:path*
//   off:      FORGE_DEV_API_PROXY=off, or no upstream. The browser then calls
//             the configured API URL directly, cross-origin, as before.
//
// The answer reaches the bundle as process.env.FORGE_DEV_API_PROXY (`env`
// below), which api-base.ts reads, so the rewrite and the transport are one
// decision. Next's proxy ends a request after 30s (`experimental.proxyTimeout`);
// a server-streaming RPC that must outlive that needs it raised, or the proxy off.
//
// There is no production equivalent, for the same reasons as /_otel above. A
// build reads the API's URL from the runtime config (config.js), as before.
const apiUpstream = (process.env.NEXT_PUBLIC_API_URL || "").replace(/\/+$/, "");
const devApiProxy =
  process.env.NODE_ENV === "development" &&
  apiUpstream !== "" &&
  !/^(off|false|0|no)$/i.test(process.env.FORGE_DEV_API_PROXY ?? "")
    ? "/_api"
    : "";

// ── Dev origins (DEV ONLY) ──────────────────────────────────────────────
//
// `next dev` refuses its own dev resources — the HMR socket, /__nextjs_*,
// dev fonts — to a page whose Origin is not localhost or listed in
// `allowedDevOrigins`. A page opened any other way renders but never
// hydrates: every button is dead and nothing in the console says why.
// Allowed here, beside localhost:
//
//   - this dev server's Reliant workspace preview host: RELIANT_PREVIEW_URL_TEMPLATE
//     (`https://{port}-<id>.workspaces.reliantapi.com`, set on a Reliant
//     cloud machine) with the port the dev server binds (PORT, which
//     `forge env up` sets; Next's 3000 otherwise).
//   - this machine's own network addresses, so `http://<LAN or container
//     IP>:<port>` works once the dev server listens beyond loopback
//     (`forge env up dev -- -H 0.0.0.0`). A page served from this machine's
//     own address is no more foreign than localhost, which Next allows on
//     any port.
//   - FORGE_DEV_ALLOWED_ORIGINS: more hostnames, comma-separated (a tunnel,
//     a custom dev DNS name). Next matches hostnames, with `*` for a whole
//     label, and ignores ports.
const devOrigins = (): string[] => {
  const out = new Set<string>();
  const preview = process.env.RELIANT_PREVIEW_URL_TEMPLATE;
  if (preview) {
    try {
      out.add(new URL(preview.replace("{port}", process.env.PORT || "3000")).hostname);
    } catch {
      // A malformed template allows nothing extra.
    }
  }
  for (const addrs of Object.values(os.networkInterfaces())) {
    for (const addr of addrs ?? []) {
      if (!addr.internal && addr.family === "IPv4") out.add(addr.address);
    }
  }
  for (const host of (process.env.FORGE_DEV_ALLOWED_ORIGINS ?? "").split(",")) {
    if (host.trim()) out.add(host.trim());
  }
  return [...out];
};

