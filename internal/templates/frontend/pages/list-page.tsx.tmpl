"use client";

// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// This route is OWNED and DISPOSABLE. forge scaffolds a full CRUD route for
// EVERY entity, but a purpose-built frontend uses only a fraction — if this
// entity isn't part of THIS frontend's product surface, delete the route
// instead of leaving it wired into navigation.
// {{.EntityNamePlural}} list page — generated by `forge scaffold page`.
//
// Conventions baked in (see frontend-runtime + frontend/pages skills):
//   - The forge runtime <Resource> container owns the loading / error /
//     empty / data tristate ladder, the debounced server-side filter box,
//     and cursor pagination. This page never re-hand-rolls that ladder and
//     never client-side-filters a single fetched page.
//   - Filtering + pagination happen SERVER-SIDE. The List RPC's own request
//     filter fields — the SAME fields the backend query filters on — are
//     passed through, and the response's next_page_token drives the cursor.
//   - Prior rows stay visible (dimmed) across page/filter changes via
//     `placeholderData: keepPreviousData`, so the table never flashes back to
//     a full skeleton; the <Resource> footer's isFetching spinner covers it.
//   - Typed columns: the generator knows {{.EntityName}}'s fields from the
//     proto descriptor, so columns are declared (type-checked against the
//     entity) instead of reflected out of Object.keys at runtime. Enum
//     columns render through <StatusBadge>, which takes the raw field plus
//     the enum object and does the protobuf-es NUMBER → member-name reverse
//     map itself; money columns (*_cents) format as currency; foreign keys
//     show the referenced record's name through <EntityName>.
//   - Rows keep table semantics. The record's primary cell is a real link
//     (what a keyboard or screen-reader user follows); clicking elsewhere on
//     the row is a pointer convenience on top of it.
//   - Filters sit in a toolbar row of their own (the installed <FilterBar>),
//     which wraps on a phone; the record count lives in the pager.
//
// This file is yours — hand-edit freely (add a column, tweak a cell). To
// regenerate it from the current proto, delete the file and run
// `forge project rescaffold <path>` (forge never overwrites an existing scaffold).
{{/* Import ORDER is derived, not authored. This import set is conditional on
     the entity's shape and two of its paths are only known at render time
     (the service hooks module, the enums' protobuf-es module), so no fixed
     line order here can be canonical for every entity. The page writer sorts
     what was actually emitted — see templates.CanonicalTSImportOrder. List a
     new import wherever it reads best; do not hand-maintain the order. */}}
import { Resource, type ResourceColumn{{if .HasListSortColumn}}, type ResourceSort{{end}} } from "@reliantlabs/forge-web-runtime";
import { keepPreviousData } from "@tanstack/react-query";
{{- if .HasCreate}}
import { Plus } from "lucide-react";
{{- end}}
{{- if .PrimaryListColumn}}
import Link from "next/link";
{{- end}}
{{- if .HasURLFilters}}
import { usePathname, useRouter } from "next/navigation";
import { {{joinStrings .ListReactImports ", "}} } from "react";
import { z } from "zod";
{{- else}}
{{- if .EmitsDetailPage}}
import { useRouter } from "next/navigation";
{{- end}}
{{- if .HasCursorPagination}}
import { useState } from "react";
{{- end}}
{{- end}}

{{if .HasListEntityName}}import { EntityName } from "@/components/entity-name";
{{end -}}
{{if .HasListFKFilter}}import { EntityPicker } from "@/components/entity-picker";
{{end -}}
{{if .HasBadgeColumns}}import { StatusBadge } from "@/components/status-badge";
{{end -}}
{{if .HasCreate}}import Button from "@/components/ui/button";
{{end -}}
{{if .ExactFilterFields}}import FilterBar from "@/components/ui/filter_bar";
{{end -}}
{{if .HasScalarExactFilter}}import Input from "@/components/ui/input";
{{end -}}
{{if .HasURLFilters}}import SkeletonLoader from "@/components/ui/skeleton_loader";
{{end}}import { useQueryResource{{if .HasScalarExactFilter}}, useDebouncedValue{{end}} } from "@/hooks/use-query-resource";
{{- if .EmitsDetailPage}}
import { entityViewHref } from "@/lib/entity-routes";
{{- end}}
import { {{if .HasMoneyColumns}}formatMoneyCents, {{end}}formatValue } from "@/lib/format-utils";
{{- if .HasURLFilters}}
import { useTypedSearchParams } from "@/lib/search-schemas";
{{- end}}
{{- range .ListHookImports}}
import { {{joinStrings .Symbols ", "}} } from "{{.Module}}";
{{- end}}
{{- range .ListEnumImports}}
import { {{range $i, $t := .Types}}{{if $i}}, {{end}}{{$t}}{{end}} } from "{{.Path}}";
{{- end}}

import type { {{.EntityName}} } from "{{.EntityTypeImportPath}}";
{{- if .HasPageSize}}

// Rows per page requested from the server. Paginate the result with the
// <Resource> footer's Prev/Next (they walk the next_page_token cursor).
// Bump this to taste.
const PAGE_SIZE = 25;
{{- end}}

// ---- Typed columns ----
// One entry per renderable proto field, type-checked against {{.EntityName}}.
{{- if .EmitsDetailPage}}
// The id and the created/updated timestamps are deliberately NOT here — the
// primary cell already links to the detail page, which is where they belong.
// Add one back if this list needs it; this file is yours.
{{- else}}
// The service has no Get RPC, so there is no detail page: rows are not links,
// and the id and timestamps a detail page would show stay here instead. Add a
// Get RPC (and delete + rescaffold this file) to give records a page of their own.
{{- end}}
{{- if .HasListSortColumn}}
// A column with a sortKey sorts SERVER-SIDE: the key is the List request's
// order_by (a column name). A sorted list is one page — the server's keyset
// cursor pages only in primary-key order, so it returns no next-page token.
{{- end}}
const columns: ResourceColumn<{{.EntityName}}>[] = [
{{- $primary := .PrimaryListColumn}}
{{- range .ListColumns}}
  {
    header: "{{.Label}}",
{{- if and $.HasSort .SortKey}}
    sortKey: "{{.SortKey}}",
{{- end}}
{{- if and $primary (eq .Name $primary)}}
    cell: (item) => (
      <Link
        href={entityViewHref("{{$.EntitySlug}}", item.{{$.PkFieldCamel}})}
        className="font-medium text-ink underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        {{- if or .FK .IsBadge}}
        {{template "listCellValue" .}}
        {{- else}}
        {{"{"}}{{template "listCellValue" .}}{{"}"}}
        {{- end}}
      </Link>
    ),
{{- else}}
    cell: (item) => {{template "listCellValue" .}},
{{- end}}
  },
{{- end}}
];

{{- if .HasURLFilters}}

// The URL is the source of truth for this page's filters and sort — the
// "schema at the URL boundary" convention from the `frontend/state` skill,
// driven by useTypedSearchParams. A dashboard tile linking to
// `/{{.EntitySlug}}?…` therefore lands on a FILTERED list; the Back button undoes a
// filter change; and a filtered view is a link somebody can paste into a
// ticket. Holding these in useState instead makes every such link dead — it
// renders the unfiltered list, with no error anywhere to say so.
const searchParamsSchema = z.object({
{{- if .SearchFilterField}}
  q: z.string().optional(),
{{- end}}
{{- range .ExactFilterFields}}
  {{.Name}}: z.string().optional(),
{{- end}}
{{- if .HasListSortColumn}}
  sort: z.string().optional(),
  desc: z.string().optional(),
{{- end}}
});
{{- if .HasListSortColumn}}

// The sort keys this page accepts from `?sort=`. Anything else is ignored
// rather than sent: the server refuses an order_by it does not know.
const sortKeys = [{{range $i, $k := .ListSortKeys}}{{if $i}}, {{end}}"{{$k}}"{{end}}] as const;
{{- end}}
{{- range .ExactFilterFields}}
{{- if eq .Kind "enum"}}

// URL token ⇄ enum member BY NAME (`?{{.Name}}=…`), not by ordinal: the link stays
// readable and survives a proto renumber. An unrecognised token means "no
// filter" rather than an error page.
const {{.Name}}Options = [{{range $i, $v := .EnumValues}}{{if $i}}, {{end}}{{$v.Ref}}{{end}}] as const;
{{- end}}
{{- end}}
{{- if .ListFilterBarFields}}

// The facets <FilterBar> renders (its values are the URL tokens above).
const filterDefs = [
{{- range $f := .ListFilterBarFields}}
{{- if eq .Kind "enum"}}
  {
    key: "{{.Name}}",
    label: "{{.Label}}",
    type: "select" as const,
    options: [
{{- range .EnumValues}}
      { value: {{$f.EnumType}}[{{.Ref}}], label: "{{.Label}}" },
{{- end}}
    ],
  },
{{- else}}
  {
    key: "{{.Name}}",
    label: "{{.Label}}",
    type: "select" as const,
    options: [
      { value: "true", label: "{{.Label}}" },
      { value: "false", label: "Not {{.Label | lower}}" },
    ],
  },
{{- end}}
{{- end}}
];
{{- end}}
{{- end}}

{{if .HasURLFilters}}function {{.EntityNamePlural}}PageContent() {
{{- else}}export default function {{.EntityNamePlural}}Page() {
{{- end}}
{{- if or .HasURLFilters .EmitsDetailPage}}
  const router = useRouter();
{{- end}}
{{- if .HasURLFilters}}
  const pathname = usePathname();
  const params = useTypedSearchParams(searchParamsSchema);

  // One writer for every filter. It reads the LIVE query string instead of
  // closing over the parsed params, which keeps the callback stable — so the
  // debounced effects below fire on a real change, not on every navigation.
  const setFilters = useCallback(
    (next: Record<string, string | undefined>) => {
      const sp = new URLSearchParams(window.location.search);
      for (const [key, value] of Object.entries(next)) {
        if (value === undefined || value === "") sp.delete(key);
        else sp.set(key, value);
      }
      const qs = sp.toString();
      router.replace(qs ? `${pathname}?${qs}` : pathname, { scroll: false });
    },
    [pathname, router],
  );
{{- end}}
{{- if .HasCursorPagination}}

  // Cursor stack: each entry is the page_token that opened that page (the
  // last entry is the current page; empty = first page). The cursor stays in
  // component state — it is an opaque server cursor, not a view worth
  // linking to — and any filter or sort change resets the stack to page one.
  const [cursor, setCursor] = useState<string[]>([]);
{{- end}}
{{- if .SearchFilterField}}
  const search = params.q ?? "";
{{- end}}
{{- if .HasListSortColumn}}
  const sortKey = sortKeys.find((key) => key === params.sort);
  const sort: ResourceSort | null = sortKey ? { key: sortKey, descending: params.desc === "true" } : null;
{{- end}}
{{- range .ExactFilterFields}}
{{- if eq .Kind "enum"}}
  const {{.Name}} = {{.Name}}Options.find((member) => {{.EnumType}}[member] === params.{{.Name}});
{{- else if eq .Kind "bool"}}
  const {{.Name}} = params.{{.Name}} === undefined ? undefined : params.{{.Name}} === "true";
{{- else if eq .Kind "fk"}}
  const {{.Name}} = params.{{.Name}};
  const set{{.NamePascal}} = (value: string | undefined) => {
    setFilters({ {{.Name}}: value });
{{- if $.HasCursorPagination}}
    setCursor([]);
{{- end}}
  };
{{- else}}
  // Debounced so typing doesn't fire one RPC per keystroke (like the
  // <Resource> search box). The input binds the raw value; the settled value
  // is what lands in the URL and drives the query.
  const [{{.Name}}Input, set{{.NamePascal}}Input] = useState(params.{{.Name}} ?? "");
  const {{.Name}} = useDebouncedValue({{.Name}}Input, 300);
  useEffect(() => {
    if ({{.Name}} !== (params.{{.Name}} ?? "")) setFilters({ {{.Name}} });
  }, [{{.Name}}, params.{{.Name}}, setFilters]);
{{- end}}
{{- end}}

  // Server-side query: filters, sort and cursor go to the backend; nothing is
  // filtered, sorted or capped in the browser. keepPreviousData holds the
  // prior page while the next loads (no skeleton flash).
  const query = use{{.ListRPC}}({
{{- if .HasPageSize}}
    pageSize: PAGE_SIZE,
{{- end}}
{{- if .HasCursorPagination}}
    pageToken: cursor.at(-1),
{{- end}}
{{- if .HasListSortColumn}}
    orderBy: sort?.key ?? "",
    descending: sort?.descending ?? false,
{{- end}}
{{- if .SearchFilterField}}
    {{.SearchFilterField}}: search || undefined,
{{- end}}
{{- range .ExactFilterFields}}
{{- if eq .Kind "number"}}
{{- if .IsBigInt}}
    {{- /* A 64-bit filter goes through the DIGITS, never through Number():
           an exact-match filter on 9007199254740993 rounded through a double
           queries 9007199254740992 and quietly returns the wrong row (or
           none). Non-digits mean "no filter" rather than a thrown BigInt. */}}
    {{.Name}}: /^-?\d+$/.test({{.Name}}) ? BigInt({{.Name}}) : undefined,
{{- else}}
    {{.Name}}: {{.Name}} === "" ? undefined : Number({{.Name}}),
{{- end}}
{{- else if or (eq .Kind "text") (eq .Kind "fk")}}
    {{.Name}}: {{.Name}} || undefined,
{{- else}}
    {{.Name}}: {{.Name}},
{{- end}}
{{- end}}
  }, { placeholderData: keepPreviousData });
  const resource = useQueryResource(query);
{{- if .HasCursorPagination}}

  const nextToken = resource.status === "success" ? resource.data.{{.NextTokenField}} : "";
{{- end}}
{{- if .HasTotalCount}}
  const total = resource.status === "success" ? Number(resource.data.{{.TotalCountField}}) : undefined;
{{- end}}

  return (
    <Resource<{{.EntityName}}>
      title="{{.EntityNamePlural | humanize}}"
      status={resource.status}
      data={resource.status === "success" ? resource.data.{{.ItemsField}} : undefined}
      error={resource.status === "error" ? resource.error : undefined}
      onRetry={resource.status === "error" ? resource.refetch : undefined}
      isFetching={query.isFetching}
      columns={columns}
      rowKey={(item) => String(item.{{.PkFieldCamel}})}
{{- if .EmitsDetailPage}}
      onRowClick={(item) => router.push(entityViewHref("{{.EntitySlug}}", item.{{.PkFieldCamel}}))}
{{- if .PrimaryListColumn}}
      rowsHaveLinks
{{- end}}
{{- end}}
      emptyTitle="No {{.EntityNamePlural | humanLower}} found"
      emptyMessage="No records match the current view."
{{- if .SearchFilterField}}
      filter={search}
      onFilterChange={(value) => {
        setFilters({ q: value });
{{- if .HasCursorPagination}}
        setCursor([]);
{{- end}}
      }}
      filterPlaceholder="Search {{.EntityNamePlural | humanLower}}…"
{{- end}}
{{- if .HasListSortColumn}}
      sort={sort}
      onSortChange={(next) => {
        setFilters({ sort: next?.key, desc: next?.descending ? "true" : undefined });
{{- if .HasCursorPagination}}
        setCursor([]);
{{- end}}
      }}
{{- end}}
{{- if .HasCursorPagination}}
      onNextPage={() => setCursor((c) => [...c, nextToken])}
      onPrevPage={() => setCursor((c) => c.slice(0, -1))}
      hasNextPage={Boolean(nextToken)}
      hasPrevPage={cursor.length > 0}
{{- end}}
{{- if .HasTotalCount}}
      totalCount={total}
{{- if .HasPageSize}}
      pageStart={ {{if .HasCursorPagination}}cursor.length * PAGE_SIZE{{else}}0{{end}} }
{{- end}}
{{- end}}
{{- if .ExactFilterFields}}
      toolbar={
        <FilterBar
          filters={ {{if .ListFilterBarFields}}filterDefs{{else}}[]{{end}} }
          values={ { {{range $i, $f := .ListFilterBarFields}}{{if $i}}, {{end}}{{$f.Name}}: params.{{$f.Name}} ?? ""{{end}} } }
          onFilterChange={(next) => {
            setFilters({ {{range $i, $f := .ListFilterBarFields}}{{if $i}}, {{end}}{{$f.Name}}: next.{{$f.Name}}{{end}} });
{{- if .HasCursorPagination}}
            setCursor([]);
{{- end}}
          }}
          onClearAll={() => {
            setFilters({ {{range $i, $f := .ExactFilterFields}}{{if $i}}, {{end}}{{$f.Name}}: undefined{{end}} });
{{- range .ListFilterExtraFields}}
{{- if ne .Kind "fk"}}
            set{{.NamePascal}}Input("");
{{- end}}
{{- end}}
{{- if .HasCursorPagination}}
            setCursor([]);
{{- end}}
          }}
{{- if .ListFilterExtraFields}}
          hasOtherFilters={ {{range $i, $f := .ListFilterExtraFields}}{{if $i}} || {{end}}Boolean(params.{{$f.Name}}){{end}} }
        >
{{- range .ListFilterExtraFields}}
{{- if eq .Kind "fk"}}
{{- template "listFKFilterPicker" .}}
{{- else}}
          <div className="w-full min-w-0 sm:w-48">
            <Input
              {{- /* A 64-bit field is filtered as TEXT: <input type="number"> is a
                     double and cannot hold every int64. */}}
              type="{{if and (eq .Kind "number") (not .IsBigInt)}}number{{else if eq .Kind "number"}}text{{else}}search{{end}}"
              aria-label="Filter by {{.Label | lower}}"
              value={ {{.Name}}Input }
              onChange={(e) => {
                set{{.NamePascal}}Input(e.target.value);
{{- if $.HasCursorPagination}}
                setCursor([]);
{{- end}}
              }}
              placeholder="{{.Label}}"
            />
          </div>
{{- end}}
{{- end}}
        </FilterBar>
{{- else}}
        />
{{- end}}
      }
{{- end}}
{{- if .HasCreate}}
      actions={
        <Button href="/{{.EntitySlug}}/new" size="lg" leftIcon={<Plus aria-hidden strokeWidth={2} />}>
          New {{.EntityName | humanize}}
        </Button>
      }
{{- end}}
    />
  );
}

{{if .HasURLFilters}}// useSearchParams() reads a value that only exists on the client, so Next
// refuses to prerender a route that calls it outside a <Suspense> boundary —
// `next build` fails the page otherwise. The prop-free wrapper below is the
// route's actual export; the content component above is where the page lives.
export default function {{.EntityNamePlural}}Page() {
  return (
    <Suspense fallback={<SkeletonLoader variant="table-row" count={5} />}>
      <{{.EntityNamePlural}}PageContent />
    </Suspense>
  );
}
{{end}}
