// Code generated by forge. DO NOT EDIT.
// forge-owned: regenerated every run — do not edit (forge project disown to take ownership)
//
// The staleness guard for this project's mock fixtures.
//
// # What it is defending against
//
// `src/mocks/<entity>_gen.ts` holds the FIRST ROWS OF THE DEV DATABASE,
// written out as TypeScript at `forge generate` time. They are a cache: the
// values come from the same seed plan `forge db seed apply` uses, computed by
// applying `db/migrations` to a real postgres and introspecting the result.
//
// A browser cannot do that, and neither can `npm test` — there is no database
// in either. So the fixtures cannot be recomputed where they are USED, which
// makes them a cache with no natural invalidation. Edit a migration, skip
// `forge generate`, and every fixture keeps confidently serving rows for a
// schema that no longer exists. Nothing breaks; the data is just wrong, and it
// stays wrong until someone notices a column that should be there and isn't.
//
// # What it does instead
//
// It cannot recompute the VALUES without a database, but it can recompute the
// QUESTION. The fixtures were generated from a specific set of input files —
// `db/migrations/*.up.sql` and `db/seeds/vocab.yaml` — and this test hashes
// those same files, by the same rule, and compares the digest to the one
// recorded when the fixtures were written.
//
// The recorded digest is a MARKER (FIXTURE_MARKER, under .forge/) that
// `forge generate` writes and nothing commits, together with the sha256 of each
// generated file it wrote beside the fixtures. So:
//
//   - the fixtures on disk are the ones that marker describes, and the inputs
//     moved since: STALE — the test FAILS with the command that fixes it.
//     Unless the marker also records what each fixture is built from (its
//     tables, the tables they reference or are referenced by, and its enum
//     and domain types) and every migration added since names none of
//     them: a pull or merge that brought in such migrations changed no
//     fixture, and the test passes;
//   - no marker (a fresh clone, CI), or fixtures that differ from the ones it
//     describes (pulled or checked out since): nothing here can vouch for
//     them, so the test SKIPS, naming `forge generate`. Committed fixtures are
//     checked against their inputs by `forge ci verify-generated`, which
//     regenerates them.
//
// That converts the silent-wrong-data failure into a loud one wherever a
// schema edit and a skipped generate meet in one checkout.
//
// It runs in plain Node with no database and no server: it reads files and
// hashes them.
{{ if .HasSchema -}}
import { createHash } from "node:crypto";
import { readdir, readFile, stat } from "node:fs/promises";
import { basename, join } from "node:path";

import { describe, expect, it } from "vitest";

import { FIXTURE_MARKER, PROJECT_ROOT_FROM_FRONTEND } from "@/mocks/fixture-manifest_gen";

// The digest rule, mirroring pkg/seedplan's FingerprintInputs EXACTLY. The two
// implementations are pinned to each other by this test itself: if they ever
// disagree, this fails on a clean tree, which is a loud and immediate signal
// rather than a quiet one.
//
// Every field is LENGTH-FRAMED (`<len>:<bytes>`) before hashing. Without
// framing, concatenation is ambiguous — two different file sets can produce
// the same byte stream — and the guard would miss real changes.
const FINGERPRINT_VERSION = "forge-seed-fp-v1";

/** Length-framed append, the Go side's writeFramed. */
function framed(value: string): string {
  return `${Buffer.byteLength(value, "utf8")}:${value}`;
}

/**
 * Recompute the seed fingerprint from the files on disk.
 *
 * Returns null when the project has no migrations at all — a project that has
 * not authored a schema yet has no fixtures that can be stale.
 */
async function computeFingerprint(migDir: string): Promise<string | null> {
  let entries: string[];
  try {
    entries = await readdir(migDir);
  } catch {
    return null;
  }

  // Only *.up.sql — the exact set forge applies to the shadow database.
  // Down migrations are never applied, so they cannot move a seeded value;
  // hashing them would report drift for an edit that provably cannot cause
  // any.
  const paths = entries.filter((n) => n.endsWith(".up.sql")).map((n) => join(migDir, n));
  if (paths.length === 0) return null;

  // The vocabulary overlay changes VALUES without changing the schema, so it
  // is part of the input set whenever it exists.
  const vocab = join(migDir, "..", "seeds", "vocab.yaml");
  if (await exists(vocab)) paths.push(vocab);

  // Sorted, so directory order cannot change the digest.
  paths.sort();

  const hash = createHash("sha256");
  hash.update(framed(FINGERPRINT_VERSION));
  for (const path of paths) {
    const body = await readFile(path, "utf8");
    // The BASE name, never the full path: an absolute path would make the
    // digest depend on where the repo is checked out, so CI and a laptop
    // would disagree forever.
    hash.update(framed(basename(path)));
    // CRLF is normalized: a checkout under a line-ending-translating git
    // config is not a schema change.
    hash.update(framed(body.replaceAll("\r\n", "\n")));
  }
  return hash.digest("hex");
}

async function exists(path: string): Promise<boolean> {
  try {
    await stat(path);
    return true;
  } catch {
    return false;
  }
}

/** The marker `forge generate` writes (see the manifest). */
interface FixtureMarker {
  seed_fingerprint: string;
  fixtures: Record<string, string>;
  // Per input and per fixture, when the dataset was known (forge#2287).
  migrations?: Record<string, string>;
  vocab?: string;
  fixture_inputs?: Record<string, string[]>;
}

/** One seed input's digest, as forge records it in the marker. */
function inputDigest(body: string): string {
  return createHash("sha256").update(body.replaceAll("\r\n", "\n")).digest("hex");
}

/** A SQL body with its comments removed, lowercased. */
function sqlText(body: string): string {
  return body
    .replace(/\/\*[\s\S]*?\*\//g, " ")
    .replace(/--[^\n]*/g, " ")
    .toLowerCase();
}

/** Whether sql names identifier as a whole word (quoted or schema-qualified alike). */
function mentions(sql: string, identifier: string): boolean {
  const escaped = identifier.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp(`(^|[^a-z0-9_$])${escaped}($|[^a-z0-9_$])`).test(sql);
}

/**
 * Which fixtures the seed inputs that moved since the marker can have
 * changed, each with the input that changed it — or null when the marker
 * carries no per-fixture record, and only the whole digest can be compared.
 *
 * A fixture's rows are a function of the tables and types it is built from
 * (fixture_inputs). A migration added since that names none of them cannot
 * change it: pulling one is not a stale fixture. A vocabulary change, or an
 * edit to (or removal of) a migration the fixtures were built from, may
 * change any of them.
 */
async function staleFixtures(migDir: string, marker: FixtureMarker): Promise<string[] | null> {
  const recorded = marker.migrations;
  const inputs = marker.fixture_inputs;
  if (!recorded || !inputs) return null;
  const every = Object.keys(inputs).sort();
  let vocab = "";
  try {
    vocab = inputDigest(await readFile(join(migDir, "..", "seeds", "vocab.yaml"), "utf8"));
  } catch {
    // no vocabulary overlay
  }
  if (vocab !== (marker.vocab ?? "")) return every.map((f) => `${f} (db/seeds/vocab.yaml changed)`);

  const current = new Map<string, string>();
  for (const name of (await readdir(migDir)).filter((n) => n.endsWith(".up.sql"))) {
    current.set(name, await readFile(join(migDir, name), "utf8"));
  }
  for (const [name, sha] of Object.entries(recorded)) {
    const body = current.get(name);
    if (body === undefined || inputDigest(body) !== sha) {
      return every.map((f) => `${f} (${name} was edited or removed)`);
    }
  }
  const stale: string[] = [];
  for (const name of [...current.keys()].sort()) {
    if (recorded[name] !== undefined) continue;
    const sql = sqlText(current.get(name) ?? "");
    for (const fixture of every) {
      const hit = (inputs[fixture] ?? []).find((id) => mentions(sql, id));
      if (hit !== undefined) stale.push(`${fixture} (${name} names ${hit})`);
    }
  }
  return stale;
}

/**
 * The marker, when it describes the generated files on disk now; otherwise
 * the reason it cannot vouch for them.
 */
async function readMarker(root: string): Promise<FixtureMarker | string> {
  let marker: FixtureMarker;
  try {
    marker = JSON.parse(await readFile(join(root, FIXTURE_MARKER), "utf8")) as FixtureMarker;
  } catch {
    return `no ${FIXTURE_MARKER}: \`forge generate\` has not run in this checkout`;
  }
  for (const [name, sha] of Object.entries(marker.fixtures ?? {})) {
    let body: Buffer;
    try {
      body = await readFile(join(__dirname, name));
    } catch {
      return `${name} is gone since the last \`forge generate\``;
    }
    if (createHash("sha256").update(body).digest("hex") !== sha) {
      return `${name} changed since the last \`forge generate\` in this checkout (pulled or checked out)`;
    }
  }
  return marker;
}

describe("mock fixture freshness", () => {
  it("fixtures were generated from the schema currently on disk", async (ctx) => {
    const root = join(__dirname, PROJECT_ROOT_FROM_FRONTEND);
    const migDir = join(root, {{ .MigrationsDirArgs }});
    const actual = await computeFingerprint(migDir);
    const marker = await readMarker(root);
    if (typeof marker === "string") {
      // Not a pass: nothing here can say which inputs these fixtures came
      // from. `forge ci verify-generated` checks committed fixtures; run
      // `forge generate` to check them here.
      ctx.skip(
        `cannot verify the mock fixtures: ${marker}. Run \`forge generate\` ` +
          "(`reliant forge generate` when forge runs inside reliant) from the project root to check them.",
      );
      return;
    }

    // No migrations: nothing for the fixtures to disagree WITH, and the
    // marker must say so too.
    if (actual === null) {
      expect(marker.seed_fingerprint).toBe("");
      return;
    }

    // The inputs moved: only the migrations that name what a fixture is
    // built from can have changed it. A pull or merge that brought in
    // migrations touching no fixture leaves them current.
    let stale: string[] | null = null;
    if (actual !== marker.seed_fingerprint) {
      stale = await staleFixtures(migDir, marker);
      if (stale !== null && stale.length === 0) return;
    }

    expect(
      actual,
      "STALE MOCK FIXTURES.\n\n" +
        (stale !== null ? `Changed since the last generate: ${stale.join("; ")}.\n\n` : "") +
        "src/mocks/<entity>_gen.ts was generated from different seed inputs than the ones " +
        "on disk now. The fixtures are derived from TWO inputs, and one of them changed " +
        "since the last generate:\n" +
        "  - the schema: db/migrations/*.up.sql (a migration was added or edited), or\n" +
        "  - the seed vocabulary: db/seeds/vocab.yaml (its pools or columns were edited).\n" +
        "Either one changes the rows mock mode (NEXT_PUBLIC_MOCK_API / VITE_MOCK_API) serves " +
        "and your tests assert against, so the cached fixtures no longer match.\n\n" +
        "Fix: from the project root, run `forge generate` (`reliant forge generate` when " +
        "forge runs inside reliant). It rewrites src/mocks/*_gen.ts and the fingerprint " +
        "this test compares.\n",
    ).toBe(marker.seed_fingerprint);
  });
});
{{- else -}}
import { describe, expect, it } from "vitest";

import { FIXTURE_MARKER } from "@/mocks/fixture-manifest_gen";

// This project has no migrations yet, so there is no schema its fixtures can
// go stale against. The guard still ships — and still asserts something real —
// so that the file is present and correct from birth rather than appearing
// later. It becomes the full input-hashing guard on the next `forge generate`
// after the first migration lands.
describe("mock fixture freshness", () => {
  it("records no schema, because the project has no migrations", () => {
    expect(FIXTURE_MARKER).toMatch(/^\.forge\/fixtures\/.+\/generated-from\.json$/);
  });
});
{{- end }}
