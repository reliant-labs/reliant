// Code generated by forge. DO NOT EDIT.
// forge-owned: regenerated every run — do not edit (forge project disown to take ownership)
//
// The staleness guard for this project's mock fixtures.
//
// # What it is defending against
//
// `src/mocks/<entity>_gen.ts` holds the FIRST ROWS OF THE DEV DATABASE,
// written out as TypeScript at `forge generate` time. They are a cache: the
// values come from the same seed plan `forge db seed apply` uses, computed by
// applying `db/migrations` to a real postgres and introspecting the result.
//
// A browser cannot do that, and neither can `npm test` — there is no database
// in either. So the fixtures cannot be recomputed where they are USED, which
// makes them a cache with no natural invalidation. Edit a migration, skip
// `forge generate`, and every fixture keeps confidently serving rows for a
// schema that no longer exists. Nothing breaks; the data is just wrong, and it
// stays wrong until someone notices a column that should be there and isn't.
//
// # What it does instead
//
// It cannot recompute the VALUES without a database, but it can recompute the
// QUESTION. The fixtures were generated from a specific set of input files —
// `db/migrations/*.up.sql` and `db/seeds/vocab.yaml` — and this test hashes
// those same files, by the same rule, and compares the digest to the one
// recorded when the fixtures were written.
//
// Equal digests mean the fixtures were generated from the schema currently on
// disk. A mismatch means they were not, and the test FAILS with the command
// that fixes it. That converts the silent-wrong-data failure into a loud one,
// in a lane (`npm test`, and `task test` in CI) that already runs on every
// change.
//
// It runs in plain Node with no database and no server: it reads files and
// hashes them.
{{ if .HasSchema -}}
import { createHash } from "node:crypto";
import { readdir, readFile, stat } from "node:fs/promises";
import { basename, join } from "node:path";

import { describe, expect, it } from "vitest";

import { SEED_FINGERPRINT, PROJECT_ROOT_FROM_FRONTEND } from "@/mocks/fixture-manifest_gen";

// The digest rule, mirroring pkg/seedplan's FingerprintInputs EXACTLY. The two
// implementations are pinned to each other by this test itself: if they ever
// disagree, this fails on a clean tree, which is a loud and immediate signal
// rather than a quiet one.
//
// Every field is LENGTH-FRAMED (`<len>:<bytes>`) before hashing. Without
// framing, concatenation is ambiguous — two different file sets can produce
// the same byte stream — and the guard would miss real changes.
const FINGERPRINT_VERSION = "forge-seed-fp-v1";

/** Length-framed append, the Go side's writeFramed. */
function framed(value: string): string {
  return `${Buffer.byteLength(value, "utf8")}:${value}`;
}

/**
 * Recompute the seed fingerprint from the files on disk.
 *
 * Returns null when the project has no migrations at all — a project that has
 * not authored a schema yet has no fixtures that can be stale.
 */
async function computeFingerprint(migDir: string): Promise<string | null> {
  let entries: string[];
  try {
    entries = await readdir(migDir);
  } catch {
    return null;
  }

  // Only *.up.sql — the exact set forge applies to the shadow database.
  // Down migrations are never applied, so they cannot move a seeded value;
  // hashing them would report drift for an edit that provably cannot cause
  // any.
  const paths = entries.filter((n) => n.endsWith(".up.sql")).map((n) => join(migDir, n));
  if (paths.length === 0) return null;

  // The vocabulary overlay changes VALUES without changing the schema, so it
  // is part of the input set whenever it exists.
  const vocab = join(migDir, "..", "seeds", "vocab.yaml");
  if (await exists(vocab)) paths.push(vocab);

  // Sorted, so directory order cannot change the digest.
  paths.sort();

  const hash = createHash("sha256");
  hash.update(framed(FINGERPRINT_VERSION));
  for (const path of paths) {
    const body = await readFile(path, "utf8");
    // The BASE name, never the full path: an absolute path would make the
    // digest depend on where the repo is checked out, so CI and a laptop
    // would disagree forever.
    hash.update(framed(basename(path)));
    // CRLF is normalized: a checkout under a line-ending-translating git
    // config is not a schema change.
    hash.update(framed(body.replaceAll("\r\n", "\n")));
  }
  return hash.digest("hex");
}

async function exists(path: string): Promise<boolean> {
  try {
    await stat(path);
    return true;
  } catch {
    return false;
  }
}

describe("mock fixture freshness", () => {
  it("fixtures were generated from the schema currently on disk", async () => {
    const migDir = join(__dirname, PROJECT_ROOT_FROM_FRONTEND, "db", "migrations");
    const actual = await computeFingerprint(migDir);

    // No migrations: nothing for the fixtures to disagree WITH. Assert that
    // explicitly rather than skipping, so this branch is visible in the
    // report instead of looking like a passing check.
    if (actual === null) {
      expect(SEED_FINGERPRINT).toBe("");
      return;
    }

    // A recorded fingerprint of "" means codegen could not read the inputs
    // when it wrote these fixtures. That is not agreement — it is the
    // absence of evidence — and it must not pass silently.
    expect(
      SEED_FINGERPRINT,
      "These mock fixtures carry no seed fingerprint, so there is no way to tell whether " +
        "they match db/migrations and db/seeds/vocab.yaml. From the project root, run " +
        "`forge generate` (`reliant forge generate` when forge runs inside reliant) to record one.",
    ).not.toBe("");

    expect(
      actual,
      "STALE MOCK FIXTURES.\n\n" +
        "src/mocks/<entity>_gen.ts was generated from different seed inputs than the ones " +
        "on disk now. The fixtures are derived from TWO inputs, and one of them changed " +
        "since the last generate:\n" +
        "  - the schema: db/migrations/*.up.sql (a migration was added or edited), or\n" +
        "  - the seed vocabulary: db/seeds/vocab.yaml (its pools or columns were edited).\n" +
        "Either one changes the rows mock mode (NEXT_PUBLIC_MOCK_API / VITE_MOCK_API) serves " +
        "and your tests assert against, so the cached fixtures no longer match.\n\n" +
        "Fix: from the project root, run `forge generate` (`reliant forge generate` when " +
        "forge runs inside reliant). It rewrites src/mocks/*_gen.ts and the fingerprint " +
        "this test compares.\n",
    ).toBe(SEED_FINGERPRINT);
  });
});
{{- else -}}
import { describe, expect, it } from "vitest";

import { SEED_FINGERPRINT } from "@/mocks/fixture-manifest_gen";

// This project has no migrations yet, so there is no schema its fixtures can
// go stale against. The guard still ships — and still asserts something real —
// so that the file is present and correct from birth rather than appearing
// later, and so the manifest's claim ("no schema") is checked rather than
// assumed. It becomes the full input-hashing guard on the next `forge
// generate` after the first migration lands.
describe("mock fixture freshness", () => {
  it("records no schema fingerprint, because the project has no migrations", () => {
    expect(SEED_FINGERPRINT).toBe("");
  });
});
{{- end }}
