func defaultTestConfig(t *testing.T) *testConfig {
	t.Helper()
	return &testConfig{
		logger: testkit.DiscardLogger(),
{{- if .ConfigImport}}
		cfg:    {{if .ConfigDefaults}}config.Defaults(){{else}}&config.Config{}{{end}},
{{- end}}
{{- if .HasDB}}
		// Bare real postgres — no schema (a fresh isolated database on the
		// shared ephemeral postgres). Tests that exercise real SQL should
		// opt in to the migrated database{{if .HasMigrationsFS}} via
		// WithDB(NewMigratedTestDB(t)){{end}}; the migrations run on the
		// same engine production does, so there is no portability subset.
		db: testkit.NewPostgresDB(t),
{{- end}}
	}
}
{{- if and .HasDB .HasMigrationsFS}}

// NewMigratedTestDB returns a real-postgres ORM context with the
// project's embedded db/migrations applied — the same FS AutoMigrate
// uses in production — so handler preconditions (tables, indexes) hold
// in tests. Inject it where the schema matters:
//
//	svc := NewTest{{.FieldName}}(t, WithDB(NewMigratedTestDB(t)))
//
// The migrations run on real postgres (the production engine), so they
// apply verbatim; a migration postgres rejects fails the test LOUDLY,
// naming the offending file.
func NewMigratedTestDB(t *testing.T) orm.Context {
	t.Helper()
	return testkit.NewMigratedPostgresDB(t, forgedb.MigrationsFS)
}
{{- end}}
{{- if .IsService}}

// AuthedContext returns a context carrying authenticated test claims,
// installed via middleware.ContextWithClaims — the same setter the
// production auth middleware uses — so handlers that call
// middleware.GetUser / middleware.ClaimsFromContext see a real principal.
//
// Defaults: UserID "test-user", Role/Roles "admin". Override with
// testkit.ClaimsOption values:
//
//	ctx := AuthedContext(t, testkit.WithRoles("viewer"))
func AuthedContext(t *testing.T, opts ...testkit.ClaimsOption) context.Context {
	return testkit.AuthedContext(t, middleware.ContextWithClaims, opts...)
}
