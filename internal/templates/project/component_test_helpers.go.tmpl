// NewTest{{.FieldName}}Server creates an httptest.Server with the {{.FieldName}} service registered.
// Returns the server and a typed Connect client.
//
// Access control is HANDLER LOGIC (GetUser + your own checks), not a
// generated interceptor, so the only thing standing in for production here
// is AUTHENTICATION: every call reaches the handler carrying the default test
// principal, installed server-side through middleware.ContextWithClaims.
// Server-side is the point — AuthedContext puts claims on a context the TEST
// holds, and a context does not cross HTTP, so passing it to a client call
// authenticates nothing. Adjust the principal with WithPrincipal, or drop it
// with WithoutPrincipal to assert an RPC refuses anonymous callers.
func NewTest{{.FieldName}}Server(t *testing.T, opts ...TestOption) (*httptest.Server, {{.ProtoConnectPkg}}.{{.ConnectServiceGoName}}Client) {
	t.Helper()
	cfg := testkit.ApplyOptions(defaultTestConfig(t), opts...)
	svc := newTest{{.FieldName}}Service(t, cfg)
	var handlerOpts []connect.HandlerOption
	if !cfg.anonymous {
		handlerOpts = append(handlerOpts, testkit.ServerPrincipal(middleware.ContextWithClaims, cfg.principal...))
	}
	return testkit.NewConnectClient(t, svc.{{if .MountMethod}}{{.MountMethod}}{{else}}Register{{end}}, {{.ProtoConnectPkg}}.New{{.ConnectServiceGoName}}Client, handlerOpts...)
}
