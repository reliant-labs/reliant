{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@0.21.0"]
    },
{{- if .ForgeCommandJSON }}
    "forge": {
      "command": {{ .ForgeCommandJSON }},
      "args": {{ .ForgeArgsJSON }}
    },
{{- end }}
    "reliant-docs": {
      "command": "npx",
      "args": ["-y", "@reliant-labs/docs-mcp@0.1.0"]
    }
  }
}
