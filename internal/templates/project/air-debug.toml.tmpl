root = "."
testdata_dir = "testdata"
tmp_dir = "tmp"

[build]
  # Atomic binary replacement: build to .tmp then mv (unix). Windows is
  # overridden in [build.windows] below: air stops the running .exe before
  # building there (a running .exe cannot be replaced), so it builds in place.
  # -trimpath=false beats a -trimpath in GOFLAGS/go env: a debugger sets
  # breakpoints by absolute source path, which a trimmed binary does not record.
  cmd = "forge storage check ./tmp && CGO_ENABLED=0 go build -gcflags='all=-N -l' -trimpath=false -buildvcs=false -o ./tmp/{{.Name}}.tmp ./cmd/{{.Name}} && mv ./tmp/{{.Name}}.tmp ./tmp/{{.Name}}"
  delay = 1000
  # exclude_dir entries are root-relative: the bare "node_modules" only
  # covers a top-level node_modules. "frontends" excludes the whole
  # Next.js tree (frontends/<name>/node_modules included) — no Go code
  # lives there and npm owns that dev loop; without it air watches
  # thousands of node_modules dirs per boot.
  exclude_dir = ["assets", "tmp", "vendor", "testdata", "web", "dist", "node_modules", "frontends", "e2e", "gen", ".forge", ".git", "config", "deploy", "proto", "db"]
  exclude_file = ["_test.go"]
  exclude_regex = ["_test\\.go$"]
  exclude_unchanged = false
  follow_symlink = false
  # ENVIRONMENT=development: see .air.toml. A debug session hits the same wall
  # — the server refuses its own frontend's preflight without it.
  entrypoint = ["dlv", "exec", "--headless", "--listen=:2345", "--api-version=2", "--accept-multiclient", "./tmp/{{.Name}}", "--", "server"]
  include_ext = ["go", "yaml"]
  include_file = []
  kill_delay = "5s"
  log = "build-errors.log"
  poll = false
  poll_interval = 0
  post_cmd = []
  pre_cmd = []
  rerun = false
  rerun_delay = 500
  send_interrupt = true
  stop_on_error = false

[build.windows]
  # PowerShell, not sh: no `&&`, no `mv`, no inline VAR=val. air >= v1.65.3
  # stops the running .exe before building, so building in place is safe.
  cmd = 'forge storage check ./tmp; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $env:CGO_ENABLED=0; go build "-gcflags=all=-N -l" -trimpath=false -buildvcs=false -o ./tmp/{{.Name}}.exe ./cmd/{{.Name}}'
  entrypoint = ["dlv", "exec", "--headless", "--listen=:2345", "--api-version=2", "--accept-multiclient", "./tmp/{{.Name}}.exe", "--", "server"]

[color]
  app = ""
  build = "yellow"
  main = "magenta"
  runner = "green"
  watcher = "cyan"

[log]
  main_only = false
  time = false

[misc]
  clean_on_exit = true

[screen]
  clear_on_rebuild = false
  keep_scroll = true
