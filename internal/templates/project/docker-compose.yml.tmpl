# Images: nothing here pulls from Docker Hub. Its anonymous pull limit is per
# IP, so an office, a CI runner or a cloud sandbox that shares one address runs
# out partway through a first `forge env up`. Each image comes from its
# publisher's own registry where there is one (ghcr for OpenTelemetry and
# Zitadel, quay for Prometheus), from public.ecr.aws/docker/library (the Docker
# Official Images mirror) for postgres, and from mirror.gcr.io (Google's Docker
# Hub cache) for ClickStack, which is published only to Docker Hub.
#
# Every image is pinned by digest, so a registry is only transport: what runs
# is what the digest names, from whichever host serves it. To pull through
# your own mirror, change the host and keep the digest.
services:
  # The app's database as a CONTAINER — available, but NOT what the
  # scaffolded dev environment runs.
  #
  # `deploy/kcl/dev/main.k` declares postgres as a `forge.HostInfra`, so
  # `forge env up` starts a real postgres binary as a host process and never
  # touches this service. The reasoning is there, in the file that makes the
  # choice; the short version is that a dev loop whose own code runs on the
  # host should not require a container runtime underneath it, and on a small
  # cloud VM docker costs hundreds of megabytes before the project starts.
  #
  # To use this instead, change that one declaration:
  #
  #     deploy = forge.Compose {service = "postgres"}
  #
  # and set the DSN's port to match the one published below. Nothing else
  # changes; the app cannot tell the difference.
  postgres:
    image: public.ecr.aws/docker/library/postgres:17-alpine@sha256:1bcc18d81671b02906296aad470ec9778a6b71016ce953092024b680bad007b0
    restart: unless-stopped
    mem_limit: 512m
    cpus: 0.5
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-{{.ProjectName}}}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
    ports:
      # Fixed, loopback-bound host port so the host-side dev loop
      # (`forge env up dev`, psql, DATABASE_URL) reaches postgres without
      # inspecting `docker compose ps` for a random mapping. Override
      # with POSTGRES_PORT if 5432 is taken.
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres}"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - {{.ProjectName}}-net

  app:
    build:
      context: .
      target: dev
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/${POSTGRES_DB:-{{.ProjectName}}}?sslmode=disable
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4318
      OTEL_EXPORTER_OTLP_PROTOCOL: http/protobuf
      OTEL_EXPORTER_OTLP_PROFILES_ENDPOINT: http://otel-profiles:4318/v1development/profiles
      OTEL_SERVICE_NAME: {{.ProjectName}}
      ENVIRONMENT: development
      LOG_LEVEL: debug
      LOG_FORMAT: text
      AUTO_MIGRATE: "true"
      # pprof is on by default and bound to LOOPBACK by the config
      # default (127.0.0.1:6060). Loopback inside a container is the
      # container's own netns, so nothing outside it — no scraper, no
      # published port — can reach it. This
      # is the deliberate container-boundary override, and it is safe
      # because it is confined to this compose network: no port for it
      # is published to the host, and the k8s manifests give it no
      # Service. `docker compose exec app` or a published port of your
      # own is how you reach it by hand.
      PPROF_ADDR: "0.0.0.0:6060"
      # ── Identity (see the `idp` service below) ────────────────────────
      #
      # These are PASSTHROUGH with an empty default, and empty is the
      # CLOSED state, not an off switch: with no key material the
      # validator SetupAuth builds rejects every credential it is shown.
      # Nothing here decides WHETHER this server authenticates — that is
      # AuthDeps{AnonymousOK: false} plus the protos' auth_required
      # declarations, both in source. There is deliberately no
      # AUTH_ENABLED.
      #
      # Bringing the environment up writes both JWT_ISSUER and
      # JWT_JWKS_URL, and against the dev IdP they name the SAME origin
      # (http://localhost:${IDP_PORT}) — the one the browser uses. They
      # stay two fields because a real deployment can need them to
      # differ; here they do not, so discovery would work too.
      #
      # THIS CONTAINER is the exception, and it is why the dev loop for
      # a project with an IdP is `forge env up` (host processes) rather
      # than `docker compose up app`. Zitadel resolves WHICH instance a
      # request is for from the request's Host header, and the instance
      # only knows the domain it was configured with (`localhost`). A
      # fetch from inside this network to http://idp:8080 is answered
      # "Instance not found" — so an in-network JWKS URL does not work,
      # and no URL can carry the override. A host process reaches the
      # IdP at the same localhost URL the browser does, which is the
      # configuration forge writes.
      JWT_ISSUER: ${JWT_ISSUER-}
      JWT_JWKS_URL: ${JWT_JWKS_URL-}
      JWT_AUDIENCE: ${JWT_AUDIENCE-}
      OIDC_CLIENT_ID: ${OIDC_CLIENT_ID-}
      OIDC_REDIRECT_URI: ${OIDC_REDIRECT_URI-}
      OIDC_SCOPES: ${OIDC_SCOPES-}
    ports:
      - "0:8080"
      - "0:6060"
    volumes:
      - .:/app
      - go_mod_cache:/go/pkg/mod
      - go_build_cache:/root/.cache/go-build
    depends_on:
      postgres:
        condition: service_healthy
      clickstack:
        condition: service_started
{{- if .HasFrontend}}
      # required: false is LOAD-BEARING, not politeness. It is what lets
      # `docker compose up app` start without waiting on the IdP — the app
      # does not need it to boot (its identity env is passthrough-empty
      # until the application is registered), and gating the app's start on
      # a second web server's 60s first-boot would slow every `up` for a
      # dependency it can tolerate arriving late.
      idp:
        condition: service_healthy
        required: false
{{- end}}
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q --spider http://localhost:8080/healthz || exit 1",
        ]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 15s
    networks:
      - {{.ProjectName}}-net

  app-debug:
    build:
      context: .
      target: debug
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/${POSTGRES_DB:-{{.ProjectName}}}?sslmode=disable
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4318
      OTEL_EXPORTER_OTLP_PROTOCOL: http/protobuf
      OTEL_EXPORTER_OTLP_PROFILES_ENDPOINT: http://otel-profiles:4318/v1development/profiles
      OTEL_SERVICE_NAME: {{.ProjectName}}
      ENVIRONMENT: development
    ports:
      - "0:8080"
      - "0:2345"
    security_opt:
      - "apparmor=unconfined"
    cap_add:
      - SYS_PTRACE
    depends_on:
      postgres:
        condition: service_healthy
      clickstack:
        condition: service_started
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q --spider http://localhost:8080/healthz || exit 1",
        ]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 30s
    profiles:
      - debug
    networks:
      - {{.ProjectName}}-net

{{- if .HasFrontend}}
  # Zitadel — an OIDC identity provider, so a developer can complete a REAL
  # browser sign-in locally instead of hand-minting HS256 tokens.
  #
  # AVAILABLE, but NOT what the scaffolded dev environment runs — the same
  # status the `postgres` service above has.
  #
  # `deploy/kcl/dev/main.k` declares the IdP as a `forge.HostInfra` with
  # `engine = "zitadel"`, so `forge env up` downloads the pinned Zitadel binary
  # once and supervises it as a host process. That is what makes a
  # scaffolded project start ZERO containers: Zitadel is a single static Go
  # binary, and a dev loop whose own code runs on the host should not need a
  # container runtime for its dependencies either.
  #
  # To use this instead, change that one declaration:
  #
  #     deploy = forge.Compose {
  #         service = "idp"
  #         env = {"IDP_PORT": str(_idp_port)}
  #     }
  #
  # Everything else is unchanged — same steps file, same port, same
  # provisioning job — because all of it reads the same `_idp_port`.
  #
  # It is scaffolded HERE because this project declares a frontend. A
  # project with no browser (API-key auth, a worker, a CLI) never gets
  # this service written at all, so it never pays for a second web server
  # it would not call.
  #
  # The instance is DECLARED, not provisioned by hand. `idp-steps.yaml`
  # next to this file describes the instance, the organization, the admin
  # user and the service account, and Zitadel converges to it on first
  # boot — including writing the service account's personal access token to
  # ./.forge/idp/pat.txt.
  #
  # The app's identity env stays EMPTY by default rather than defaulting to
  # these URLs, and that is deliberate: a configured-but-unreachable JWKS
  # endpoint makes the server REFUSE TO START (pkg/auth fetches keys at
  # boot). The values are converged into deploy/kcl/dev/config.k once the
  # application is registered — see below. Empty means "no key material" —
  # closed, and bootable.
  #
  # One value CANNOT be declared: an OIDC client's `client_id` is generated
  # by the server when the application is registered, so the browser cannot
  # be told what to send until it exists. Zitadel's FirstInstance schema has
  # no Project/Application section, so there is nowhere in THIS file to put
  # it. forge converges it instead: bringing the environment up registers
  # the application over the IdP's own API (using the PAT above) and writes
  # the client id — plus the issuer/JWKS/audience both halves must agree on
  # — into the env's KCL config. It adopts an existing
  # registration rather than creating a second one, so it is a no-op once
  # correct — and bringing the environment up is the only thing that runs
  # it, so there is no second path to forget.
  #
  # Pinned MINOR.PATCH, never `latest`: an IdP that silently changes
  # version under a dev stack turns "login broke today" into an
  # archaeology exercise. Bump deliberately.
  idp:
    image: ghcr.io/zitadel/zitadel:v4.19.5@sha256:a586456a208e0db4c633db0ba43c427c24b37846138b8b13ff16ad8e003a18d3
    restart: unless-stopped
    # Backed by `idp-db` below — a postgres container of the IdP's OWN,
    # NOT the app's database.
    #
    # It used to share the app's postgres in a separate `zitadel`
    # database, which was the right call when both were containers on one
    # compose network. They are not any more: the app's postgres runs as a
    # HOST PROCESS by default (see deploy/kcl/dev/main.k), and pointing a
    # container at it would mean reaching back out through the docker
    # host gateway — a different address on Linux than on macOS, on a port
    # that moves when the host port does. That is a lot of coupling to
    # save a container on the ONE service in this stack that is already a
    # container.
    #
    # The cost is ~256 MB and a second volume while the IdP is running.
    # The benefit is that the IdP's storage is entirely its own: it starts,
    # stops and resets without touching the app's database, and nothing
    # about where the app's postgres lives can break the sign-in loop.
    command:
      - start-from-init
      - --masterkey
      - ${IDP_MASTERKEY:-MasterkeyNeedsToHave32Characters}
      - --tlsMode
      - disabled
      - --steps
      - /steps.yaml
    environment:
      # `idp-db` is the compose service name below — an in-network address,
      # so no host port is involved and nothing here moves when the app's
      # postgres does.
      ZITADEL_DATABASE_POSTGRES_HOST: idp-db
      ZITADEL_DATABASE_POSTGRES_PORT: "5432"
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      # Plain HTTP, because this is a local dev loop with no certificate.
      # Both are required: ExternalSecure alone still serves TLS.
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_TLS_ENABLED: "false"
      # EXTERNALDOMAIN/EXTERNALPORT are the address the BROWSER uses, and
      # they are what Zitadel mints tokens under — the `iss` your server
      # then enforces. They are also how Zitadel decides which instance a
      # request is FOR: it matches the request's Host header against the
      # instance's registered domains and answers "Instance not found" to
      # anything else. That is why nothing in this stack reaches the IdP
      # at `http://idp:8080` — see the `auth/dev-loop` skill.
      ZITADEL_EXTERNALDOMAIN: localhost
      ZITADEL_EXTERNALPORT: ${IDP_PORT:-8080}
      # The declarative boot writes the service account's PAT here, which
      # is what lets forge register the application
      # without a console visit or a seeded secret read out of the IdP's
      # own database.
      ZITADEL_FIRSTINSTANCE_PATPATH: /pat/pat.txt
      # Serve the BUILT-IN (v1) sign-in pages. Zitadel v4 defaults this to
      # `true`, which routes /oauth/v2/authorize at a login UI that ships
      # as a SEPARATE container (ghcr.io/zitadel/zitadel-login) — with
      # that container absent the sign-in page 404s, so the redirect flow
      # dead-ends after a correct-looking authorization request. The v1
      # pages are served by this container and complete the same flow, so
      # one container is the whole IdP. If you later want the v2 login
      # experience, add that image and set this back to true.
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED: "false"
      # Do not interrupt the first sign-in with a passkey/2FA enrollment
      # prompt. It is skippable, but it is a screen between a developer
      # and the thing they are actually testing, and a local instance has
      # no SMTP or WebAuthn origin to complete it against.
      #
      # BOTH are needed and they are not the same knob. ForceMFA (already
      # false by default) decides whether MFA is REQUIRED; these decide
      # whether the enrollment NUDGE is shown. PasswordlessType 0 drops
      # the passkey offer, and MfaInitSkipLifetime 0s stops the "set up
      # 2FA" interstitial — with only the first, the sign-in still lands
      # on a 2-Factor Setup screen instead of the callback.
      #
      # A DEV default, not a recommendation: your real IdP is a different
      # issuer and should absolutely prompt.
      ZITADEL_DEFAULTINSTANCE_LOGINPOLICY_PASSWORDLESSTYPE: "0"
      ZITADEL_DEFAULTINSTANCE_LOGINPOLICY_MFAINITSKIPLIFETIME: 0s
    volumes:
      - ./idp-steps.yaml:/steps.yaml:ro
      - ./.forge/idp:/pat
    ports:
      # Loopback-bound and FIXED — this one genuinely cannot float. The
      # issuer in every token Zitadel mints is derived from the origin it
      # is reached on, and both halves of auth have to name that same
      # origin in advance (the browser's oidc_issuer and the backend's
      # jwt_issuer), so a port assigned at launch would leave two
      # declarations pointing nowhere. Override it with IDP_PORT when it
      # collides, and move the declared issuer with it.
      #
      # The FRONTEND's port is a different matter and is NOT pinned: the
      # app registered here runs in dev mode, where Zitadel matches
      # redirect URIs as globs, so `forge env up` (which converges the env's
      # forge.ManagedIdentity) registers http://localhost:*/auth/callback and the
      # frontend keeps whatever port the kernel gives it.
      #
      # Zitadel needs ONE port — its console, APIs and OIDC endpoints are
      # all served here.
      - "127.0.0.1:${IDP_PORT:-8080}:8080"
    depends_on:
      idp-db:
        condition: service_healthy
    healthcheck:
      # /debug/ready is Zitadel's own unauthenticated readiness route. It
      # reports READY rather than merely listening, which matters on the
      # first boot: the declarative setup (schema, instance, org, admin
      # user, PAT) runs before it starts serving. The image is distroless
      # — no wget, no curl, no shell — so probe with the zitadel binary
      # that is guaranteed present.
      test: ["CMD", "/app/zitadel", "ready"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 60s
    networks:
      - {{.ProjectName}}-net

  # The dev IdP's OWN database. Deliberately not the app's.
  #
  # NO PUBLISHED PORT: nothing outside the compose network ever connects to
  # it, so it takes no host port and cannot collide with anything — which
  # also means there is no second port to declare in KCL. The IdP reaches it
  # at `idp-db:5432` on this network.
  #
  # It is only running while the IdP is. `forge env up` starts the IdP, which
  # `depends_on` this and waits for its healthcheck, so it comes and goes
  # with the one service that uses it. A project that drops the IdP from
  # deploy/kcl/dev/main.k starts neither.
  idp-db:
    image: public.ecr.aws/docker/library/postgres:17-alpine@sha256:1bcc18d81671b02906296aad470ec9778a6b71016ce953092024b680bad007b0
    restart: unless-stopped
    mem_limit: 256m
    cpus: 0.5
    environment:
      # Fixed, not ${VAR}-driven: these credentials are reachable only from
      # inside this network, they are referenced by the `idp` service above,
      # and making them configurable would be two more values to keep in
      # agreement for no gain.
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      # Zitadel creates its own `zitadel` database on first boot (hence the
      # ADMIN credentials it is given), so this is just the maintenance DB
      # it connects to in order to do that.
      POSTGRES_DB: postgres
    volumes:
      - idp_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - {{.ProjectName}}-net
{{- end}}

  # ClickStack — the local observability backend, ON by default.
  #
  # ONE container, HyperDX's own "local mode" image (clickhouse/clickstack-local):
  # ClickHouse + MongoDB + the HyperDX UI/API + the ClickStack OTel collector.
  # Local mode is HyperDX's documented no-auth build, so there is nothing to
  # register and no ingestion key to copy: the collector opens its OTLP
  # receivers at boot and accepts traces, metrics and logs from any caller that
  # can reach the port. That is safe here only because every port below is
  # published on LOOPBACK. The separate-container topology (OpAMP-managed
  # collector + team API keys) opens no OTLP port until someone registers in the
  # UI, and then demands a key apps cannot send — do not reintroduce it.
  #
  # Three signals, one path each:
  #   traces + metrics  host processes push OTLP/HTTP to 127.0.0.1:4318 (`forge
  #                     env up` exports OTEL_EXPORTER_OTLP_ENDPOINT to them);
  #                     compose services push to http://otel-collector:4318.
  #   logs              the collector tails .forge/logs/<env>/<service>.log —
  #                     the files `forge env up` already tees every host
  #                     process into — and parses the JSON lines the runtime
  #                     writes. See deploy/observability/otel-collector.yaml.
  #
  # ClickHouse is NOT published: it listens only inside this container, behind
  # the user below (the passwordless `default` user is removed). Query it with
  #   docker compose exec clickstack sh -c 'clickhouse-client -u "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD"'
  #
  # To turn it off: `_observability = False` in deploy/kcl/dev/main.k.
  #
  # Ports are declared once in deploy/kcl/dev/main.k and handed to compose as
  # CLICKSTACK_*_PORT; the defaults only serve a bare `docker compose up`.
  clickstack:
    image: mirror.gcr.io/clickhouse/clickstack-local:2.40.0@sha256:4690fbfc2f25e2366ca496aabf4ee9e14d6cacb42119b84888b182495e6a5b74
    restart: unless-stopped
    # tini as PID 1: the dashboard-provisioner loop below is a background child
    # of the image's entrypoint and would otherwise be reparented to a shell.
    init: true
    ports:
      - "127.0.0.1:${CLICKSTACK_UI_PORT:-8180}:8080" # HyperDX UI + API
      - "127.0.0.1:${CLICKSTACK_OTLP_HTTP_PORT:-4318}:4318" # OTLP/HTTP, for host processes
      - "127.0.0.1:${CLICKSTACK_OTLP_GRPC_PORT:-4317}:4317" # OTLP/gRPC, for host processes
    environment:
      FRONTEND_URL: http://localhost:${CLICKSTACK_UI_PORT:-8180}
      # Dev-only credentials, never published. Setting a user removes the
      # image's passwordless `default`; the collector and HyperDX both read
      # these from the container env.
      CLICKHOUSE_USER: forge
      CLICKHOUSE_PASSWORD: ${CLICKSTACK_CLICKHOUSE_PASSWORD:-forge-dev-only}
      DEFAULT_CONNECTIONS: '[{"name":"Local ClickHouse","host":"http://localhost:8123","username":"forge","password":"${CLICKSTACK_CLICKHOUSE_PASSWORD:-forge-dev-only}"}]'
      USAGE_STATS_ENABLED: "false"
      # Table TTL from Observability.retention (one TTL covers every table:
      # the longest hint). Unset keeps ClickStack's own default.
      HYPERDX_OTEL_EXPORTER_TABLES_TTL: ${CLICKSTACK_TABLES_TTL:-720h}
      # YOUR collector pipelines, merged over ClickStack's: the filelog log path.
      CUSTOM_OTELCOL_CONFIG_FILE: /etc/otelcol-contrib/forge.config.yaml
      # Where the dashboard provisioner reads HyperDX v2 dashboard JSON (below).
      DASHBOARD_PROVISIONER_DIR: /etc/forge/dashboards
    # Local mode starts neither the dashboard provisioner nor a Team document
    # for it to attach to. This wrapper adds both: once the API is up it loads
    # every *.json in the provisioner dir, and again whenever the set of files
    # changes, so dropping a dashboard in needs no restart. (`$$` is compose's
    # escape for a literal `$`.)
    entrypoint:
      - sh
      - -c
      - |
        cat > /tmp/forge-bind.js <<'FORGE_BIND'
        var T = ObjectId("5f6c6f63616c5f7465616d5f");
        var ids = {};
        db.sources.find({team: T}).forEach(function (s) { ids[s.name] = s._id.str; });
        db.dashboards.find({team: T, provisioned: true}).forEach(function (d) {
          var tiles = (d.tiles || []).map(function (t) { if (t.config && ids[t.config.source]) { t.config.source = ids[t.config.source]; } return t; });
          var filters = (d.filters || []).map(function (f) { if (ids[f.source]) { f.source = ids[f.source]; } return f; });
          db.dashboards.updateOne({_id: d._id}, {$$set: {tiles: tiles, filters: filters}});
        });
        var raw = "";
        listFiles("/etc/forge/dashboards").forEach(function (f) {
          if (f.isDirectory || !/_gen\.ndjson$$/.test(f.name)) { return; }
          try { raw += cat(f.name) + "\n"; } catch (e) {}
        });
        raw.split("\n").forEach(function (line) {
          if (!line) { return; }
          var s = JSON.parse(line);
          if (!ids[s.source]) { return; }
          db.savedsearches.updateOne({team: T, name: s.name}, {$$set: {select: s.select, where: s.where, whereLanguage: s.whereLanguage, orderBy: s.orderBy, source: ObjectId(ids[s.source]), tags: s.tags}}, {upsert: true});
        });
        FORGE_BIND
        (
          until curl -fs http://localhost:8000/health >/dev/null 2>&1; do sleep 3; done
          last=
          while :; do
            # The image starts the collector once, with no retry. On a starved
            # machine its OpAMP supervisor can miss its bootstrap window and
            # exit ("failed to start supervisor"), leaving a healthy UI and
            # nothing listening on 4317/4318. Start it again, with the
            # environment the image gave the rest of the stack.
            if ! pgrep -x opampsupervisor >/dev/null; then
              echo "[forge] the ClickStack collector is not running; starting it again"
              xargs -0 -a /proc/$$(pgrep -f '^node ./node_modules/.bin/concurrently' | head -1)/environ \
                sh -c 'exec env "$$@" /otel-entrypoint.sh /usr/local/bin/opampsupervisor' sh >/proc/1/fd/1 2>&1 &
              sleep 20
            fi
            now=$$(cd "$$DASHBOARD_PROVISIONER_DIR" && cksum *.json *.ndjson 2>/dev/null)
            if [ "$$now" != "$$last" ]; then
              mongo --quiet hyperdx --eval 'db.teams.updateOne({_id: ObjectId("5f6c6f63616c5f7465616d5f")}, {$$setOnInsert: {name: "Local App Team", collectorAuthenticationEnforced: false}}, {upsert: true})' >/dev/null
              (cd /app && MONGO_URI=mongodb://db:27017/hyperdx IS_LOCAL_APP_MODE='DANGEROUSLY_is_local_app_mode💀' HYPERDX_IMAGE=all-in-one-noauth RUN_SCHEDULED_TASKS_EXTERNALLY=true DASHBOARD_PROVISIONER_TEAM_ID=5f6c6f63616c5f7465616d5f ./packages/api/bin/hyperdx task provision-dashboards) >/proc/1/fd/1 2>&1 && last="$$now"
            fi
            # Dashboards name their source ("Logs", "Traces", "Metrics"); the
            # UI looks a source up by its mongo id, which is random per
            # database. Swap each name for this database's id, and upsert the
            # generated saved searches, which the file provisioner has no path
            # for. Idempotent, so it runs every pass: a name already replaced
            # matches nothing, and a source that does not exist yet is retried.
            mongo --quiet hyperdx /tmp/forge-bind.js >/dev/null
            sleep 15
          done
        ) &
        exec sh /etc/local/entry.sh
    volumes:
      - clickstack_clickhouse:/var/lib/clickhouse
      - clickstack_mongo:/data/db
      - ./deploy/observability/otel-collector.yaml:/etc/otelcol-contrib/forge.config.yaml:ro
      - ./.forge/logs:/var/log/forge:ro
      - ./deploy/observability/dashboards:/etc/forge/dashboards:ro
    healthcheck:
      # Ready means the thing #603 never had: the UI answers AND the collector
      # is actually accepting OTLP (it opens its receivers only once HyperDX
      # has handed it config, a moment after the UI is up).
      test:
        - CMD-SHELL
        - >-
          curl -fs http://localhost:8080/api/health >/dev/null &&
          curl -fs -X POST -H 'Content-Type: application/json' -d '{}' http://localhost:4318/v1/traces >/dev/null
      interval: 5s
      timeout: 5s
      retries: 60
      start_period: 20s
    networks:
      {{.ProjectName}}-net:
        # What compose services (and the `app` service above) export to.
        aliases:
          - otel-collector

  # otel-forwarder — stands in for `clickstack` when the env declares an
  # observability DESTINATION (`destination = forge.ObservabilityDestination
  # {...}` in deploy/kcl/dev/main.k): a plain collector that forwards OTLP and
  # the host processes' logs there instead of storing them locally. Its
  # pipelines are rendered by `forge env up` from that declaration into
  # .forge/observability/forwarder.yaml; the destination's headers arrive as
  # FORGE_OTLP_HEADERS from the env's secret store, never from this file.
  # Apps are unchanged: they keep exporting to the same local port.
  otel-forwarder:
    image: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6
    restart: unless-stopped
    # The gate lets a destination that accepts profiles get them
    # (`signals.profiles = True`); it is inert while no profiles pipeline exists.
    command:
      [
        "--config=/etc/otel/forwarder.yaml",
        "--feature-gates=+service.profilesSupport",
      ]
    ports:
      - "127.0.0.1:${OTEL_FORWARDER_HTTP_PORT:-4318}:4318"
      - "127.0.0.1:${OTEL_FORWARDER_GRPC_PORT:-4317}:4317"
    # A destination on this machine (localhost, 127.0.0.1) is rendered as
    # host.docker.internal: inside this container "localhost" is the container.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      FORGE_OTLP_HEADERS: ${FORGE_OTLP_HEADERS:-}
    volumes:
      - ./.forge/observability/forwarder.yaml:/etc/otel/forwarder.yaml:ro
      - ./.forge/logs:/var/log/forge:ro
    networks:
      {{.ProjectName}}-net:
        aliases:
          - otel-collector

  # ── Profiles ───────────────────────────────────────────────────────────────
  # The collector inside `clickstack` is ClickStack's own build of contrib v0.155:
  # it receives profiles but cannot WRITE them. So continuous profiles take a
  # SECOND collector, stock contrib v0.162.0 with the `service.profilesSupport`
  # feature gate, writing to the ClickHouse inside `clickstack` (26.8, past the
  # 26.2 contrib's profiles exporter needs). Nothing replaces the collector above;
  # traces, metrics and logs keep their one endpoint.
  #
  # Apps PUSH. pkg/observe captures a 10s CPU profile plus heap and goroutine
  # snapshots about once a minute and POSTs OTLP profiles to
  # OTEL_EXPORTER_OTLP_PROFILES_ENDPOINT. dev/main.k's declaration
  # (`profiles_port`) points host processes at 127.0.0.1:${CLICKSTACK_PROFILES_OTLP_PORT};
  # compose services use `otel-profiles` below. It runs only beside `clickstack`
  # (it writes into its ClickHouse), so a destination env does not start it.
  # The collector scrapes nothing. OTEL_PROFILES_EXPORTER=none turns a
  # process's profiling off.
  #
  # Tables and TTLs live in deploy/observability/profiles-schema.sql, applied
  # idempotently by `profiles-schema` on every up; the collector writes only
  # (create_schema: false). Read them back with `forge obs profile`.
  #
  # Pinned by digest AND version: the profiles wire format is v1development and
  # changes between releases. pkg/observe's converter is pinned to the same
  # v0.162.0; bump them together.
  profiles-schema:
    image: mirror.gcr.io/clickhouse/clickstack-local:2.40.0@sha256:4690fbfc2f25e2366ca496aabf4ee9e14d6cacb42119b84888b182495e6a5b74
    restart: "no"
    depends_on:
      clickstack:
        condition: service_healthy
    environment:
      CLICKHOUSE_USER: forge
      CLICKHOUSE_PASSWORD: ${CLICKSTACK_CLICKHOUSE_PASSWORD:-forge-dev-only}
    entrypoint:
      - sh
      - -c
      - >-
        until clickhouse-client --host clickstack -u "$$CLICKHOUSE_USER" --password "$$CLICKHOUSE_PASSWORD" --query 'SELECT 1' >/dev/null 2>&1; do sleep 2; done;
        exec clickhouse-client --host clickstack -u "$$CLICKHOUSE_USER" --password "$$CLICKHOUSE_PASSWORD" --multiquery < /etc/forge/profiles-schema.sql
    volumes:
      - ./deploy/observability/profiles-schema.sql:/etc/forge/profiles-schema.sql:ro
    networks:
      - {{.ProjectName}}-net

  otel-profiles:
    image: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6
    restart: unless-stopped
    command:
      - --config=/etc/otelcol/profiles.yaml
      - --feature-gates=+service.profilesSupport
    ports:
      - "127.0.0.1:${CLICKSTACK_PROFILES_OTLP_PORT:-4328}:4318" # OTLP/HTTP profiles, for host processes
    environment:
      CLICKHOUSE_USER: forge
      CLICKHOUSE_PASSWORD: ${CLICKSTACK_CLICKHOUSE_PASSWORD:-forge-dev-only}
    volumes:
      - ./deploy/observability/otel-profiles.yaml:/etc/otelcol/profiles.yaml:ro
    depends_on:
      profiles-schema:
        condition: service_completed_successfully
    networks:
      {{.ProjectName}}-net:
        aliases:
          - otel-profiles

  # ── Local alert delivery ─────────────────────────────────────────────────
  # The Alertmanager the local evaluator (`forge obs alerts run`, the
  # `alerts` workload in deploy/kcl/dev/main.k) posts firing alerts to. Its
  # configuration is NOT written here: `forge env up` renders it into
  # .forge/observability/alertmanager/ from the env's forge.Alerts with the
  # control plane's own renderer (forge/pkg/alerting/amconfig), so a route
  # reaches the same receiver locally as in production. Receivers are
  # forge.AlertReceiver entries; their secrets come from the env's secret
  # store as files under secrets/. The default receiver, reliant-inapp,
  # delivers to the evaluator, which writes .forge/logs/dev/alerts.log.
  #
  # The image is the version (and digest) the control plane runs and links
  # the config loader of, from the Prometheus project's own registry (quay
  # serves the same digest as Docker Hub, without its anonymous pull limit).
  # One replica, so gossip is off. host.docker.internal is how it reaches
  # receivers on this machine (forge rewrites localhost to it).
  alertmanager:
    image: quay.io/prometheus/alertmanager:v0.28.1@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=:9093
      - --cluster.listen-address=
    ports:
      - "127.0.0.1:${ALERTMANAGER_PORT:-9093}:9093" # API + UI
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./.forge/observability/alertmanager:/etc/alertmanager:ro
      - alertmanager_data:/alertmanager
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:9093/-/ready"]
      interval: 5s
      timeout: 5s
      retries: 24
    networks:
      - {{.ProjectName}}-net

volumes:
  postgres_data:
  go_mod_cache:
  go_build_cache:
  clickstack_clickhouse:
  clickstack_mongo:
  alertmanager_data:
{{- if .HasFrontend}}
  idp_db_data:
{{- end}}

networks:
  {{.ProjectName}}-net:
    driver: bridge
