package {{.Package}}

import (
	"context"
	"log/slog"
	"time"

	"go.opentelemetry.io/otel"
{{- if .HasConfig}}

	"{{.Module}}/pkg/config"
{{- end}}
)

// tracer is the OTel tracer for this worker, named after the package so
// spans group cleanly in the trace UI.
var tracer = otel.Tracer("internal/workers/{{.Name}}")

// Deps contains the dependencies for the {{.Name}} worker.
type Deps struct {
	Logger *slog.Logger
{{- if .HasConfig}}
	Config *config.Config
{{- end}}
}

// Worker implements the background processing for {{.Name}}.
type Worker struct {
	deps Deps
}

// New creates a new {{.Name}} worker.
func New(deps Deps) *Worker {
	return &Worker{deps: deps}
}

// Name returns the worker's identifier.
func (w *Worker) Name() string { return "{{.Name | kebabCase}}" }

// Start runs the worker's cycle loop until ctx is cancelled. Keep the
// ctx.Done() arm — it is the graceful-shutdown seam. See the forge
// `workers` skill.
func (w *Worker) Start(ctx context.Context) error {
	w.deps.Logger.InfoContext(ctx, "worker started", "worker", w.Name())

	// TODO: tune the cadence, or replace the ticker with a queue/event stream.
	ticker := time.NewTicker(30 * time.Second)
	defer ticker.Stop()

	for {
		select {
		case <-ctx.Done():
			return nil
		case <-ticker.C:
			if err := w.runOnce(ctx); err != nil {
				w.deps.Logger.ErrorContext(ctx, "worker cycle failed", "worker", w.Name(), "error", err)
			}
		}
	}
}

// runOnce performs a single work cycle. Pass ctx into every context-aware
// call so a long cycle observes shutdown mid-flight.
func (w *Worker) runOnce(ctx context.Context) error {
	// LIFO defer: span.End() runs after recover, so the span records the
	// panicked state. Nothing above this restarts a poll worker, so a panic
	// that escaped here would unwind through Start's ticker loop and take
	// the whole process down; recovering keeps the cadence alive across bad
	// cycles.
	ctx, span := tracer.Start(ctx, "worker.{{.Name}}.tick")
	defer func() {
		if r := recover(); r != nil {
			w.deps.Logger.ErrorContext(ctx, "worker cycle panicked", "worker", w.Name(), "panic", r)
		}
		span.End()
	}()

	// TODO: implement your per-cycle work here.
	w.deps.Logger.InfoContext(ctx, "worker cycle", "worker", w.Name())
	return nil
}

// Stop is called during graceful shutdown, after Start's ctx has been
// cancelled and the cycle loop has returned. Drain in-flight work here.
func (w *Worker) Stop(ctx context.Context) error {
	w.deps.Logger.InfoContext(ctx, "worker stopping", "worker", w.Name())
	return nil
}
