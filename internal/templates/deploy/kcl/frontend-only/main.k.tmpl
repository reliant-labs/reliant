"""
{{.ProjectName}} / {{.EnvName}}: a frontend with no backend infrastructure.
YOURS: forge scaffolds this file once. Each frontend binds its own runtime.
{{if eq .EnvName "dev"}}`forge env up dev` starts the dev server; no database or cluster is needed.{{else}}Static hosting is managed by Reliant: the bucket, the CDN and the hostname. Hosting limits and billing are enforced by the platform; see `forge skill load deploy/static-site`.
`forge env deploy {{.EnvName}}` publishes the static export.{{end}}
"""
import forge
{{if eq .EnvName "dev"}}import kcl_plugin.forge as plugin
{{end}}
_hosted_frontend = lambda f: forge.Frontend -> forge.Frontend {
    f | {image = f.name, runtime = forge.OnHosted {}}
}
# Hosting elsewhere is a binding edit: declare your bucket, then rebind
# the frontend's line to `_on_bucket(...)`.
_bucket = None
_on_bucket = lambda f: forge.Frontend -> forge.Frontend {
    assert _bucket, "declare _bucket = forge.OnBucket {bucket = \"your-bucket\"}, or use _hosted_frontend"
    f | {runtime = _bucket}
}
_on_host_frontend = lambda f: forge.Frontend -> forge.Frontend {
    f | {runtime = forge.OnHost {}}
}
{{if .HasFrontend}}
# Masked session recording for this environment. False stops capture AND
# removes the ingestion opt-in. DNT/GPC and the app's consent gate still win.
# Dev uses hosted telemetry when signed in; offline, supply a collector to
# record sessions (observability.local_port), or leave capture unavailable.
_session_replay = {{if .SessionReplay}}True{{else}}False{{end}}
_{{.FrontendIdent}}_frontend = forge.Frontend {
    runtime_config = {OTEL_REPLAY = "true" if _session_replay else "false"}
    name = "{{.FrontendName}}"
{{if .FrontendType}}    type = "{{.FrontendType}}"
{{end}}    path = "{{.FrontendPath}}"
{{if .FrontendRoutes}}    routes = [{{range .FrontendRoutes}}{{printf "%q" .}}, {{end}}]
{{end}}    public_dir = "{{.FrontendPublicDir}}"
{{if eq .EnvName "dev"}}    port = plugin.resolve_port("{{.ProjectName}}-dev-{{.FrontendName}}", 3000)
{{end}}}
{{end}}
_bundle = forge.Bundle {
    project = "{{.ProjectName}}"
    control_plane = forge.ControlPlane {}
{{if .HasFrontend}}    observability = forge.Observability {signals = forge.ObservabilitySignals {replay = _session_replay}}
{{end}}{{if eq .EnvName "dev"}}    lifecycle = "local"
{{end}}{{if .HasFrontend}}    frontends = [
{{if eq .EnvName "dev"}}        _on_host_frontend(_{{.FrontendIdent}}_frontend)
{{else}}        _hosted_frontend(_{{.FrontendIdent}}_frontend)
{{end}}    ]
{{end}}    secret_provider = {{if eq .EnvName "dev"}}forge.FileSecrets {path = "secrets/dev.yaml"}{{else}}forge.HostedSecrets {}{{end}}
}
output = forge.render(_bundle)
