// DeepCopyObject implements runtime.Object.
//
// Hand-written because these types live beside the controller, outside api/,
// where forge generates no deepcopy. Move them under api/<version>/ (scaffold
// with --api-package) to get a generated, field-complete deepcopy instead.
func (in *{{.TypeName}}) DeepCopyObject() runtime.Object {
	if in == nil {
		return nil
	}
	out := new({{.TypeName}})
	*out = *in
	in.ObjectMeta.DeepCopyInto(&out.ObjectMeta)
	out.Status.Conditions = make([]metav1.Condition, len(in.Status.Conditions))
	copy(out.Status.Conditions, in.Status.Conditions)
	return out
}

// DeepCopyObject implements runtime.Object.
func (in *{{.TypeName}}List) DeepCopyObject() runtime.Object {
	if in == nil {
		return nil
	}
	out := new({{.TypeName}}List)
	*out = *in
	out.Items = make([]{{.TypeName}}, len(in.Items))
	for i := range in.Items {
		out.Items[i] = *in.Items[i].DeepCopyObject().(*{{.TypeName}})
	}
	return out
}
