{
  "name": "shop: shop-worker",
  "tags": [
    "forge",
    "generated"
  ],
  "tiles": [
    {
      "id": "t-worker-runs",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Worker runs",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "runs"
          }
        ],
        "where": "ServiceName IN ('shop-worker') AND startsWith(SpanName, 'worker.')",
        "whereLanguage": "sql",
        "groupBy": "SpanName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-worker-failures",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Worker run failures",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "failed"
          }
        ],
        "where": "ServiceName IN ('shop-worker') AND startsWith(SpanName, 'worker.') AND lower(StatusCode) = 'error'",
        "whereLanguage": "sql",
        "groupBy": "SpanName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-worker-duration",
      "x": 0,
      "y": 7,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Worker run duration",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "runs"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "failed"
          },
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration/1e6",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "ServiceName IN ('shop-worker') AND startsWith(SpanName, 'worker.')",
        "whereLanguage": "sql",
        "groupBy": "SpanName"
      }
    },
    {
      "id": "t-go-memory",
      "x": 0,
      "y": 15,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Go memory used",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "",
            "alias": "used",
            "metricName": "go.memory.used",
            "metricType": "sum"
          },
          {
            "aggFn": "avg",
            "valueExpression": "",
            "alias": "gc goal",
            "metricName": "go.memory.gc.goal",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName IN ('shop-worker')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "byte",
          "mantissa": 1
        }
      }
    },
