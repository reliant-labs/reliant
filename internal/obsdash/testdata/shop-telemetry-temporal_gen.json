{
  "name": "shop: temporal",
  "tags": [
    "forge",
    "generated"
  ],
  "tiles": [
    {
      "id": "t-scrape-up",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Scrape up",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "min",
            "valueExpression": "",
            "alias": "up",
            "metricName": "up",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['service.instance.id']",
        "granularity": "auto"
      }
    },
    {
      "id": "t-scrape-samples",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Samples per scrape",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "scraped",
            "metricName": "scrape_samples_scraped",
            "metricType": "gauge"
          },
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "kept",
            "metricName": "scrape_samples_post_metric_relabeling",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-scrape-duration",
      "x": 0,
      "y": 7,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Scrape duration",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "duration",
            "metricName": "scrape_duration_seconds",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['service.instance.id']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "s"
        }
      }
    },
    {
      "id": "t-cpu-usage",
      "x": 0,
      "y": 14,
      "w": 12,
      "h": 7,
      "config": {
        "name": "CPU usage",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "avg",
            "valueExpression": "",
            "alias": "cpu",
            "metricName": "container.cpu.usage",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('temporal')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto"
      }
    },
    {
      "id": "t-memory-working-set",
      "x": 12,
      "y": 14,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Memory working set",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "avg",
            "valueExpression": "",
            "alias": "memory",
            "metricName": "container.memory.working_set",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('temporal')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto",
        "numberFormat": {
          "output": "byte",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-restarts",
      "x": 0,
      "y": 21,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Container restarts",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "restarts",
            "metricName": "k8s.container.restarts",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('temporal')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-restarts-by-exit-reason",
      "x": 12,
      "y": 21,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Restarts by last exit reason",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "restarts",
            "metricName": "k8s.container.restarts",
            "metricType": "gauge"
          }
        ],
        "where": "ResourceAttributes['k8s.workload.name'] IN ('temporal')",
        "whereLanguage": "sql",
        "groupBy": "Attributes['k8s.container.last_terminated_reason']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-log-volume",
      "x": 0,
      "y": 28,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Log volume by severity",
        "source": "Logs",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "records"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "SeverityText",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-logs",
      "x": 0,
      "y": 35,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Error lines",
        "source": "Logs",
        "displayType": "search",
        "select": "Timestamp, ServiceName, SeverityText, Body",
        "where": "ServiceName = 'temporal' AND lower(SeverityText) = 'error'",
        "whereLanguage": "sql"
      }
    },
    {
      "id": "t-logs",
      "x": 0,
      "y": 43,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Recent lines",
        "source": "Logs",
        "displayType": "search",
        "select": "Timestamp, ServiceName, SeverityText, Body",
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql"
      }
    },
    {
      "id": "t-span-rate",
      "x": 0,
      "y": 51,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Spans by name",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "spans"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "SpanName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-span-errors",
      "x": 12,
      "y": 51,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Span error ratio",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "spans"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "granularity": "auto",
        "seriesReturnType": "ratio",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-span-p95",
      "x": 0,
      "y": 58,
      "w": 24,
      "h": 7,
      "config": {
        "name": "p95 duration by span name",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "SpanName",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "ms"
        }
      }
    },
    {
      "id": "t-spans-by-name",
      "x": 0,
      "y": 65,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Rate, errors and latency by span name",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration/1e6",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "SpanName"
      }
    },
    {
      "id": "t-tcp-checks",
      "x": 0,
      "y": 73,
      "w": 12,
      "h": 7,
      "config": {
        "name": "TCP checks",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "min",
            "valueExpression": "",
            "alias": "connected",
            "metricName": "tcpcheck.status",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "Attributes['tcpcheck.endpoint']",
        "granularity": "auto"
      }
    },
    {
      "id": "t-http-checks",
      "x": 12,
      "y": 73,
      "w": 12,
      "h": 7,
      "config": {
        "name": "HTTP checks",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "aggCondition": "Attributes['http.status_class'] = '2xx'",
            "aggConditionLanguage": "sql",
            "alias": "2xx",
            "metricName": "httpcheck.status",
            "metricType": "sum"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "groupBy": "Attributes['http.url']",
        "granularity": "auto"
      }
    },
    {
      "id": "t-check-latency",
      "x": 0,
      "y": 80,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Check latency",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "avg",
            "valueExpression": "",
            "alias": "tcp",
            "metricName": "tcpcheck.duration",
            "metricType": "gauge"
          },
          {
            "aggFn": "avg",
            "valueExpression": "",
            "alias": "http",
            "metricName": "httpcheck.duration",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'temporal'",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "ms"
        }
      }
    }
  ],
  "filters": [
    {
      "id": "filter-env",
      "type": "QUERY_EXPRESSION",
      "name": "deployment.environment.name",
      "expression": "ResourceAttributes['deployment.environment.name']",
      "source": "Traces",
      "whereLanguage": "sql"
    }
  ]
}
