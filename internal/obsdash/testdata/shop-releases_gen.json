  "tiles": [
    {
      "id": "t-request-rate-by-version",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Requests by version",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['service.version']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-rate-by-version",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Error rate by version",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['service.version']",
        "granularity": "auto",
        "seriesReturnType": "ratio",
        "numberFormat": {
          "output": "percent",
          "mantissa": 1
        }
      }
    },
    {
      "id": "t-p95-by-version",
      "x": 0,
      "y": 7,
      "w": 12,
      "h": 7,
      "config": {
        "name": "p95 latency by version",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
