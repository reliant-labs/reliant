    {
      "id": "t-version-comparison",
      "x": 0,
      "y": 14,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Version comparison",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "requests"
          },
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "lower(StatusCode) = 'error'",
            "aggConditionLanguage": "sql",
            "alias": "errors"
          },
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration/1e6",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration/1e6",
            "alias": "p95"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "valueExpression": "Duration/1e6",
            "alias": "p99"
          }
        ],
        "where": "SpanKind IN ('Server', 'SPAN_KIND_SERVER')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['service.version']"
