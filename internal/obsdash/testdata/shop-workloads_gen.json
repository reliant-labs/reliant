        "source": "Logs",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "events"
          }
        ],
        "where": "LogAttributes['k8s.event.reason'] != ''",
        "whereLanguage": "sql",
        "groupBy": "LogAttributes['k8s.event.reason']",
