{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.gen.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "composite": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    /* Declarations for tsconfig.app.json and tsconfig.test.json, which reference this project; see tsconfig.app.json. */
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc",

    /* Relaxed linting for generated code */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    /* Note: erasableSyntaxOnly is NOT set - allows enums in generated protobuf code */
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/gen/**/*"]
}
