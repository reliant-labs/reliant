flowchart TB
    subgraph Process["Single OS Process — reliant monolith"]
        direction TB

        subgraph APILayer["API Layer"]
            direction LR
            HTTP["HTTP API\n<i>port 8080</i>"]
            GRPC["gRPC Server\n<i>port 9090</i>"]
        end

        subgraph Core["Core Engine"]
            direction LR
            TEMP["Embedded Temporal\n<i>SQLite-backed</i>"]
            WKRS["In-Process Workers"]
        end

        subgraph DaemonLayer["Tools Daemon (in-process)"]
            direction LR
            LAZY["LazyDaemonStarter\n<i>starts on first auth request</i>"]
            LOCAL["LocalDaemonRouter\n<i>direct function calls</i>"]
        end

        MEM["MemoryUpdateHub\n<i>In-memory pub/sub</i>"]

        APILayer --> Core
        Core --> DaemonLayer
        Core --> MEM
        MEM --> APILayer
    end

    subgraph Data["📁 data/"]
        direction LR
        APPDB[("reliant.db\n<i>App state</i>")]
        TMPDB[("temporal.db\n<i>Workflow state</i>")]
        CERTS["certs/\n<i>Auto-generated TLS</i>"]
        LOCK[".reliant-backend.lock\n<i>PID lock</i>"]
    end

    subgraph External["External"]
        direction LR
        FE["Frontend\n<i>Web / Electron</i>"]
        LLMS["LLM Providers\n<i>Anthropic, OpenAI</i>"]
    end

    FE -->|REST + gRPC| APILayer
    Core -->|inference| LLMS
    Process --> Data

    classDef process fill:#F0FDF4,stroke:#16A34A,color:#1F2937
    classDef api fill:#4F46E5,stroke:#3730A3,color:#fff
    classDef core fill:#0891B2,stroke:#0E7490,color:#fff
    classDef daemon fill:#D97706,stroke:#B45309,color:#fff
    classDef mem fill:#7C3AED,stroke:#5B21B6,color:#fff
    classDef data fill:#64748B,stroke:#475569,color:#fff
    classDef external fill:#F3F4F6,stroke:#9CA3AF,color:#1F2937

    class HTTP,GRPC api
    class TEMP,WKRS core
    class LAZY,LOCAL daemon
    class MEM mem
    class APPDB,TMPDB,CERTS,LOCK data
    class FE,LLMS external
