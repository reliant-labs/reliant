goroutines.txt
# go.work is gitignored and machine-local: it bridges this checkout to the
# sibling ../forge modules so local edits are picked up without a release.
# Inside the image those paths do not exist, and the build must resolve every
# module at the version go.mod pins. Without this exclusion `COPY . .` drags it
# in and the build dies with:
#   go: cannot load module /forge/pkg listed in go.work file
go.work
go.work.sum
